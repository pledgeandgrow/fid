// expect-error: calling the @unsafe function poke() needs an `unsafe` block
// Release M10: an @unsafe function's contract is its caller's to keep, so a
// call from safe code needs an `unsafe` block (with a `// SAFETY:` comment
// saying why the contract holds) or an @unsafe caller. Here main hands poke
// an address it made up (0x1000) outside `unsafe`: the call is rejected at
// compile time instead of writing to memory nobody owns. Before, only raw
// memory, C calls and integer-to-pointer casts needed `unsafe`; a call to an
// @unsafe function of the program itself did not (test_unsafe_call_ok.fd:
// the same call inside `unsafe` is accepted).

// SAFETY: the caller's promise: p is a live, aligned, writable word.
@unsafe
fn poke(p: i64, v: i64) {
    var w: * mut i64 = p;
    * w = v;
}

fn main() -> i64 {
    poke(4096, 1);
    println("written");
    return 0;
}
