// stdlib/i18n: CLDR cardinal plural categories for 17 languages on the CLDR sample numbers (including v/f operands: "1" vs "1.0"), locale number formatting (grouping, minimum grouping digits, U+202F/U+00A0 spaces shown as <nnbsp>/<nbsp>, Arabic-Indic digits), CLDR short/long dates, and catalog messages with placeholders, plural (=N, #) and select, with locale fallback.
// Expected output:
// en 0:other 1:one 2:other 1.0:other 1.5:other
// de 1:one 2:other 1.0:other
// fr 0:one 1:one 1.5:one 2:other 1000000:many
// pt-BR 0:one 1:one 1.7:one 2:other
// es 1:one 1.0:one 2:other 1000000:many
// it 1:one 1.0:other 5:other 2000000:many
// ru 1:one 2:few 5:many 11:many 12:many 21:one 22:few 25:many 111:many 1.5:other
// uk 31:one 34:few 35:many 113:many
// pl 1:one 2:few 5:many 12:many 22:few 25:many 101:many 102:few 1.5:other
// cs 1:one 2:few 4:few 5:other 1.5:many
// ar 0:zero 1:one 2:two 3:few 10:few 11:many 99:many 100:other 102:other 103:few 111:many 1.5:other
// he 1:one 2:two 3:other 0.5:one 20:other
// tr 1:one 2:other
// ja 0:other 1:other 2:other
// zh 1:other
// ko 1:other
// nl 1:one 2:other
// en 1,234,567.89 0.00 1,000.00 1,000
// de 1.234.567,89 1.234
// es 1234 12.345 1.234.567,5
// fr 1<nnbsp>234<nnbsp>567,89
// ru 1<nbsp>234<nbsp>567,5
// pl 1234 12<nbsp>345
// ja 1,234,567 zh 0.5
// ar ١٬٢٣٤٫٥
// en 3/7/26 | March 7, 2026
// de 07.03.26 | 7. März 2026
// fr 07/03/2026 | 7 mars 2026
// es 7/3/26 | 7 de marzo de 2026
// it 07/03/26 | 7 marzo 2026
// pt 07/03/2026 | 7 de março de 2026
// nl 07-03-2026 | 7 maart 2026
// ru 07.03.2026 | 7 марта 2026 г.
// pl 7.03.2026 | 7 marca 2026
// ja 2026/03/07 | 2026年3月7日
// zh 2026/3/7 | 2026年3月7日
// Ann has no files. / У Ann нет файлов. / Ann ma 0 plików.
// Ann has 1 file. / У Ann 1 файл. / Ann ma 1 plik.
// Ann has 2 files. / У Ann 2 файла. / Ann ma 2 pliki.
// Ann has 5 files. / У Ann 5 файлов. / Ann ma 5 plików.
// Ann has 22 files. / У Ann 22 файла. / Ann ma 22 pliki.
// Ann has 1.5 files. / У Ann 1,5 файла. / Ann ma 1,5 pliku.
// Ann has 1,234 files. / У Ann 1 234 файла. / Ann ma 1234 pliki.
// Kim liked her photo
// Sam liked their photo
// fallback: English only / missing: nope.key
// lang: pt zh en
use i18n;
use vec;
use string;

fn cats(locale: str, nums: str) -> str {
    val ns: Vec<str> = str_split(nums, " ");
    var o: str = "";
    var i: i64 = 0;
    while i < ns.len() {
        if i > 0 { o = o + " "; }
        o = o + ns.get(i) + ":" + i18n_plural(locale, ns.get(i));
        i = i + 1;
    }
    return locale + " " + o;
}

fn vis(s: str) -> str {
    return str_replace(str_replace(s, "\u{202F}", "<nnbsp>"), "\u{00A0}", "<nbsp>");
}

fn main() -> i64 {
    println(cats("en", "0 1 2 1.0 1.5"));
    println(cats("de", "1 2 1.0"));
    println(cats("fr", "0 1 1.5 2 1000000"));
    println(cats("pt-BR", "0 1 1.7 2"));
    println(cats("es", "1 1.0 2 1000000"));
    println(cats("it", "1 1.0 5 2000000"));
    println(cats("ru", "1 2 5 11 12 21 22 25 111 1.5"));
    println(cats("uk", "31 34 35 113"));
    println(cats("pl", "1 2 5 12 22 25 101 102 1.5"));
    println(cats("cs", "1 2 4 5 1.5"));
    println(cats("ar", "0 1 2 3 10 11 99 100 102 103 111 1.5"));
    println(cats("he", "1 2 3 0.5 20"));
    println(cats("tr", "1 2"));
    println(cats("ja", "0 1 2"));
    println(cats("zh", "1"));
    println(cats("ko", "1"));
    println(cats("nl", "1 2"));

    println("en " + i18n_number("en", "1234567.891", 2) + " " + i18n_number("en", "-0.004", 2) + " " + i18n_number("en", "999.995", 2) + " " + i18n_int("en", 1000));
    println("de " + i18n_number("de", "1234567.891", 2) + " " + i18n_int("de", 1234));
    println("es " + i18n_int("es", 1234) + " " + i18n_int("es", 12345) + " " + i18n_number("es", "1234567.5", 1));
    println("fr " + vis(i18n_number("fr", "1234567.891", 2)));
    println("ru " + vis(i18n_number("ru", "1234567.5", 1)));
    println("pl " + vis(i18n_int("pl", 1234)) + " " + vis(i18n_int("pl", 12345)));
    println("ja " + i18n_number("ja", "1234567", 0) + " zh " + i18n_number("zh", "0.5", 1));
    println("ar " + i18n_number("ar", "1234.5", 1));

    println("en " + i18n_date("en", "short", 2026, 3, 7) + " | " + i18n_date("en", "long", 2026, 3, 7));
    println("de " + i18n_date("de", "short", 2026, 3, 7) + " | " + i18n_date("de", "long", 2026, 3, 7));
    println("fr " + i18n_date("fr", "short", 2026, 3, 7) + " | " + i18n_date("fr", "long", 2026, 3, 7));
    println("es " + i18n_date("es", "short", 2026, 3, 7) + " | " + i18n_date("es", "long", 2026, 3, 7));
    println("it " + i18n_date("it", "short", 2026, 3, 7) + " | " + i18n_date("it", "long", 2026, 3, 7));
    println("pt " + i18n_date("pt", "short", 2026, 3, 7) + " | " + i18n_date("pt", "long", 2026, 3, 7));
    println("nl " + i18n_date("nl", "short", 2026, 3, 7) + " | " + i18n_date("nl", "long", 2026, 3, 7));
    println("ru " + i18n_date("ru", "short", 2026, 3, 7) + " | " + i18n_date("ru", "long", 2026, 3, 7));
    println("pl " + i18n_date("pl", "short", 2026, 3, 7) + " | " + i18n_date("pl", "long", 2026, 3, 7));
    println("ja " + i18n_date("ja", "short", 2026, 3, 7) + " | " + i18n_date("ja", "long", 2026, 3, 7));
    println("zh " + i18n_date("zh", "short", 2026, 3, 7) + " | " + i18n_date("zh", "long", 2026, 3, 7));

    var c: I18n = i18n_new("en");
    i18n_add(& mut c, "en", "files", "{user} has {n, plural, =0 {no files} one {# file} other {# files}}.");
    i18n_add(& mut c, "ru", "files", "У {user} {n, plural, =0 {нет файлов} one {# файл} few {# файла} many {# файлов} other {# файла}}.");
    i18n_add(& mut c, "pl", "files", "{user} ma {n, plural, one {# plik} few {# pliki} many {# plików} other {# pliku}}.");
    i18n_add(& mut c, "en", "liked", "{name} liked {gender, select, female {her} male {his} other {their}} photo");
    i18n_add(& mut c, "en", "only.en", "English only");
    val ns: Vec<str> = str_split("0 1 2 5 22 1.5 1234", " ");
    var i: i64 = 0;
    while i < ns.len() {
        var a: I18nArgs = i18n_args1("user", "Ann");
        i18n_arg(& mut a, "n", ns.get(i));
        println(i18n_t(& c, "en", "files", a) + " / " + i18n_t(& c, "ru", "files", a) + " / " + i18n_t(& c, "pl-PL", "files", a));
        i = i + 1;
    }
    var g: I18nArgs = i18n_args1("name", "Kim");
    i18n_arg(& mut g, "gender", "female");
    println(i18n_t(& c, "en", "liked", g));
    var g2: I18nArgs = i18n_args1("name", "Sam");
    i18n_arg(& mut g2, "gender", "unknown");
    println(i18n_t(& c, "en", "liked", g2));
    println("fallback: " + i18n_t(& c, "ru", "only.en", i18n_args()) + " / missing: " + i18n_t(& c, "ru", "nope.key", i18n_args()));
    println("lang: " + i18n_lang("pt-BR") + " " + i18n_lang("zh_Hant_TW") + " " + i18n_lang("EN"));
    return 0;
}
