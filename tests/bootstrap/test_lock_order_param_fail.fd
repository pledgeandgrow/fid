// expect-error: Deadlock error: locks are taken in an inconsistent order: 'a' (a local of 'main') then 'b' (a local of 'main')
// Complaint roadmap CA4: locks passed as arguments. `lock_both(x, y)` takes
// its first argument then its second; `main` calls it as (a, b) and as
// (b, a), so the two calls take the same two mutexes in opposite orders.

fn lock_both(x: i64, y: i64) -> i64 {
    p_mutex_lock(x);
    p_mutex_lock(y);
    p_mutex_unlock(y);
    p_mutex_unlock(x);
    return 1;
}

fn main() {
    val a: i64 = p_mutex_init();
    val b: i64 = p_mutex_init();
    var n: i64 = lock_both(a, b);
    n = n + lock_both(b, a);
    println(int_to_str(n));
}
