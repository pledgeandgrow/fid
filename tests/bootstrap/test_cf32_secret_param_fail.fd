// expect-error: branches on secret data
// CF32: only a parameter @public marks is public to the constant-time
// check. `shut` branches on a parameter of its own that is not marked,
// though `open`, looked at just before, has that position marked.
@constant_time
fn open(@public flag: i64, a: i64) -> i64 {
    var r: i64 = 0;
    if flag == 1 {
        r = a;
    }
    return r;
}

@constant_time
fn shut(flag: i64, a: i64) -> i64 {
    var r: i64 = 0;
    if flag == 1 {
        r = a;
    }
    return r;
}

fn main() -> i64 {
    println(open(1, 9));
    println(shut(1, 9));
    return 0;
}
