// L8F: Comptime reflection — function_effects and function_capabilities
cap Display {
    fn show(self) -> str;
}

struct Widget {
    id: i64,
}

impl Display for Widget {
    pub fn show(self: Widget) -> str {
        return "widget";
    }
}

fn main() {
    // function_capabilities — show method's containing type (Widget) implements Display
    val caps = comptime function_capabilities(show);
    // The result is a comptime-substituted array literal.
    // We can iterate or index it. Print the first capability.
    print(caps[0]);
}
