// expect-error: Init error: variable 'x' is used before being assigned a value.
// Bugs roadmap BG20: the init guarantee (F63) joined the branches of an
// `if` only: an assignment in any one arm of a `match` counted, so x was
// read unassigned when k is not 1.
fn main() -> i64 {
    val k: i64 = 2;
    var x: i64;
    match k {
        1 => {
            x = 5;
        }
        _ => {
        }
    }
    println(int_to_str(x));
    return 0;
}
