// OP5 (competitive roadmap): inline2 (compiler/iropt_me.fd
// ime_inline_site, on by default) copying a void callee whose call's value
// is used. A function that ends in `panic(..)` is lowered to
// `%c = call panic(..): void; return %c`; when inline2 copies core's
// `panic` in, %c must stay defined (it becomes a 0). Before the fix,
// `FID_VERIFY=1 fid emit` stopped with "IR verifier (after iropt):
// classify: %N uses %M, which is defined nowhere" (stdlib json_len did the
// same in test_json). tests/tooling/inline2-check.sh emits it with
// FID_VERIFY=1, inline2 on and off.
//
// Expected output:
// 1
// 2
// 7
// 3

fn classify(x: i64) -> i64 {
    if x > 0 {
        return 1;
    }
    if x < 0 {
        return 2;
    }
    panic("classify: zero");
}

fn note(x: i64) {
    if x > 100 {
        println(x);
    }
}

fn pick(x: i64) -> i64 {
    note(x);
    if x != 0 {
        return x + 6;
    }
    panic("pick: zero");
}

fn main() {
    println(classify(5));
    println(classify(0 - 3));
    println(pick(1));
    var s: i64 = 0;
    var i: i64 = 0;
    while i < 3 {
        note(i);
        s = s + 1;
        i = i + 1;
    }
    println(s);
}
