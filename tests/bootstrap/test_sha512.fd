// sha512.fd against FIPS 180-4 / NIST CAVP example vectors:
//   "abc" (one block), "" (empty), the 896-bit two-block message,
// plus padding edges (111, 112, 127, 128 bytes of 'a') and a 1280-byte
// message, whose digests come from Python's hashlib.
// A wrong answer panics on every backend.
use sha512;

fn check(label: str, got: str, want: str) {
    if !str_equal(got, want) {
        p_panic(label + ": got " + got + ", want " + want);
    }
    println(label + " ok");
}

fn repeat_a(n: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n { v.push(97); i = i + 1; }
    return v;
}

fn main() -> i64 {
    check("sha512 abc", sha512_hex(sha512_str("abc")),
        "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a" +
        "2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f");
    check("sha512 empty", sha512_hex(sha512_bytes(Vec::new())),
        "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce" +
        "47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e");
    check("sha512 896-bit", sha512_hex(sha512_str(
        "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmno" +
        "ijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu")),
        "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018" +
        "501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909");
    check("sha512 a*111", sha512_hex(sha512_bytes(repeat_a(111))),
        "fa9121c7b32b9e01733d034cfc78cbf67f926c7ed83e82200ef86818196921760b4beff48404df811b953828274461673c68d04e297b0eb7b2b4d60fc6b566a2");
    check("sha512 a*112", sha512_hex(sha512_bytes(repeat_a(112))),
        "c01d080efd492776a1c43bd23dd99d0a2e626d481e16782e75d54c2503b5dc32bd05f0f1ba33e568b88fd2d970929b719ecbb152f58f130a407c8830604b70ca");
    check("sha512 a*127", sha512_hex(sha512_bytes(repeat_a(127))),
        "828613968b501dc00a97e08c73b118aa8876c26b8aac93df128502ab360f91bab50a51e088769a5c1eff4782ace147dce3642554199876374291f5d921629502");
    check("sha512 a*128", sha512_hex(sha512_bytes(repeat_a(128))),
        "b73d1929aa615934e61a871596b3f3b33359f42b8175602e89f7e06e5f658a243667807ed300314b95cacdd579f3e33abdfbe351909519a846d465c59582f321");
    var big: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 1280 { big.push(i % 256); i = i + 1; }
    check("sha512 1280 bytes", sha512_hex(sha512_bytes(big)),
        "c93f55ccf2fa8c82699ff9b58afe3591242b135d908a6d865e17e38adb41c21d1d5359e51273036373d54d20b5659cc87e6e7b381ff027d33f971416cc590f90");
    println("sha512 vectors ok");
    return 0;
}
