// expect-error: Borrow error: function 'keep' returns a @scoped struct, which cannot outlive its scope.
// TL2: a diagnostic per check. A @scoped struct lives only in the scope
// that made it: no function may return one.

@scoped
struct View {
    at: i64,
}

fn keep(x: i64) -> View {
    return View { at: x };
}

fn main() -> i64 {
    val v: View = keep(3);
    println(int_to_str(v.at));
    return 0;
}
