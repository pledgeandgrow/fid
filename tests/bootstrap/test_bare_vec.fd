// An un-annotated Vec says nothing about its elements.
fn main() -> i64 {
    val names = Vec::new();
    names.push("a");
    names.push("b");
    var first: str = names.get(0);
    println(first);
    val nums = Vec::new();
    nums.push(2);
    nums.push(3);
    print(nums.get(0) * nums.get(1) + 1);
    print("\n");
    return 0;
}
