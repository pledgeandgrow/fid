// expect-error: p_sandbox_exit() cannot be called inside sandbox
//! error: p_sandbox_exit() cannot be called inside sandbox
// TL2: a test per diagnostic of the type, borrow and escape checks.
// Code in a sandbox may not lift its own revocation.

fn main() -> i64 {
    sandbox {
        p_sandbox_exit();
    }
    return 0;
}
