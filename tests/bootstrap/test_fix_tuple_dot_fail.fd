// expect-error: a tuple element is not read with `.N`
// Test (stdlib-agent bug 16): Fides reads a tuple by destructuring
// (reference §5.1, `val (a, b) = p;`); there is no `p.0`. The error said
// "expected identifier but got '0'"; it now says how to read the element.
fn pair() -> (i64, i64) {
    return (3, 4);
}

fn main() {
    val p = pair();
    println(int_to_str(p.0));
}
