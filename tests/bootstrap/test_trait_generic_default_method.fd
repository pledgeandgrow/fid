// LG4: a generic trait method with a default body that an impl does not
// override keeps its type parameters when compiler.fd
// fill_default_trait_methods copies it into the impl, so the checker binds
// U at each call and mono instantiates it per type (before, the copy lost
// `<U>` and `U` was an unknown type in the filled method).
// Expected output:
// 7
// hi
// 2.5
// 10
// over
cap Keep {
    fn keep<U>(self, x: U) -> U {
        return x;
    }
    fn base(self) -> i64;
}

struct A { n: i64 }
struct B { n: i64 }

impl Keep for A {
    fn base(self) -> i64 { return self.n; }
}

impl Keep for B {
    fn keep<U>(self, x: U) -> U { return x; }
    fn base(self) -> i64 { return self.n * 2; }
}

fn main() -> i64 {
    val a: A = A { n: 5 };
    val k: i64 = a.keep(7);
    println(int_to_str(k));
    val s: str = a.keep("hi");
    println(s);
    val f: f64 = a.keep(2.5);
    println(f);
    val b: B = B { n: 5 };
    println(int_to_str(b.base()));
    println(b.keep("over"));
    return 0;
}
