// expect-error: embed() reads a file while compiling: call it in comptime code.
// expect-error: embed takes one argument, the file's path (a str)
// embed() reads a file at compile time (comptime only), and takes exactly
// one str: the path.
fn main() -> i64 {
    val bytes: Vec<i64> = embed("data.bin");
    comptime { embed("a.txt", "b.txt"); }
    println(bytes.len());
    return 0;
}
