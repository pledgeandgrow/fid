// stdlib/brotli (competitive SL10): decoding Brotli streams (RFC 7932).
// Most streams come from the reference encoder (Python's brotli 1.2.1) at
// quality 0, 5 and 11, MODE_TEXT and MODE_GENERIC, lgwin 10 and 24: English
// text that quality 11 codes with static-dictionary words and transforms,
// UTF-8 text, binary data, a long repetitive text, random bytes (an
// uncompressed meta-block). Two streams are hand-made
// (scratch encoder, checked with brotli.decompress): one with a dictionary
// reference for each of the 121 transforms, and one with metadata
// meta-blocks, an uncompressed meta-block and NPOSTFIX/NDIRECT distance
// codes. Each line gives the decoded length and its CRC-32 (zlib's);
// some print a slice of the text, and the UTF-8 one is printed whole
// through brotli_decompress_str. Empty streams decode to zero bytes with
// brotli_ok true; corrupted streams (a flipped bit, a cut end, a byte
// after the end) must give the error result, not a panic.
//
// Expected output:
// short: 23 bytes, crc32 2170218022
//   "hello hello hello world"
// english q11 text: 709 bytes, crc32 1455242721
//   "or your interest in our community, and we hope that you will find something useful here."
// english q11 generic: 709 bytes, crc32 1455242721
// medium q0: 348 bytes, crc32 1201824475
//   "A brotli stream is a sequence of m"
// medium q5: 348 bytes, crc32 1201824475
// medium q11: 348 bytes, crc32 1201824475
// medium q11 lgwin 24: 348 bytes, crc32 1201824475
// medium q11 lgwin 10: 348 bytes, crc32 1201824475
// repetitive q5: 6480 bytes, crc32 2453282764
//   "line 119: the quick brown fox jumps over the lazy dog"
// utf-8 q11: 205 bytes, crc32 878660712
//   "Ça va très bien, merci beau"
// binary q11: 700 bytes, crc32 2857310115
// random q5: 100 bytes, crc32 657427164
// 121 transforms: 1714 bytes, crc32 1903391530
//   "timetitle  window essionवेल underline the  Refe"
// metadata+raw+postfix: 90 bytes, crc32 3265699597
//   "Hello, brotli! abcabcabc-! ab0123456789"
// Ça va très bien, merci beaucoup ! Où est la gare ? Привет, как дела? Всё хорошо, спасибо. 日本語のテキストも圧縮できます。 Ελληνικά γράμματα.
// empty: 0 bytes, ok true, error ""
// empty: 0 bytes, ok true, error ""
// flipped bit: ERR
// truncated: ERR
// trailing byte: ERR

use brotli;
use compress;
use string;

fn bytes(csv_list: str) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var parts: Vec<str> = str_split(csv_list, ",");
    var i: i64 = 0;
    while i < parts.len() {
        out.push(str_parse_int(parts.get(i)));
        i = i + 1;
    }
    return out;
}

fn check(name: str, stream: Vec<i64>, a: i64, b: i64) -> void {
    val out: Vec<i64> = brotli_decompress(stream);
    val n: str = int_to_str(out.len());
    val c: str = int_to_str(crc32_bytes(out));
    println(name + ": " + n + " bytes, crc32 " + c);
    if b > a {
        // the decoded bytes [a, b) as text
        var sb: StringBuilder = StringBuilder::new();
        var i: i64 = a;
        while i < b && i < out.len() { sb.append_char(out[i]); i = i + 1; }
        val part: str = sb.to_str();
        println("  \"" + part + "\"");
    }
}

fn empty(stream: Vec<i64>) -> void {
    val out: Vec<i64> = brotli_decompress(stream);
    val n: str = int_to_str(out.len());
    val ok: bool = brotli_ok(stream);
    var oks: str = "false";
    if ok { oks = "true"; }
    val err: str = brotli_error(stream);
    println("empty: " + n + " bytes, ok " + oks + ", error \"" + err + "\"");
}

fn corrupt(name: str, stream: Vec<i64>) -> void {
    val out: Vec<i64> = brotli_decompress(stream);
    val ok: bool = brotli_ok(stream);
    if out.len() == 0 && !ok { println(name + ": ERR"); }
    else { println(name + ": decoded, expected an error"); }
}

