// Roadmap Phase 9 (aerospace, F45): @redundant runs a function as two
// channels and votes. compiler/mono.fd turns `pitch_command` into
// `pitch_command_chan_a`, `pitch_command_chan_b` and a voter that calls
// both with the same arguments and stops (fail-safe) if they disagree.
// The typechecker accepted it: scalar result, no `&mut` parameter, and
// nothing it reaches does IO or writes a global.
// Expected output:
//   pitch 700
//   pitch -1000
//   in range true

fn clamp(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo {
        return lo;
    }
    if v > hi {
        return hi;
    }
    return v;
}

@redundant
fn pitch_command(alpha: i64, q: i64) -> i64 {
    val p: i64 = alpha * 100 + q * 50;
    return clamp(p, 0 - 1000, 1000);
}

@redundant
fn in_envelope(speed: i64) -> bool {
    return speed > 120 && speed < 900;
}

fn main() {
    println("pitch " + int_to_str(pitch_command(5, 4)));
    println("pitch " + int_to_str(pitch_command(0 - 30, 2)));
    if in_envelope(450) {
        println("in range true");
    } else {
        println("in range false");
    }
}
