// BM4 (competitive roadmap): strings, "0,1,...,999," built and hashed.
// bench/work/fides/strings.fd on a small input (strings(1000)), so the suite checks
// the benchmark's code on every backend; the expected value is the
// reference algorithm's, computed in Python with the same operations.
//
// Expected output:
// 38889532800003890
fn strings(n: i64) -> i64 {
    var sb: StringBuilder = StringBuilder::new();
    var i: i64 = 0;
    while i < n {
        sb.append_int(i);
        sb.append_char(44);
        i = i + 1;
    }
    val s: str = sb.to_str();
    val len: i64 = str_len(s);
    var h: i64 = 0;
    i = 0;
    while i < len {
        h = (h * 31 + str_byte_at(s, i)) % 1000000007;
        i = i + 1;
    }
    return h * 100000000 + len;
}

fn main() -> i64 {
    println(strings(1000));
    return 0;
}
