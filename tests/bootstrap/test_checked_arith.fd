// Test: F64 checked arithmetic lock + F65 @wrapping escape hatch
//
// F64: overflow in normal functions = panic (checked arithmetic is the default)
// F65: @wrapping functions use wrap-around arithmetic (no panic)

@wrapping fn hash_combine(x: i64, k: i64) -> i64 {
    // Hashing needs wrap-around — this would panic without @wrapping
    val r = x * 31;
    return r + k;
}

@wrapping fn rotl(x: i64, n: i64) -> i64 {
    // Bit rotation needs wrapping
    return (x << n) | (x >> (64 - n));
}

fn safe_add(a: i64, b: i64) -> i64 {
    return a + b;
}

fn main() {
    // Normal arithmetic — no overflow
    val r1 = safe_add(100, 200);
    print("100 + 200 = ");
    print(r1);
    print("\n");

    // @wrapping function — wraps instead of panicking
    val max_val: i64 = 9223372036854775807;
    val h = hash_combine(max_val, 1);
    print("hash_combine(MAX, 1) = ");
    print(h);
    print("\n");

    // Another @wrapping test
    val r2 = rotl(1, 63);
    print("rotl(1, 63) = ");
    print(r2);
    print("\n");

    // Large multiplication with @wrapping
    val h2 = hash_combine(1000000000, 1000000000);
    print("hash_combine(1B, 1B) = ");
    print(h2);
    print("\n");

    print("OK\n");
}
