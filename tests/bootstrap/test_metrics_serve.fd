// metrics: GET /metrics served in the Prometheus text format (CO3).
// The handler is exercised directly — a real serve blocks until shutdown.
use metrics;
use http;

fn req(path: str) -> HttpRequest {
    return http_parse_head("GET " + path + " HTTP/1.1\r\n\r\n");
}

fn main() -> i64 {
    var m: Metrics = metrics_new();
    val c: i64 = metrics_counter(&mut m, "requests_total", "Requests");
    metrics_inc(&mut m, c, 5);
    metrics_serve_set(m);

    var resp: str = metrics_http_handler(req("/metrics"));
    println(str_find(resp, "200 OK") >= 0);
    println(str_find(resp, "requests_total 5") >= 0);

    var other: str = metrics_http_handler(req("/elsewhere"));
    println(str_find(other, "404") >= 0);
    println("metrics serve OK");
    return 0;
}
