// Freeing what locals own (release C5-C7): a Vec<str> that owns its
// strings, a Vec<Vec<i64>> that owns its Vecs, a HashMap local, and
// collections declared in a region, freed at the region's end. A Vec<str>
// whose elements escape keeps them alive. Every value read must stay right
// (a double free or a dangling read would crash or print garbage).

fn owned_strings(n: i64) -> i64 {
    var names: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < n {
        names.push("item" + int_to_str(i));
        i = i + 1;
    }
    var total: i64 = 0;
    i = 0;
    while i < names.len() {
        total = total + str_len(names.get(i));
        i = i + 1;
    }
    return total;
}

fn owned_vecs(n: i64) -> i64 {
    var rows: Vec<Vec<i64>> = Vec::new();
    var i: i64 = 0;
    while i < n {
        rows.push(Vec::new());
        i = i + 1;
    }
    return rows.len();
}

fn escaping(n: i64) -> str {
    var parts: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < n {
        parts.push("p" + int_to_str(i));
        i = i + 1;
    }
    // the element leaves the function: the Vec must not free it
    val kept: str = parts.get(n - 1);
    return kept;
}

fn map_local(n: i64) -> i64 {
    var m: HashMap<str, i64> = HashMap::new();
    var i: i64 = 0;
    while i < n {
        m.insert("k" + int_to_str(i), i * 2);
        i = i + 1;
    }
    return m.get("k3") + m.len();
}

fn in_region(rounds: i64) -> i64 {
    var sum: i64 = 0;
    var r: i64 = 0;
    while r < rounds {
        region scratch {
            var tmp: Vec<i64> = Vec::new();
            tmp.push(r);
            tmp.push(r * 10);
            sum = sum + tmp.get(0) + tmp.get(1);
        }
        r = r + 1;
    }
    return sum;
}

fn main() -> i64 {
    var round: i64 = 0;
    var a: i64 = 0;
    var b: i64 = 0;
    var c: str = "";
    var d: i64 = 0;
    while round < 200 {
        a = owned_strings(50);
        b = owned_vecs(20);
        c = escaping(5);
        d = map_local(10);
        round = round + 1;
    }
    println(a);
    println(b);
    println(c);
    println(d);
    println(in_region(100));
    return 0;
}
