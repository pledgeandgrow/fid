// BG257 (docs/roadmap/bugs-roadmap.md): a literal of a struct of another
// module parses whatever the case of its name. math's `vec2` and `mat4`
// are lowercase, and a literal of either was "unexpected token 'Colon'":
// with the first field on the next line, on the same line, after `val`.
// A block after a lowercase name (a loop over a Vec, a condition on a
// variable) is still a block.
//
// Expected output:
// true
// true
// true
// true
// true
// true
// true
use core;
use math;

fn next_line() -> vec2 {
    return vec2 {
        x: 1.0, y: 2.5
    };
}

fn same_line() -> vec2 {
    return vec2 { x: 3.0,
        y: 4.0
    };
}

fn after_val() -> vec2 {
    val v = vec2 {
        x: 5.0, y: 6.0
    };
    return v;
}

fn the_matrix() -> mat4 {
    return mat4 {
        m00: 1.0, m01: 0.0, m02: 0.0, m03: 7.0, m10: 0.0, m11: 1.0, m12: 0.0, m13: 8.0, m20: 0.0, m21: 0.0, m22: 1.0, m23: 9.0, m30: 0.0, m31: 0.0, m32: 0.0, m33: 1.0
    };
}

fn main() -> i64 {
    val a = next_line();
    println(a.x == 1.0 && a.y == 2.5);
    val b = same_line();
    println(b.x == 3.0 && b.y == 4.0);
    val c = after_val();
    println(c.x == 5.0 && c.y == 6.0);
    val m = the_matrix();
    println(m.m00 == 1.0 && m.m11 == 1.0 && m.m22 == 1.0 && m.m33 == 1.0 && m.m03 == 7.0 && m.m13 == 8.0 && m.m23 == 9.0 && m.m01 == 0.0 && m.m32 == 0.0);
    // a block still follows a lowercase name
    var pts: Vec<vec2> = Vec::new();
    pts.push(next_line());
    pts.push(same_line());
    var total: f64 = 0.0;
    for p in pts {
        total = total + p.x;
    }
    println(total == 4.0);
    var n: i64 = pts.len();
    var seen: i64 = 0;
    while n > 0 {
        seen = seen + 1;
        n = n - 1;
    }
    println(seen == 2);
    var ok = total == 4.0;
    if ok {
        ok = false;
    }
    println(!ok);
    return 0;
}
