// stdlib/ahci: structure bytes (H2D FIS, command header, PRD), then the driver against a simulated 2-port HBA.
// Expected output:
// READ DMA EXT FIS: 278025009a785640341200000800000000000000
// IDENTIFY FIS: 2780ec0000000000000000000000000000000000
// command header: 4500010000000000805634120000000000000000000000000000000000000000
// header parsed: cfl 5 write true prdtl 1 ctba 305419904
// PRD 4 KiB irq: 000020000000000000000000ff0f0080
// PRD entries for 9 MiB: 3
// D2H: valid true irq true status 80 error 0 lba 4096 count 1
// CAP: 2 ports, 32 slots, gen 3, 64-bit true, NCQ true, AHCI 1.3.1
// probe: port 0 SATA, speed gen 2
// port 0 setup: ok, CLB 65536 FB 66560
// IDENTIFY: model "FIDES SIMULATED DISK", serial "SN0001", firmware "1.0", lba48 true, 64 sectors of 512, NCQ true depth 32
// write 2 sectors at LBA 5, read back: same 1024 bytes
// slot used: 0, prdbc 1024
// unsupported command: EIO status 65 error 4
// block device: 64 blocks, sector 10 round trip: true
// misaligned set-up: misaligned CLB, FB or command table
use ahci;
use vfs;
use vec;
use string;
use encoding;

// --- the simulated HBA ------------------------------------------------------------

var sim_regs: HashMap<i64, i64> = HashMap::new();
var sim_mem: HashMap<i64, i64> = HashMap::new();
var sim_disk: HashMap<i64, i64> = HashMap::new();
var sim_slot_seen: i64 = -1;

fn sim_get(m: & HashMap<i64, i64>, k: i64) -> i64 {
    if m.contains(k) {
        return m.get(k);
    }
    return 0;
}

fn sim_mem_rd(addr: i64, n: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        out.push(sim_get(&sim_mem, addr + i));
        i = i + 1;
    }
    return out;
}

fn sim_mem_wr(addr: i64, data: Vec<i64>) -> i64 {
    var i: i64 = 0;
    while i < data.len() {
        sim_mem.insert(addr + i, data.get(i));
        i = i + 1;
    }
    return 0;
}

fn sim_mem32(addr: i64) -> i64 {
    return sim_get(&sim_mem, addr) | (sim_get(&sim_mem, addr + 1) << 8) | (sim_get(&sim_mem, addr + 2) << 16) | (sim_get(&sim_mem, addr + 3) << 24);
}

fn sim_put32(addr: i64, v: i64) {
    sim_mem.insert(addr, v & 255);
    sim_mem.insert(addr + 1, (v >> 8) & 255);
    sim_mem.insert(addr + 2, (v >> 16) & 255);
    sim_mem.insert(addr + 3, (v >> 24) & 255);
}

fn sim_rd(off: i64) -> i64 {
    return sim_get(&sim_regs, off);
}

fn sim_identify_data() -> Vec<i64> {
    var d: Vec<i64> = Vec::filled(512, 0);
    val model: Vec<i64> = str_bytes(str_pad_right("FIDES SIMULATED DISK", 40, 32));
    val serial: Vec<i64> = str_bytes(str_pad_right("SN0001", 20, 32));
    val fw: Vec<i64> = str_bytes(str_pad_right("1.0", 8, 32));
    var i: i64 = 0;
    // ATA strings: two characters per word, the first in the high byte
    while i < 40 {
        d.set(54 + i, model.get(i ^ 1));
        i = i + 1;
    }
    i = 0;
    while i < 20 {
        d.set(20 + i, serial.get(i ^ 1));
        i = i + 1;
    }
    i = 0;
    while i < 8 {
        d.set(46 + i, fw.get(i ^ 1));
        i = i + 1;
    }
    d.set(150, 31);
    d.set(153, 1);
    d.set(167, 4);
    d.set(200, 64);
    return d;
}

/// Execute the command in `slot` of port `p` as a SATA disk would.
fn sim_exec(p: i64, slot: i64) {
    sim_slot_seen = slot;
    val base: i64 = 256 + 128 * p;
    val clb: i64 = sim_rd(base) | (sim_rd(base + 4) << 32);
    val fb: i64 = sim_rd(base + 8) | (sim_rd(base + 12) << 32);
    val hdr: i64 = clb + 32 * slot;
    val dw0: i64 = sim_mem32(hdr);
    val prdtl: i64 = (dw0 >> 16) & 65535;
    val ctba: i64 = sim_mem32(hdr + 8) | (sim_mem32(hdr + 12) << 32);
    val fis: Vec<i64> = sim_mem_rd(ctba, 20);
    val cmd: i64 = fis.get(2);
    val lba: i64 = fis.get(4) | (fis.get(5) << 8) | (fis.get(6) << 16) | (fis.get(8) << 24) | (fis.get(9) << 32) | (fis.get(10) << 40);
    val count: i64 = fis.get(12) | (fis.get(13) << 8);
    var ok: bool = fis.get(0) == 39 && (fis.get(1) & 128) != 0;
    var data: Vec<i64> = Vec::new();
    if cmd == 236 {
        data = sim_identify_data();
    } else if cmd == 37 {
        var i: i64 = 0;
        while i < count * 512 {
            data.push(sim_get(&sim_disk, lba * 512 + i));
            i = i + 1;
        }
    } else if cmd != 53 {
        ok = false;
    }
    var moved: i64 = 0;
    if ok {
        var k: i64 = 0;
        while k < prdtl {
            val e: i64 = ctba + 128 + 16 * k;
            val dba: i64 = sim_mem32(e) | (sim_mem32(e + 4) << 32);
            val n: i64 = (sim_mem32(e + 12) & 4194303) + 1;
            var j: i64 = 0;
            while j < n {
                if cmd == 53 {
                    sim_disk.insert(lba * 512 + moved, sim_get(&sim_mem, dba + j));
                } else if moved < data.len() {
                    sim_mem.insert(dba + j, data.get(moved));
                }
                moved = moved + 1;
                j = j + 1;
            }
            k = k + 1;
        }
        sim_put32(hdr + 4, moved);
    }
    var status: i64 = 80;
    var error: i64 = 0;
    if !ok {
        status = 65;
        error = 4;
        sim_regs.insert(base + 16, sim_rd(base + 16) | 1073741824);
    } else {
        sim_regs.insert(base + 16, sim_rd(base + 16) | 1);
    }
    sim_regs.insert(base + 32, status | (error << 8));
    // Register FIS Device to Host into the received-FIS area
    var d2h: Vec<i64> = Vec::filled(20, 0);
    d2h.set(0, 52);
    d2h.set(1, 64);
    d2h.set(2, status);
    d2h.set(3, error);
    sim_mem_wr(fb + 64, d2h);
}

fn sim_wr(off: i64, v: i64) -> i64 {
    if off >= 256 {
        val p: i64 = (off - 256) / 128;
        val r: i64 = (off - 256) % 128;
        if r == 24 {
            // CR follows ST, FR follows FRE
            var c: i64 = v & (4294967295 - 49152);
            if (v & 1) != 0 {
                c = c | 32768;
            }
            if (v & 16) != 0 {
                c = c | 16384;
            }
            sim_regs.insert(off, c);
            return 0;
        }
        if r == 16 || r == 48 {
            sim_regs.insert(off, sim_rd(off) & (4294967295 - v));
            return 0;
        }
        if r == 56 {
            var s: i64 = 0;
            while s < 32 {
                if ((v >> s) & 1) != 0 {
                    sim_exec(p, s);
                }
                s = s + 1;
            }
            sim_regs.insert(off, 0);
            return 0;
        }
    }
    if off == 4 && (v & 1) != 0 {
        sim_regs.insert(off, v & (4294967295 - 1));
        return 0;
    }
    sim_regs.insert(off, v);
    return 0;
}

fn sim_init() {
    sim_regs.insert(0, 1 | (31 << 8) | (3 << 20) | 1073741824 | 2147483648);
    sim_regs.insert(12, 3);
    sim_regs.insert(16, 66305);
    sim_regs.insert(256 + 40, 291);
    sim_regs.insert(256 + 36, 257);
    sim_regs.insert(256 + 32, 80);
}

fn main() {
    println("READ DMA EXT FIS: " + hex_encode_bytes(ahci_fis_read_dma_ext(78187493530, 8)));
    println("IDENTIFY FIS: " + hex_encode_bytes(ahci_fis_identify()));
    val h: Vec<i64> = ahci_cmd_header(20, false, true, false, false, 1, 305419904);
    println("command header: " + hex_encode_bytes(h));
    val hp: AhciCmdHeader = ahci_cmd_header_parse(&h, 0);
    println("header parsed: cfl " + int_to_str(hp.cfl) + " write " + bool_to_str(hp.write) + " prdtl " + int_to_str(hp.prdtl) + " ctba " + int_to_str(hp.ctba));
    println("PRD 4 KiB irq: " + hex_encode_bytes(ahci_prd(2097152, 4096, true)));
    println("PRD entries for 9 MiB: " + int_to_str(ahci_prdt_len(9 * 1048576)));
    var df: Vec<i64> = Vec::filled(20, 0);
    df.set(0, 52);
    df.set(1, 64);
    df.set(2, 80);
    df.set(5, 16);
    df.set(12, 1);
    val d: AhciD2h = ahci_fis_parse_d2h(&df, 0);
    println("D2H: valid " + bool_to_str(d.valid) + " irq " + bool_to_str(d.irq) + " status " + int_to_str(d.status) + " error " + int_to_str(d.error) + " lba " + int_to_str(d.lba) + " count " + int_to_str(d.count));

    sim_init();
    val bus: AhciBus = AhciBus { mmio_rd: sim_rd, mmio_wr: sim_wr, mem_rd: sim_mem_rd, mem_wr: sim_mem_wr };
    ahci_reset(&bus);
    val cap: i64 = ahci_rd(&bus, AHCI_CAP);
    println("CAP: " + int_to_str(ahci_cap_nports(cap)) + " ports, " + int_to_str(ahci_cap_nslots(cap)) + " slots, gen " + int_to_str(ahci_cap_iss(cap)) + ", 64-bit " + bool_to_str((cap & AHCI_CAP_S64A) != 0) + ", NCQ " + bool_to_str((cap & AHCI_CAP_SNCQ) != 0) + ", AHCI " + ahci_version_str(ahci_rd(&bus, AHCI_VS)));
    val found: Vec<i64> = ahci_probe(&bus);
    println("probe: port " + int_to_str(found.get(0)) + " " + ahci_sig_name(found.get(1)) + ", speed gen " + int_to_str(ahci_ssts_speed(ahci_rd(&bus, ahci_port_reg(0, AHCI_PX_SSTS)))));
    var port: AhciPort = ahci_port_setup(&bus, 0, 65536, 66560, 69632);
    var okstr: str = port.err;
    if str_len(okstr) == 0 {
        okstr = "ok";
    }
    println("port 0 setup: " + okstr + ", CLB " + int_to_str(ahci_rd(&bus, ahci_port_reg(0, AHCI_PX_CLB))) + " FB " + int_to_str(ahci_rd(&bus, ahci_port_reg(0, AHCI_PX_FB))));
    val id: AhciIdentify = ahci_identify(&bus, &mut port, 131072);
    println("IDENTIFY: model \"" + id.model + "\", serial \"" + id.serial + "\", firmware \"" + id.firmware + "\", lba48 " + bool_to_str(id.lba48) + ", " + int_to_str(id.sectors) + " sectors of " + int_to_str(id.sector_size) + ", NCQ " + bool_to_str(id.ncq) + " depth " + int_to_str(id.queue_depth));

    var pat: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 1024 {
        pat.push((i * 7) % 256);
        i = i + 1;
    }
    sim_mem_wr(196608, pat);
    ahci_write(&bus, &mut port, 5, 2, 196608, 512);
    ahci_read(&bus, &mut port, 5, 2, 262144, 512);
    val back: Vec<i64> = sim_mem_rd(262144, 1024);
    var same: bool = true;
    i = 0;
    while i < 1024 {
        if back.get(i) != pat.get(i) {
            same = false;
        }
        i = i + 1;
    }
    println("write 2 sectors at LBA 5, read back: " + str_replace(bool_to_str(same), "true", "same 1024 bytes"));
    println("slot used: " + int_to_str(sim_slot_seen) + ", prdbc " + int_to_str(sim_mem32(65536 + 32 * sim_slot_seen + 4)));
    val bad: i64 = ahci_exec(&bus, &mut port, ahci_fis_h2d(255, 0, 0, 0, 64), false, 262144, 512);
    println("unsupported command: " + vfs_errno_name(bad) + " status " + int_to_str(port.last_status) + " error " + int_to_str(port.last_error));

    val dev: BlockDev = ahci_blockdev(bus, port, &id, 327680);
    var sec: Vec<i64> = Vec::filled(512, 0);
    sec.set(0, 222);
    sec.set(511, 173);
    blk_write(&dev, 10, sec);
    val rb: Vec<i64> = blk_read(&dev, 10);
    println("block device: " + int_to_str(dev.nblocks) + " blocks, sector 10 round trip: " + bool_to_str(rb.get(0) == 222 && rb.get(511) == 173 && rb.get(1) == 0));
    println("misaligned set-up: " + ahci_port_setup(&bus, 0, 65537, 66560, 69632).err);
}
