// expect-error: p_malloc_uninit() is internal to the core library
// RT8: p_malloc_uninit hands out a block whose bytes are not zeroed; only
// stdlib/core.fd and the runtimes merged into it may call it (and core's
// p_str_alloc_uninit, a string made with it). Memory any other code gets
// reads as zero.
@unsafe
fn main() -> i64 {
    var p: i64 = p_malloc_uninit(16);
    var s: i64 = p_str_alloc_uninit(8);
    p_free(p);
    print("allocated");
    return 0;
}
