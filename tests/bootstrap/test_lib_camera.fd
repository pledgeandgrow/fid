// stdlib/camera: 2D follow, zoom limits, bounds, shake decay, screen and
// world conversion, visibility, and the 3D camera's axes and movement.
// Values are chosen so the arithmetic is exact.
use camera;

// adding 0.0 turns -0.0 into 0.0 so cross products print the same everywhere
fn pf(x: f64) {
    println(x + 0.0);
}

fn pv(v: vec3) {
    pf(v.x);
    pf(v.y);
    pf(v.z);
}

fn main() -> i64 {
    var c = camera2d_create(800, 600);
    println(c.zoom);
    println(c.has_bounds);

    // screen centre is the camera position; one pixel is one unit at zoom 1
    var w = camera2d_screen_to_world(&c, 400, 300);
    pf(w.x);
    pf(w.y);
    w = camera2d_screen_to_world(&c, 0, 0);
    pf(w.x);
    pf(w.y);
    var s = camera2d_world_to_screen(&c, 100.0, -50.0);
    pf(s.x);
    pf(s.y);

    // follow: lerp factor is speed * dt = 0.5, so each step halves the gap
    camera2d_follow(&mut c, 100.0, 40.0);
    camera2d_update(&mut c, 0.1);
    pf(c.x);
    pf(c.y);
    camera2d_update(&mut c, 0.1);
    pf(c.x);
    pf(c.y);
    // a long step clamps the factor to 1 and lands on the target
    camera2d_update(&mut c, 10.0);
    pf(c.x);
    pf(c.y);

    // zoom 2: half the world per screen
    camera2d_set_zoom(&mut c, 2.0);
    w = camera2d_screen_to_world(&c, 0, 0);
    pf(w.x);
    pf(w.y);
    s = camera2d_world_to_screen(&c, 100.0, 40.0);
    pf(s.x);
    pf(s.y);
    var o = camera2d_view_offset(&c);
    pf(o.x);
    pf(o.y);

    // zoom never goes below 0.1
    camera2d_set_zoom(&mut c, 0.01);
    pf(c.zoom);

    // zoom_at keeps the world point fixed: a camera at (100,40) zooming x2
    // on (0,0) moves to (50,20); a factor of 0 still stops at zoom 0.1
    var z = camera2d_create(800, 600);
    z.x = 100.0;
    z.y = 40.0;
    camera2d_zoom_at(&mut z, 0.0, 0.0, 2.0);
    pf(z.zoom);
    pf(z.x);
    pf(z.y);

    // visibility: zoom 2 shows 400 x 300 world units around (50, 20),
    // that is x from -150 to 250 and y from -130 to 170
    println(camera2d_is_visible(&z, 50.0, 20.0, 10.0, 10.0));
    println(camera2d_is_visible(&z, 1000.0, 20.0, 10.0, 10.0));
    println(camera2d_is_visible(&z, -160.0, 20.0, 10.0, 10.0));
    println(camera2d_is_visible(&z, -151.0, 20.0, 10.0, 10.0));
    println(camera2d_is_visible(&z, 50.0, 171.0, 10.0, 10.0));
    println(camera2d_is_visible(&z, 50.0, 169.0, 10.0, 10.0));
    var zz = camera2d_create(800, 600);
    zz.x = 100.0;
    camera2d_zoom_at(&mut zz, 0.0, 0.0, 0.0);
    pf(zz.zoom);
    pf(zz.x);

    // bounds: a 1000 x 1000 world, 800 x 600 view at zoom 1
    var b = camera2d_create(800, 600);
    camera2d_set_bounds(&mut b, 0.0, 0.0, 1000.0, 1000.0);
    println(b.has_bounds);
    camera2d_update(&mut b, 0.1);
    pf(b.x);
    pf(b.y);
    camera2d_follow(&mut b, 5000.0, 5000.0);
    camera2d_update(&mut b, 10.0);
    pf(b.x);
    pf(b.y);

    // shake adds up and decays by 5 per second; at zero the offset is zero
    var k = camera2d_create(800, 600);
    camera2d_shake(&mut k, 1.0);
    camera2d_shake(&mut k, 1.0);
    pf(k.shake_amount);
    camera2d_update(&mut k, 0.25);
    pf(k.shake_amount);
    camera2d_update(&mut k, 0.5);
    pf(k.shake_amount);
    println(k.shake_x == 0.0);
    println(k.shake_y == 0.0);
    w = camera2d_screen_to_world(&k, 400, 300);
    pf(w.x);

    // 3D: camera on +z looking at the origin
    var c3 = camera3d_create(vec3(0.0, 0.0, 10.0), vec3(0.0, 0.0, 0.0), 90.0, 2.0, 0.5, 100.0);
    println(c3.dirty);
    pf(c3.aspect);
    pf(c3.near);
    pf(c3.far);
    camera3d_update(&mut c3);
    println(c3.dirty);
    pv(camera3d_forward(&c3));
    pv(camera3d_right(&c3));
    var vm = camera3d_view_matrix(&c3);
    pf(vm.m22);
    pf(vm.m23);
    pf(vm.m03);
    var pm = camera3d_projection(&c3);
    pf(pm.m32);
    camera3d_move_forward(&mut c3, 3.0);
    pv(c3.position);
    pv(c3.target);
    camera3d_move_right(&mut c3, 2.0);
    pv(c3.position);
    pv(c3.target);
    println(c3.dirty);
    camera3d_update(&mut c3);
    camera3d_set_aspect(&mut c3, 1.5);
    pf(c3.aspect);
    println(c3.dirty);
    // the ray through the screen centre is the forward direction
    var ray = camera3d_screen_to_ray(&c3, 0.0, 0.0);
    pv(ray.origin);
    pv(ray.direction);
    // orbit clamps the pitch just short of straight up
    camera3d_orbit(&mut c3, 0.0, 5.0);
    pf(c3.pitch);
    camera3d_orbit(&mut c3, 0.0, -10.0);
    pf(c3.pitch);
    pf(c3.yaw);
    return 0;
}
