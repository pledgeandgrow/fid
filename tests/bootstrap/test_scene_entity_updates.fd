// stdlib/scene's entity updates change the entity (release-roadmap N5: the
// lint's unused-parameter warnings on scene_update_entity, scene_set_velocity,
// scene_damage and scene_set_tag showed they did nothing; scene_despawn did
// not mark the entity inactive either).
//
// Expected output:
// moved 13 4
// velocity 3 -2
// damage 70 false
// tagged 1
// died true 0 1
// dead takes no damage false
// despawned 0
// scene updates ok
use scene;

fn check(label: str, ok: bool) {
    if !ok {
        p_panic("scene: wrong " + label);
    }
}

fn main() -> i64 {
    var sm = scene_manager_create();
    val tpl = scene_register_template(& mut sm, "orc", 100, 16, 16);
    val a = scene_spawn(& mut sm, tpl, 10.0, 5.0);
    val b = scene_spawn(& mut sm, tpl, 0.0, 0.0);

    scene_set_velocity(& mut sm, a, 3.0, - 1.0);
    scene_update_entity(& mut sm, a, 1.0);
    var e = scene_get_entity(sm, a);
    check("move", e.x == 13.0 && e.y == 4.0);
    println("moved " + int_to_str(e.x as i64) + " " + int_to_str(e.y as i64));

    scene_set_velocity(& mut sm, a, 3.0, - 2.0);
    e = scene_get_entity(sm, a);
    println("velocity " + int_to_str(e.vx as i64) + " " + int_to_str(e.vy as i64));

    val died1 = scene_damage(& mut sm, a, 30);
    e = scene_get_entity(sm, a);
    check("damage", e.health == 70 && !died1);
    println("damage " + int_to_str(e.health) + " " + bool_str(died1));

    scene_set_tag(& mut sm, b, 7);
    check("tag", scene_count_by_tag(sm, 7) == 1);
    println("tagged " + int_to_str(scene_count_by_tag(sm, 7)));

    val died2 = scene_damage(& mut sm, a, 500);
    e = scene_get_entity(sm, a);
    check("death", died2 && e.health == 0 && !e.active);
    println("died " + bool_str(died2) + " " + int_to_str(e.health) + " " + int_to_str(scene_entity_count(sm)));

    val died3 = scene_damage(& mut sm, a, 10);
    check("dead", !died3);
    println("dead takes no damage " + bool_str(died3));

    check("despawn", scene_despawn(& mut sm, b));
    println("despawned " + int_to_str(scene_entity_count(sm)));
    println("scene updates ok");
    return 0;
}

fn bool_str(b: bool) -> str {
    if b {
        return "true";
    }
    return "false";
}
