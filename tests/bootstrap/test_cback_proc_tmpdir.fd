// SL17 (known-bugs 2g.44): a captured process writes its stdout and stderr
// capture files in the temp directory, not the current one. The child
// lists the current directory; no `.fides_proc_` file is in it.
//
// Expected output:
// started = true
// capture file in cwd = false
// stdout = hello

use process;
use os;
use string;

fn main() {
    var cmd: str = "ls -a";
    var osn: str = os_name();
    if str_contains(osn, "Windows") {
        cmd = "dir /b /a";
    }
    var h: i64 = process_run(cmd);
    println("started = " + bool_to_str(process_ok(h)));
    var out: str = process_stdout(h);
    println("capture file in cwd = " + bool_to_str(str_contains(out, ".fides_proc_")));
    process_close(h);
    var h2: i64 = process_run("echo hello");
    println("stdout = " + str_trim(process_stdout(h2)));
    process_close(h2);
}
