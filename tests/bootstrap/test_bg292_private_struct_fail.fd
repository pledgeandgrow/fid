// expect-error: Visibility error: struct 'Priv' is private to module
// Bugs roadmap BG292: a struct without `pub` cannot be used from another
// module (reference §2.9); before, `Priv { a: 3 }` compiled and ran.
use vis_lib::vmod;

fn main() -> i64 {
    val r = Priv { a: 3 };
    println(r.a);
    return 0;
}
