// BG283 (docs/roadmap/bugs-roadmap.md): SAE J1939-21 PDU1 is PF 0..239
// (destination-specific: PS is the destination address, not part of the
// PGN) and PDU2 is PF 240..255 (broadcast: PS is the group extension, part
// of the PGN); j1939_is_pdu1/2 and j1939_pgn follow it.
//
// Expected output:
// EEC1 0x0CF00400: pgn 61444 pdu1=false pdu2=true sa 0
// Request 0x18EA17F9: pgn 59904 pdu1=true pdu2=false dest 23 sa 249
// TP.CM 0x1CECFF00: pgn 60416 pdu1=true
// PF 239 0x18EFAB01: pgn 61184 pdu1=true
// PF 240 0x18F0AB01: pgn 61611 pdu2=true
// DP 1 PF 0xFE 0x19FECA00: pgn 130762
// DP 1 PF 0x10 0x19102000: pgn 69632
use can;

fn b(x: bool) -> str {
    if x {
        return "true";
    }
    return "false";
}

fn main() {
    val eec1: i64 = 0x0CF00400;
    println("EEC1 0x0CF00400: pgn " + int_to_str(j1939_pgn(eec1)) + " pdu1=" + b(j1939_is_pdu1(eec1)) + " pdu2=" + b(j1939_is_pdu2(eec1)) + " sa " + int_to_str(j1939_source_addr(eec1)));
    val rq: i64 = 0x18EA17F9;
    println("Request 0x18EA17F9: pgn " + int_to_str(j1939_pgn(rq)) + " pdu1=" + b(j1939_is_pdu1(rq)) + " pdu2=" + b(j1939_is_pdu2(rq)) + " dest " + int_to_str(j1939_pdu_specific(rq)) + " sa " + int_to_str(j1939_source_addr(rq)));
    println("TP.CM 0x1CECFF00: pgn " + int_to_str(j1939_pgn(0x1CECFF00)) + " pdu1=" + b(j1939_is_pdu1(0x1CECFF00)));
    println("PF 239 0x18EFAB01: pgn " + int_to_str(j1939_pgn(0x18EFAB01)) + " pdu1=" + b(j1939_is_pdu1(0x18EFAB01)));
    println("PF 240 0x18F0AB01: pgn " + int_to_str(j1939_pgn(0x18F0AB01)) + " pdu2=" + b(j1939_is_pdu2(0x18F0AB01)));
    println("DP 1 PF 0xFE 0x19FECA00: pgn " + int_to_str(j1939_pgn(0x19FECA00)));
    println("DP 1 PF 0x10 0x19102000: pgn " + int_to_str(j1939_pgn(0x19102000)));
}
