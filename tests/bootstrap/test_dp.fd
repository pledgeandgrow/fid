// test_dp.fd — ML12: Differential Privacy Enforcement
// Expected: PASS
// Tests @dp annotation with Noise effect enforcement.

use tensor;
use dp;

fn vec2(a: i64, b: i64) -> Vec<i64> {
    val v = Vec::new();
    v.push(a);
    v.push(b);
    return v;
}

@dp(epsilon=1.0)
@differentiable
fn private_train_step(x: Tensor, grad: Tensor) -> Tensor {
    // Add noise to gradients for differential privacy
    val noisy_grad = dp_noise(grad, 0.1);
    val result = add(x, noisy_grad);
    return result;
}

// The noise is random (different on every run), so main checks its
// properties instead of printing the values: every element moved away from
// 2.0 (1 + 1 before noise) by less than 10 sigma, and not all by zero.
fn main() {
    val x = ones(vec2(2, 2));
    val grad = ones(vec2(2, 2));
    val result = private_train_step(x, grad);
    var in_bounds = true;
    var changed = 0;
    var i = 0;
    while i < 2 {
        var j = 0;
        while j < 2 {
            val v = get(result, vec2(i, j));
            if v < 1.0 || v > 3.0 { in_bounds = false; }
            if v != 2.0 { changed = changed + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    print("noise within 10 sigma: ");
    print(in_bounds);
    print("\n");
    print("noise added: ");
    print(changed > 0);
    print("\n");
    return 0;
}
