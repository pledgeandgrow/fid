// test_dp.fd — ML12: Differential Privacy Enforcement
// Expected: PASS
// Tests @dp annotation with Noise effect enforcement.

use tensor;
use dp;

fn vec2(a: i64, b: i64) -> Vec<i64> {
    val v = Vec::new();
    v.push(a);
    v.push(b);
    return v;
}

@dp(epsilon=1.0)
@differentiable
fn private_train_step(x: Tensor, grad: Tensor) -> Tensor {
    // Add noise to gradients for differential privacy
    val noisy_grad = dp_noise(grad, 0.1);
    val result = add(x, noisy_grad);
    return result;
}

fn main() {
    val x = ones(vec2(2, 2));
    val grad = ones(vec2(2, 2));
    val result = private_train_step(x, grad);
    print(to_str(result));
    print("\n");
    return 0;
}
