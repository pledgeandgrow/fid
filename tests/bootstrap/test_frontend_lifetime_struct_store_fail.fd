// expect-error: which stores a reference
// LG3: a struct holding a reference is held like one: it cannot be stored
// in a Vec (the Vec could outlive what it points to).
struct View<'a> {
    r: &'a i64,
    k: i64,
}

fn main() -> i64 {
    var a: i64 = 5;
    var vs: Vec<View> = Vec::new();
    vs.push(View { r: &a, k: 0 });
    println(vs.len());
    return 0;
}
