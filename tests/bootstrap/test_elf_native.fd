// `fid emit --elf` (release F4, first step): a static Linux x86-64
// executable from fid's own code generator (pe_ir), no C compiler, no
// linker, no libc. The runtime is the bare build's, with Linux system calls
// for output, the heap and exit; the stdlib is not available there yet.
//   fid emit tests/bootstrap/test_elf_native.fd --elf -o elf_native
//   ./elf_native; echo $?        (Linux x86-64; prints the lines below, 0)
// Hosted backends print the same.
//
// Expected output:
// hello from a native ELF
// 832040
// -9223372036854775807
// false
// 55
// sum of squares 1..10: 385

var g_total: i64 = 0;

struct Acc {
    n: i64,
    sum: i64,
}

fn fib(n: i64) -> i64 {
    if n < 2 { return n; }
    return fib(n - 1) + fib(n - 2);
}

fn add_to(a: &mut Acc, v: i64) {
    a.n = a.n + 1;
    a.sum = a.sum + v;
}

fn main() -> i64 {
    print("hello from a native ELF\n");
    print(fib(30)); print("\n");
    print(0 - 9223372036854775807); print("\n");
    print(fib(3) > 5); print("\n");
    var i: i64 = 1;
    while i <= 10 {
        g_total = g_total + i;
        i = i + 1;
    }
    print(g_total); print("\n");
    var acc = Acc { n: 0, sum: 0 };
    i = 1;
    while i <= 10 {
        add_to(&mut acc, i * i);
        i = i + 1;
    }
    print("sum of squares 1..");
    print(acc.n);
    print(": ");
    print(acc.sum); print("\n");
    return 0;
}
