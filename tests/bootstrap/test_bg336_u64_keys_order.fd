// BG336 (docs/roadmap/bugs-roadmap.md): keys() of a HashMap<u64, V> is in
// unsigned order (semantics-2 §20.2): keys at or above 2^63 came first.
//
// Expected output:
// 1,9223372036854775808,18446744073709551615,
// 2,3,1,

fn idu64(x: u64) -> u64 {
    return x;
}

fn main() {
    var mu: HashMap<u64, i64> = HashMap::new();
    mu.insert(idu64(18446744073709551615), 1);
    mu.insert(idu64(1), 2);
    mu.insert(idu64(9223372036854775808), 3);
    var ku = "";
    for k in mu.keys() {
        ku = ku + f"{k},";
    }
    println(ku);
    var vu = "";
    for v in mu.values() {
        vu = vu + f"{v},";
    }
    println(vu);
}
