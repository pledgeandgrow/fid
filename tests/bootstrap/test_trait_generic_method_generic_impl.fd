// LG4: a generic method in a generic impl (`impl<T> Pair for Slot<T>` with
// `fn with<U>`, `impl<T> Slot<T>` with `fn get_or<U>`): T comes from the
// receiver's type, U from the call's arguments (typechecker.fd
// TypeChecker_lg4_method_call on the generic receiver; mono.fd
// mono_lg4_tps: the instantiation binds T then U, `Slot__get_or__str_bool`).
// Expected output:
// x
// 42
// 7
// s
// 6
// 8

cap Pair {
    fn with<U>(self, x: U) -> U;
    fn tag(self) -> i64;
}

struct Slot<T> { v: T, tag: i64 }

impl<T> Slot<T> {
    fn get_or<U>(self, other: U) -> T { return self.v; }
}

impl<T> Pair for Slot<T> {
    fn with<U>(self, x: U) -> U { return x; }
    fn tag(self) -> i64 { return self.tag; }
}

fn main() -> i64 {
    val a: Slot<i64> = Slot { v: 5, tag: 7 };
    val b: Slot<str> = Slot { v: "s", tag: 8 };
    println(a.with("x"));
    println(b.with(42));
    println(a.tag());
    println(b.get_or(true));
    println(a.get_or("q") + 1);
    println(b.tag());
    return 0;
}
