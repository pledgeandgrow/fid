// Bugs roadmap BG351: stdlib/html.fd h_unescape UTF-8 encoded a numeric
// character reference as given: `&#0;` gave a NUL byte, `&#xD800;` the
// bytes ED A0 80 and `&#x110000;` F4 90 80 80 (neither valid UTF-8). The
// HTML standard maps 0, surrogates and values past U+10FFFF to U+FFFD (EF
// BF BD); a very long reference no longer overflows.
//
// Expected output:
// 3 239 191 189
// 9 true
// 3 true
// 4 A€
// 3 true

use html;

fn main() {
    val z: str = h_unescape("&#0;");
    println(f"{str_len(z)} {str_byte_at(z, 0)} {str_byte_at(z, 1)} {str_byte_at(z, 2)}");
    val three: str = h_unescape("&#0;&#x110000;&#xD800;");
    println(f"{str_len(three)} {three == "\u{FFFD}\u{FFFD}\u{FFFD}"}");
    val big: str = h_unescape("&#xFFFFFFFFFFFFFFFFFFFFFF;");
    println(f"{str_len(big)} {big == "\u{FFFD}"}");
    val ok: str = h_unescape("&#65;&#x20AC;");
    println(f"{str_len(ok)} {ok}");
    val dec: str = h_unescape("&#99999999999999999999999;");
    println(f"{str_len(dec)} {dec == "\u{FFFD}"}");
}
