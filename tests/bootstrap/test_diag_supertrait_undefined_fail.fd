// expect-error: trait 'Printable' is not defined (supertrait of 'Labelled')
// Expected to FAIL (CE4): a cap (trait) names a supertrait that no cap
// declares.
cap Labelled: Printable {
    fn label(self) -> str;
}

struct Tag {
    name: str,
}

impl Labelled for Tag {
    fn label(self) -> str {
        return self.name;
    }
}

fn main() -> i64 {
    val t: Tag = Tag { name: "a" };
    println(t.label());
    return 0;
}
