// BG67 (docs/roadmap/bugs-roadmap.md): a u64 at or above 2^63 converted to
// f64 is its unsigned value. The interpreter converted the word as signed
// (u64::MAX became -1.0). Every backend prints the same.
//
// Expected output:
// 16777216
// 8388608
// 16777216
// -1
// 1000
fn main() -> i64 {
    val two40: f64 = 1099511627776.0;
    // u64::MAX: 2^64 once rounded
    val big: u64 = (0 - 1) as u64;
    println(int_to_str(((big as f64) / two40) as i64));
    // 2^63
    val top: u64 = (0 - 9223372036854775807 - 1) as u64;
    println(int_to_str(((top as f64) / two40) as i64));
    // 2^64 - 1023: rounds to the nearest, 2^64 (not 2^64 - 2048)
    val odd: u64 = (0 - 1023) as u64;
    println(int_to_str(((odd as f64) / two40) as i64));
    // signed words stay signed
    val neg: i64 = 0 - 1;
    println(int_to_str((neg as f64) as i64));
    val small: u64 = 1000;
    println(int_to_str((small as f64) as i64));
    return 0;
}
