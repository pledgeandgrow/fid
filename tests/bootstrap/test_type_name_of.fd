// Roadmap L8F: minimal run-time type information. `type_name_of(x)` is the
// name of x's type as a str, fixed when the program is compiled (after
// monomorphization: inside a generic function it names the instance's
// type), so every backend has it. The argument is not evaluated.
//
// Expected output:
//     i64
//     f64
//     str
//     bool
//     Vec<i64>
//     Point
//     Shape
//     f64
//     i64!
//     generic: i64
//     generic: str
//     generic: Point
//     bump: i64
//     not evaluated: 0
//     bad value of type str: oops

struct Point {
    x: i64,
    y: i64,
}

enum Shape {
    Circle(f64),
    Square(f64),
}

fn describe<T>(v: T) -> str {
    return "generic: " + type_name_of(v);
}

var g_calls: i64 = 0;

fn bump() -> i64 {
    g_calls = g_calls + 1;
    return g_calls;
}

fn check(v: str) -> str {
    if v == "ok" {
        return "fine";
    }
    return "bad value of type " + type_name_of(v) + ": " + v;
}

fn main() {
    val n: i64 = 42;
    val f: f64 = 2.5;
    val s: str = "hi";
    val b: bool = true;
    var v: Vec<i64> = Vec::new();
    v.push(1);
    val p: Point = Point { x: 1, y: 2 };
    val sh: Shape = Shape::Circle(1.0);
    println(type_name_of(n));
    println(type_name_of(f));
    println(type_name_of(s));
    println(type_name_of(b));
    println(type_name_of(v));
    println(type_name_of(p));
    println(type_name_of(sh));
    println(type_name_of(f * 2.0));
    println(type_name_of(n) + "!");
    println(describe(n));
    println(describe(s));
    println(describe(p));
    val t: str = type_name_of(bump());
    println("bump: " + t);
    println("not evaluated: " + int_to_str(g_calls));
    println(check("oops"));
}
