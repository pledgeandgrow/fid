// BM3 (competitive roadmap): n-body, the energy after 1000 steps (-0.169087605).
// bench/game/fides/nbody.fd on a small input (nbody(1000)), so the suite checks
// the benchmark's code on every backend; the expected value is the one
// the reference algorithm gives (computed in double precision, the same
// operations in the same order).
//
// Expected output:
// -169087605
use math;

fn energy(x: Vec<f64>, y: Vec<f64>, z: Vec<f64>, vx: Vec<f64>, vy: Vec<f64>, vz: Vec<f64>, m: Vec<f64>) -> f64 {
    var e: f64 = 0.0;
    var i: i64 = 0;
    while i < 5 {
        e = e + 0.5 * m.get(i) * (vx.get(i) * vx.get(i) + vy.get(i) * vy.get(i) + vz.get(i) * vz.get(i));
        var j: i64 = i + 1;
        while j < 5 {
            val dx: f64 = x.get(i) - x.get(j);
            val dy: f64 = y.get(i) - y.get(j);
            val dz: f64 = z.get(i) - z.get(j);
            val d: f64 = math_sqrt(dx * dx + dy * dy + dz * dz);
            e = e - (m.get(i) * m.get(j)) / d;
            j = j + 1;
        }
        i = i + 1;
    }
    return e;
}

fn nbody(steps: i64) -> i64 {
    val pi: f64 = 3.141592653589793;
    val sm: f64 = 4.0 * pi * pi;
    val dpy: f64 = 365.24;
    // the sun, Jupiter, Saturn, Uranus, Neptune
    var x: Vec<f64> = Vec::new();
    var y: Vec<f64> = Vec::new();
    var z: Vec<f64> = Vec::new();
    var vx: Vec<f64> = Vec::new();
    var vy: Vec<f64> = Vec::new();
    var vz: Vec<f64> = Vec::new();
    var m: Vec<f64> = Vec::new();
    x.push(0.0);
    y.push(0.0);
    z.push(0.0);
    vx.push(0.0);
    vy.push(0.0);
    vz.push(0.0);
    m.push(sm);
    x.push(4.84143144246472090e+00);
    y.push(-1.16032004402742839e+00);
    z.push(-1.03622044471123109e-01);
    vx.push(1.66007664274403694e-03 * dpy);
    vy.push(7.69901118419740425e-03 * dpy);
    vz.push(-6.90460016972063023e-05 * dpy);
    m.push(9.54791938424326609e-04 * sm);
    x.push(8.34336671824457987e+00);
    y.push(4.12479856412430479e+00);
    z.push(-4.03523417114321381e-01);
    vx.push(-2.76742510726862411e-03 * dpy);
    vy.push(4.99852801234917238e-03 * dpy);
    vz.push(2.30417297573763929e-05 * dpy);
    m.push(2.85885980666130812e-04 * sm);
    x.push(1.28943695621391310e+01);
    y.push(-1.51111514016986312e+01);
    z.push(-2.23307578892655734e-01);
    vx.push(2.96460137564761618e-03 * dpy);
    vy.push(2.37847173959480950e-03 * dpy);
    vz.push(-2.96589568540237556e-05 * dpy);
    m.push(4.36624404335156298e-05 * sm);
    x.push(1.53796971148509165e+01);
    y.push(-2.59193146099879641e+01);
    z.push(1.79258772950371181e-01);
    vx.push(2.68067772490389322e-03 * dpy);
    vy.push(1.62824170038242295e-03 * dpy);
    vz.push(-9.51592254519715870e-05 * dpy);
    m.push(5.15138902046611451e-05 * sm);

    // the sun takes the momentum that makes the total zero
    var px: f64 = 0.0;
    var py: f64 = 0.0;
    var pz: f64 = 0.0;
    var i: i64 = 0;
    while i < 5 {
        px = px + vx.get(i) * m.get(i);
        py = py + vy.get(i) * m.get(i);
        pz = pz + vz.get(i) * m.get(i);
        i = i + 1;
    }
    vx.set(0, (0.0 - px) / sm);
    vy.set(0, (0.0 - py) / sm);
    vz.set(0, (0.0 - pz) / sm);

    val dt: f64 = 0.01;
    var s: i64 = 0;
    while s < steps {
        var a: i64 = 0;
        while a < 5 {
            var b: i64 = a + 1;
            while b < 5 {
                val dx: f64 = x.get(a) - x.get(b);
                val dy: f64 = y.get(a) - y.get(b);
                val dz: f64 = z.get(a) - z.get(b);
                val d2: f64 = dx * dx + dy * dy + dz * dz;
                val mag: f64 = dt / (d2 * math_sqrt(d2));
                val mb: f64 = m.get(b) * mag;
                val ma: f64 = m.get(a) * mag;
                vx.set(a, vx.get(a) - dx * mb);
                vy.set(a, vy.get(a) - dy * mb);
                vz.set(a, vz.get(a) - dz * mb);
                vx.set(b, vx.get(b) + dx * ma);
                vy.set(b, vy.get(b) + dy * ma);
                vz.set(b, vz.get(b) + dz * ma);
                b = b + 1;
            }
            a = a + 1;
        }
        a = 0;
        while a < 5 {
            x.set(a, x.get(a) + dt * vx.get(a));
            y.set(a, y.get(a) + dt * vy.get(a));
            z.set(a, z.get(a) + dt * vz.get(a));
            a = a + 1;
        }
        s = s + 1;
    }
    val e: f64 = energy(x, y, z, vx, vy, vz, m);
    return (e * 1000000000.0) as i64;
}

fn main() -> i64 {
    println(nbody(1000));
    return 0;
}
