// A float-returning method inside a larger expression, and a float through a
// function value.
struct V { x: f64 }

impl V {
    fn dot(self: V, o: V) -> f64 {
        return self.x * o.x;
    }
}

fn twice(f: fn(f64) -> f64, x: f64) -> f64 {
    return f(f(x));
}

fn half(x: f64) -> f64 {
    return x / 2.0;
}

fn main() -> i64 {
    val e: V = V { x: 3.0 };
    println(-1.0 * e.dot(e));
    println(e.dot(e) - 2.0);
    println(-e.dot(e));
    println(2 * e.dot(e));
    println(e.dot(e) > 8.5);
    println(twice(half, 10.0));
    return 0;
}
