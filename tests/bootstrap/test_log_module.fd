// log (CO4): JSON output parses back against the spec, and a module can
// carry its own level. Timestamps stay off, so output is deterministic.
use log;
use json;

fn main() -> i64 {
    // JSON spec check: render, parse back, verify the keys.
    var f: Vec<str> = Vec::new();
    f.push("port");
    f.push("8080");
    var line: str = log_render_json(LOG_INFO, "hello", f);
    println(json_get(line, "level"));
    println(json_get(line, "msg"));
    println(json_get(line, "port"));

    // Per-module level: "noisy" is silenced below ERROR, others are not.
    log_set_module_level("noisy", LOG_ERROR);
    println(log_module_level("noisy"));
    println(log_module_level("other"));
    logm(LOG_INFO, "noisy", "hidden");
    logmf(LOG_ERROR, "noisy", "shown", f);
    println("log module OK");
    return 0;
}
