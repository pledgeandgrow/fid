// BG306 (docs/roadmap/bugs-roadmap.md): str_parse_int_opt gives None for a
// number outside i64 (it gave Some(0), str_parse_int's failure value), and
// still gives both ends of the range, i64::MIN and i64::MAX.
//
// Expected output:
// None
// None
// None
// None
// -9223372036854775808
// 9223372036854775807
// 9223372036854775807
// 0
// -12
// None
// None
// None
// 7
use string;

fn show(o: Option<i64>) {
    match o {
        Option::Some(v) => { println(f"{v}"); }
        Option::None => { println("None"); }
    }
}

fn main() -> i64 {
    // the entry's triggers
    show(str_parse_int_opt("9223372036854775808"));
    show(str_parse_int_opt("99999999999999999999"));
    // one past each end, with a sign
    show(str_parse_int_opt("-9223372036854775809"));
    show(str_parse_int_opt("+9223372036854775808"));
    // the ends themselves
    show(str_parse_int_opt("-9223372036854775808"));
    show(str_parse_int_opt("9223372036854775807"));
    show(str_parse_int_opt("+9223372036854775807"));
    // ordinary values and malformed ones
    show(str_parse_int_opt("0"));
    show(str_parse_int_opt("-12"));
    show(str_parse_int_opt("-"));
    show(str_parse_int_opt("1x"));
    show(str_parse_int_opt(""));
    show(str_parse_int_opt("007"));
    return 0;
}
