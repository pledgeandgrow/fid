// expect-error: `Len + f64`: a unit adds only to a value of its own unit (Len).
// Expected to FAIL (CE4): metres plus a bare number has no unit (CL10).
@dimension(m = 1)
struct Len {
    value: f64,
}

fn main() -> i64 {
    val d: Len = Len { value: 3.0 };
    val x: Len = d + 2.0;
    println(int_to_str(x.value as i64));
    return 0;
}
