// expect-error: cannot mutate v: shared borrow(s) are active on it or its fields
// BG141: the same for a `match` initializer whose arms give references.
fn main() {
    var v: Vec<i64> = Vec::new();
    v.push(111);
    val k: i64 = 1;
    val r: &i64 = match k {
        1 => &v[0],
        _ => &v[0],
    };
    var i: i64 = 0;
    while i < 100000 {
        v.push(i);
        i = i + 1;
    }
    println(int_to_str(*r));
}
