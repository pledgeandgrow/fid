// L8G: Trait upcasting — dyn trait dispatch of inherited supertrait methods
cap Greet {
    fn greet(self) -> str;
}

cap NamedGreet: Greet {
    fn name(self) -> str;
}

struct Person {
    name: str,
}

impl NamedGreet for Person {
    pub fn greet(self: Person) -> str {
        return "Hello from " + self.name;
    }
    pub fn name(self: Person) -> str {
        return self.name;
    }
}

fn describe(a: dyn NamedGreet) -> str {
    val n = a.name();
    val g = a.greet();
    print(n);
    print(g);
    return g;
}

fn main() {
    val p = Person { name: "Bob" };
    val dp = p as dyn NamedGreet;
    val result = describe(dp);
    print(result);
}
