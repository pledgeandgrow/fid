// expect-error: returns str; the trait's method returns i64
// LG4: a trait type naming an associated type is compared with the impl's,
// the associated type being the impl's binding (`type Item = i64`).
cap Container {
    type Item;
    fn first(self) -> Item;
}

struct IntBox { value: i64 }

impl Container for IntBox {
    type Item = i64;
    fn first(self) -> str { return "x"; }
}

fn main() -> i64 {
    return 0;
}
