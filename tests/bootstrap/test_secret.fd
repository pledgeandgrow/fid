// @secret information flow: what the check accepts.
@secret
fn load_key() -> i64 { return 42; }

fn mix(a: i64, b: i64) -> i64 { return a * 31 + b; }

// A @secret parameter may receive secrets; using them without output is fine.
fn digest(@secret k: i64) -> i64 {
    val t: i64 = mix(k, 7);
    return 0;
}

// An audited release: callers treat the result as public.
@declassify
fn matches(@secret k: i64, guess: i64) -> bool { return k == guess; }

fn show(x: i64) { println(x); }

fn main() {
    val k = load_key();
    val h = mix(k, 7);
    assert_msg(digest(h) == 0, "secret passed to a @secret parameter");
    assert_msg(!matches(42, 41), "declassified comparison");
    show(5);
    print("secret OK
");
}
