// expect-error: 'v' would outlive 'b'
// LG3: a struct holding a reference must not outlive what it points to:
// `b` is freed at the end of its block while `v` is still in scope.
struct View<'a> {
    r: &'a i64,
    k: i64,
}

fn main() -> i64 {
    var a: i64 = 5;
    var v = View { r: &a, k: 0 };
    {
        var b: i64 = 3;
        v = View { r: &b, k: 1 };
    }
    println(*v.r);
    return 0;
}
