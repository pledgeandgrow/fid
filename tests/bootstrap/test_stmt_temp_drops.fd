fn main() {
    // Vec temporaries: a fresh header used once by a read that keeps nothing
    println(Vec::new().len());       // 0
    println(Vec::new().is_empty());  // true

    // A temp consumed by push then dropped (was: leaked header)
    Vec::new().push(9);

    // HashMap temporary used once
    var m = HashMap::new();
    m.insert("k", 4);
    println(m.get("k"));             // 4

    // Slot-path Vec unchanged: stored, reassigned, read
    var v = Vec::new();
    v.push(10);
    v.push(20);
    v.push(30);
    println(v.len());                // 3
    v.clear();
    println(v.is_empty());           // true

    // Str temporaries (widened producers): dup + to_str + concat
    var s = "ab";
    println(str_len(s + "cd"));      // 4

    println("temps ok");
}
