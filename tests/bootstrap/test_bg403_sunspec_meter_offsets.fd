// BG403 (docs/roadmap/bugs-roadmap.md): sunspec_meter reads the wye meter
// model 203 at the SunSpec data offsets (model_203.json, offsets after ID
// and L): A 0, A_SF 4, PhV 5, V_SF 13, Hz 14, Hz_SF 15, W 16, W_SF 20,
// TotWhExp 36-37, TotWhImp 44-45, TotWh_SF 52. Every neighbouring point
// (per-phase values, per-phase energy totals) holds a different value, so a
// wrong offset shows.
//
// Expected output:
// direct: ok A 10 V 230 Hz 50 W 1000 exp 5000 imp 7000
// models: 203@4
// scan: ok A 10.5 V 230 Hz 50 W -1500 exp 10000 imp 700
use sunspec;
use modbus;

fn setr(m: &mut ModbusMap, off: i64, v: i64) {
    m.holding.set(off, v & 65535);
}

fn show(name: str, mt: SunSpecMeter) {
    var okw: str = "";
    if mt.ok {
        okw = "ok ";
    }
    println(name + ": " + okw + "A " + float_to_str(mt.ac_current) + " V " + float_to_str(mt.voltage_ln) + " Hz " + float_to_str(mt.frequency) + " W " + float_to_str(mt.real_power) + " exp " + float_to_str(mt.exported_wh) + " imp " + float_to_str(mt.imported_wh));
}

fn main() {
    // the entry's trigger: a 203 data block, all scale factors 0
    var r: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 105 {
        r.push(0);
        i = i + 1;
    }
    r.set(0, 10);      // A
    r.set(1, 3);       // AphA
    r.set(2, 4);       // AphB
    r.set(3, 3);       // AphC
    r.set(5, 230);     // PhV
    r.set(6, 231);     // PhVphA
    r.set(7, 229);     // PhVphB
    r.set(8, 232);     // PhVphC
    r.set(14, 50);     // Hz
    r.set(16, 1000);   // W
    r.set(17, 300);    // WphA
    r.set(18, 330);    // WphB
    r.set(19, 370);    // WphC
    r.set(37, 5000);   // TotWhExp (low register)
    r.set(39, 1500);   // TotWhExpPhA
    r.set(41, 1600);   // TotWhExpPhB
    r.set(43, 1900);   // TotWhExpPhC
    r.set(45, 7000);   // TotWhImp
    r.set(47, 2000);   // TotWhImpPhA
    r.set(49, 2500);   // TotWhImpPhB
    r.set(51, 2500);   // TotWhImpPhC
    show("direct", sunspec_meter(&r, 0));

    // the same over a ModbusMap: SunS marker, model 203 (L = 105), end
    var m: ModbusMap = modbus_map_new(0, 0, 120, 0);
    m.holding.set(0, SUNSPEC_MARKER_HI);
    m.holding.set(1, SUNSPEC_MARKER_LO);
    m.holding.set(2, 203);
    m.holding.set(3, 105);
    val d: i64 = 4;
    setr(&mut m, d + 0, 105);      // A
    setr(&mut m, d + 1, 35);
    setr(&mut m, d + 2, 36);
    setr(&mut m, d + 3, 34);
    setr(&mut m, d + 4, -1);       // A_SF
    setr(&mut m, d + 5, 2300);     // PhV
    setr(&mut m, d + 6, 2310);
    setr(&mut m, d + 7, 2290);
    setr(&mut m, d + 8, 2320);
    setr(&mut m, d + 9, 3990);     // PPV
    setr(&mut m, d + 10, 3991);
    setr(&mut m, d + 11, 3992);
    setr(&mut m, d + 12, 3993);
    setr(&mut m, d + 13, -1);      // V_SF
    setr(&mut m, d + 14, 500);     // Hz
    setr(&mut m, d + 15, -1);      // Hz_SF
    setr(&mut m, d + 16, -150);    // W
    setr(&mut m, d + 17, 111);
    setr(&mut m, d + 18, 222);
    setr(&mut m, d + 19, 333);
    setr(&mut m, d + 20, 1);       // W_SF
    setr(&mut m, d + 21, 777);     // VA
    setr(&mut m, d + 22, 2);
    setr(&mut m, d + 36, 1);       // TotWhExp = 0x000186A0 = 100000
    setr(&mut m, d + 37, 0x86A0);
    setr(&mut m, d + 39, 11);      // TotWhExpPhA..C
    setr(&mut m, d + 41, 22);
    setr(&mut m, d + 43, 33);
    setr(&mut m, d + 45, 7000);    // TotWhImp
    setr(&mut m, d + 47, 44);      // TotWhImpPhA..C
    setr(&mut m, d + 49, 55);
    setr(&mut m, d + 51, 66);
    setr(&mut m, d + 52, -1);      // TotWh_SF
    setr(&mut m, d + 54, 3);
    m.holding.set(109, 65535);     // end model
    val models: Vec<SunSpecModel> = sunspec_scan(&m, 0);
    var ms: str = "";
    var k: i64 = 0;
    while k < models.len() {
        ms = ms + int_to_str(models.get(k).id) + "@" + int_to_str(models.get(k).data_off);
        k = k + 1;
    }
    println("models: " + ms);
    show("scan", sunspec_read_meter(&m, &models));
}
