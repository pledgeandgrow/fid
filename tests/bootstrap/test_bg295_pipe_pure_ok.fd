// Bugs roadmap BG295: a pipe into a function with no effects stays
// allowed in a `!{}` function.
//
// Expected output:
// 6
// 8

fn inc(x: i64) -> i64 {
    return x + 1;
}
fn add(x: i64, y: i64) -> i64 {
    return x + y;
}
fn pure_pipe() -> i64 !{} {
    return 5 |> inc;
}
fn pure_pipe2() -> i64 !{} {
    return 5 |> add(3);
}
fn main() -> i64 {
    println(pure_pipe());
    println(pure_pipe2());
    return 0;
}
