// Recursive enum via Box<T> — enables AST-like data structures.
// This is the key test for self-hosting: the Fides compiler's AST is
// defined as recursive enums with Box<T> indirection.
enum Expr {
    Num(i64),
    Add(Box<Expr>, Box<Expr>),
    Mul(Box<Expr>, Box<Expr>),
}

fn eval(e: Box<Expr>) -> i64 {
    match e {
        Expr::Num(n) => { return n; }
        Expr::Add(left, right) => { return eval(left) + eval(right); }
        Expr::Mul(left, right) => { return eval(left) * eval(right); }
    }
}

fn count_nodes(e: Box<Expr>) -> i64 {
    match e {
        Expr::Num(_) => { return 1; }
        Expr::Add(left, right) => { return count_nodes(left) + count_nodes(right) + 1; }
        Expr::Mul(left, right) => { return count_nodes(left) + count_nodes(right) + 1; }
    }
}

fn main() -> i64 {
    // Build: (1 + 2) * (3 + 4) = 21
    val one = Box::new(Expr::Num(1));
    val two = Box::new(Expr::Num(2));
    val three = Box::new(Expr::Num(3));
    val four = Box::new(Expr::Num(4));
    val left = Box::new(Expr::Add(one, two));
    val right = Box::new(Expr::Add(three, four));
    val root = Box::new(Expr::Mul(left, right));

    print(eval(root));        // 21
    print(count_nodes(root)); // 7 (3 internal + 4 leaves)

    return 0;
}
