// Bugs roadmap BG416: a linear value live at a `?` is an error; one
// consumed before the `?`, or by the `?`'s own statement, is not.
//
// Expected output:
// 7
// 8

@linear
struct T { v: i64 }
fn eat(t: T) -> i64 { return t.v; }
fn g() -> Option<i64> { return Option::None; }
fn h() -> Option<i64> { return Option::Some(7); }

fn before() -> Option<i64> {
    val t = T { v: 1 };
    val a = eat(t);
    val x = g()?;
    return Option::Some(a + x);
}

fn same_stmt() -> Option<i64> {
    val t = T { v: 1 };
    val r = eat(t) + h()?;
    return Option::Some(r);
}

fn main() {
    println(before() ?? 7);
    println(same_stmt() ?? 0);
}
