// Test: Drop trait — compiler-inserted drops (Issue 50)
// When a struct implements `drop`, the compiler calls it at scope exit.

struct Logger {
    fd: i64,
}

impl Logger {
    fn new(fd: i64) -> Logger {
        return Logger { fd: fd };
    }

    fn log(self: &Logger, msg: str) {
        p_print_str(msg);
        p_print_str("\n");
    }

    fn drop(self: &mut Logger) {
        // In a real program, this would close the file descriptor.
        // Here we just print to verify drop was called.
        p_print_str("Logger dropped\n");
    }
}

fn main() {
    val logger: Logger = Logger::new(1);
    logger.log("hello from logger");
    // At function exit, compiler should call Logger_drop automatically.
}
