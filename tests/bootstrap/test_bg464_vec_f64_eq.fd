// BG464 (docs/roadmap/bugs-roadmap.md): `==` on two Vec<f64> compares the
// elements as floats (IEEE: -0.0 == 0.0, a NaN equals nothing); it compared
// their bits. Vec<f32> too.
//
// Expected output:
// true
// false
// true
// false
// true

fn idf(x: f32) -> f32 {
    return x;
}

fn main() {
    val z: f64 = 0.0;
    var a: Vec<f64> = Vec::new();
    a.push(z);
    var b: Vec<f64> = Vec::new();
    b.push(-z);
    println(a == b);
    var c: Vec<f64> = Vec::new();
    c.push(z / z);
    var d: Vec<f64> = Vec::new();
    d.push(z / z);
    println(c == d);
    var e: Vec<f64> = Vec::new();
    e.push(1.5);
    e.push(-2.0);
    var f: Vec<f64> = Vec::new();
    f.push(1.5);
    f.push(-2.0);
    println(e == f);
    println(e != f);
    var g: Vec<f32> = Vec::new();
    g.push(idf(0.5));
    var h: Vec<f32> = Vec::new();
    h.push(idf(0.5));
    println(g == h);
}
