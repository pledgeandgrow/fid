// expect-error: Event error: 'pay' can emit 'Transfer' (through 'move_funds'), which its @emit does not list
// Roadmap Phase 9 (F34): @emit lists the events a function can emit through
// everything it calls: `pay` calls `move_funds`, which emits Transfer.
@event
fn Transfer(from: i64, to: i64, amount: i64) {}

@event
fn Approval(owner: i64, spender: i64, allowed: bool) {}

@emit(Transfer)
fn move_funds(amount: i64) {
    Transfer(1, 2, amount);
}

@emit(Approval)
fn pay(amount: i64) {
    Approval(1, 2, true);
    move_funds(amount);
}

fn main() -> i64 {
    pay(5);
    return 0;
}
