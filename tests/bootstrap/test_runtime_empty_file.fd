// read_file of an existing empty file is Some("") on every backend, the
// interpreter included (known-bugs 2g.42, competitive SL17); a missing file
// is None. The file lives in a fresh directory under the system temp
// directory, removed at the end.
//
// Expected output:
// empty: Some, length 0
// one byte: Some, length 1
// missing: None
// removed: true
use fs;
use env;
use path;

fn temp_base() -> str {
    var t: str = env_get("TEMP");
    if str_len(t) > 0 && fs_is_dir(t) { return t; }
    t = env_get("TMPDIR");
    if str_len(t) > 0 && fs_is_dir(t) { return t; }
    if fs_is_dir("/tmp") { return "/tmp"; }
    return ".";
}

fn show(label: str, path: str) {
    match read_file(path) {
        Option::Some(text) => {
            println(label + ": Some, length " + int_to_str(str_len(text)));
        }
        Option::None => {
            println(label + ": None");
        }
    }
}

fn main() -> i64 {
    val root: str = fs_temp_dir(temp_base(), "empty_file");
    val e: str = path_join(root, "empty.txt");
    fs_write_text(e, "");
    show("empty", e);
    val one: str = path_join(root, "one.txt");
    fs_write_text(one, "x");
    show("one byte", one);
    show("missing", path_join(root, "missing.txt"));
    println("removed: " + bool_to_str(fs_rmdir_all(root)));
    return 0;
}
