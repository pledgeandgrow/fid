// Bugs roadmap BG182: `a?.f` on an Option<P> has the type of P's field f
// (0 for None, reference §4.5).
//
// Expected output:
// 4
// 0
// 5

struct P {
    x: i64,
}

fn mk(b: bool) -> Option<P> {
    if b {
        return Option::Some(P { x: 4 });
    }
    return Option::None;
}

fn main() -> i64 {
    val a = mk(true);
    val n = mk(false);
    val ax: i64 = a?.x;
    println(ax);
    println(n?.x);
    println(a?.x + 1);
    return 0;
}
