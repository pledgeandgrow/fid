// Expected to fail at run time (BG96, docs/roadmap/bugs-roadmap.md): two
// tasks await each other, so neither can ever finish. The C runtime panics
// with "Tasks are deadlocked: each one awaits another" (exit code 1); the
// interpreter (`fid run`) waited forever. Now the task whose await closes
// the cycle panics with the same message. "not reached" is never printed.
//@ backends: run,ccompile
use task;

var g_a: i64 = 0;
var g_b: i64 = 0;

fn a(x: i64) -> i64 {
    task_sleep(20);
    return p_future_poll(g_b | (32677 << 48));
}

fn b(x: i64) -> i64 {
    task_sleep(40);
    return p_future_poll(g_a | (32677 << 48));
}

fn main() -> i64 {
    print("before\n");
    g_a = task_go("a", 0);
    g_b = task_go("b", 0);
    task_run();
    println("not reached");
    return 0;
}
