// expect-error: contains a 'loop' loop
// Bugs roadmap BG376: @realtime forbids unbounded loops; `loop { }` passed
// (only `while` was looked for).
@realtime
fn f(x: i64) -> i64 {
    var i: i64 = 0;
    loop {
        i = i + 1;
        if i > x {
            break;
        }
    }
    return i;
}
fn main() -> i64 { println(f(3)); return 0; }
