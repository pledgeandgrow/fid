// stdlib/svd: a small CMSIS-SVD document (inherited defaults, bitRange/lsb-msb/bitOffset fields, enums, oneToClear, dim array, cluster, derivedFrom) read into regmap blocks.
// Expected output:
// ok true device STM32X width 32
// ints: 26 26 5 5 -1
// STM32X (2 peripherals)
// GPIOA 0x40020000
//   MODER +0x000 32b RW reset 0xA8000000
//     MODE0 [1:0] RW Input=0 Output=1 Alternate=2 Analog=3
//     MODE1 [3:2] RW Input=0 Output=1 Alternate=2 Analog=3
//   IDR +0x010 32b RO reset 0x00000000
//     IDR0 [0:0] RO
//   BSRR +0x018 32b WO reset 0x00000000
//     BS0 [0:0] WO
//     BR0 [16:16] WO
//   SR +0x01C 16b RW reset 0x0000
//     RDY [0:0] RO
//     ERR [1:1] W1C
//   AFR0 +0x020 32b RW reset 0x00000000
//   AFR1 +0x024 32b RW reset 0x00000000
//   CH0_CFG +0x040 32b RW reset 0x00000000
//   CH0_CNT +0x044 32b RO reset 0x00000000
//   CH1_CFG +0x050 32b RW reset 0x00000000
//   CH1_CNT +0x054 32b RO reset 0x00000000
// GPIOB 0x40020400
//   MODER +0x000 32b RW reset 0xA8000000
//     MODE0 [1:0] RW Input=0 Output=1 Alternate=2 Analog=3
//     MODE1 [3:2] RW Input=0 Output=1 Alternate=2 Analog=3
//   IDR +0x010 32b RO reset 0x00000000
//     IDR0 [0:0] RO
//   BSRR +0x018 32b WO reset 0x00000000
//     BS0 [0:0] WO
//     BR0 [16:16] WO
//   SR +0x01C 16b RW reset 0x0000
//     RDY [0:0] RO
//     ERR [1:1] W1C
//   AFR0 +0x020 32b RW reset 0x00000000
//   AFR1 +0x024 32b RW reset 0x00000000
//   CH0_CFG +0x040 32b RW reset 0x00000000
//   CH0_CNT +0x044 32b RO reset 0x00000000
//   CH1_CFG +0x050 32b RW reset 0x00000000
//   CH1_CNT +0x054 32b RO reset 0x00000000
// GPIOB MODER after MODE1=Output: 0xA8000004
// SR after ERR raised and cleared: 0x0001
// bad: svd: peripheral X has no baseAddress
// bad: svd: root element is <chip>, not <device>
use svd;
use regmap;
use xml;
use vec;
use string;

fn doc() -> str {
    var s: str = "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n";
    s = s + "<device schemaVersion=\"1.3\"><name>STM32X</name><width>32</width>";
    s = s + "<size>32</size><access>read-write</access><resetValue>0x00000000</resetValue>";
    s = s + "<peripherals><peripheral><name>GPIOA</name><description>GPIO port A</description>";
    s = s + "<baseAddress>0x40020000</baseAddress><registers>";
    s = s + "<register><name>MODER</name><addressOffset>0x00</addressOffset><resetValue>0xA8000000</resetValue>";
    s = s + "<fields><field><name>MODE0</name><bitRange>[1:0]</bitRange>";
    s = s + "<enumeratedValues><enumeratedValue><name>Input</name><value>0</value></enumeratedValue>";
    s = s + "<enumeratedValue><name>Output</name><value>1</value></enumeratedValue>";
    s = s + "<enumeratedValue><name>Alternate</name><value>#10</value></enumeratedValue>";
    s = s + "<enumeratedValue><name>Analog</name><value>0b11</value></enumeratedValue>";
    s = s + "<enumeratedValue><name>Pattern</name><value>#1x</value></enumeratedValue></enumeratedValues></field>";
    s = s + "<field><name>MODE1</name><lsb>2</lsb><msb>3</msb>";
    s = s + "<enumeratedValues><enumeratedValue><name>Input</name><value>0</value></enumeratedValue>";
    s = s + "<enumeratedValue><name>Output</name><value>1</value></enumeratedValue>";
    s = s + "<enumeratedValue><name>Alternate</name><value>2</value></enumeratedValue>";
    s = s + "<enumeratedValue><name>Analog</name><value>3</value></enumeratedValue></enumeratedValues></field>";
    s = s + "</fields></register>";
    s = s + "<register><name>IDR</name><addressOffset>0x10</addressOffset><access>read-only</access>";
    s = s + "<fields><field><name>IDR0</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth></field></fields></register>";
    s = s + "<register><name>BSRR</name><addressOffset>0x18</addressOffset><access>write-only</access>";
    s = s + "<fields><field><name>BS0</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth></field>";
    s = s + "<field><name>BR0</name><bitOffset>16</bitOffset><bitWidth>1</bitWidth></field></fields></register>";
    s = s + "<register><name>SR</name><addressOffset>0x1C</addressOffset><size>16</size>";
    s = s + "<fields><field><name>RDY</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth><access>read-only</access></field>";
    s = s + "<field><name>ERR</name><bitOffset>1</bitOffset><bitWidth>1</bitWidth>";
    s = s + "<modifiedWriteValues>oneToClear</modifiedWriteValues></field></fields></register>";
    s = s + "<register><dim>2</dim><dimIncrement>4</dimIncrement><name>AFR%s</name>";
    s = s + "<addressOffset>0x20</addressOffset></register>";
    s = s + "<cluster><dim>2</dim><dimIncrement>0x10</dimIncrement><name>CH[%s]</name><addressOffset>0x40</addressOffset>";
    s = s + "<register><name>CFG</name><addressOffset>0</addressOffset></register>";
    s = s + "<register><name>CNT</name><addressOffset>4</addressOffset><access>read-only</access></register>";
    s = s + "</cluster></registers></peripheral>";
    s = s + "<peripheral derivedFrom=\"GPIOA\"><name>GPIOB</name><baseAddress>0x40020400</baseAddress></peripheral>";
    s = s + "</peripherals></device>";
    return s;
}

fn main() {
    val dev: SvdDevice = svd_parse(doc());
    var okstr: str = "false";
    if dev.ok { okstr = "true"; }
    println("ok " + okstr + " device " + dev.name + " width " + int_to_str(dev.width) + dev.error);
    println("ints: " + int_to_str(svd_parse_int("0x1A")) + " " + int_to_str(svd_parse_int(" 26 ")) + " "
        + int_to_str(svd_parse_int("#101")) + " " + int_to_str(svd_parse_int("0b101")) + " " + int_to_str(svd_parse_int("#1x1")));
    print(svd_listing(dev));

    val gpiob: RegBlock = svd_peripheral(dev, "GPIOB");
    var bus: RegBus = regbus_fake();
    bus.logging = false;
    regbus_attach(&mut bus, gpiob);
    regmap_write_enum(&mut bus, gpiob, "MODER", "MODE1", "Output");
    println("GPIOB MODER after MODE1=Output: " + regmap_hex(regmap_read(&mut bus, gpiob, "MODER"), 8));
    val sr: i64 = regblock_addr(&gpiob, "SR");
    regbus_poke(&mut bus, sr, 3);
    regmap_write_field(&mut bus, gpiob, "SR", "ERR", 1);
    println("SR after ERR raised and cleared: " + regmap_hex(regmap_read(&mut bus, gpiob, "SR"), 4));

    val bad1: SvdDevice = svd_parse("<device><name>D</name><peripherals><peripheral><name>X</name></peripheral></peripherals></device>");
    println("bad: " + bad1.error);
    val bad2: SvdDevice = svd_parse("<chip/>");
    println("bad: " + bad2.error);
}
