// Bugs roadmap BG333: valid \u{...} escapes, the largest scalar value and
// the code points around the surrogates.
//
// Expected output:
// 1114111
// 55295 57344
// 2 3 4
fn main() -> i64 {
    println('\u{10FFFF}');
    val lo: i64 = '\u{D7FF}';
    val hi: i64 = '\u{E000}';
    println(f"{lo} {hi}");
    val a: i64 = str_len("\u{e9}");
    val b: i64 = str_len("\u{E000}");
    val c: i64 = str_len("\u{10FFFF}");
    println(f"{a} {b} {c}");
    return 0;
}
