// Test: stdlib/process — subprocess run with captured stdout/stderr/code.
use process;
use vec;

fn bs(b: bool) -> str {
    if b { return "t"; }
    return "f";
}

fn main() -> i64 {
    // capture stdout + exit code (sh -c path; cmd /C on Windows builds)
    // str_trim normalizes \r\n vs \n child output across shells/backends
    var h: i64 = process_run("echo hello_proc && echo e_out 1>&2 && exit 3");
    println("p1 " + bs(process_ok(h)));
    println("p2 " + str_trim(process_stdout(h)));
    println("p3 " + str_trim(process_stderr(h)));
    println("p4 " + int_to_str(process_code(h)));
    process_close(h);

    // simple success case
    var h2: i64 = process_run("exit 0");
    println("p5 " + int_to_str(process_code(h2)));
    process_close(h2);

    // bad handle
    println("p6 " + int_to_str(process_code(0)));

    // pid is positive
    println("p7 " + bs(process_pid() > 0));

    // capture convenience returns [stdout, code-str]
    var c: Vec = process_capture("echo cap_me");
    var c0: str = c.get(0);
    var c1: str = c.get(1);
    println("p8 " + str_trim(c0));
    println("p9 " + c1);

    return 0;
}
