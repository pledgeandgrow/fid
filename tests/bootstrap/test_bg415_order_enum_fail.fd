// expect-error: cannot order two values of enum 'E' with `<`: only `==` and `!=` are defined for a struct or an enum
// Bugs roadmap BG415: `<` on two values of one enum ordered their words:
// `E::B < E::A` and `E::A < E::B` were both true on `fid run`, both false
// on pe_ir.
enum E { A, B }
fn main() {
    println(E::B < E::A);
    println(E::A < E::B);
}
