// LF17: a Vec or map dropped while it is still empty (made by Vec::new() or
// HashMap::new() and seen by nothing since) is neither made nor dropped
// (compiler/lower.fd `lw_rc_empty_drops`). `fid dump-c` of this file shows
// no Vec_new_typed / Vec_drop pair for `v` in `unused_local` nor for the
// first value of `w` in `main`. The program checks the values that stay are
// still made, kept and dropped as before (tests/leaks/empty_drops.fd runs
// it under the leak report).
// Expected output:
// 8
// 1
// 3
// 0
// 2
// 5
// 4
// done

fn unused_local(n: i64) -> i64 {
    var v: Vec<i64> = Vec::new();
    var t: i64 = n * 2;
    return t;
}

fn reassigned() -> i64 {
    var w: Vec<i64> = Vec::new();
    w = Vec::new();
    w.push(7);
    return w.len();
}

fn in_loop() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 3 {
        var acc: Vec<i64> = Vec::new();
        acc = Vec::new();
        acc.push(i);
        total = total + acc.len();
        i = i + 1;
    }
    return total;
}

fn kept_empty() -> Vec<i64> {
    var e: Vec<i64> = Vec::new();
    return e;
}

fn maps() -> i64 {
    var m: HashMap<str, i64> = HashMap::new();
    m = HashMap::new();
    m.insert("a", 1);
    m.insert("b", 2);
    return m.len();
}

fn strings() -> i64 {
    var s: Vec<str> = Vec::new();
    s = Vec::new();
    s.push("x" + int_to_str(5));
    var n: i64 = 0;
    if s.get(0) == "x5" {
        n = 5;
    }
    return n;
}

fn main() {
    println(int_to_str(unused_local(4)));
    println(int_to_str(reassigned()));
    println(int_to_str(in_loop()));
    println(int_to_str(kept_empty().len()));
    println(int_to_str(maps()));
    println(int_to_str(strings()));
    var last: Vec<i64> = Vec::new();
    last.push(1);
    last = Vec::new();
    last.push(2);
    last.push(3);
    last.push(4);
    last.push(5);
    println(int_to_str(last.len()));
    println("done");
}
