// ME7 (compiler/egraph.fd, native paths; FID_NAT_OFF=egraph turns it off):
// unary operations are e-graph nodes now. -x, ~x and !b of constants fold
// (not the negation of the minimum, nor a result outside a narrow or
// unsigned type), ~~x and !!b are x and b, -(-x) is x only in @wrapping
// code, and operations on parameters take part. Every line must be what
// the program computes with the e-graph off.
//
// Expected output:
// 5
// -9
// 12
// -1
// 1
// 0
// -13
// 255
// 250
// 7
// -100
// 128
// 42
// 1

fn negneg(x: i64) -> i64 {
    return -(-x) + 0;
}

fn notnot_bits(x: i64) -> i64 {
    return ~(~x);
}

fn notnot(b: bool) -> bool {
    return !(!b);
}

fn consts() -> i64 {
    var c: i64 = 6;
    return -c + ~c;
}

fn bnot_u8(x: u8) -> u8 {
    return ~x;
}

@wrapping
fn wneg(x: i64) -> i64 {
    return -(-x);
}

fn neg_i16(x: i16) -> i64 {
    // a narrow negation, widened afterwards
    var y: i16 = -x;
    return y as i64;
}

fn same_twice(a: i64, b: i64) -> i64 {
    // equal unary values on parameters: one may become a move of the other
    var p: i64 = -a;
    var q: i64 = -a;
    if p == q {
        return a * b;
    }
    return 0;
}

fn main() -> i64 {
    print(negneg(5));
    print("\n");
    print(negneg(-9));
    print("\n");
    print(notnot_bits(12));
    print("\n");
    print(notnot_bits(0) - 1);
    print("\n");
    if notnot(true) {
        print(1);
    } else {
        print(0);
    }
    print("\n");
    if notnot(false) {
        print(1);
    } else {
        print(0);
    }
    print("\n");
    print(consts());
    print("\n");
    print(bnot_u8(0) as i64);
    print("\n");
    print(bnot_u8(5) as i64);
    print("\n");
    print(wneg(7));
    print("\n");
    print(neg_i16(100));
    print("\n");
    print(neg_i16(-128));
    print("\n");
    print(same_twice(6, 7));
    print("\n");
    var m: i64 = -1;
    print(-m);
    print("\n");
    return 0;
}
