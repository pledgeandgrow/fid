// Test (stdlib-agent bug 25): a global of struct type has storage for every
// field. The interpreter gave each global one 8-byte slot, so writing the
// next global overwrote the struct's second field.
// Expected output:
// 1 100 7
// 3 4 9
// 5 6 7
struct U { lo: i64, hi: i64 }
struct P { a: i64, b: i64, c: i64 }

var g_u: U = U { lo: 1, hi: 100 };
var g_n: i64 = 0;
var g_p: P = P { a: 3, b: 4, c: 5 };
var g_m: i64 = 0;

fn main() {
    g_n = 7;
    println(int_to_str(g_u.lo) + " " + int_to_str(g_u.hi) + " " + int_to_str(g_n));
    g_m = 9;
    println(int_to_str(g_p.a) + " " + int_to_str(g_p.b) + " " + int_to_str(g_m));
    g_u = U { lo: 5, hi: 6 };
    println(int_to_str(g_u.lo) + " " + int_to_str(g_u.hi) + " " + int_to_str(g_n));
}
