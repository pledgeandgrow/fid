// expect-error: is @no-indirect but calls its parameter 'f', a function value
// Test: @no-indirect rejects a call through a parameter of function type
// (release L1).

@no-indirect
fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(x);
}

fn double(x: i64) -> i64 { return x * 2; }

fn main() {
    println(apply(double, 4));
}
