// OP9, OP25 (compiler/iropt.fd iro_licm_loop): expected to fail at run
// time ("negative limit"), after printing "before 0". `checked(n)` has no
// effect but a panic, so LICM may move it out of the loop's header, but
// only when nothing a program could see comes before it there: here
// `before(i)` prints first, so the call stays and the line is printed
// before the panic. Moving it ahead would panic with nothing printed.
// Likewise `total / k` (k is 0) in the body is not moved: the body never
// runs, and the division would raise its panic first.

fn before(i: i64) -> i64 {
    print("before ");
    println(i);
    return i;
}

fn checked(n: i64) -> i64 {
    if n < 0 {
        panic("negative limit");
    }
    return n;
}

fn run(n: i64, total: i64, k: i64) -> i64 {
    var i: i64 = 0;
    var acc: i64 = 0;
    while before(i) < checked(n) {
        acc = acc + total / k;
        i = i + 1;
    }
    return acc;
}

fn main() {
    println(run(0 - 1, 10, 0));
    print("unreachable\n");
}
