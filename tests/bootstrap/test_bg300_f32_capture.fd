// BG300 (docs/roadmap/bugs-roadmap.md): under `fid run`, a closure reading
// a captured f32 got 0. The closure environment stores a float capture
// with an explicit store type (Some(F32)) into a slot typed i64; the
// interpreter's Store honoured an explicit type only for a struct, wrote
// the f64 bits, and the closure's f32 load read the low half. C, pe_ir and
// --nat print 9 and 4.5.
//
// Expected output:
// 9 4.5
// 2.5
// 7.5

fn idf(x: f32) -> f32 {
    return x;
}

fn main() {
    val cap: f32 = idf(4.5);
    val clo = fn(m: f32) -> f32 {
        return cap * m;
    };
    val clo4 = fn() -> f32 {
        return cap;
    };
    println(f"{clo(2.0)} {clo4()}");
    val half: f32 = idf(1.25);
    val dbl = fn() -> f32 {
        return half * 2.0;
    };
    println(f"{dbl()}");
    val wide: f64 = 2.5;
    val both = fn() -> f64 {
        return wide * 3.0;
    };
    println(f"{both()}");
}
