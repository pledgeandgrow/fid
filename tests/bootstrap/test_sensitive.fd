// @sensitive information flow (roadmap CO7): personal data may reach an
// output only through privacy::release, which checks consent at runtime.
use privacy;

@sensitive
fn load_id() -> i64 { return 42000; }

// Computing on @sensitive data is fine; only output is gated.
fn absorb(@sensitive v: i64) -> i64 { return 0; }

// A @sensitive function may return sensitive-derived results.
@sensitive
fn bucket(@sensitive v: i64) -> i64 { return v / 1000; }

fn main() {
    @sensitive val e = load_id();
    val b = bucket(e);
    absorb(e);
    val c = consent_grant("alice", "analytics");
    val ok = release(c, b);          // consent checked — ok is public
    println(ok);
    consent_revoke("alice", "analytics");
    if !consent_given("alice", "analytics") {
        println("sensitive OK");
    }
}
