// L8A: a const generic struct's parameter used in the bodies of its
// methods. `impl<T, const N: usize> Matrix<T, N>` puts N in scope in every
// method as a constant, the number of the receiver's type: a Matrix<i64, 3>
// runs the methods with N = 3, a Matrix<i64, 2> and a Matrix<str, 2> with
// N = 2 (one instantiation per type). `impl<N: i64> Matrix<i64, N>` (the
// other spelling of a const parameter) adds a method for i64 matrices of
// any size. Before, the impl's parameter list did not take `const N:
// usize` (a parse error) and N in a method body was an undefined variable.
//
// Expected output:
// 3 9 15
// 2 4 30
// 3 1 3
// 2 0 10
// 2 pq
// 4 15 9

struct Matrix<T, const N: usize> {
    data: Vec<T>,
}

impl<T, const N: usize> Matrix<T, N> {
    fn dim(self) -> i64 {
        return N;
    }

    fn cells(self) -> i64 {
        return N * N;
    }

    fn first_row(self) -> Vec<T> {
        var r: Vec<T> = Vec::new();
        for i in 0..N {
            r.push(self.data.get(i));
        }
        return r;
    }

    fn transpose(self) -> Matrix<T, N> {
        var d: Vec<T> = Vec::new();
        for i in 0..N {
            for j in 0..N {
                d.push(self.data.get(j * N + i));
            }
        }
        val r: Matrix<T, N> = Matrix { data: d };
        return r;
    }
}

impl<N: i64> Matrix<i64, N> {
    fn trace(self) -> i64 {
        var s: i64 = 0;
        for i in 0..N {
            s = s + self.data.get(i * N + i);
        }
        return s;
    }
}

fn main() -> i64 {
    var v3: Vec<i64> = Vec::new();
    for i in 0..9 {
        v3.push(i + 1);
    }
    val a: Matrix<i64, 3> = Matrix { data: v3 };
    var v2: Vec<i64> = Vec::new();
    for i in 0..4 {
        v2.push(i * 10);
    }
    val b: Matrix<i64, 2> = Matrix { data: v2 };
    var vs: Vec<str> = Vec::new();
    vs.push("p");
    vs.push("q");
    vs.push("r");
    vs.push("s");
    val s: Matrix<str, 2> = Matrix { data: vs };
    println(int_to_str(a.dim()) + " " + int_to_str(a.cells()) + " " + int_to_str(a.trace()));
    println(int_to_str(b.dim()) + " " + int_to_str(b.cells()) + " " + int_to_str(b.trace()));
    val ra: Vec<i64> = a.first_row();
    println(int_to_str(ra.len()) + " " + int_to_str(ra.get(0)) + " " + int_to_str(ra.get(2)));
    val rb: Vec<i64> = b.first_row();
    println(int_to_str(rb.len()) + " " + int_to_str(rb.get(0)) + " " + int_to_str(rb.get(1)));
    val rs: Vec<str> = s.first_row();
    println(int_to_str(s.dim()) + " " + rs.get(0) + rs.get(1));
    val t: Matrix<i64, 3> = a.transpose();
    println(int_to_str(t.data.get(1)) + " " + int_to_str(t.trace()) + " " + int_to_str(t.data.get(8)));
    return 0;
}
