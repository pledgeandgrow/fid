// Bugs roadmap BG337: an integer converted to f32 was rounded twice (to
// f64, then to f32) on run, C and --nat: 2^54 + 2^30 + 1 must round once to
// 2^54 + 2^31 (semantics-2 §10 F32-cast); through f64 it became the tie
// 2^54 + 2^30 and rounded to even, 2^54. Small values are exact either way.
//
// Expected output:
// 18014400656965632
// 18014400656965632
// 16777216 -3
fn id64(x: i64) -> i64 {
    return x;
}
fn idu(x: u64) -> u64 {
    return x;
}
fn main() {
    val f: f32 = id64(18014399583223809) as f32;
    println(f"{(f as f64) as i64}");
    val g: f32 = idu(18014399583223809) as f32;
    println(f"{(g as f64) as i64}");
    val h: f32 = id64(16777217) as f32;
    val n: f32 = id64(-3) as f32;
    println(f"{(h as f64) as i64} {(n as f64) as i64}");
}
