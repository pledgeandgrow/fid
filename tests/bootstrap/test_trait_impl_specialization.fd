// L8H: specialization of trait impls. Beside the generic impl of a trait
// for a whole struct (`impl<T> Show for Wrap<T>`), impls of the trait for
// narrower types (`impl Show for Wrap<i64>`, `impl Show for Wrap<str>`,
// `impl<U> Show for Wrap<Vec<U>>`) give the trait's methods for those
// types: a call runs the method of the most specific impl whose type takes
// the receiver's, the generic impl's otherwise (Wrap<bool>). This holds in
// a direct call, in a call through a bound (`fn render<T: Show>`), and in
// a default method of the trait (`twice` calls `self.show()`), each decided
// per instantiation. A method the narrower impl leaves out (`label` for
// Wrap<i64>) is the generic impl's. Before, the second `impl Show for Wrap`
// replaced the first one's methods for every type.
//
// Expected output:
// i64 5
// str hi
// any
// vec of 2
// i64 7
// any
// i64 5 i64 5
// any any
// label any
// label str
// 3

cap Show {
    fn show(self) -> str;
    fn twice(self) -> str { return self.show() + " " + self.show(); }
    fn label(self) -> str { return "label any"; }
}

struct Wrap<T> {
    v: T,
}

impl<T> Show for Wrap<T> {
    fn show(self) -> str {
        return "any";
    }
}

impl Show for Wrap<i64> {
    fn show(self) -> str {
        return "i64 " + int_to_str(self.v);
    }
}

impl Show for Wrap<str> {
    fn show(self) -> str {
        return "str " + self.v;
    }

    fn label(self) -> str {
        return "label str";
    }
}

impl<U> Show for Wrap<Vec<U>> {
    fn show(self) -> str {
        return "vec of " + int_to_str(self.v.len());
    }
}

fn render<T: Show>(x: T) -> str {
    return x.show();
}

fn main() -> i64 {
    val a: Wrap<i64> = Wrap { v: 5 };
    println(a.show());
    val b: Wrap<str> = Wrap { v: "hi" };
    println(b.show());
    val c: Wrap<bool> = Wrap { v: true };
    println(c.show());
    var vs: Vec<str> = Vec::new();
    vs.push("a");
    vs.push("b");
    val d: Wrap<Vec<str>> = Wrap { v: vs };
    println(d.show());
    val e: Wrap<i64> = Wrap { v: 7 };
    println(render(e));
    println(render(c));
    println(a.twice());
    println(c.twice());
    println(a.label());
    println(b.label());
    println(int_to_str(a.v - 2));
    return 0;
}
