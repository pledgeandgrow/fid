// expect-error: not @send
// Diagnostic: spawn hands a task a non-send value; error says what can't cross.
// (A struct of plain values is @send by itself; a raw pointer is not.)
// The task is awaited: a task never awaited, joined or detached is an
// error of its own (CA6), which hid this one.
struct Local { h: *mut i64 }

fn show(l: Local) -> i64 {
    print(l.h as i64);
    return 0;
}

fn main() -> i64 {
    val l = Local { h: 0 as *mut i64 };
    val t = spawn show(l);
    println(await t);
    return 0;
}
