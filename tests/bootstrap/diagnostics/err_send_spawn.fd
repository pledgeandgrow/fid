// expect-error: not @send
// Diagnostic: spawn captures a non-send variable; error says what can't cross.
// (A struct of plain values is @send by itself; a raw pointer is not.)
struct Local { h: *mut i64 }
fn main() -> i64 {
    val l = Local { h: 0 as *mut i64 };
    spawn {
        print(l.h as i64);
    }
    return 0;
}
