// OP9 (ME25 in part; compiler/iropt_me.fd ime_licm_guard with
// ime_guard_reaches, opt-in FID_IROPT_ON=licmguard): arithmetic that may
// panic moves out of a loop under a guard from a block deeper than the
// first block of the body, when every pass entering the body reaches it
// through blocks that do nothing a program could see (a test of plain
// locals, an empty branch).
// - deep_div: `t / k` after `if a < b { }`: the division sits in the
//   block where the two ways join. With no pass (n = 0) it is not made,
//   so k = 0 raises nothing.
// - deep_sub: `x - y` may overflow; after an empty `if`/`else`.
// - after_store: a store comes first in the joined block: nothing moves.
// The program prints the same with the pass on and off.
//
// Expected output:
// 0
// 15
// 30
// 12
// 0
// 6

fn deep_div(n: i64, a: i64, b: i64, t: i64, k: i64) -> i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < n {
        if a < b {
        }
        acc = acc + t / k;
        i = i + 1;
    }
    return acc;
}

fn deep_sub(n: i64, a: i64, b: i64, x: i64, y: i64) -> i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < n {
        if a == b {
        } else {
        }
        acc = acc + (x - y);
        i = i + 1;
    }
    return acc;
}

fn after_store(n: i64, a: i64, b: i64, t: i64, k: i64) -> i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < n {
        if a < b {
        }
        i = i + 1;
        acc = acc + t / k;
    }
    return acc;
}

fn main() {
    println(deep_div(0, 1, 2, 10, 0));
    println(deep_div(3, 1, 2, 10, 2));
    println(deep_div(3, 5, 2, 20, 2));
    println(deep_sub(4, 1, 1, 5, 2));
    var m: i64 = 0 - 9223372036854775807;
    m = m - 1;
    println(deep_sub(0, 1, 2, m, 1));
    println(after_store(2, 1, 2, 9, 3));
}
