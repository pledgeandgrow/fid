// L3A: Effect handler continuation semantics test
// Tests resume(cont, value) — the handler can resume the continuation

fn main() {
    // Simple effect handler with resume
    handle {
        val x = 10;
        do IO.print(x);
        // After resume, this should run
        println(x + 1);
    } with {
        IO.print(v) => {
            println(v);
            resume(cont, 0);
        }
    }
}
