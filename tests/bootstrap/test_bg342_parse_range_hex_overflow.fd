// Bugs roadmap BG342 (BG175's siblings in stdlib/core.fd):
// str_parse_int_range panicked "Integer overflow on multiplication" on a
// digit run past i64::MAX, and str_parse_hex (@wrapping) kept shifting past
// 16 digits: "1ffffffffffffffff" gave -1 and "10000000000000000" (2^64) 0,
// with no way to tell overflow from a value. Both now return 0 (their
// failure value) for a value that does not fit in 64 bits; 16 hex digits
// keep their two's-complement meaning, and leading zeros do not count.
//
// Expected output:
// 0
// 0 0
// 0
// 9223372036854775807 12345
// -1 9223372036854775807 255 255
// 0

fn main() {
    println(f"{str_parse_int("99999999999999999999")}");
    println(f"{str_parse_hex("1ffffffffffffffff")} {str_parse_hex("10000000000000000")}");
    println(f"{str_parse_int_range("99999999999999999999", 0, 20)}");
    println(f"{str_parse_int_range("x9223372036854775807", 1, 20)} {str_parse_int_range("12345", 0, 5)}");
    println(f"{str_parse_hex("ffffffffffffffff")} {str_parse_hex("0x7fffffffffffffff")} {str_parse_hex("00000000000000000ff")} {str_parse_hex("FF")}");
    println(f"{str_parse_int_range("9223372036854775808", 0, 19)}");
}
