// Earlier miscompile "known-bugs 1.18": `print` of any value called the
// integer printer (a string printed as its address, or crashed natively).
// print and println of each basic type.
//
// Expected output:
// text
// 42
// -7
// true
// 2.5
// ab3

fn main() -> i64 {
    println("text");
    println(42);
    var n: i64 = -7;
    println(n);
    var b: bool = true;
    println(b);
    var f: f64 = 2.5;
    println(f);
    print("a");
    print("b");
    print(3);
    println("");
    return 0;
}
