// test_midend_egplace.fd — ME8 (docs/roadmap/llvm-roadmap.md): placement in
// the e-graph pass (compiler/egraph.fd eg_place, Click's global code
// motion), on by default on the native paths since Nov 17
// (FID_NAT_OFF=egplace or FID_IROPT_OFF=egplace turns it off).
// Each function has a pure value (one that reads no memory and cannot
// panic) that placement may move:
// - nested: `(a & b) | c` inside two loops uses only parameters: it may be
//   computed before both loops.
// - inner_only: `o ^ k` depends on the outer loop's variable only: it may
//   leave the inner loop, not the outer one.
// - zero_trip: an invariant of a loop that runs zero times is still
//   computed only if needed; the result is the same.
// - float_inv: `x * y` in a loop is invariant (floats do not panic).
// - wrap_inv: @wrapping `a * b + c` in a loop is invariant.
// - cmp_branch: `a < b` read by the branch in the loop stays with its
//   branch; `a == b` read by arithmetic may leave the loop.
// - sink_one: `x ^ 5` used in one arm moves into it; `x & 3` used in both
//   stays before the `if`.
// - sink_after: `x | 8`, made before a loop and used after it, may go to
//   after the loop (not into it).
// - nested_branch: an invariant read only in a branch inside a loop.
// - casts: widening and narrowing of a loop-invariant value.
// Every line must be what the program computes with placement off, and
// what `fid run` prints.
//
// Expected output:
// 3500
// 1150
// 0
// 7
// 63
// 2420
// 10
// 11
// 140
// 24
// 6
// 1000
// 210
// done

fn nested(n: i64, m: i64, a: i64, b: i64, c: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n {
        var j: i64 = 0;
        while j < m {
            s = s + ((a & b) | c);
            j = j + 1;
        }
        i = i + 1;
    }
    return s;
}

fn inner_only(n: i64, m: i64, k: i64) -> i64 {
    var s: i64 = 0;
    var o: i64 = 0;
    while o < n {
        var j: i64 = 0;
        while j < m {
            s = s + (o ^ k);
            j = j + 1;
        }
        o = o + 1;
    }
    return s;
}

fn zero_trip(n: i64, a: i64, b: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n {
        s = s + (a | b);
        i = i + 1;
    }
    return s;
}

fn float_inv(n: i64, x: f64, y: f64) -> f64 {
    var s: f64 = 0.0;
    var i: i64 = 0;
    while i < n {
        s = s + x * y;
        i = i + 1;
    }
    return s;
}

@wrapping fn wrap_inv(n: i64, a: i64, b: i64, c: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n {
        s = s + (a * b + c);
        i = i + 1;
    }
    return s;
}

fn cmp_branch(n: i64, a: i64, b: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n {
        if a < b {
            s = s + 1;
        }
        var e: bool = a == b;
        if e {
            s = s + 100;
        }
        i = i + 1;
    }
    return s;
}

fn sink_one(x: i64, c: bool) -> i64 {
    var y: i64 = x ^ 5;
    var z: i64 = x & 3;
    if c {
        return y + z;
    }
    return z;
}

fn sink_after(n: i64, x: i64) -> i64 {
    var y: i64 = x | 8;
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n {
        s = s + i;
        i = i + 1;
    }
    return s + y;
}

fn nested_branch(n: i64, a: i64, b: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n {
        if (i & 1) == 0 {
            s = s + (a ^ b);
        } else {
            s = s + 1;
        }
        i = i + 1;
    }
    return s;
}

fn casts(n: i64, v: i32) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n {
        var w: i64 = v as i64;
        var t: i8 = w as i8;
        s = s + w + (t as i64);
        i = i + 1;
    }
    return s;
}

fn main() {
    // (6 & 3) | 5 = 7, 25 * 20 times: 3500
    println(nested(25, 20, 6, 3, 5));
    // o ^ 9 for o in 0..10, 10 times each: (9+8+11+10+13+12+15+14+1+0) * 10
    // = 930; + 220 = 1150
    println(inner_only(10, 10, 9) + 220);
    println(zero_trip(0, 6, 3));
    // 3.5 * 2.0 = 7.0, once
    var f: f64 = float_inv(1, 3.5, 2.0);
    println(f as i64);
    // 9 * 7 + 0 = 63, once
    println(wrap_inv(1, 9, 7, 0));
    // a < b true on 20 iterations (20), a == b false: 20; then a == b: 2400
    println(cmp_branch(20, 1, 2) + cmp_branch(24, 3, 3));
    // 9 ^ 5 = 12, 9 & 3 = 1: 13 vs 1; 13 - 3 = 10
    println(sink_one(9, true) - 3);
    println(sink_one(9, false) + 10);
    // 0 + 1 + ... + 15 = 120, 4 | 8 = 12: 132; + 8 = 140
    println(sink_after(16, 4) + 8);
    // 10 iterations: 5 even ones add 6 ^ 3 = 5 (25), 5 odd ones add 1 (5): 30 - 6 = 24
    println(nested_branch(10, 6, 3) - 6);
    // v = 1: w = 1, t = 1, 2 per iteration, 3 iterations: 6
    println(casts(3, 1));
    // v = 300: w = 300, t = 44: 344 per iteration; 3 times: 1032 - 32 = 1000
    println(casts(3, 300) - 32);
    // 0 + 1 + ... + 19 = 190, 1 | 8 = 9: 199; + 11 = 210
    println(sink_after(20, 1) + 11);
    println("done");
}
