// expect-error: variable 'm' was already consumed (moved).
// Test: linear Money type violations (should fail to compile)
// This test exercises the linear type system: Money cannot be used twice.

use money;

fn main() -> i64 {
    val m = Money_new(10000);  // $100.00

    // ERROR: using 'm' twice violates linear semantics.
    // The first call consumes 'm', the second is a use-after-move.
    val a = Money_to_cents(m);
    val b = Money_to_cents(m);  // ← linear type error: 'm' already consumed

    print(a);
    print(b);
    return 0;
}
