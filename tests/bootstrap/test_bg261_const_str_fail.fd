// expect-error: cannot assign str to const 'C' of type i64
// Bugs roadmap BG261: a const's initializer is type-checked against the
// declared type (reference §2.7); before, `const C: i64 = "abc"` made C a
// str and `println(C)` printed abc.
const C: i64 = "abc";

fn main() -> i64 {
    println(C);
    return 0;
}
