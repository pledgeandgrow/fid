// expect-error: p_malloc() needs an `unsafe` block
// Release M2: a program file that declares its module (`module x;`) is held
// to the `unsafe` rule as one without a declaration is. Before, the rule
// applied only to the module named "main" and to imported user modules, so
// this file allocated raw memory outside `unsafe` and was accepted
// (typechecker.fd tc_module_needs_unsafe, g_tc_program_module).

module unsafe_module_decl_prog;

fn main() -> i64 {
    val p: i64 = p_malloc(16);
    println(p != 0);
    return 0;
}
