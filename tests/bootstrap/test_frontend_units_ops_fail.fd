// expect-error: `Meters.add` takes Meters, got Seconds
// CL10 (fid): `+` on two units of different dimensions is a type error.
use units;

fn main() -> i64 {
    val d: Meters = meters(100.0);
    val t: Seconds = seconds(10.0);
    val x: Meters = d + t;
    println(int_to_str(x.value as i64));
    return 0;
}
