// Test (stdlib-agent bugs 11/24): a struct literal whose struct the parser
// does not know yet (declared further down, or in a module imported after
// this one) parses when its first field is named by a word keyword
// (`handle`, `state`, `query`, ...). The parser decides `Name { field: ...`
// is a literal syntactically; it accepted only a plain identifier there, so
// `Dev { handle: h, ... }` gave "expected { but got 'Colon'". Also checks
// that a variable named by a word keyword can head a field assignment
// (`handle.fd = ...`) and an index assignment.
// Expected output:
// 7 2 1
// 9
// 10 5
fn mk(h: i64) -> Dev {
    return Dev { handle: h, size: 2, state: 1 };
}

fn mk2() -> Dev {
    return Dev { state: 0, handle: 9, size: 4 };
}

fn main() {
    val d: Dev = mk(7);
    println(int_to_str(d.handle) + " " + int_to_str(d.size) + " " + int_to_str(d.state));
    var handle: Dev = mk2();
    println(int_to_str(handle.handle));
    handle.size = 5;
    var state: Vec<i64> = Vec::new();
    state.push(1);
    state[0] = 10;
    println(int_to_str(state.get(0)) + " " + int_to_str(handle.size));
}

struct Dev {
    handle: i64,
    size: i64,
    state: i64,
}
