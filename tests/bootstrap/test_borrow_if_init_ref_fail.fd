// expect-error: cannot mutate v: shared borrow(s) are active on it or its fields
// BG141: a reference made in a branch of an `if` initializer is r's
// borrow: it ended with the branch's block, so the pushes were accepted
// while r pointed into the old buffer (`*r` printed 0).
fn main() {
    var v: Vec<i64> = Vec::new();
    v.push(111);
    v.push(222);
    val c: bool = true;
    val r: &i64 = if c { &v[0] } else { &v[1] };
    var i: i64 = 0;
    while i < 100000 {
        v.push(i);
        i = i + 1;
    }
    println(int_to_str(*r));
}
