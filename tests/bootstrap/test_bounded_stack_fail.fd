// expect-error: Safety error (bounded-stack)
// Test: @bounded-stack rejects recursion in anything it reaches (release
// L1: one negative test per safety rule).

fn walk(n: i64) -> i64 {
    if n == 0 { return 0; }
    return walk(n - 1) + 1;
}

@bounded-stack(4096)
fn entry() -> i64 {
    return walk(10);
}

fn main() {
    println(entry());
}
