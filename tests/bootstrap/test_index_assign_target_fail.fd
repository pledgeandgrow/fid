// expect-error: cannot index type i64 in the assignment to 'p[..]'
// Bugs roadmap BG1: `name[i] = v` checked only that `name` exists, and the
// lowering stored through any other value with GetElemPtr + Store: here a
// store of 7 to address 4096 in safe code. Only an element of a Vec or of
// an array can be assigned (reference §4.4, §5.3), as `p[0]` on the read
// side says.

fn main() -> i64 {
    var p: i64 = 4096;
    p[0] = 7;
    println(int_to_str(p));
    return 0;
}
