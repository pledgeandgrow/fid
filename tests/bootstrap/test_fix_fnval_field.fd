// Test (stdlib-agent bug 30): an unannotated variable holding a function
// value read from a struct field (`val f = c.h;`) lost its string results
// (f("q") printed nothing): the variable's type was not taken from the
// field, so the call's result was read as an i64. A typed variable worked.
// Also run it through `fid ccompile`.
// Expected output:
// q!
// r!
// 12
struct C {
    h: fn(str) -> str,
    n: fn(i64) -> i64,
}

fn up(s: str) -> str {
    return s + "!";
}

fn dbl(x: i64) -> i64 {
    return x * 2;
}

fn use_it(c: C) -> i64 {
    val g = c.n;
    return g(6);
}

fn main() {
    val c: C = C { h: up, n: dbl };
    val f = c.h;
    println(f("q"));
    val g: fn(str) -> str = c.h;
    println(g("r"));
    println(use_it(c));
}
