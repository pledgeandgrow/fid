// Bugs roadmap BG134: pe_ir (the default Windows `fid emit`) with an f32
// operand next to an f64 one (the literal of `w % 2.0`, `0.5 > w` is an
// f64 ConstFloat). PeirGen_gen_float_binop loaded both with movss: the
// f64's low 32 bits (0.0) were used, or the compiler panicked "pe_ir: a
// register value used as memory" when the constant sat in an xmm register.
// Now both are computed in f64 and an f32 result narrowed (as C, `fid run`
// and nat_ir's ng_float_mixed). Covers what test_isel_f32_mixed.fd does
// not: a remainder (the f64 fmod narrowed), an f64 constant on the left of
// a comparison or an operation, a loop that keeps its constants in
// registers, and an f64 constant stored into an f32 field after the
// struct was made (the store converts it: the low 32 bits were stored).
//
// Expected output:
// 1 3 0
// 1 0 1
// 1 0
// 7 -6
// 12 6
// 25 4
// 4

struct Q {
    a: f32,
    b: f32,
}

fn rem2(w: f32) -> f32 {
    return w % 2.0;
}

fn above(w: f32) -> i64 {
    if 0.5 > w {
        return 0;
    }
    return 1;
}

fn is_two(w: f32) -> i64 {
    if 2.0 == w {
        return 1;
    }
    return 0;
}

fn main() {
    var x: f32 = 7.0;
    var y: f32 = 3.5;
    println(int_to_str(rem2(x) as i64) + " " + int_to_str((y % 0.5 + 3.0) as i64) + " " + int_to_str(rem2(0.0 - 6.0) as i64));

    var two: f32 = 2.0;
    println(int_to_str(above(x)) + " " + int_to_str(above(0.25)) + " " + int_to_str(is_two(two)));
    println(int_to_str(is_two(two * 1.0)) + " " + int_to_str(is_two(two + 0.5)));

    var s: f32 = 10.0 - x;
    var t: f32 = 1.5 - y * 2.0;
    println(int_to_str((s + 4.0) as i64) + " " + int_to_str((t - 0.5) as i64));

    var q: Q = Q { a: 1.0, b: 2.0 };
    q.a = 12.75;
    q.b = 6.5;
    println(int_to_str(q.a as i64) + " " + int_to_str(q.b as i64));

    var acc: f32 = 0.0;
    var hits: i64 = 0;
    var i: i64 = 0;
    while i < 10 {
        acc = acc + 2.5;
        if acc > 12.0 {
            hits = hits + 1;
        }
        if 20.0 <= acc {
            hits = hits + 0;
        }
        i = i + 1;
    }
    println(int_to_str(acc as i64) + " " + int_to_str(hits - 2));

    var m: f32 = 9.0;
    m = m % 5.0;
    println(int_to_str(m as i64));
}
