// TLS 1.3 over loopback with a local self-signed certificate (competitive
// SL4, release I7): no network, no files of its own. The certificate below
// (CN=localhost, RSA 2048, valid until 2126; a test key, never use it for
// anything else) is written to the temporary directory as PEM files for
// OpenSSL or as a .pfx (password "test") for Schannel. A tls_server13
// that also answers ALPN ("h2,http/1.1") serves two connections:
//   [1] tls_connect13_unchecked: a 1.3-only client offering no ALPN;
//   [2] tls_connect_alpn_unchecked offering "h2": a client that is not
//       pinned to 1.3, so the 1.3 comes from the server's side.
// Both sides check the version (772 = TLS 1.3) and one message each way.
// Then tls_server_close frees the server (on Windows it deletes the key
// that importing the .pfx put in the user's key store) and the files go.
//
// Needs tasks that run side by side and the system's TLS library: C and
// native builds (`fid ccompile`, `fid emit`), Windows 11 / Server 2022 or
// later (Schannel TLS 1.3), OpenSSL 1.1.1 or later elsewhere. `fid run`
// cannot call Schannel or libssl.
//
// Expected output:
// [1] server version 772
// [1] server alpn: (none)
// [1] server got ping
// [1] client version 772
// [1] client alpn: (none)
// [1] client got pong
// [2] server version 772
// [2] server alpn: h2
// [2] server got ping
// [2] client version 772
// [2] client alpn: h2
// [2] client got pong
// server closed
// tls13 local ok
use tls;
use task;
use fs;
use vec;
use string;

var g_server: i64 = 0;
var g_port: i64 = 0;
var g_log: Vec<str> = Vec::new();
var g_failed: bool = false;

fn hex_digit(c: i64) -> i64 {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    return c - 87;
}

fn hex_bytes(h: str) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i + 1 < str_len(h) {
        out.push(hex_digit(str_byte_at(h, i)) * 16 + hex_digit(str_byte_at(h, i + 1)));
        i = i + 2;
    }
    return out;
}

fn temp_dir() -> str {
    match env_var("TMPDIR") {
        Option::Some(d) => {
            if d != "" {
                return d;
            }
        }
        Option::None => {}
    }
    match env_var("TEMP") {
        Option::Some(d) => {
            if d != "" {
                return d;
            }
        }
        Option::None => {}
    }
    return "/tmp";
}

@unsafe
fn recv_text(s: i64) -> str {
    var buf: i64 = 0;
    // SAFETY: a 256-byte block of our own; tls_session_recv writes at most
    // 255 bytes into it and the loop reads only the n it wrote
    unsafe { buf = p_malloc(256); }
    val n: i64 = tls_session_recv(s, buf, 255, 10000);
    var out: str = "";
    if n > 0 {
        var bytes: Vec<i64> = Vec::new();
        var i: i64 = 0;
        while i < n {
            bytes.push(p_volatile_load8(buf + i));
            i = i + 1;
        }
        out = str_from_bytes(bytes);
    }
    unsafe { p_free(buf); }
    return out;
}

fn send_text(s: i64, t: str) -> bool {
    return tls_session_send(s, t as i64, str_len(t)) == str_len(t);
}

fn alpn_text(s: i64) -> str {
    val a: str = tls_session_alpn(s);
    if a == "" {
        return "(none)";
    }
    return a;
}

fn check(line: str, want: str) {
    println(line);
    if line != want {
        g_failed = true;
    }
}

// The server: two connections, one after the other. What it sees goes to
// g_log; the client prints it once it has the reply (sent after the log).
fn serve(lfd: i64) -> i64 {
    var k: i64 = 1;
    while k <= 2 {
        val tag: str = "[" + int_to_str(k) + "] ";
        val c: i64 = p_co_accept(lfd);
        if c < 0 {
            g_log.push(tag + "server: accept failed");
            return 1;
        }
        val s: i64 = tls_accept(g_server, c);
        if s == 0 {
            g_log.push(tag + "server: handshake failed");
            p_socket_close(c);
            return 1;
        }
        g_log.push(tag + "server version " + int_to_str(tls_session_version(s)));
        g_log.push(tag + "server alpn: " + alpn_text(s));
        var got: str = "";
        // SAFETY: recv_text is @unsafe (release M10); s is the session
        // tls_accept just made
        unsafe { got = recv_text(s); }
        g_log.push(tag + "server got " + got);
        send_text(s, "pong");
        tls_session_close(s);
        p_socket_close(c);
        k = k + 1;
    }
    return 0;
}

fn print_server_log(want: Vec<str>) {
    var i: i64 = 0;
    while i < g_log.len() {
        if i < want.len() {
            check(g_log.get(i), want.get(i));
        } else {
            check(g_log.get(i), "");
        }
        i = i + 1;
    }
    if g_log.len() != want.len() {
        g_failed = true;
    }
    g_log = Vec::new();
}

fn round(k: i64, s: i64, want_alpn: str) {
    val tag: str = "[" + int_to_str(k) + "] ";
    if s == 0 {
        println(tag + "client: handshake failed");
        g_failed = true;
        return;
    }
    send_text(s, "ping");
    var reply: str = "";
    // SAFETY: recv_text is @unsafe (release M10); s is a live session
    // (round's caller connected it; 0 returned above)
    unsafe { reply = recv_text(s); }
    var want: Vec<str> = Vec::new();
    want.push(tag + "server version 772");
    want.push(tag + "server alpn: " + want_alpn);
    want.push(tag + "server got ping");
    print_server_log(want);
    check(tag + "client version " + int_to_str(tls_session_version(s)), tag + "client version 772");
    check(tag + "client alpn: " + alpn_text(s), tag + "client alpn: " + want_alpn);
    check(tag + "client got " + reply, tag + "client got pong");
    val fd: i64 = tls_session_fd(s);
    tls_session_close(s);
    p_socket_close(fd);
}

fn clients(n: i64) -> i64 {
    round(1, tls_connect13_unchecked("localhost", g_port), "(none)");
    round(2, tls_connect_alpn_unchecked("localhost", g_port, "h2"), "h2");
    return n;
}

fn main() -> i64 {
    val dir: str = temp_dir();
    val stamp: str = int_to_str(p_clock_now_us() % 1000000007);
    val pfx_path: str = dir + "/fides_tls13_" + stamp + ".pfx";
    val cert_path: str = dir + "/fides_tls13_" + stamp + "_cert.pem";
    val key_path: str = dir + "/fides_tls13_" + stamp + "_key.pem";
    var written: bool = false;
    if tls_library() == "schannel" {
        written = fs_write_bytes(pfx_path, hex_bytes(pfx_hex()));
        if written {
            g_server = tls_server13(pfx_path, "test");
        }
    } else {
        written = fs_write_text(cert_path, cert_pem()) && fs_write_text(key_path, key_pem());
        if written {
            g_server = tls_server13(cert_path, key_path);
        }
    }
    if !written {
        println("FAIL: could not write the certificate to " + dir);
        return 1;
    }
    var ok: bool = g_server != 0 && tls_server_alpn(g_server, "h2,http/1.1");
    if !ok {
        println("FAIL: tls_server13 could not load the certificate or has no TLS 1.3");
    } else {
        var port: i64 = 18700;
        var lfd: i64 = p_socket_listen(port);
        while lfd < 0 && port < 18740 {
            port = port + 1;
            lfd = p_socket_listen(port);
        }
        g_port = port;
        val s: i64 = task_go("serve", lfd);
        val c: i64 = task_go("clients", 0);
        task_run();
        p_socket_close(lfd);
        if task_result(s) != 0 {
            // what the server logged after the last client round
            print_server_log(Vec::new());
            g_failed = true;
        }
    }
    if g_server != 0 {
        tls_server_close(g_server);
        println("server closed");
    }
    if tls_library() == "schannel" {
        fs_delete(pfx_path);
    } else {
        fs_delete(cert_path);
        fs_delete(key_path);
    }
    if !ok || g_failed {
        println("FAIL");
        return 1;
    }
    println("tls13 local ok");
    return 0;
}

