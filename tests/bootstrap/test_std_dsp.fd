// stdlib/dsp: FFT (radix-2, Bluestein), windows, FIR and RBJ biquads, RMS, THD, Goertzel
// Reference values: numpy.fft.fft([1..8]) and fft([1..5]); numpy hamming /
// blackman and the flattopwin coefficients; a windowed-sinc design computed
// independently with numpy; the RBJ low-pass at 1 kHz, Q = 1/sqrt(2), 48 kHz
// (cookbook formulas, -3.0103 dB at f0); DTMF tones (ITU-T Q.23) detected by
// Goertzel at 8 kHz with N = 205, the classic block length. The filtered
// tones (peak of the samples after the transient) were checked with numpy.
// Expected output:
// fft8: 36.0000+0.0000i -4.0000+9.6569i -4.0000+4.0000i -4.0000+1.6569i -4.0000+0.0000i
// fft5: 15.0000+0.0000i -2.5000+3.4410i -2.5000+0.8123i -2.5000-0.8123i -2.5000-3.4410i
// bluestein n=7 and n=12 match the direct DFT: true true
// ifft(fft(x)) == x for n=12 and n=16: true true
// hann5: 0.0000 0.5000 1.0000 0.5000 0.0000
// hann4 periodic: 0.0000 0.5000 1.0000 0.5000
// hamming5: 0.0800 0.5400 1.0000 0.5400 0.0800
// blackman5: 0.0000 0.3400 1.0000 0.3400 0.0000
// flattop5: -0.000421 -0.054737 1.000000 -0.054737 -0.000421
// fir lp 21 taps fc=0.1: center 0.199169 |H| 1.0000 0.4969 0.0002 0.0007
// fir hp 21 taps fc=0.1: |H| 0.0000 0.5031 1.0002 0.9993
// fir lp filters a 0.02 tone at 0.9907 and a 0.3 tone at 0.0006
// rbj lpf b=0.0039161 0.0078323 0.0039161 a=-1.8153411 0.8310056
// rbj lpf |H(f0)| = -3.0103 dB, DC gain after a step 1.000000
// peaking +6 dB at f0: 6.0000 dB, notch at f0: 0.000000
// low shelf +6 at DC: 6.0000 dB, high shelf -6 at Nyquist: -6.0000 dB
// allpass |H| at 300 Hz and 9 kHz: 1.000000 1.000000
// rms of 2 sin: 1.414214
// harmonics: dc 0.5000 h1 1.0000 h2 0.0000 h3 0.1000 h4 0.0000 h5 0.0500
// thd = 0.111803
// goertzel bin 3 of fft8 input: -4.0000+1.6569i
// dtmf: 5 #
// convolve: 0.0000 1.0000 2.5000 4.0000 1.5000
use dsp;
use math;
use complex;
use string;

// x rounded to d places (half away from zero) as fixed-point text
fn fx(x: f64, d: i64) -> str {
    var p: i64 = 1;
    var i: i64 = 0;
    while i < d {
        p = p * 10;
        i = i + 1;
    }
    var ax: f64 = x;
    if ax < 0.0 {
        ax = 0.0 - ax;
    }
    val v: i64 = math_floor(ax * (p as f64) + 0.5) as i64;
    var out: str = int_to_str(v / p);
    if d > 0 {
        var frac: str = int_to_str(v % p);
        while str_len(frac) < d {
            frac = "0" + frac;
        }
        out = out + "." + frac;
    }
    if x < 0.0 && v != 0 {
        return "-" + out;
    }
    return out;
}

fn cs(z: Complex) -> str {
    var s: str = "+";
    var im: f64 = z.im;
    if im < 0.0 && fx(im, 4) != "0.0000" {
        s = "-";
    }
    return fx(z.re, 4) + s + fx(math_fabs(im), 4) + "i";
}

fn row(v: &Vec<f64>, d: i64) -> str {
    var out: str = "";
    var i: i64 = 0;
    while i < v.len() {
        if i > 0 {
            out = out + " ";
        }
        out = out + fx(v.get(i), d);
        i = i + 1;
    }
    return out;
}

fn maxerr(a: &CVec, b: &CVec) -> f64 {
    var e: f64 = 0.0;
    var i: i64 = 0;
    while i < a.re.len() {
        e = math_max_f64(e, math_fabs(a.re.get(i) - b.re.get(i)));
        e = math_max_f64(e, math_fabs(a.im.get(i) - b.im.get(i)));
        i = i + 1;
    }
    return e;
}

fn seq(n: i64) -> CVec {
    var x = dsp_cvec_zeros(n);
    var i: i64 = 0;
    while i < n {
        x.re.set(i, math_sin(0.7 * (i as f64)) + 0.25 * (i as f64));
        x.im.set(i, math_cos(1.3 * (i as f64)) - 0.5);
        i = i + 1;
    }
    return x;
}

fn tone(n: i64, f: f64) -> Vec<f64> {
    var v: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        v.push(math_sin(2.0 * dsp_pi() * f * (i as f64)));
        i = i + 1;
    }
    return v;
}

fn dtmf(f1: f64, f2: f64) -> str {
    var x: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < 205 {
        val t: f64 = (i as f64) / 8000.0;
        x.push(math_sin(2.0 * dsp_pi() * f1 * t) + math_sin(2.0 * dsp_pi() * f2 * t));
        i = i + 1;
    }
    var rows: Vec<f64> = Vec::new();
    rows.push(697.0);
    rows.push(770.0);
    rows.push(852.0);
    rows.push(941.0);
    var cols: Vec<f64> = Vec::new();
    cols.push(1209.0);
    cols.push(1336.0);
    cols.push(1477.0);
    cols.push(1633.0);
    var br: i64 = 0;
    var bc: i64 = 0;
    var k: i64 = 0;
    while k < 4 {
        if dsp_goertzel_power(&x, rows.get(k), 8000.0) > dsp_goertzel_power(&x, rows.get(br), 8000.0) {
            br = k;
        }
        if dsp_goertzel_power(&x, cols.get(k), 8000.0) > dsp_goertzel_power(&x, cols.get(bc), 8000.0) {
            bc = k;
        }
        k = k + 1;
    }
    val keys: str = "123A456B789C*0#D";
    return str_slice(keys, br * 4 + bc, br * 4 + bc + 1);
}

fn main() {
    var r8: Vec<f64> = Vec::new();
    var i: i64 = 1;
    while i <= 8 {
        r8.push(i as f64);
        i = i + 1;
    }
    val f8 = dsp_fft_real(&r8);
    println("fft8: " + cs(dsp_cvec_get(&f8, 0)) + " " + cs(dsp_cvec_get(&f8, 1)) + " " + cs(dsp_cvec_get(&f8, 2)) + " " + cs(dsp_cvec_get(&f8, 3)) + " " + cs(dsp_cvec_get(&f8, 4)));
    var r5: Vec<f64> = Vec::new();
    i = 1;
    while i <= 5 {
        r5.push(i as f64);
        i = i + 1;
    }
    val f5 = dsp_fft_real(&r5);
    println("fft5: " + cs(dsp_cvec_get(&f5, 0)) + " " + cs(dsp_cvec_get(&f5, 1)) + " " + cs(dsp_cvec_get(&f5, 2)) + " " + cs(dsp_cvec_get(&f5, 3)) + " " + cs(dsp_cvec_get(&f5, 4)));
    val x7 = seq(7);
    val x12 = seq(12);
    val e7: f64 = maxerr(&dsp_fft(&x7), &dsp_dft(&x7));
    val e12: f64 = maxerr(&dsp_fft(&x12), &dsp_dft(&x12));
    println("bluestein n=7 and n=12 match the direct DFT: " + bool_to_str(e7 < 0.000000001) + " " + bool_to_str(e12 < 0.000000001));
    val x16 = seq(16);
    val b12 = dsp_ifft(&dsp_fft(&x12));
    val b16 = dsp_ifft(&dsp_fft(&x16));
    println("ifft(fft(x)) == x for n=12 and n=16: " + bool_to_str(maxerr(&b12, &x12) < 0.000000000001) + " " + bool_to_str(maxerr(&b16, &x16) < 0.000000000001));

    println("hann5: " + row(&dsp_window(DSP_WIN_HANN, 5, false), 4));
    println("hann4 periodic: " + row(&dsp_window(DSP_WIN_HANN, 4, true), 4));
    println("hamming5: " + row(&dsp_window(DSP_WIN_HAMMING, 5, false), 4));
    println("blackman5: " + row(&dsp_window(DSP_WIN_BLACKMAN, 5, false), 4));
    println("flattop5: " + row(&dsp_window(DSP_WIN_FLATTOP, 5, false), 6));

    val h = dsp_fir_lowpass(21, 0.1, DSP_WIN_HAMMING);
    var one: Vec<f64> = Vec::new();
    one.push(1.0);
    var a0: Vec<f64> = Vec::new();
    println("fir lp 21 taps fc=0.1: center " + fx(h.get(10), 6) + " |H| " + fx(complex_abs(dsp_freq_response(&h, &one, 0.0)), 4) + " " + fx(complex_abs(dsp_freq_response(&h, &one, 0.1)), 4) + " " + fx(complex_abs(dsp_freq_response(&h, &one, 0.25)), 4) + " " + fx(complex_abs(dsp_freq_response(&h, &a0, 0.5)), 4));
    val hp = dsp_fir_highpass(21, 0.1, DSP_WIN_HAMMING);
    println("fir hp 21 taps fc=0.1: |H| " + fx(complex_abs(dsp_freq_response(&hp, &one, 0.0)), 4) + " " + fx(complex_abs(dsp_freq_response(&hp, &one, 0.1)), 4) + " " + fx(complex_abs(dsp_freq_response(&hp, &one, 0.25)), 4) + " " + fx(complex_abs(dsp_freq_response(&hp, &one, 0.5)), 4));
    // steady-state amplitude of filtered tones (the second half of 400 samples)
    val ylo = dsp_fir_filter(&h, &tone(400, 0.02));
    val yhi = dsp_fir_filter(&h, &tone(400, 0.3));
    var plo: f64 = 0.0;
    var phi: f64 = 0.0;
    i = 200;
    while i < 400 {
        plo = math_max_f64(plo, math_fabs(ylo.get(i)));
        phi = math_max_f64(phi, math_fabs(yhi.get(i)));
        i = i + 1;
    }
    println("fir lp filters a 0.02 tone at " + fx(plo, 4) + " and a 0.3 tone at " + fx(phi, 4));

    var lp = dsp_biquad_lowpass(48000.0, 1000.0, 1.0 / math_sqrt(2.0));
    println("rbj lpf b=" + fx(lp.b0, 7) + " " + fx(lp.b1, 7) + " " + fx(lp.b2, 7) + " a=" + fx(lp.a1, 7) + " " + fx(lp.a2, 7));
    val db0: f64 = dsp_db(Biquad_magnitude(&lp, 48000.0, 1000.0));
    var y: f64 = 0.0;
    i = 0;
    while i < 2000 {
        y = Biquad_process(&mut lp, 1.0);
        i = i + 1;
    }
    println("rbj lpf |H(f0)| = " + fx(db0, 4) + " dB, DC gain after a step " + fx(y, 6));
    val pk = dsp_biquad_peaking(48000.0, 2000.0, 1.0, 6.0);
    val nt = dsp_biquad_notch(48000.0, 2000.0, 2.0);
    println("peaking +6 dB at f0: " + fx(dsp_db(Biquad_magnitude(&pk, 48000.0, 2000.0)), 4) + " dB, notch at f0: " + fx(Biquad_magnitude(&nt, 48000.0, 2000.0), 6));
    val ls = dsp_biquad_lowshelf(48000.0, 500.0, 0.7071, 6.0);
    val hs = dsp_biquad_highshelf(48000.0, 5000.0, 0.7071, -6.0);
    println("low shelf +6 at DC: " + fx(dsp_db(Biquad_magnitude(&ls, 48000.0, 0.0)), 4) + " dB, high shelf -6 at Nyquist: " + fx(dsp_db(Biquad_magnitude(&hs, 48000.0, 24000.0)), 4) + " dB");
    val ap = dsp_biquad_allpass(48000.0, 3000.0, 0.9);
    println("allpass |H| at 300 Hz and 9 kHz: " + fx(Biquad_magnitude(&ap, 48000.0, 300.0), 6) + " " + fx(Biquad_magnitude(&ap, 48000.0, 9000.0), 6));

    // 10 cycles of 50 Hz at 5 kHz
    var s: Vec<f64> = Vec::new();
    var sig: Vec<f64> = Vec::new();
    i = 0;
    while i < 1000 {
        val wt: f64 = 2.0 * dsp_pi() * 50.0 * (i as f64) / 5000.0;
        s.push(2.0 * math_sin(wt));
        sig.push(0.5 + math_sin(wt) + 0.1 * math_sin(3.0 * wt) + 0.05 * math_sin(5.0 * wt + 0.3));
        i = i + 1;
    }
    println("rms of 2 sin: " + fx(dsp_rms(&s), 6));
    val hm = dsp_harmonics(&sig, 5000.0, 50.0, 5);
    println("harmonics: dc " + fx(hm.get(0), 4) + " h1 " + fx(hm.get(1), 4) + " h2 " + fx(hm.get(2), 4) + " h3 " + fx(hm.get(3), 4) + " h4 " + fx(hm.get(4), 4) + " h5 " + fx(hm.get(5), 4));
    println("thd = " + fx(dsp_thd(&hm), 6));
    println("goertzel bin 3 of fft8 input: " + cs(dsp_goertzel(&r8, 3.0, 8.0)));
    println("dtmf: " + dtmf(770.0, 1336.0) + " " + dtmf(941.0, 1477.0));
    var ca: Vec<f64> = Vec::new();
    ca.push(1.0);
    ca.push(2.0);
    ca.push(3.0);
    var cb: Vec<f64> = Vec::new();
    cb.push(0.0);
    cb.push(1.0);
    cb.push(0.5);
    println("convolve: " + row(&dsp_convolve(&ca, &cb), 4));
}
