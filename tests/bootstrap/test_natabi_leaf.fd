// test_natabi_leaf.fd — llvm WP8: on the machine layer a function that calls
// nothing, cannot panic and keeps nothing on the stack runs without a
// frame: no prologue, its epilogue only the return (compiler/nat_ir.fd
// ng_leaf_ok; `FID_NAT_OFF=leaf` to compare). Before Nov 16 it never
// fired: the allocator's frame is at least 16 bytes, and that was tested.
// The results do not change: every backend prints the same.
//
// Expected output:
// 7
// 12
// 255
// 1
// 2
// 28
// 4

@wrapping
fn add3(a: i64, b: i64, c: i64) -> i64 {
    return a + b + c;
}

@wrapping
fn mul_add(a: i64, b: i64, c: i64) -> i64 {
    return a * b + c;
}

fn bits(x: i64) -> i64 {
    return (x & 255) | 15;
}

fn pick(c: bool, a: i64, b: i64) -> i64 {
    if c {
        return a;
    }
    return b;
}

/// A loop whose locals live in registers: still a leaf
@wrapping
fn sum_to(n: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 1;
    while i <= n {
        s = s + i;
        i = i + 1;
    }
    return s;
}

/// Can panic (overflow check): keeps its frame for the trace
fn checked_add(a: i64, b: i64) -> i64 {
    return a + b;
}

fn main() {
    println(add3(1, 2, 4));
    println(mul_add(2, 5, 2));
    println(bits(240));
    println(pick(true, 1, 2));
    println(pick(false, 1, 2));
    println(sum_to(7));
    println(checked_add(1, 3));
}
