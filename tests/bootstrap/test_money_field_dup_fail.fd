// expect-error: was already consumed
// Test: moving a Money out of a field consumes that field: using
// w.balance twice would duplicate the money in the wallet.
use money;

@linear
struct Wallet { id: i64, balance: Money }

@conserve
fn dup(w: Wallet) -> Money {
    return Money_add(w.balance, w.balance);
}

fn main() -> i64 {
    val w = Wallet { id: 1, balance: Money_new(100) };
    print(Money_to_cents(dup(w)));
    return 0;
}
