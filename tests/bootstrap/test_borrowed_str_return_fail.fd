// expect-error: returns a borrowed string (&str) as an owned str
// A string of a @scoped struct belongs to it: returning it as an owned str
// would outlive the struct (release M11). str_clone(m.text) is the fix.

@scoped
struct Msg {
    text: str,
}

fn leak(m: Msg) -> str {
    return m.text;
}

fn main() {
    val m: Msg = Msg { text: "a" };
    println(leak(m));
}
