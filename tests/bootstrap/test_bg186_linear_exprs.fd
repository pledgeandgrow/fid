// Bugs roadmap BG186: an enum literal and an f-string consume what they
// hold, once; a `val t` declared again after the first `t` was consumed
// starts unconsumed (it looked consumed already).
//
// Expected output:
// 1
// 2
// 3

@linear
struct Tok {
    v: i64,
}

fn use_tok(t: Tok) -> i64 {
    return t.v;
}

fn main() -> i64 {
    val t = Tok { v: 1 };
    val o: Option<Tok> = Option::Some(t);
    match o {
        Option::Some(x) => {
            println(use_tok(x));
        }
        Option::None => {
        }
    }
    val u = Tok { v: 2 };
    println(f"{use_tok(u)}");
    val w = Tok { v: 5 };
    println(use_tok(w) - 2);
    val w = Tok { v: 9 };
    val k: i64 = use_tok(w);
    if k > 100 {
        println(k);
    }
    return 0;
}
