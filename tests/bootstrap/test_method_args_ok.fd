// Bugs roadmap BG18: method and associated function calls have their
// arguments checked; these stay accepted: a value auto-borrowed for
// `&mut self`, a narrower integer, a Vec, a string, an associated function
// and a generic impl's method on an instance (Option<i64>.unwrap_or).
// Expected output:
// total 10
// 7
struct Acc {
    total: i64,
}

impl Acc {
    fn make(start: i64) -> Acc {
        return Acc { total: start };
    }

    fn add(self: &mut Acc, n: i64) {
        self.total = self.total + n;
    }

    fn add_all(self: &mut Acc, xs: Vec<i64>) {
        for x in xs {
            self.total = self.total + x;
        }
    }

    fn name(self: Acc, prefix: str) -> str {
        return prefix + int_to_str(self.total);
    }
}

fn main() -> i64 {
    var a: Acc = Acc::make(1);
    a.add(2);
    val small: u8 = 3;
    a.add(small);
    var xs: Vec<i64> = Vec::new();
    xs.push(4);
    a.add_all(xs);
    println(a.name("total "));
    val o: Option<i64> = Option::Some(7);
    println(int_to_str(o.unwrap_or(0)));
    return 0;
}
