// expect-error: the literal does not fit in i8
// Bugs roadmap BG287: `w.set(0, 200)` on a Vec<i8> stored -56 (as
// `w.push(200)` did); `insert` stores its second argument the same way.
fn main() -> i64 {
    var w: Vec<i8> = Vec::new();
    w.push(1);
    w.set(0, 200);
    println(w[0]);
    return 0;
}
