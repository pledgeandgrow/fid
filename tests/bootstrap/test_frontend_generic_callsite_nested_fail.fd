// expect-error: (line 22, in 'main'): 'outer_x' is called with V = str, but str has no field 'x', which the body of 'outer_x' needs.
// CE9: a generic function that hands its own type parameter to another
// generic function needs what that one needs: the call that chooses the
// type, two levels up, is the one reported.

struct Pt {
    x: i64,
}

fn inner_x<T>(v: T) -> i64 {
    return v.x;
}

fn outer_x<V>(v: V) -> i64 {
    // V is passed on: inner_x reads its field x
    return inner_x(v);
}

fn main() -> i64 {
    println(outer_x(Pt { x: 3 }));
    val s: str = "seven";
    println(outer_x(s));
    return 0;
}
