// BG303 (docs/roadmap/bugs-roadmap.md): a HashMap in an f-string shows as
// println shows it (it printed the map handle's address).
//
// Expected output:
// {5: 5}
// x {5: 5}
// [{5: 5}]

fn main() {
    var m: HashMap<i64, i64> = HashMap::new();
    m.insert(5, 5);
    println(m);
    println(f"x {m}");
    println(f"[{m:>6}]");
}
