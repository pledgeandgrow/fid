// Bugs roadmap BG154: HashMap and Vec method arguments of the right types
// stay accepted (the negative cases: test_bg154_*_fail.fd).
//
// Expected output:
// 3
// 9
// true
// false
// 1
// 2
// x a
// true
// 1

fn main() -> i64 {
    var m: HashMap<str, i64> = HashMap::new();
    m.insert("a", 3);
    m.insert("b", 4);
    println(m.get("a"));
    println(m.get_or("z", 9));
    println(m.contains("b"));
    m.remove("b");
    println(m.contains("b"));
    println(m.len());
    var n: HashMap<i64, Option<i64>> = HashMap::new();
    n.insert(1, Option::None);
    n.insert(2, Option::Some(5));
    println(n.len());
    var v: Vec<str> = Vec::new();
    v.push("a");
    v.insert(0, "x");
    println(v.get(0) + " " + v.get(1));
    println(v.contains("a"));
    v.remove(0);
    println(v.len());
    return 0;
}
