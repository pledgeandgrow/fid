// Branches of `parallel {}` run at the same time (release H7): `x = f(..)`
// is spawned and x takes the result at the join; a branch of several
// statements runs as a function of its own on its own thread. Only one
// branch prints, so the output does not depend on scheduling.

fn fib(n: i64) -> i64 {
    if n < 2 { return n; }
    return fib(n - 1) + fib(n - 2);
}

fn main() {
    var a: i64 = 0;
    var b: i64 = 0;
    val n: i64 = 20;
    parallel {
        | a = fib(n);
        | b = fib(n + 1);
        | val k: i64 = n * 2;
          println("branch " + int_to_str(k));
    }
    println(a);
    println(b);
    println(a + b);
}
