// expect-error: returns early inside a closure
// Bugs roadmap BG374: an early `return` inside a closure of a
// @constant_time function was not looked for.
@constant_time
@wrapping
fn f(a: i64, b: i64) -> i64 {
    val g = fn(x: i64) -> i64 {
        if x > 3 {
            return 1;
        }
        return 0;
    };
    return g(a) + b;
}
fn main() {
    println(f(5, 1));
}
