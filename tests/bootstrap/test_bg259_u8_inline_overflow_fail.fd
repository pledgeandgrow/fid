// expect-error: Integer overflow on addition
// Bugs roadmap BG259: on the machine layer (`emit --nat`) the inliner mapped
// a u8 parameter to the call's I64 literal 200 and the e-graph folded the
// body's `200 + 100` at 64 bits: `a4(200)` printed 300 with no overflow
// panic. run, ccompile and emit panic.
fn a4(x: u8) -> u8 {
    val y: u8 = x + 100;
    return y;
}
fn main() {
    println(f"a4 {a4(200)}");
}
