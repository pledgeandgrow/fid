// Test: @audit annotation (Phase F33)
// Functions marked @audit emit log calls at entry and exit.

@audit
fn audited_add(a: i64, b: i64) -> i64 {
    return a + b;
}

@audit
fn audited_greet(name: str) -> void {
    print("Hello, ");
    print(name);
    print("!\n");
}

// Non-audited function for comparison
fn plain_mul(a: i64, b: i64) -> i64 {
    return a * b;
}

fn main() {
    print("=== Start ===\n");
    val r = audited_add(3, 4);
    print("Result: ");
    print(r);
    print("\n");

    audited_greet("Fides");

    val r2 = plain_mul(5, 6);
    print("Plain result: ");
    print(r2);
    print("\n");
    print("=== End ===\n");
}
