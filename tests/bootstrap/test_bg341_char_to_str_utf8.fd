// Bugs roadmap BG341: `char_to_str` and `StringBuilder.append_char` of a
// character literal above 255 kept only its low byte (stdlib/core.fd, both
// through p_char_to_str, which stores `c & 255`): char_to_str('€') was the
// byte 0xAC. A value above 255 is now its UTF-8 encoding (a surrogate or a
// value past U+10FFFF is U+FFFD); 0..255 stays the one byte of that value,
// which callers use to build UTF-8 and binary strings byte by byte.
//
// Expected output:
// 8364 3 226 true
// 3 true
// 4 true
// 3 239 191 189
// 3 239
// 2 true
// 1 65

fn main() {
    val e: i64 = '€';
    val s: str = char_to_str(e);
    println(f"{e} {str_len(s)} {str_byte_at(s, 0)} {s == "€"}");
    var sb = StringBuilder::new();
    sb.append_char('€');
    val t: str = sb.to_str();
    println(f"{sb.len()} {t == "€"}");
    val g: str = char_to_str(128512);
    println(f"{str_len(g)} {g == "😀"}");
    val sur: str = char_to_str(55296);
    println(f"{str_len(sur)} {str_byte_at(sur, 0)} {str_byte_at(sur, 1)} {str_byte_at(sur, 2)}");
    val big: str = char_to_str(1114112);
    println(f"{str_len(big)} {str_byte_at(big, 0)}");
    var sb2 = StringBuilder::new();
    sb2.append_char(195);
    sb2.append_char(169);
    println(f"{sb2.len()} {sb2.to_str() == "é"}");
    val a: str = char_to_str(65);
    println(f"{str_len(a)} {str_byte_at(a, 0)}");
}
