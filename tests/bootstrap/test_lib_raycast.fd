// stdlib/raycast: 2D rays against boxes, circles and segments, 3D rays
// against boxes, spheres, planes and triangles, and points along a ray.
// Rays are axis aligned and distances are whole numbers so the results
// are exact. Each hit prints: hit t point normal.
use raycast;

// adding 0.0 turns -0.0 into 0.0 so the output is the same everywhere
fn pf(x: f64) {
    print(x + 0.0);
    print(" ");
}

fn h2(h: RayHit2D) {
    print(h.hit);
    print(" ");
    pf(h.t);
    pf(h.point.x);
    pf(h.point.y);
    pf(h.normal.x);
    pf(h.normal.y);
    println("");
}

fn h3(h: RayHit3D) {
    print(h.hit);
    print(" ");
    pf(h.t);
    pf(h.point.x);
    pf(h.point.y);
    pf(h.point.z);
    pf(h.normal.x);
    pf(h.normal.y);
    pf(h.normal.z);
    println("");
}

fn main() -> i64 {
    // the direction is normalised when the ray is made
    var r0 = ray2d_create(vec2(0.0, 0.0), vec2(3.0, 0.0));
    pf(r0.direction.x);
    pf(r0.direction.y);
    println("");

    // 2D box (10,-5)-(20,5)
    var east = ray2d_create(vec2(0.0, 0.0), vec2(1.0, 0.0));
    h2(ray2d_vs_aabb(east, 10.0, -5.0, 20.0, 5.0));
    // starting inside the box: t = 0
    var inside = ray2d_create(vec2(15.0, 0.0), vec2(1.0, 0.0));
    h2(ray2d_vs_aabb(inside, 10.0, -5.0, 20.0, 5.0));
    // box behind the ray
    var west = ray2d_create(vec2(0.0, 0.0), vec2(-1.0, 0.0));
    h2(ray2d_vs_aabb(west, 10.0, -5.0, 20.0, 5.0));
    // parallel to the box but above it
    var above = ray2d_create(vec2(0.0, 10.0), vec2(1.0, 0.0));
    h2(ray2d_vs_aabb(above, 10.0, -5.0, 20.0, 5.0));
    // from below, into the min-y face; from the right, into the max-x face
    var up = ray2d_create(vec2(15.0, -20.0), vec2(0.0, 1.0));
    h2(ray2d_vs_aabb(up, 10.0, -5.0, 20.0, 5.0));
    var left = ray2d_create(vec2(30.0, 0.0), vec2(-1.0, 0.0));
    h2(ray2d_vs_aabb(left, 10.0, -5.0, 20.0, 5.0));

    // 2D circle at (10,0) radius 2
    h2(ray2d_vs_circle(east, 10.0, 0.0, 2.0));
    var in_c = ray2d_create(vec2(10.0, 0.0), vec2(1.0, 0.0));
    h2(ray2d_vs_circle(in_c, 10.0, 0.0, 2.0));
    var past = ray2d_create(vec2(20.0, 0.0), vec2(1.0, 0.0));
    h2(ray2d_vs_circle(past, 10.0, 0.0, 2.0));
    var graze = ray2d_create(vec2(0.0, 2.0), vec2(1.0, 0.0));
    h2(ray2d_vs_circle(graze, 10.0, 0.0, 2.0));
    var wide = ray2d_create(vec2(0.0, 3.0), vec2(1.0, 0.0));
    h2(ray2d_vs_circle(wide, 10.0, 0.0, 2.0));

    // 2D segment: a vertical wall at x = 5 from y = -5 to 5
    h2(ray2d_vs_segment(east, 5.0, -5.0, 5.0, 5.0));
    h2(ray2d_vs_segment(east, -5.0, -5.0, -5.0, 5.0));
    h2(ray2d_vs_segment(east, 5.0, 1.0, 5.0, 5.0));
    h2(ray2d_vs_segment(east, 5.0, 1.0, 9.0, 1.0));

    // points along a ray
    var p2 = ray2d_at(east, 7.0);
    pf(p2.x);
    pf(p2.y);
    println("");

    // 3D box (1,1,1)-(3,3,3)
    var ex = ray3d_create(vec3(0.0, 2.0, 2.0), vec3(1.0, 0.0, 0.0));
    h3(ray3d_vs_aabb(ex, 1.0, 1.0, 1.0, 3.0, 3.0, 3.0));
    var dz = ray3d_create(vec3(2.0, 2.0, 10.0), vec3(0.0, 0.0, -1.0));
    h3(ray3d_vs_aabb(dz, 1.0, 1.0, 1.0, 3.0, 3.0, 3.0));
    var dy = ray3d_create(vec3(2.0, 10.0, 2.0), vec3(0.0, -1.0, 0.0));
    h3(ray3d_vs_aabb(dy, 1.0, 1.0, 1.0, 3.0, 3.0, 3.0));
    var high = ray3d_create(vec3(0.0, 5.0, 2.0), vec3(1.0, 0.0, 0.0));
    h3(ray3d_vs_aabb(high, 1.0, 1.0, 1.0, 3.0, 3.0, 3.0));

    // 3D sphere at (0,0,5) radius 1
    var fwd = ray3d_create(vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 1.0));
    h3(ray3d_vs_sphere(fwd, vec3(0.0, 0.0, 5.0), 1.0));
    var from_c = ray3d_create(vec3(0.0, 0.0, 5.0), vec3(0.0, 0.0, 1.0));
    h3(ray3d_vs_sphere(from_c, vec3(0.0, 0.0, 5.0), 1.0));
    var beyond = ray3d_create(vec3(0.0, 0.0, 10.0), vec3(0.0, 0.0, 1.0));
    h3(ray3d_vs_sphere(beyond, vec3(0.0, 0.0, 5.0), 1.0));
    var offset = ray3d_create(vec3(0.0, 3.0, 0.0), vec3(0.0, 0.0, 1.0));
    h3(ray3d_vs_sphere(offset, vec3(0.0, 0.0, 5.0), 1.0));

    // 3D plane y = 5
    var rise = ray3d_create(vec3(0.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0));
    h3(ray3d_vs_plane(rise, vec3(0.0, 1.0, 0.0), 5.0));
    var flat = ray3d_create(vec3(0.0, 0.0, 0.0), vec3(1.0, 0.0, 0.0));
    h3(ray3d_vs_plane(flat, vec3(0.0, 1.0, 0.0), 5.0));
    var sink = ray3d_create(vec3(0.0, 0.0, 0.0), vec3(0.0, -1.0, 0.0));
    h3(ray3d_vs_plane(sink, vec3(0.0, 1.0, 0.0), 5.0));

    // 3D triangle (0,0,0) (4,0,0) (0,4,0)
    var v0 = vec3(0.0, 0.0, 0.0);
    var v1 = vec3(4.0, 0.0, 0.0);
    var v2 = vec3(0.0, 4.0, 0.0);
    var down = ray3d_create(vec3(1.0, 1.0, 5.0), vec3(0.0, 0.0, -1.0));
    h3(ray3d_vs_triangle(down, v0, v1, v2));
    var outside = ray3d_create(vec3(3.0, 3.0, 5.0), vec3(0.0, 0.0, -1.0));
    h3(ray3d_vs_triangle(outside, v0, v1, v2));
    var under = ray3d_create(vec3(1.0, 1.0, -5.0), vec3(0.0, 0.0, -1.0));
    h3(ray3d_vs_triangle(under, v0, v1, v2));
    var along = ray3d_create(vec3(-5.0, 1.0, 0.0), vec3(1.0, 0.0, 0.0));
    h3(ray3d_vs_triangle(along, v0, v1, v2));

    var p3 = ray3d_at(down, 2.0);
    pf(p3.x);
    pf(p3.y);
    pf(p3.z);
    println("");
    return 0;
}
