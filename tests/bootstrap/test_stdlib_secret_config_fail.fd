// expect-error: in 'main', a secret value is passed to 'show', which outputs its parameter 'value'
// Expected to FAIL (complaint CO1): config_secret's result is @secret; a
// helper that prints its argument cannot be given it.
use config;

fn show(label: str, value: str) {
    print(label + "=" + value + "\n");
}

fn main() -> i64 {
    var c: Config = config_new();
    config_opt(& mut c, "api_key", CONFIG_STR, "k-123");
    config_load(& mut c, "", "FIDES_TEST_CO1_");
    show("api_key", config_secret(c, "api_key"));
    return 0;
}
