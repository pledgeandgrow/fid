// WP19 (compiler/iropt.fd iro_fold_identical, FID_IROPT_ON=icf): calls to
// a function whose IR is the same as an earlier function's go to the
// earlier one. clamp_a and clamp_b have the same body and are folded;
// clamp_c differs in one constant and count_down calls itself, so neither
// is folded with anything. The program prints the same with the pass on
// and off.
//
// Expected output:
// 0
// 5
// 10
// 0
// 7
// 10
// 0
// 5
// 11
// 6

fn clamp_a(x: i64) -> i64 {
    if x < 0 {
        return 0;
    }
    if x > 10 {
        return 10;
    }
    return x;
}

fn clamp_b(x: i64) -> i64 {
    if x < 0 {
        return 0;
    }
    if x > 10 {
        return 10;
    }
    return x;
}

fn clamp_c(x: i64) -> i64 {
    if x < 0 {
        return 0;
    }
    if x > 11 {
        return 11;
    }
    return x;
}

fn count_down(n: i64) -> i64 {
    if n <= 0 {
        return 0;
    }
    return 1 + count_down(n - 1);
}

fn main() {
    println(clamp_a(0 - 4));
    println(clamp_a(5));
    println(clamp_a(40));
    println(clamp_b(0 - 1));
    println(clamp_b(7));
    println(clamp_b(12));
    println(clamp_c(0 - 9));
    println(clamp_c(5));
    println(clamp_c(12));
    println(count_down(6));
}
