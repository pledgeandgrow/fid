// WP19 (compiler/iropt.fd iro_fold_identical, `icf`, on by default since
// Nov 21; FID_IROPT_OFF=icf turns it off): calls to a function whose IR is
// the same as an earlier function's go to the earlier one. mix_a and mix_b
// have the same body — over inline2's callee budget (60 instructions), so
// the default inliner leaves their calls for icf — and are folded; mix_c
// differs in one constant and count_down calls itself, so neither is
// folded with anything. The program prints the same with the pass on and
// off.
//
// Expected output:
// -446168529276956
// 721548511738669
// 5262670337910544
// -446168529276956
// 721548511738669
// 5262670337910544
// -1094900218730071
// 721548511738679
// 1629772876973054
// 6

fn mix_a(x: i64) -> i64 {
    var t: i64 = x;
    t = t * 3 + 1;
    t = t * 5 + 2;
    t = t * 3 + 3;
    t = t * 5 + 4;
    t = t * 3 + 5;
    t = t * 5 + 6;
    t = t * 3 + 7;
    t = t * 5 + 8;
    t = t * 3 + 9;
    t = t * 5 + 10;
    t = t * 3 + 11;
    t = t * 5 + 12;
    t = t * 3 + 13;
    t = t * 5 + 14;
    t = t * 3 + 15;
    t = t * 5 + 16;
    t = t * 3 + 17;
    t = t * 5 + 18;
    t = t * 3 + 19;
    t = t * 5 + 20;
    t = t * 3 + 21;
    t = t * 5 + 22;
    t = t * 3 + 23;
    t = t * 5 + 24;
    return t;
}

fn mix_b(x: i64) -> i64 {
    var t: i64 = x;
    t = t * 3 + 1;
    t = t * 5 + 2;
    t = t * 3 + 3;
    t = t * 5 + 4;
    t = t * 3 + 5;
    t = t * 5 + 6;
    t = t * 3 + 7;
    t = t * 5 + 8;
    t = t * 3 + 9;
    t = t * 5 + 10;
    t = t * 3 + 11;
    t = t * 5 + 12;
    t = t * 3 + 13;
    t = t * 5 + 14;
    t = t * 3 + 15;
    t = t * 5 + 16;
    t = t * 3 + 17;
    t = t * 5 + 18;
    t = t * 3 + 19;
    t = t * 5 + 20;
    t = t * 3 + 21;
    t = t * 5 + 22;
    t = t * 3 + 23;
    t = t * 5 + 24;
    return t;
}

fn mix_c(x: i64) -> i64 {
    var t: i64 = x;
    t = t * 3 + 1;
    t = t * 5 + 2;
    t = t * 3 + 3;
    t = t * 5 + 4;
    t = t * 3 + 5;
    t = t * 5 + 6;
    t = t * 3 + 7;
    t = t * 5 + 8;
    t = t * 3 + 9;
    t = t * 5 + 10;
    t = t * 3 + 11;
    t = t * 5 + 12;
    t = t * 3 + 13;
    t = t * 5 + 14;
    t = t * 3 + 15;
    t = t * 5 + 16;
    t = t * 3 + 17;
    t = t * 5 + 18;
    t = t * 3 + 19;
    t = t * 5 + 20;
    t = t * 3 + 21;
    t = t * 5 + 22;
    t = t * 3 + 25;
    t = t * 5 + 24;
    return t;
}

fn count_down(n: i64) -> i64 {
    if n <= 0 {
        return 0;
    }
    return 1 + count_down(n - 1);
}

fn main() {
    println(mix_a(0 - 4));
    println(mix_a(5));
    println(mix_a(40));
    println(mix_b(0 - 4));
    println(mix_b(5));
    println(mix_b(40));
    println(mix_c(0 - 9));
    println(mix_c(5));
    println(mix_c(12));
    println(count_down(6));
}
