// expect-error: async fn 'a9' has 9 parameters; an async function runs as a task, which takes at most 8 arguments
//! error: async fn 'a9' has 9 parameters
// Bugs roadmap BG159: an async function runs as a task started by name
// (p_co_async), whose block keeps at most 8 arguments on every compiled
// backend: `fid run` printed 936, emit 536877147236, --nat garbage and C
// panicked "task: a function started by name takes at most 8 arguments".
// Now refused at its declaration (TypeChecker_check_async_arity).
async fn a9(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64) -> Future<i64> {
    return a + b + c + d + e + f + g + h + i * 100;
}

fn main() -> i64 {
    println(await a9(1, 2, 3, 4, 5, 6, 7, 8, 9));
    return 0;
}
