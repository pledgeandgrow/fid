// BG55 (docs/roadmap/bugs-roadmap.md): the machine layer's overflow
// checks of i64 add, sub and mul (compiler/nat_ir.fd ng_gen_checked) kept
// a value in g.ad, the address scratch register, from one MIR instruction
// to the next. A spill reload with a far frame offset (RISC-V, AArch64)
// computes its address in that register, so a reload between the two
// instructions could overwrite it: a missed or a false overflow. Now the
// third scratch is a fresh vreg the allocator sees. Sixteen values stay
// live across checked operations near the ends of i64 here (none
// overflows), so some are spilled while the checks run.
//
// Expected output:
// 4611686018427387946 4611686018427387874 -110
// 4611686018427387966 -41
// 9223372030926249001 9223372036854775681 -9223372036854775751
// 216

fn spread(n: i64) {
    val a: i64 = n + 1;
    val b: i64 = n + 2;
    val c: i64 = n + 3;
    val d: i64 = n + 4;
    val e: i64 = n + 5;
    val f: i64 = n + 6;
    val g: i64 = n + 7;
    val h: i64 = n + 8;
    val i: i64 = n + 9;
    val j: i64 = n + 10;
    val k: i64 = n + 11;
    val l: i64 = n + 12;
    val m: i64 = n + 13;
    val o: i64 = n + 14;
    val p: i64 = n + 15;
    val q: i64 = n + 16;
    val big: i64 = 4611686018427387904;
    val x1: i64 = big + a * b;
    val x2: i64 = x1 - c * d;
    val x3: i64 = (e * f) * (g - h);
    val x4: i64 = big - i * j + k * l;
    val x5: i64 = (m - o) * (p + q);
    val r: i64 = 3037000499 + n - n;
    val y: i64 = r * r;
    val z: i64 = 9223372036854775807 - a * q;
    val w: i64 = 0 - 9223372036854775807 + b * c;
    print(x1);
    print(" ");
    print(x2);
    print(" ");
    println(x3);
    print(x4);
    print(" ");
    println(x5);
    print(y);
    print(" ");
    print(z);
    print(" ");
    println(w);
    println(a + b + c + d + e + f + g + h + i + j + k + l + m + o + p + q);
}

fn main() -> i64 {
    spread(5);
    return 0;
}
