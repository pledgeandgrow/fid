// expect-error: @redundant function 'bump' takes 'v' by mutable reference. (line 7)
//! error: @redundant function 'bump' takes 'v' by mutable reference. (line 7)
// TL2: a test per diagnostic of the type, borrow and escape checks.
// Both channels run on the same arguments: one would see the other's writes.

@redundant
fn bump(v: &mut i64) -> i64 { // <- here
    *v = *v + 1;
    return *v;
}

fn main() -> i64 {
    var x: i64 = 1;
    println(bump(&mut x));
    return 0;
}
