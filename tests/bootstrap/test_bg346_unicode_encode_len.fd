// Bugs roadmap BG346: stdlib/unicode.fd uni_encode_cp wrote a surrogate
// (U+D800 -> ED A0 80) and values past U+10FFFF (0x110000 -> F4 90 80 80,
// 0x200000 and up a 0xF8 lead byte) as bytes the module's own decoder
// rejects; uni_len stepped by the lead byte without validating, so it
// disagreed with uni_to_codepoints on invalid input. Each is now U+FFFD,
// and uni_len counts what uni_to_codepoints decodes.
//
// Expected output:
// 3 3
// 1 1
// 1 65533
// 1 65533
// 1 65533
// 3 true
// 3 3
// 4 1 1 1114111

use unicode;

fn main() {
    var v: Vec<i64> = Vec::new();
    v.push(128);
    v.push(128);
    v.push(97);
    val bad: str = str_from_bytes(v);
    println(f"{uni_len(bad)} {uni_to_codepoints(bad).len()}");
    println(f"{uni_to_codepoints(uni_encode_cp(1114112)).len()} {uni_to_codepoints(uni_encode_cp(55296)).len()}");
    println(f"{uni_to_codepoints(uni_encode_cp(55296)).len()} {uni_to_codepoints(uni_encode_cp(55296)).get(0)}");
    println(f"{uni_to_codepoints(uni_encode_cp(1114112)).len()} {uni_to_codepoints(uni_encode_cp(1114112)).get(0)}");
    println(f"{uni_to_codepoints(uni_encode_cp(2097152)).len()} {uni_to_codepoints(uni_encode_cp(2097152)).get(0)}");
    val ok: str = uni_encode_cp(8364);
    println(f"{str_len(ok)} {ok == "€"}");
    var t: Vec<i64> = Vec::new();
    t.push(97);
    t.push(226);
    t.push(130);
    val trunc: str = str_from_bytes(t);
    println(f"{uni_len(trunc)} {uni_to_codepoints(trunc).len()}");
    val e: str = uni_encode_cp(1114111);
    println(f"{str_len(e)} {uni_len(e)} {uni_to_codepoints(e).len()} {uni_to_codepoints(e).get(0)}");
}
