// Bugs roadmap BG78: a `select` case's variable with the name of an outer
// variable was stored into that variable (compiler/lower.fd
// Lowerer_lower_select_stmt took the existing slot of the name): the
// select changed the outer `x`. The case's variable is a new one now,
// seen in the case's body only, as a match arm's binding.
//
// Expected output:
// 7
// 5
// 13
// 5
// 21

use channel;

fn main() -> i64 {
    val ch = channel_create(1);
    var x: i64 = 5;
    channel_send(ch, 7);
    select {
        case ch => x => { println(x); }
        default => { println(0); }
    }
    println(x);
    var sum: i64 = 0;
    var i: i64 = 1;
    while i <= 2 {
        channel_send(ch, i + 5);
        select {
            case ch => x => { sum = sum + x; }
            default => { sum = sum + 1000; }
        }
        i = i + 1;
    }
    println(sum);
    println(x);
    println(sum + 8);
    return 0;
}
