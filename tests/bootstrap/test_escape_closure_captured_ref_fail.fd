// expect-error: a closure returns a reference to 'a', its own copy of a captured variable
// BG138: a closure returning `&a` of a variable it captures. Captures are
// by value, so `&a` points into the closure's own copy, freed when the call
// returns: `*f()` read a dead value (printed 0, not 41).
fn main() {
    var a: i64 = 41;
    val f = fn() -> &i64 => &a;
    println(int_to_str(*f()));
}
