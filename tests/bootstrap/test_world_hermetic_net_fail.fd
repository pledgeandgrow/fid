// expect-error: Hermetic error: 'test_ping' is @hermetic but reaches the network directly: 'Probe.connect' calls 'p_net_connect' (effect Net), on the path test_ping -> Probe.connect
// Complaint CT1: a @hermetic test may use the network only through what
// stdlib/world fakes (http_client). `Probe::connect` opens a socket
// itself (p_net_connect): world_no_network() would not stop it. The
// search follows the static method call `Probe::connect(..)`.
use world;

struct Probe {
    fd: i64,
}

impl Probe {
    fn connect(host: str, port: i64) -> Probe {
        return Probe { fd: p_net_connect(host, port) };
    }
}

@hermetic
fn test_ping() -> i64 {
    world_no_network();
    val p: Probe = Probe::connect("127.0.0.1", 9);
    println(int_to_str(p.fd));
    return 0;
}

fn main() -> i64 {
    return test_ping();
}
