// BG401 (docs/roadmap/bugs-roadmap.md): physics rays and circle distances
// used a 10-step Newton square root started at x = d, far from converged
// for d over ~1000: a (1000, 0) direction was "normalized" to 0.77, hit
// distances came out scaled (500 reported as 648), circles 1000 apart were
// 1296 apart, and a tangent ray (discriminant 0) computed 0/0 = NaN and
// missed. They use math_sqrt now (as raycast.fd does).
//
// Expected output:
// 1
// 0
// 500
// 800
// 10
// 1000
// 5
// 0
// 0.6
// 0.8
// -1
use physics;

fn main() {
    val r = physics_ray_new(0.0, 0.0, 1000.0, 0.0, 10000.0);
    println(r.dir_x);
    println(r.dir_y);
    println(physics_ray_vs_aabb(r, physics_aabb_new(500.0, -10.0, 100.0, 20.0)));
    val u = physics_ray_new(0.0, 0.0, 1.0, 0.0, 10000.0);
    println(physics_ray_vs_circle(u, physics_circle_new(1000.0, 0.0, 200.0)));
    // tangent: the ray along y = 0 grazes the circle at (10, 0)
    println(physics_ray_vs_circle(u, physics_circle_new(10.0, 5.0, 5.0)));
    println(physics_circle_distance(physics_circle_new(0.0, 0.0, 1.0), physics_circle_new(1000.0, 0.0, 1.0)));
    println(physics_circle_distance(physics_circle_new(0.0, 0.0, 1.0), physics_circle_new(3.0, 4.0, 1.0)));
    println(physics_circle_distance(physics_circle_new(2.0, 2.0, 1.0), physics_circle_new(2.0, 2.0, 1.0)));
    val d = physics_ray_new(0.0, 0.0, 3000.0, 4000.0, 10.0);
    println(d.dir_x);
    println(d.dir_y);
    // the hit at 500 lies past max_dist 100
    println(physics_ray_vs_aabb(physics_ray_new(0.0, 0.0, 1000.0, 0.0, 100.0), physics_aabb_new(500.0, -10.0, 100.0, 20.0)));
}
