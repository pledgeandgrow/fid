// expect-error: no field 'zzz' on struct 'P'
// Bugs roadmap BG182: `a?.f` on an Option<P> was typed i64 whatever f was,
// even for a field P does not have (`a?.zzz` gave 0).
struct P {
    x: i64,
}

fn mk(b: bool) -> Option<P> {
    if b {
        return Option::Some(P { x: 4 });
    }
    return Option::None;
}

fn main() -> i64 {
    val a = mk(true);
    val q = a?.zzz;
    println(q);
    return 0;
}
