// expect-error: requires U: Show; the trait's method does not
// LG4: an impl's generic method may not ask more of its type parameter than
// the trait's: a call through a bound `T: Keeper` may pass any type
// (typechecker.fd TypeChecker_check_impl_sig).
cap Show {
    fn show(self) -> str;
}

cap Keeper {
    fn keep<U>(self, x: U) -> U;
}

struct Pos { n: i64 }

impl Keeper for Pos {
    fn keep<U: Show>(self, x: U) -> U { return x; }
}

fn main() -> i64 {
    val p = Pos { n: 1 };
    println(p.keep(3));
    return 0;
}
