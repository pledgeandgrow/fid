// expect-error: is safety-annotated but calls 'boom'
// Bugs roadmap BG130: the safety scans did not look inside f-strings, so a
// @crashfree function could call a panicking one in `f"{..}"`.
fn boom(n: i64) -> i64 { panic("boom"); return n; }
@crashfree
fn cf(n: i64) -> str {
    return f"v={boom(n)}";
}
fn main() -> i64 { println(cf(3)); return 0; }
