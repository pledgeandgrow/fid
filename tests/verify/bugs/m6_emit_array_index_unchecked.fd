// Miscompile log M6 (docs/verification/miscompile-log.md). With `fid emit`,
// indexing a fixed array past its end is not checked: `a[3]` of a
// `[i64; 3]` reads 0 and the program exits 0 (reference §3.2: "Indexing is
// bounds-checked at run time", §8.2). Found by the conformance test
// tests/conformance/s8_2_array_oob_panics.fd (VF10). (`fid run` reads the
// literal wrong, M5; `fid ccompile` does not compile it, M5.)
//@ backends: emit
//! panic

fn main() -> i64 {
    var a: [i64; 3] = [1, 2, 3];
    var i: i64 = 2;
    println(a[i]);
    i = i + 1;
    println(a[i]);
    return 0;
}
//> 3
