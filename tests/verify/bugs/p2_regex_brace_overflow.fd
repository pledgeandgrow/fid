// Parser log P2. A repetition count larger than an i64 (`a{3999…9}`) panics
// with an integer overflow in rx_parse_brace instead of failing to match or
// rejecting the pattern. Found by scripts/fuzz/fuzz_parsers.py (VF15).

use regex;

fn main() -> i64 {
    val m = regex_match("aaa", "a{39999999999999999999999999}");
    println("ok");
    return 0;
}
//> ok
