// Miscompile log M21 (VF9, docs/verification/semantics-2.md §12 A-val).
// Reference §8.1: arrays are values, "assignment and by-value passing copy
// them". `var b = a; b[0] = 9` changes `a` too on `run`, `ccompile` and
// `emit` (Nov 17, stage 0 of Nov 16): the array is shared like a handle.

fn sum3(a: [i64; 3]) -> i64 { return a[0] + a[1] + a[2]; }

fn main() -> i64 {
    val arr = [4, 5, 6];
    var arr2 = arr;
    arr2[0] = 9;
    println(arr[0]);
    println(arr2[0]);
    println(sum3(arr));
    return 0;
}
//> 4
//> 9
//> 15
