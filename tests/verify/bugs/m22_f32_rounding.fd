// Miscompile log M22 (VF9, docs/verification/semantics-2.md §10). `f32`
// arithmetic rounds to binary32 once per operation, and `as f32` rounds.
// Nov 17 (stage 0 of Nov 16): `fid ccompile` prints all of this; `fid run`
// does not round `f64 as f32` (the second number of F9 is 16777217);
// `fid emit` adds two f32 values wrong (2.5 + 2.5 gave 2) and stops with
// "Panic: Illegal instruction" on F8 (known-bugs 2g.13: nat_ir/pe_ir keep
// the bits on an f32 <-> f64 conversion).

fn bs(b: bool) -> str { if b { return "true"; } return "false"; }

fn main() -> i64 {
    val h: f32 = 2.5 as f32;
    val hh: f32 = h + h;
    println(int_to_str((hh as f64) as i64));
    val fa: f32 = 0.1 as f32;
    val fb: f32 = 0.2 as f32;
    val fc: f32 = 0.3 as f32;
    val fsum: f32 = fa + fb;
    println("F8 " + bs(fsum == fc) + " " + bs((fa as f64) == 0.1));
    val big24: f32 = 16777216.0 as f32;
    val one32: f32 = 1.0 as f32;
    val b25: f32 = big24 + one32;
    println("F9 " + int_to_str((b25 as f64) as i64) + " " + int_to_str(((16777216.0 + 1.0) as f32) as i64));
    val third: f32 = one32 / (3.0 as f32);
    println("F10 " + bs((third as f64) == 1.0 / 3.0) + " " + bs(((third as f64) as f32) == third));
    return 0;
}
//> 5
//> F8 true false
//> F9 16777216 16777216
//> F10 false true
