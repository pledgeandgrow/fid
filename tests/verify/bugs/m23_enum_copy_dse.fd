// Miscompile log M23 (VF9, docs/verification/semantics-2.md §7 E-value).
// Enums are values: `val eb = ea; ea = Sh::One(2)` leaves eb as it was.
// Nov 17 (stage 0 of Nov 16): `fid emit` prints -100 for eb (the match
// finds no variant: the copy's tag was never stored); `fid ccompile` is
// right. `FID_IROPT_OFF=dse` makes emit right, so the IR optimizer's dead
// store elimination (compiler/iropt.fd) drops the store of the copy.
// Also line E5 of tests/bootstrap/test_verify_semantics_ext.fd.

enum Sh {
    One(i64),
    Two(i64, i32),
    Zero,
}

fn sh_val(s: Sh) -> i64 {
    match s {
        Sh::One(a) => { return a; }
        Sh::Two(a, b) => { return a + (b as i64); }
        Sh::Zero => { return 0; }
    }
    return -100;
}

fn main() -> i64 {
    var ea = Sh::One(1);
    val eb = ea;
    ea = Sh::One(2);
    println(sh_val(eb));
    println(sh_val(ea));
    return 0;
}
//> 1
//> 2
