// Miscompile log M1 (docs/verification/miscompile-log.md). A cast between
// integer types of the same width and other signedness (`u8 as i8`,
// `u16 as i16`, `u32 as i32`) is lowered as a BitCast
// (compiler/lower.fd Lowerer_lower_cast), which `fid run` and `fid emit`
// treat as the identity: the value keeps the zero extension of the unsigned
// type. `fid ccompile` is right. Found by scripts/fuzz/gen_vs_c.py (VF2).

fn id8(x: i8) -> i8 { return x; }

fn main() -> i64 {
    var b: u8 = 200;
    println(b as i8);
    if (b as i8) < 0 { println(1); } else { println(0); }
    println((b as i8) as i64);
    println(id8(b as i8));
    var w: i16 = (b as i8) as i16 + 1;
    println(w);
    var big: u16 = 65535;
    println(big as i16);
    var q: i32 = (big as i16) as i32;
    println(q);
    var u: u32 = 4294967295;
    println(u as i32);
    return 0;
}
//> -56
//> 1
//> -56
//> -56
//> -55
//> -1
//> -1
//> -1
