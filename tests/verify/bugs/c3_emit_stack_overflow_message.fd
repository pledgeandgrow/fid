// Chaos log C3. With `fid emit`, unbounded recursion ends with "Panic:
// Invalid memory access (null or dangling pointer)" (exit 1); run and
// ccompile report "Stack overflow: the recursion is too deep". The exit is
// clean; the message names the wrong cause. Found by scripts/verify/chaos.py.
//@ backends: emit
//! panic

fn deep(n: i64) -> i64 {
    if n == 0 { return 0; }
    return deep(n - 1) + 1;
}

fn main() -> i64 {
    println(deep(100000000));
    return 0;
}
