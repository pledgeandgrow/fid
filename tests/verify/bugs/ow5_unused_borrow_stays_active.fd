// Log OW5 (docs/verification/miscompile-log.md, wrong rejections; VF11,
// scripts/verify/own_diff.py "fid rejects"). Reference §8.4: "A borrow ends
// at the borrower's last use." A borrow that is never used ends where it is
// made, so changing its owner afterwards is allowed. With stage 0 of
// Nov 16 a `&mut` borrow with no use stays active to the end of its block
// ("cannot mutate a: a mutable borrow is active on it", E080), and so does
// a shared one inside a block (`{ val r = &a; a.n = 1; }`: "a is borrowed",
// E044); 12 of the 240 programs of the own_diff run of Nov 18 were
// rejected, all for this (an unused `r` in each). Not unsafe (stricter than the rules), but the
// model and the reference accept these programs.
//> 1
//> 2

struct Bx {
    n: i64,
    kids: Vec<Bx>,
}

fn main() -> i64 {
    var a: Bx = Bx { n: 0, kids: Vec::new() };
    var r: &mut Bx = &mut a;
    a = Bx { n: 1, kids: Vec::new() };
    println(a.n);
    {
        val q: &Bx = &a;
        a.n = 2;
    }
    println(a.n);
    return 0;
}
