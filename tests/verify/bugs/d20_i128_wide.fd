// Reference/compiler disagreement D20 (VF9, docs/verification/semantics-2.md
// §11 I-wide). Reference §3.1: `i128` is a 128-bit signed integer, so
// i64::MAX + 1 is a value of it. The compiler lowers `i128`/`u128` to 64
// bits (compiler/ir.fd maps Type::I128 to IrType::I64; known-bugs 2c.10):
// the addition panics with an overflow on every backend.

fn main() -> i64 {
    val a: i128 = 9223372036854775807;
    val b: i128 = a + 1;
    println(b > a);
    val c: i128 = b - 1;
    println(c == a);
    return 0;
}
//> true
//> true
