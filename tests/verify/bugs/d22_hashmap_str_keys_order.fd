// Reference/compiler disagreement D22 (VF9, docs/verification/semantics-2.md
// §20.2; reference §13.3, decided Nov 17): `keys()` gives the keys in
// ascending order, strings byte by byte as `str_compare`, and `values()`
// the values in that order. Nov 17 (stage 0 of Nov 16): `fid emit` prints
// the line below; `fid run` and `fid ccompile` print the keys in the
// order of their addresses (here insertion order: pear apple fig banana),
// because `stdlib/core.fd` `HashMap_keys` sorts string keys with
// `Vec_sort`, which compares the words (pointers).

fn main() -> i64 {
    var m: HashMap<str, i64> = HashMap::new();
    m.insert("pear", 1);
    m.insert("apple", 2);
    m.insert("fig", 3);
    m.insert("banana", 4);
    val ks: Vec<str> = m.keys();
    val vs: Vec<i64> = m.values();
    var line: str = "keys";
    var i: i64 = 0;
    while i < ks.len() {
        line = line + " " + ks.get(i) + "=" + int_to_str(vs.get(i));
        i = i + 1;
    }
    println(line);
    return 0;
}
//> keys apple=2 banana=4 fig=3 pear=1
