// Miscompile log M13 (docs/verification/miscompile-log.md). `continue` in a
// `for` loop must go on with the next element (§5): here k = 0, 2, 3. Every
// backend loops forever instead (run, ccompile, emit, --nat, the Linux
// targets): compiler/lower.fd lowers each `for` form (range, array, Vec,
// str) with the loop's continue target set to the condition block, and the
// increment of the index sits after the body, so `continue` jumps past it
// and the same element comes again. `while` loops, which carry their own
// increment, are right. Found by scripts/fuzz/gen_vs_c.py --backends all,
// seeds 5 and 10 (Nov 16, RL1).

fn main() -> i64 {
    var n: i64 = 0;
    for k in 0..4 {
        if k == 1 { continue; }
        n = n + k;
    }
    println(n);
    var v: Vec<i64> = Vec::new();
    v.push(10);
    v.push(20);
    v.push(30);
    var s: i64 = 0;
    for x in v {
        if x == 20 { continue; }
        s = s + x;
    }
    println(s);
    var c: i64 = 0;
    for ch in "a-b-c" {
        if ch == "-" { continue; }
        c = c + 1;
    }
    println(c);
    return 0;
}
//> 5
//> 40
//> 3
