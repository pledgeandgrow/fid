// Parser log P1 (docs/verification/miscompile-log.md). url_parse on a port
// with more digits than an i64 holds panics with an integer overflow in
// String_parse_int instead of giving an invalid Url. Found by
// scripts/fuzz/fuzz_parsers.py (VF15).

use url;

fn main() -> i64 {
    val u = url_parse("http://h:802142147483648748364875/");
    println("ok");
    return 0;
}
//> ok
