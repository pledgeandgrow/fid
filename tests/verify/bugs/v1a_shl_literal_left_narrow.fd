// Miscompile log V1a (docs/verification/miscompile-log.md, V1 reduced on
// Nov 17). An integer literal on the left of `<<` in a narrow context is
// not given that type: `(2 << a) - 62` with `a: u16 = 15` is computed in a
// wide type (2 << 15 = 65536, minus 62 = 65474, which fits a u16), so the
// subtraction does not panic. By the reference (§3.5, §4.1) the literal is
// a u16, `2 << 15` keeps the low 16 bits (0), and `0 - 62` overflows u16:
// a panic. Every backend (run, ccompile, emit, --nat) prints 65474. A
// variable on the left (`one << a`) is right. Found by
// scripts/fuzz/gen_vs_c.py --seed 100 --avoid nested-if-value: seed 151
// (`(2 << (s.f1 & 15)) - (s.f1 + s.f1)` on a u16 field) (VF2).

fn main() -> i64 {
    var a: u16 = 15;
    var one: u16 = 2;
    println((one << a) + 1);
    var b: u16 = (2 << a) - 62;
    println(b);
    return 0;
}
//> 1
//! panic
