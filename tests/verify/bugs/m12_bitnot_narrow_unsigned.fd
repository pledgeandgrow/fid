// Miscompile log M12 (docs/verification/miscompile-log.md). `~x` on an
// unsigned type narrower than 64 bits must keep the declared width (§3.5):
// `~3u8` is 252. `fid run` and every `fid emit` backend give -4 (the 64-bit
// complement, not masked), so `~a - a` on u8 panics "Integer overflow on
// subtraction: -4 - 3" and comparisons flip; `fid ccompile` is right.
// Found by scripts/fuzz/gen_vs_c.py --backends all, seed 1 (Nov 16, RL1).

fn main() -> i64 {
    var a: u8 = 3;
    var n: u8 = ~a;
    println(n);
    var d: u8 = n - a;
    println(d);
    if ~a > 200 { println(1); } else { println(0); }
    var w: u16 = 1;
    var nw: u16 = ~w;
    println(nw);
    var x: u32 = 0;
    var nx: u32 = ~x;
    println(nx);
    println((~a) as i64);
    return 0;
}
//> 252
//> 249
//> 1
//> 65534
//> 4294967295
//> 252
