// Miscompile log M3. println of a u64 above i64::MAX prints it as signed on
// every backend; print of the same value is right (reference §3.5:
// unsigned types print unsigned). Found by scripts/fuzz/gen_vs_c.py (VF2).

fn main() -> i64 {
    var g: u64 = 18446744073709551615;
    println(g);
    print(g);
    print("\n");
    return 0;
}
//> 18446744073709551615
//> 18446744073709551615
