// Reference/compiler disagreement D23 (VF9, docs/verification/semantics-2.md
// §19 Y-call; reference §10.2): an `async fn` runs at the call until it
// first waits, then the caller goes on. `fid ccompile` and `fid emit`
// print the line below; `fid run` runs the task to its end at the call
// (`1a 1b m 10`): compiler/interp.fd cannot interleave tasks (AGENTS.md,
// interp.rs row).

use task;

async fn y_step(id: i64) -> Future<i64> {
    print(int_to_str(id) + "a ");
    task_yield();
    print(int_to_str(id) + "b ");
    return id * 10;
}

fn main() -> i64 {
    val y1 = y_step(1);
    print("m ");
    val r = await y1;
    print(int_to_str(r) + "\n");
    return 0;
}
//> 1a m 1b 10
