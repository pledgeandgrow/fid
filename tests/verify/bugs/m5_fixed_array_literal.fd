// Miscompile log M5. A local fixed array initialised from a literal:
// `fid run` reads 4663, 0, 0, … instead of the elements, and `fid ccompile`
// writes C that does not compile (`int64_t[8] v209 = 0;`). `fid emit` is
// right. Found by the VF5 test of PEIR_RANGES.

fn main() -> i64 {
    var arr: [i64; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
    var s: i64 = 0;
    for k in 0..8 { s = s * 2 + arr[k]; }
    println(arr[0]);
    println(arr[7]);
    println(s);
    return 0;
}
//> 1
//> 8
//> 502
