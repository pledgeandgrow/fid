// Log N1 (docs/verification/miscompile-log.md). A program function with the
// same name as a public function of an imported module replaces it inside
// that module: stdlib/http.fd's `serve` passes its own `handle_request` to
// http_serve, but with this program's `handle_request` defined the module
// resolves the name to this one and is rejected ("private to module
// 'main'", "expects fn(HttpRequest) -> str"). A module's own items must win
// inside it. Found while writing tests/verify/soak_service.fd (VF16).

use http;

fn handle_request(i: i64) -> i64 { return i + 1; }

fn main() -> i64 {
    println(handle_request(1));
    return 0;
}
//> 2
