// Miscompile log V1c (docs/verification/miscompile-log.md, V1 reduced on
// Nov 17). With `fid ccompile`, reading `xs[i]` with `i` past the end gives
// 0 instead of panicking (§8.2): the index expression is lowered to the C
// runtime's `p_vec_get` (compiler/codegen_c.fd), which returns NULL for an
// index out of range. `xs.get(i)` goes to core's `Vec_get` and panics; run,
// emit and --nat panic on both. Found by scripts/fuzz/gen_vs_c.py --seed 100
// (seed 120: `xs[xs.len()]`) (VF2).

fn main() -> i64 {
    var xs: Vec<i64> = Vec::new();
    xs.push(1);
    xs.push(8);
    println(xs[1]);
    var i: i64 = 1;
    i = i + 4;
    println(xs[i]);
    return 0;
}
//> 8
//! panic
