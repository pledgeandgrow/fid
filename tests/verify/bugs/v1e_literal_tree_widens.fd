// Miscompile log V1e (docs/verification/miscompile-log.md, found by the
// VF2 long run of Nov 17). An operator tree of integer literals such as
// `((31 & 15) | 1)` is typed i64 inside an expression of a narrower type,
// so the operation that uses it, and the ones above it, are done at 64
// bits: `a - five % ((31 & 15) | 1)` with `a: u32 = 0`, `five: u32 = 5`
// gives 4294967291 instead of the u32 overflow panic of `0 - 5` (§3.5).
// `a - five % 15` (one literal) panics as it should. Every backend (run,
// ccompile, emit). Same family as V1a (a literal's type in a narrow
// context). gen_vs_c.py writes such divisors (`(e & 15) | 1`) and shift
// amounts everywhere: seeds 20117 and 220230 of the long run.

fn main() -> i64 {
    var a: u32 = 0;
    var five: u32 = 5;
    var ok: u32 = a + five % ((31 & 15) | 1);
    println(ok);
    var c: bool = false;
    var d: u32 = (0 as u32) - (if c { (9 as u32) % ((31 & 15) | 1) } else { (5 as u32) });
    println(d);
    return 0;
}
//> 5
//! panic
