// Log N2 (docs/verification/miscompile-log.md). When two imported modules
// both define a public function (`file_append` in file.fd and fs.fd, which
// http_client imports), an unqualified call is reported as "undefined
// function 'file_append'". Reference §2.9 makes `m::f()` the way to choose,
// but the message should say the name is ambiguous and name both modules.
// Found while writing tests/verify/chaos.fd (VF17).
//! error: ambiguous

use file;
use http_client;

fn main() -> i64 {
    println(file_append("x.txt", ""));
    return 0;
}
