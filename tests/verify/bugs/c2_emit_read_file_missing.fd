// Chaos log C2 (docs/verification/miscompile-log.md). With `fid emit`,
// read_file of a file that does not exist panics with "Invalid memory
// access (null or dangling pointer)" instead of giving None; run and
// ccompile give None. Found by scripts/verify/chaos.py (VF17).

fn main() -> i64 {
    match read_file("this-file-does-not-exist.txt") {
        Option::Some(t) => { println(str_len(t)); }
        Option::None => { println("none"); }
    }
    return 0;
}
//> none
