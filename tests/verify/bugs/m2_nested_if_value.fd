// Miscompile log M2. An `if` used as a value whose branch value is another
// `if` (reference §4.7: "has the type of its branches") is typed `void`, so
// the declaration is rejected on every backend. Parentheses around the
// inner `if` make it work. Found by scripts/fuzz/gen_vs_c.py (VF2).

fn main() -> i64 {
    val a: i64 = 3;
    var v: i64 = if a > 1 { if a > 2 { 10 } else { 20 } } else { 30 };
    println(v);
    return 0;
}
//> 10
