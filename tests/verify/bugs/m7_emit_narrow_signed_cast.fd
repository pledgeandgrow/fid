// Miscompile log M7 (docs/verification/miscompile-log.md). With `fid emit`,
// a narrowing cast to a signed type keeps the low bits zero-extended:
// `59134u16 as i8` is 254 instead of -2, so it prints 254 and `15 < v as i8`
// is true. run and ccompile are right. Found by scripts/fuzz/gen_vs_c.py
// (seed 137 of --seed 100, reduced with scripts/fuzz/reduce.py) (VF2).

fn main() -> i64 {
    var v: u16 = 59134;
    if 15 < v as i8 { println(1); } else { println(0); }
    println(v as i8);
    var x: i64 = 200;
    println(x as i8);
    return 0;
}
//> 0
//> -2
//> -56
