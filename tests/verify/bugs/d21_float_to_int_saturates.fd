// Reference/compiler disagreement D21 (VF9, docs/verification/semantics-2.md
// §20.1; reference §4.6, decided Nov 17): a float cast to an integer type
// truncates toward zero, goes to the nearest end of the type's range when
// it is out of range (±∞ included), and gives 0 for NaN; it never panics.
// Nov 17 (stage 0 of Nov 16): `fid run` and `fid emit` give
// -9223372036854775808 for the first four lines, 300 and -5 for the u8
// casts (a value outside u8) and 3000000000 for the i32 one; `fid
// ccompile` gives 2, 0, 0, 0, 44, 251 and -1294967296 (C leaves the cast
// undefined there).

fn main() -> i64 {
    val z: f64 = 0.0;
    val big: f64 = 1.0e300;
    val inf = 1.0 / z;
    val nan = z / z;
    val u: f64 = 300.7;
    val neg: f64 = -5.5;
    println(big as i64);
    println((0.0 - big) as i64);
    println(inf as i64);
    println(nan as i64);
    println(u as u8);
    println(neg as u8);
    println(3.0e9 as i32);
    val ok: f64 = 200.9;
    println(ok as u8);
    return 0;
}
//> 9223372036854775807
//> -9223372036854775808
//> 9223372036854775807
//> 0
//> 255
//> 0
//> 2147483647
//> 200
