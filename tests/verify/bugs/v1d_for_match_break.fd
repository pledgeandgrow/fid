// Miscompile log V1d (docs/verification/miscompile-log.md, found by the
// VF2 long run of Nov 17). A `break` inside a `match` arm inside a `for`
// loop leaves only the `match`: the loop goes on, on every backend (run,
// ccompile, emit). The same `break` in a `while` loop leaves the loop, as
// the reference says (§5: `break` leaves the innermost loop; `match` is not
// a loop). Found by scripts/fuzz/gen_vs_c.py --ext, seed 120083 of the
// long run (`for k3 in 0..3 { match ... { _ => { if c { break; } } } ... }`).

fn main() -> i64 {
    var a: i64 = 0;
    for k in 0..3 {
        match k {
            _ => { break; }
        }
        a = a + 1;
    }
    println(a);
    var b: i64 = 0;
    var i: i64 = 0;
    while i < 3 {
        i = i + 1;
        match i {
            _ => { if i == i { break; } }
        }
        b = b + 1;
    }
    println(b);
    var c: i64 = 0;
    for k in 0..3 {
        match k {
            0 => { if k == 0 { break; } }
            _ => { }
        }
        c = c + 1;
    }
    println(c);
    return 0;
}
//> 0
//> 0
//> 0
