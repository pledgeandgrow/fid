// Miscompile log M4 (docs/verification/miscompile-log.md). Expected to fail at
// run time on every backend; `fid ccompile` prints 45 and exits 0 (Nov 7).
// Found by the VF5 test of PEIR_RANGES.
//! panic
// The loop's bound is one past the end,
// so the last index is out of range: removing the bounds check
// (compiler/checks.fd, PEIR_RANGES) would read past the Vec instead of
// panicking.

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 10 { v.push(i); i = i + 1; }
    var s: i64 = 0;
    for k in 0..v.len() + 1 {
        s = s + v[k];
    }
    println(s);
    return 0;
}
