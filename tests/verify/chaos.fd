// Chaos driver (roadmap VF17; scripts/verify/chaos.py). Each mode does one
// thing the environment can make fail, and reports what it saw; chaos.py
// arranges the failure (a full disk, no memory, a server that drops the
// connection, a reader that goes away) and checks the program fails the way
// it should: an error result or a panic message and a nonzero exit, never a
// crash, a hang or silent wrong output.
//
//   chaos write <path> <chunks>   append 64 KiB chunks; report the first failure
//   chaos alloc                   grow memory until it runs out
//   chaos http <port> <path>      GET from 127.0.0.1:<port>
//   chaos print <n>               print n lines
//   chaos deep <n>                recurse n levels
//   chaos read <path>             read a file

use file;

// The transport of stdlib/http_client.fd http_request, line for line
// (connect, write, read until the peer closes), without the module: with
// the Nov 7 compiler a program importing http_client is rejected
// (stdlib/os.fd os_args: p_str_take(p_argv(i)) does not type-check).
@unsafe
fn get_status(port: i64, path: str) -> str {
    var fd: i64 = p_net_connect("127.0.0.1", port);
    if fd < 0 { return "status 0 body 0"; }
    p_socket_write_str(fd, "GET " + path + " HTTP/1.1
Host: 127.0.0.1
Connection: close

");
    var buf: i64 = p_malloc(8192);
    var total: i64 = 0;
    var first: i64 = -1;
    while true {
        var n: i64 = p_socket_read(fd, buf, 8192);
        if n <= 0 { break; }
        if first < 0 { first = n; }
        total = total + n;
    }
    p_free(buf);
    p_socket_close(fd);
    if total == 0 { return "status 0 body 0"; }
    return "status ? body " + int_to_str(total);
}

fn deep(n: i64) -> i64 {
    if n == 0 { return 0; }
    return deep(n - 1) + 1;
}

fn main() -> i64 {
    val mode: str = arg_at(1) ?? "";
    val a2: str = arg_at(2) ?? "";
    val a3: str = arg_at(3) ?? "0";
    if mode == "write" {
        var chunk: str = str_repeat("x", 65536);
        val n: i64 = str_parse_int(a3);
        var i: i64 = 0;
        while i < n {
            if file::file_append(a2, chunk) != 0 {  // fs.fd (through http_client) has one too
                println("write-failed at chunk " + int_to_str(i));
                return 0;
            }
            i = i + 1;
        }
        println("wrote " + int_to_str(n) + " chunks");
    } else if mode == "alloc" {
        var keep: Vec<Vec<i64>> = Vec::new();
        var total: i64 = 0;
        while true {
            var v: Vec<i64> = Vec::new();
            var j: i64 = 0;
            while j < 131072 { v.push(j); j = j + 1; }
            keep.push(v);
            total = total + 1;
            if total % 64 == 0 { println("MiB " + int_to_str(total)); }
        }
    } else if mode == "http" {
        println(get_status(str_parse_int(a2), a3));
    } else if mode == "print" {
        val n: i64 = str_parse_int(a2);
        var i: i64 = 0;
        while i < n { println("line " + int_to_str(i)); i = i + 1; }
    } else if mode == "deep" {
        println(deep(str_parse_int(a2)));
    } else if mode == "read" {
        match read_file(a2) {
            Option::Some(t) => { println("read " + int_to_str(str_len(t))); }
            Option::None => { println("none"); }
        }
    } else {
        println("unknown mode");
        return 2;
    }
    return 0;
}
