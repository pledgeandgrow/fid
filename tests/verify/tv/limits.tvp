# RL5: results no check applies to (the validator counts them as "not
# checkable"; docs/verification/translation-validation.md lists the
# limits). Each pair here must stay n/a until a check for it is written:
# when one is, move the pair to the file of its pass with accept/reject.

# tailcall: a self call made a loop. Calls are uninterpreted, so the call
# the pass removed cannot be compared with the loop it became.
pair tailcall_self_loop
pass tailcall
expect n/a
before
fn down(%0: i64) -> i64
b0:
  %1 = const i64 0
  %2 = le bool %0 %1
  %3 = br %2 b1 b2
b1:
  %4 = ret %0
b2:
  %5 = const i64 1
  %6 = sub i64 %0 %5
  %7 = call i64 down(%6)
  %8 = ret %7
after
fn down(%0: i64) -> i64
b0:
  %9 = alloca i64
  %10 = store %9 %0
  %11 = jump b3
b3:
  %12 = load i64 %9
  %1 = const i64 0
  %2 = le bool %12 %1
  %3 = br %2 b1 b2
b1:
  %4 = ret %12
b2:
  %5 = const i64 1
  %6 = sub i64 %12 %5
  %13 = store %9 %6
  %14 = jump b3

# memory through a pointer parameter is not evaluated, and no witness
# covers `simplify`
pair simplify_through_pointer
pass simplify
expect n/a
before
fn rd(%0: ptr) -> i64
b0:
  %1 = load i64 %0
  %2 = const i64 0
  %3 = add i64 %1 %2
  %4 = ret %3
after
fn rd(%0: ptr) -> i64
b0:
  %1 = load i64 %0
  %4 = ret %1

# ssa: the witness leaves a promoted local's value to the runs on random
# inputs; with a load through a pointer no run can be made, so the result
# is not checkable (it was accepted unchecked before Nov 17)
pair ssa_promote_unrunnable
pass ssa
expect n/a
before
fn f(%0: i64, %1: ptr) -> i64
b0:
  %2 = alloca i64
  %3 = store %2 %0
  %4 = load i64 %1
  %5 = load i64 %2
  %6 = add i64 %5 %4
  %7 = ret %6
after
fn f(%0: i64, %1: ptr) -> i64
b0:
  %4 = load i64 %1
  %6 = add i64 %0 %4
  %7 = ret %6
