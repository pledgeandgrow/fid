# RL5: passes no witness is written for (simplify, strength reduction,
# sccp, unroll, scheduling, iropt_me's passes ...): tv.fd's runs on random
# inputs decide (12 runs: 0, 1, -1, small, large and full-width values;
# calls with an effect and prints go into a trace that must agree).

# x * 2 and x + x overflow on the same inputs (checked arithmetic)
pair strength_mul2_add
pass strength
expect accept
before
fn f(%0: i64) -> i64
b0:
  %1 = const i64 2
  %2 = mul i64 %0 %1
  %3 = ret %2
after
fn f(%0: i64) -> i64
b0:
  %2 = add i64 %0 %0
  %3 = ret %2

# x * 8 panics on overflow, x << 3 does not
pair strength_mul8_shl
pass strength
expect reject
why on inputs
before
fn f(%0: i64) -> i64
b0:
  %1 = const i64 8
  %2 = mul i64 %0 %1
  %3 = ret %2
after
fn f(%0: i64) -> i64
b0:
  %1 = const i64 3
  %2 = shl i64 %0 %1
  %3 = ret %2

# ... in a @wrapping function they agree
pair strength_mul8_shl_wrapping
pass strength
expect accept
before
fn f(%0: i64) -> i64 wrapping
b0:
  %1 = const i64 8
  %2 = mul i64 %0 %1
  %3 = ret %2
after
fn f(%0: i64) -> i64 wrapping
b0:
  %1 = const i64 3
  %2 = shl i64 %0 %1
  %3 = ret %2

# x / 4 is not x >> 2 for negative x (division rounds toward zero)
pair strength_div4_shr
pass strength
expect reject
before
fn f(%0: i64) -> i64
b0:
  %1 = const i64 4
  %2 = div i64 %0 %1
  %3 = ret %2
after
fn f(%0: i64) -> i64
b0:
  %1 = const i64 2
  %2 = shr i64 %0 %1
  %3 = ret %2

# x & 7 is x % 8 only for x >= 0
pair strength_mod8_band
pass strength
expect reject
before
fn f(%0: i64) -> i64
b0:
  %1 = const i64 8
  %2 = mod i64 %0 %1
  %3 = ret %2
after
fn f(%0: i64) -> i64
b0:
  %1 = const i64 7
  %2 = band i64 %0 %1
  %3 = ret %2

# a branch on x == x always goes one way
pair simplify_branch_on_self
pass simplify
expect accept
before
fn f(%0: i64) -> i64
b0:
  %1 = eq bool %0 %0
  %2 = br %1 b1 b2
b1:
  %3 = ret %0
b2:
  %4 = const i64 0
  %5 = ret %4
after
fn f(%0: i64) -> i64
b0:
  %2 = jump b1
b1:
  %3 = ret %0

# x < 0 does not always hold
pair sccp_wrong_branch
pass sccp
expect reject
before
fn f(%0: i64) -> i64
b0:
  %1 = const i64 0
  %2 = lt bool %0 %1
  %3 = br %2 b1 b2
b1:
  %4 = neg i64 %0
  %5 = ret %4
b2:
  %6 = ret %0
after
fn f(%0: i64) -> i64
b0:
  %1 = const i64 0
  %3 = jump b1
b1:
  %4 = neg i64 %0
  %5 = ret %4

# for i in 0..4 { s = s + i } return s, unrolled and folded to 6
pair unroll_sum
pass unroll
expect accept
before
fn f() -> i64
b0:
  %0 = alloca i64
  %1 = alloca i64
  %2 = const i64 0
  %3 = const i64 1
  %4 = const i64 4
  %5 = store %0 %2
  %6 = store %1 %2
  %7 = jump b1
b1:
  %8 = load i64 %0
  %9 = lt bool %8 %4
  %10 = br %9 b2 b3
b2:
  %11 = load i64 %1
  %12 = add i64 %11 %8
  %13 = store %1 %12
  %14 = add i64 %8 %3
  %15 = store %0 %14
  %16 = jump b1
b3:
  %17 = load i64 %1
  %18 = ret %17
after
fn f() -> i64
b0:
  %19 = const i64 6
  %18 = ret %19

# ... off by one: the body run for i = 4 too
pair unroll_sum_off_by_one
pass unroll
expect reject
before
fn f() -> i64
b0:
  %0 = alloca i64
  %1 = alloca i64
  %2 = const i64 0
  %3 = const i64 1
  %4 = const i64 4
  %5 = store %0 %2
  %6 = store %1 %2
  %7 = jump b1
b1:
  %8 = load i64 %0
  %9 = lt bool %8 %4
  %10 = br %9 b2 b3
b2:
  %11 = load i64 %1
  %12 = add i64 %11 %8
  %13 = store %1 %12
  %14 = add i64 %8 %3
  %15 = store %0 %14
  %16 = jump b1
b3:
  %17 = load i64 %1
  %18 = ret %17
after
fn f() -> i64
b0:
  %19 = const i64 10
  %18 = ret %19

# two calls with effects may not swap
pair sched_io_calls_swapped
pass sched
expect reject
why calls or prints differ
before
fn f(%0: i64) -> i64
b0:
  %1 = call i64 a(%0) !io
  %2 = call i64 b(%0) !io
  %3 = bxor i64 %1 %2
  %4 = ret %3
after
fn f(%0: i64) -> i64
b0:
  %2 = call i64 b(%0) !io
  %1 = call i64 a(%0) !io
  %3 = bxor i64 %1 %2
  %4 = ret %3

# ... pure calls may
pair sched_pure_calls_swapped
pass sched
expect accept
before
fn f(%0: i64) -> i64
b0:
  %1 = call i64 a(%0)
  %2 = call i64 b(%0)
  %3 = bxor i64 %1 %2
  %4 = ret %3
after
fn f(%0: i64) -> i64
b0:
  %2 = call i64 b(%0)
  %1 = call i64 a(%0)
  %3 = bxor i64 %1 %2
  %4 = ret %3

# a print moved after a call with an effect
pair sched_print_after_call
pass sched
expect reject
before
fn f(%0: i64) -> i64
b0:
  %1 = print i64 %0
  %2 = call i64 a(%0) !io
  %3 = ret %2
after
fn f(%0: i64) -> i64
b0:
  %2 = call i64 a(%0) !io
  %1 = print i64 %0
  %3 = ret %2

# i8 arithmetic narrowed: (x + 1) at i8 widened to i64 and back
pair narrow_i8_add
pass narrow
expect accept
before
fn f(%0: i8) -> i8
b0:
  %1 = const i8 1
  %2 = band i8 %0 %1
  %3 = ret %2
after
fn f(%0: i8) -> i8
b0:
  %4 = ext i8 i64 %0
  %5 = const i64 1
  %6 = band i64 %4 %5
  %2 = trunc i64 i8 %6
  %3 = ret %2
