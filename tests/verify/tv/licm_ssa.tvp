# RL5: loop-invariant code motion (iropt.fd iro_licm: tv.fd tv_licm, value
# ids kept, an instruction only moves into the block that enters its loop)
# and the SSA round trip (compiler/ssa.fd: the witness leaves the values of
# promoted locals to the runs on random inputs).
#
# The loop of the licm pairs: i = 0; acc = 0; while i < n { acc = q; i += 1 }
# return acc.

pair licm_bitand
pass licm
expect accept
before
fn f(%0: i64) -> i64
b0:
  %1 = alloca i64
  %2 = alloca i64
  %3 = const i64 0
  %4 = const i64 1
  %5 = const i64 7
  %7 = store %1 %3
  %8 = store %2 %3
  %9 = jump b1
b1:
  %10 = load i64 %1
  %11 = lt bool %10 %0
  %12 = br %11 b2 b3
b2:
  %13 = band i64 %0 %5
  %14 = store %2 %13
  %15 = load i64 %1
  %16 = add i64 %15 %4
  %17 = store %1 %16
  %18 = jump b1
b3:
  %19 = load i64 %2
  %20 = ret %19
after
fn f(%0: i64) -> i64
b0:
  %1 = alloca i64
  %2 = alloca i64
  %3 = const i64 0
  %4 = const i64 1
  %5 = const i64 7
  %7 = store %1 %3
  %8 = store %2 %3
  %13 = band i64 %0 %5
  %9 = jump b1
b1:
  %10 = load i64 %1
  %11 = lt bool %10 %0
  %12 = br %11 b2 b3
b2:
  %14 = store %2 %13
  %15 = load i64 %1
  %16 = add i64 %15 %4
  %17 = store %1 %16
  %18 = jump b1
b3:
  %19 = load i64 %2
  %20 = ret %19

# 100 / n out of the body: with n <= 0 the body never runs, and n = 0
# then divides by zero before the loop
pair licm_division
pass licm
expect reject
before
fn f(%0: i64) -> i64
b0:
  %1 = alloca i64
  %2 = alloca i64
  %3 = const i64 0
  %4 = const i64 1
  %6 = const i64 100
  %7 = store %1 %3
  %8 = store %2 %3
  %9 = jump b1
b1:
  %10 = load i64 %1
  %11 = lt bool %10 %0
  %12 = br %11 b2 b3
b2:
  %13 = div i64 %6 %0
  %14 = store %2 %13
  %15 = load i64 %1
  %16 = add i64 %15 %4
  %17 = store %1 %16
  %18 = jump b1
b3:
  %19 = load i64 %2
  %20 = ret %19
after
fn f(%0: i64) -> i64
b0:
  %1 = alloca i64
  %2 = alloca i64
  %3 = const i64 0
  %4 = const i64 1
  %6 = const i64 100
  %7 = store %1 %3
  %8 = store %2 %3
  %13 = div i64 %6 %0
  %9 = jump b1
b1:
  %10 = load i64 %1
  %11 = lt bool %10 %0
  %12 = br %11 b2 b3
b2:
  %14 = store %2 %13
  %15 = load i64 %1
  %16 = add i64 %15 %4
  %17 = store %1 %16
  %18 = jump b1
b3:
  %19 = load i64 %2
  %20 = ret %19

# the header's load of i out of the loop: the loop stores i
pair licm_load_of_stored_local
pass licm
expect reject
before
fn f(%0: i64) -> i64
b0:
  %1 = alloca i64
  %2 = alloca i64
  %3 = const i64 0
  %4 = const i64 1
  %5 = const i64 7
  %7 = store %1 %3
  %8 = store %2 %3
  %9 = jump b1
b1:
  %10 = load i64 %1
  %11 = lt bool %10 %0
  %12 = br %11 b2 b3
b2:
  %13 = band i64 %0 %5
  %14 = store %2 %13
  %15 = load i64 %1
  %16 = add i64 %15 %4
  %17 = store %1 %16
  %18 = jump b1
b3:
  %19 = load i64 %2
  %20 = ret %19
after
fn f(%0: i64) -> i64
b0:
  %1 = alloca i64
  %2 = alloca i64
  %3 = const i64 0
  %4 = const i64 1
  %5 = const i64 7
  %7 = store %1 %3
  %8 = store %2 %3
  %10 = load i64 %1
  %9 = jump b1
b1:
  %11 = lt bool %10 %0
  %12 = br %11 b2 b3
b2:
  %13 = band i64 %0 %5
  %14 = store %2 %13
  %15 = load i64 %1
  %16 = add i64 %15 %4
  %17 = store %1 %16
  %18 = jump b1
b3:
  %19 = load i64 %2
  %20 = ret %19

# a local promoted: its load is the value stored
pair ssa_promote
pass ssa
expect accept
before
fn f(%0: i64, %1: i64) -> i64
b0:
  %2 = alloca i64
  %3 = store %2 %0
  %4 = load i64 %2
  %5 = add i64 %4 %1
  %6 = ret %5
after
fn f(%0: i64, %1: i64) -> i64
b0:
  %5 = add i64 %0 %1
  %6 = ret %5

# promoted with the wrong value: the load read %0, not %1
pair ssa_promote_wrong
pass ssa
expect reject
why on inputs
before
fn f(%0: i64, %1: i64) -> i64
b0:
  %2 = alloca i64
  %3 = store %2 %0
  %4 = load i64 %2
  %5 = add i64 %4 %1
  %6 = ret %5
after
fn f(%0: i64, %1: i64) -> i64
b0:
  %5 = add i64 %1 %1
  %6 = ret %5

# a local set on both sides of a branch: out of SSA its phi gets a slot of
# its own, stored at the end of each side
pair ssa_branch_slot
pass ssa
expect accept
before
fn f(%0: i64, %1: i64) -> i64
b0:
  %2 = alloca i64
  %3 = lt bool %0 %1
  %4 = br %3 b1 b2
b1:
  %5 = store %2 %0
  %6 = jump b3
b2:
  %7 = store %2 %1
  %8 = jump b3
b3:
  %9 = load i64 %2
  %10 = ret %9
after
fn f(%0: i64, %1: i64) -> i64
b0:
  %11 = alloca i64
  %3 = lt bool %0 %1
  %4 = br %3 b1 b2
b1:
  %12 = store %11 %0
  %6 = jump b3
b2:
  %13 = store %11 %1
  %8 = jump b3
b3:
  %9 = load i64 %11
  %10 = ret %9

# the same with the two sides' values swapped
pair ssa_branch_slot_swapped
pass ssa
expect reject
before
fn f(%0: i64, %1: i64) -> i64
b0:
  %2 = alloca i64
  %3 = lt bool %0 %1
  %4 = br %3 b1 b2
b1:
  %5 = store %2 %0
  %6 = jump b3
b2:
  %7 = store %2 %1
  %8 = jump b3
b3:
  %9 = load i64 %2
  %10 = ret %9
after
fn f(%0: i64, %1: i64) -> i64
b0:
  %11 = alloca i64
  %3 = lt bool %0 %1
  %4 = br %3 b1 b2
b1:
  %12 = store %11 %1
  %6 = jump b3
b2:
  %13 = store %11 %0
  %8 = jump b3
b3:
  %9 = load i64 %11
  %10 = ret %9
