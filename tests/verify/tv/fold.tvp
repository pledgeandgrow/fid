# RL5: constant folding (iropt.fd iro_fold), checked by tv.fd's witness
# (value ids kept: a folded value must equal the operation at its type,
# checked arithmetic included) and by runs on random inputs.

pair fold_mul
pass fold
expect accept
before
fn f(%0: i64) -> i64
b0:
  %1 = const i64 2
  %2 = const i64 3
  %3 = mul i64 %1 %2
  %4 = add i64 %0 %3
  %5 = ret %4
after
fn f(%0: i64) -> i64
b0:
  %1 = const i64 2
  %2 = const i64 3
  %3 = const i64 6
  %4 = add i64 %0 %3
  %5 = ret %4

pair fold_mul_wrong
pass fold
expect reject
why changed its value
before
fn f(%0: i64) -> i64
b0:
  %1 = const i64 2
  %2 = const i64 3
  %3 = mul i64 %1 %2
  %4 = add i64 %0 %3
  %5 = ret %4
after
fn f(%0: i64) -> i64
b0:
  %1 = const i64 2
  %2 = const i64 3
  %3 = const i64 7
  %4 = add i64 %0 %3
  %5 = ret %4

# max + 1 panics in checked arithmetic: folding it to min drops the panic
pair fold_overflow
pass fold
expect reject
before
fn f(%0: i64) -> i64
b0:
  %1 = const i64 max
  %2 = const i64 1
  %3 = add i64 %1 %2
  %4 = ret %0
after
fn f(%0: i64) -> i64
b0:
  %1 = const i64 max
  %2 = const i64 1
  %3 = const i64 min
  %4 = ret %0

# ... unless the function is @wrapping, where max + 1 is min
pair fold_overflow_wrapping
pass fold
expect accept
before
fn f(%0: i64) -> i64 wrapping
b0:
  %1 = const i64 max
  %2 = const i64 1
  %3 = add i64 %1 %2
  %4 = add i64 %0 %3
  %5 = ret %4
after
fn f(%0: i64) -> i64 wrapping
b0:
  %1 = const i64 max
  %2 = const i64 1
  %3 = const i64 min
  %4 = add i64 %0 %3
  %5 = ret %4

# at i8, 100 + 100 overflows (checked): no constant stands for it
pair fold_i8_overflow
pass fold
expect reject
before
fn f(%0: i8) -> i8
b0:
  %1 = const i8 100
  %2 = add i8 %1 %1
  %3 = add i8 %0 %2
  %4 = ret %3
after
fn f(%0: i8) -> i8
b0:
  %1 = const i8 100
  %2 = const i8 -56
  %3 = add i8 %0 %2
  %4 = ret %3

pair fold_compare
pass fold
expect accept
before
fn f(%0: i64) -> i64
b0:
  %1 = const i64 3
  %2 = const i64 5
  %3 = lt bool %1 %2
  %4 = br %3 b1 b2
b1:
  %5 = ret %0
b2:
  %6 = const i64 0
  %7 = ret %6
after
fn f(%0: i64) -> i64
b0:
  %1 = const i64 3
  %2 = const i64 5
  %3 = const bool true
  %4 = br %3 b1 b2
b1:
  %5 = ret %0
b2:
  %6 = const i64 0
  %7 = ret %6

pair fold_compare_wrong
pass fold
expect reject
before
fn f(%0: i64) -> i64
b0:
  %1 = const i64 3
  %2 = const i64 5
  %3 = gt bool %1 %2
  %4 = br %3 b1 b2
b1:
  %5 = ret %0
b2:
  %6 = const i64 0
  %7 = ret %6
after
fn f(%0: i64) -> i64
b0:
  %1 = const i64 3
  %2 = const i64 5
  %3 = const bool true
  %4 = br %3 b1 b2
b1:
  %5 = ret %0
b2:
  %6 = const i64 0
  %7 = ret %6

# x / 0 panics: folding it away (to 0) is wrong
pair fold_div_zero
pass fold
expect reject
before
fn f(%0: i64) -> i64
b0:
  %1 = const i64 7
  %2 = const i64 0
  %3 = div i64 %1 %2
  %4 = ret %3
after
fn f(%0: i64) -> i64
b0:
  %1 = const i64 7
  %2 = const i64 0
  %3 = const i64 0
  %4 = ret %3
