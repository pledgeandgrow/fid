use core;
use vec;
use string;

struct Foo {
    source: str,
    pos: i64,
    len: i64,
}

fn make_foo(source: str) -> Foo {
    return Foo { source: source, pos: 0, len: str_len(source) };
}

fn main() -> i64 {
    var f: Foo = make_foo("null");
    print("pos = ");
    print(int_to_str(f.pos));
    print(" (expected 0)\n");
    print("len = ");
    print(int_to_str(f.len));
    print(" (expected 4)\n");
    return 0;
}
