// ═══════════════════════════════════════════════════════════════════════════
// Tests for extract_line_col
// ═══════════════════════════════════════════════════════════════════════════

fn test_extract_line_col() {
    print("--- extract_line_col ---\n");
    var lc1: I64Pair = extract_line_col("Type error (line 25): something");
    assert_eq_i64(lc1.first, 25, "type error line");

    var lc2: I64Pair = extract_line_col("Parse error at 10:5: something");
    assert_eq_i64(lc2.first, 10, "parse error line");
    assert_eq_i64(lc2.second, 5, "parse error col");

    var lc3: I64Pair = extract_line_col("Error:3:7: something");
    assert_eq_i64(lc3.first, 3, "lexer error line");
    assert_eq_i64(lc3.second, 7, "lexer error col");

    var lc4: I64Pair = extract_line_col("just a message with no line info");
    assert_eq_i64(lc4.first, 0, "no line (returns 0)");
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests for enrich_errors
// ═══════════════════════════════════════════════════════════════════════════

fn test_enrich_errors() {
    print("--- enrich_errors ---\n");
    var source: str = "fn main() {\n    let x = 1;\n}\n";
    var errors1: Vec<str> = Vec::new();
    errors1.push("Type error (line 2): undefined variable 'x'");
    var enriched1: Vec<str> = enrich_errors(errors1, source, "test.fd");
    assert_eq_i64(enriched1.len(), 1, "with line info count");
    assert_true(str_contains(enriched1.get(0), "test.fd"), "contains filename");

    var errors2: Vec<str> = Vec::new();
    errors2.push("some error without line info");
    var enriched2: Vec<str> = enrich_errors(errors2, source, "test.fd");
    assert_eq_i64(enriched2.len(), 1, "no line info count");
    assert_eq_str(enriched2.get(0), "some error without line info", "passthrough");
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests for extract_help
// ═══════════════════════════════════════════════════════════════════════════

fn test_extract_help() {
    print("--- extract_help ---\n");
    assert_true(extract_help("Error: something. Fix: do this instead").is_some(), "Fix");
    assert_true(extract_help("Error: something. Hint: try this").is_some(), "Hint");
    assert_true(extract_help("Error: something with no help").is_none(), "none");
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests for str_substr
// ═══════════════════════════════════════════════════════════════════════════

fn test_str_substr() {
    print("--- str_substr ---\n");
    assert_eq_str(c_str_substr("hello world", 0, 5), "hello", "basic");
    assert_eq_str(c_str_substr("hello world", 6, 11), "world", "middle");
    assert_eq_str(c_str_substr("abc", 0, 100), "abc", "out of bounds end");
    assert_eq_str(c_str_substr("abc", -1, 2), "ab", "negative start");
    assert_eq_str(c_str_substr("abc", 1, 1), "", "empty range");
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests for str_lines
// ═══════════════════════════════════════════════════════════════════════════

fn test_str_lines() {
    print("--- str_lines ---\n");
    var lines1: Vec<str> = c_str_lines("line1\nline2\nline3");
    assert_eq_i64(lines1.len(), 3, "3 lines count");
    assert_eq_str(lines1.get(0), "line1", "line 0");
    assert_eq_str(lines1.get(1), "line2", "line 1");
    assert_eq_str(lines1.get(2), "line3", "line 2");

    var lines2: Vec<str> = c_str_lines("");
    assert_eq_i64(lines2.len(), 1, "empty (1 element)");

    var lines3: Vec<str> = c_str_lines("only line");
    assert_eq_i64(lines3.len(), 1, "single line");
}

