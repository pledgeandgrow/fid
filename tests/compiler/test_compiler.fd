// test_compiler.fd — Tests for the compiler pipeline driver module
//
// Tests the helper functions and utilities in compiler.fd:
//   - edit_distance (Levenshtein)
//   - extract_line_col / parse_error_position
//   - enrich_errors
//   - str_split_n, str_trim_quotes, str_find_last
//   - path_join, path_dirname
//   - str_vec_contains, str_join, str_pad_left
//   - is_capability
//   - extract_help
//
// The full pipeline (build_program_with_path) can't be tested yet because
// the imported compiler modules (opt, codegen_c, etc.) have pre-existing
// visibility conflicts that prevent cross-module compilation.

module test_compiler;

use core;
use vec;
use string;
use compiler::compiler;

// ═══════════════════════════════════════════════════════════════════════════
// Test harness — assert macros (p_panic on failure, like test_opt.fd)
// ═══════════════════════════════════════════════════════════════════════════

fn assert_eq_i64(actual: i64, expected: i64, label: str) -> void {
    if actual != expected {
        print("FAIL: ");
        print(label);
        print(" — expected ");
        print(p_to_str(expected));
        print(", got ");
        print(p_to_str(actual));
        print("\n");
        p_panic("test failed");
    }
    print("  OK: ");
    print(label);
    print("\n");
}

fn assert_eq_str(actual: str, expected: str, label: str) -> void {
    if actual != expected {
        print("FAIL: ");
        print(label);
        print(" — expected \"");
        print(expected);
        print("\", got \"");
        print(actual);
        print("\"\n");
        p_panic("test failed");
    }
    print("  OK: ");
    print(label);
    print("\n");
}

fn assert_true(b: bool, label: str) -> void {
    if !b {
        print("FAIL: ");
        print(label);
        print(" — expected true\n");
        p_panic("test failed");
    }
    print("  OK: ");
    print(label);
    print("\n");
}

fn assert_false(b: bool, label: str) -> void {
    if b {
        print("FAIL: ");
        print(label);
        print(" — expected false\n");
        p_panic("test failed");
    }
    print("  OK: ");
    print(label);
    print("\n");
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests for edit_distance (Levenshtein)
// ═══════════════════════════════════════════════════════════════════════════

fn test_edit_distance() {
    print("--- edit_distance ---\n");
    assert_eq_i64(edit_distance("hello", "hello"), 0, "identical strings");
    assert_eq_i64(edit_distance("", "abc"), 3, "empty to abc");
    assert_eq_i64(edit_distance("abc", ""), 3, "abc to empty");
    assert_eq_i64(edit_distance("cat", "bat"), 1, "cat to bat (1 sub)");
    assert_eq_i64(edit_distance("abc", "abcd"), 1, "abc to abcd (1 ins)");
    assert_eq_i64(edit_distance("abcd", "abc"), 1, "abcd to abc (1 del)");
    assert_eq_i64(edit_distance("abc", "xyz"), 3, "abc to xyz (3 subs)");
    assert_eq_i64(edit_distance("", ""), 0, "both empty");
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests for parse_error_position
// ═══════════════════════════════════════════════════════════════════════════

fn test_parse_error_position() {
    print("--- parse_error_position ---\n");
    var t1: StrTriple = parse_error_position("Error:10:5: unexpected token");
    assert_eq_i64(t1.line, 10, "lexer format line");
    assert_eq_i64(t1.col, 5, "lexer format col");
    assert_eq_str(t1.msg, "unexpected token", "lexer format msg");

    var t2: StrTriple = parse_error_position("Type error (line 42): undefined variable");
    assert_eq_i64(t2.line, 42, "type error format line");

    var t3: StrTriple = parse_error_position("Parse error at 15:3: expected fn");
    assert_eq_i64(t3.line, 15, "parse error format line");
    assert_eq_i64(t3.col, 3, "parse error format col");
    assert_eq_str(t3.msg, "expected fn", "parse error format msg");

    var t4: StrTriple = parse_error_position("some random error message");
    assert_eq_i64(t4.line, 1, "unknown format line (default 1)");
    assert_eq_i64(t4.col, 1, "unknown format col (default 1)");
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests for is_capability
// ═══════════════════════════════════════════════════════════════════════════

fn test_is_capability() {
    print("--- is_capability ---\n");
    assert_true(is_capability("Net"), "Net");
    assert_true(is_capability("IO"), "IO");
    assert_true(is_capability("FS"), "FS");
    assert_true(is_capability("Process"), "Process");
    assert_true(is_capability("Env"), "Env");
    assert_true(is_capability("Medical"), "Medical");
    assert_false(is_capability("Hello"), "Hello (not a capability)");
    assert_false(is_capability(""), "empty string");
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests for str_split_n
// ═══════════════════════════════════════════════════════════════════════════

fn test_str_split_n() {
    print("--- str_split_n ---\n");
    var parts1: Vec<str> = c_str_split_n("a:b:c", ":", 3);
    assert_eq_i64(parts1.len(), 3, "3 parts count");
    assert_eq_str(parts1.get(0), "a", "part 0");
    assert_eq_str(parts1.get(1), "b", "part 1");
    assert_eq_str(parts1.get(2), "c", "part 2");

    var parts2: Vec<str> = c_str_split_n("a:b:c:d", ":", 2);
    assert_eq_i64(parts2.len(), 2, "2 parts count");
    assert_eq_str(parts2.get(0), "a", "limited part 0");
    assert_eq_str(parts2.get(1), "b:c:d", "limited part 1 (remainder)");

    var parts3: Vec<str> = c_str_split_n("abc", ":", 3);
    assert_eq_i64(parts3.len(), 1, "no delim (1 part)");
    assert_eq_str(parts3.get(0), "abc", "no delim part 0");
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests for str_trim_quotes
// ═══════════════════════════════════════════════════════════════════════════

fn test_str_trim_quotes() {
    print("--- str_trim_quotes ---\n");
    assert_eq_str(c_str_trim_quotes("\"hello\""), "hello", "double quotes");
    assert_eq_str(c_str_trim_quotes("'hello'"), "hello", "single quotes");
    assert_eq_str(c_str_trim_quotes("hello"), "hello", "no quotes");
    assert_eq_str(c_str_trim_quotes("\""), "\"", "one char (no trim)");
    assert_eq_str(c_str_trim_quotes(""), "", "empty");
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests for str_find_last
// ═══════════════════════════════════════════════════════════════════════════

fn test_str_find_last() {
    print("--- str_find_last ---\n");
    assert_eq_i64(c_str_find_last("hello/world/test", "/"), 11, "basic");
    assert_eq_i64(c_str_find_last("hello", "/"), -1, "not found");
    assert_eq_i64(c_str_find_last("a", "a"), 0, "single char");
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests for path_join
// ═══════════════════════════════════════════════════════════════════════════

fn test_path_join() {
    print("--- path_join ---\n");
    assert_eq_str(c_path_join("foo", "bar"), "foo/bar", "basic");
    assert_eq_str(c_path_join("foo/", "bar"), "foo/bar", "trailing slash");
    assert_eq_str(c_path_join("", "bar"), "bar", "empty a");
    assert_eq_str(c_path_join("foo", ""), "foo", "empty b");
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests for path_dirname
// ═══════════════════════════════════════════════════════════════════════════

fn test_path_dirname() {
    print("--- path_dirname ---\n");
    assert_eq_str(c_path_dirname("foo/bar/baz.fd"), "foo/bar", "basic");
    assert_eq_str(c_path_dirname("baz.fd"), ".", "no slash");
    assert_eq_str(c_path_dirname("/foo"), "/", "root");
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests for str_vec_contains
// ═══════════════════════════════════════════════════════════════════════════

fn test_str_vec_contains() {
    print("--- str_vec_contains ---\n");
    var v1: Vec<str> = Vec::new();
    v1.push("apple");
    v1.push("banana");
    v1.push("cherry");
    assert_true(c_str_vec_contains(v1, "banana"), "found");
    assert_false(c_str_vec_contains(v1, "grape"), "not found");

    var v2: Vec<str> = Vec::new();
    assert_false(c_str_vec_contains(v2, "anything"), "empty vec");
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests for str_join
// ═══════════════════════════════════════════════════════════════════════════

fn test_str_join() {
    print("--- str_join ---\n");
    var v1: Vec<str> = Vec::new();
    v1.push("a");
    v1.push("b");
    v1.push("c");
    assert_eq_str(c_str_join(v1, ", "), "a, b, c", "basic");

    var v2: Vec<str> = Vec::new();
    v2.push("only");
    assert_eq_str(c_str_join(v2, ", "), "only", "single element");

    var v3: Vec<str> = Vec::new();
    assert_eq_str(c_str_join(v3, ", "), "", "empty vec");
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests for str_pad_left
// ═══════════════════════════════════════════════════════════════════════════

fn test_str_pad_left() {
    print("--- str_pad_left ---\n");
    assert_eq_str(c_str_pad_left("42", 5, 32), "   42", "basic");
    assert_eq_str(c_str_pad_left("hello", 3, 32), "hello", "already long");
    assert_eq_str(c_str_pad_left("abc", 3, 32), "abc", "exact length");
}

