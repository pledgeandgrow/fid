// Tests for I64Pair and StrTriple
// ═══════════════════════════════════════════════════════════════════════════

fn test_helper_types() {
    print("--- helper types ---\n");
    var p: I64Pair = I64Pair_new(10, 20);
    assert_eq_i64(p.first, 10, "I64Pair first");
    assert_eq_i64(p.second, 20, "I64Pair second");

    var t: StrTriple = StrTriple_new(5, 10, "test message");
    assert_eq_i64(t.line, 5, "StrTriple line");
