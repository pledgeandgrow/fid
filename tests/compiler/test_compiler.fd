// ═══════════════════════════════════════════════════════════════════════════
// Tests for classify_error
// ═══════════════════════════════════════════════════════════════════════════

fn test_classify_error() {
    print("--- classify_error ---\n");

    var e1: ErrCode = classify_error("Type error (line 5): undefined variable 'foo'");
    match e1 {
        ErrCode::UndefinedVariable => { print("  OK: undefined variable\n"); }
        _ => { print("  FAIL: expected UndefinedVariable\n"); assert(false); }
    }

    var e2: ErrCode = classify_error("Type error (line 10): undefined function 'bar'");
    match e2 {
        ErrCode::UndefinedFunction => { print("  OK: undefined function\n"); }
        _ => { print("  FAIL: expected UndefinedFunction\n"); assert(false); }
    }

    var e3: ErrCode = classify_error("Parse error at 5:10: expected ';' but got 'Ident'");
    match e3 {
        ErrCode::ExpectedToken => { print("  OK: parse error -> ExpectedToken\n"); }
        _ => { print("  FAIL: expected ExpectedToken\n"); assert(false); }
    }

    var e4: ErrCode = classify_error("Capability error: Net not granted");
    match e4 {
        ErrCode::CapabilityDenied => { print("  OK: capability denied\n"); }
        _ => { print("  FAIL: expected CapabilityDenied\n"); assert(false); }
    }

    var e5: ErrCode = classify_error("Some unknown error");
    match e5 {
        ErrCode::Custom => { print("  OK: unknown -> Custom\n"); }
        _ => { print("  FAIL: expected Custom\n"); assert(false); }
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests for errcode_to_str
// ═══════════════════════════════════════════════════════════════════════════

fn test_errcode_to_str() {
    print("--- errcode_to_str ---\n");

    assert(str_equal(errcode_to_str(ErrCode::UndefinedVariable), "UndefinedVariable"));
    print("  OK: UndefinedVariable\n");

    assert(str_equal(errcode_to_str(ErrCode::TypeMismatch), "TypeMismatch"));
    print("  OK: TypeMismatch\n");

    assert(str_equal(errcode_to_str(ErrCode::Custom), "Custom"));
    print("  OK: Custom\n");
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests for merge_programs
// ═══════════════════════════════════════════════════════════════════════════

fn test_merge_programs() {
    print("--- merge_programs ---\n");

    // Create a minimal stdlib program with one function
    var stdlib: Program = program_new();
    var std_func: Func = Func_new("std_print", Type::Void);
    std_func.is_pub = true;
    stdlib.funcs.push(std_func);

    // Create a user program with one function and one that conflicts
    var user: Program = program_new();
    var user_func: Func = Func_new("my_func", Type::Void);
    user.funcs.push(user_func);
    // User also defines std_print (overrides stdlib)
    var user_std: Func = Func_new("std_print", Type::I64);
    user.funcs.push(user_std);

    var merged: Program = merge_programs(stdlib, user);

    // Should have 2 functions: my_func and std_print (user version)
    assert(merged.funcs.len() == 2);
    print("  OK: merged has 2 functions\n");

    // Check that user's std_print (ret I64) overrode stdlib's (ret Void)
    var found_user_std: bool = false;
    var i: i64 = 0;
    while i < merged.funcs.len() {
        if str_equal(merged.funcs.get(i).name, "std_print") {
            match merged.funcs.get(i).ret_ty {
                Type::I64 => { found_user_std = true; }
                _ => { }
            }
        }
        i = i + 1;
    }
    assert(found_user_std);
    print("  OK: user std_print overrode stdlib\n");
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests for apply_cfg_filter
// ═══════════════════════════════════════════════════════════════════════════

fn test_apply_cfg_filter() {
    print("--- apply_cfg_filter ---\n");

    // Create a program with functions, some with @cfg annotations
    var program: Program = program_new();
    var func1: Func = Func_new("always_present", Type::Void);
    program.funcs.push(func1);

    // apply_cfg_filter should not remove functions without @cfg
    apply_cfg_filter(&mut program);
    assert(program.funcs.len() == 1);
    print("  OK: function without @cfg preserved\n");
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests for process_derive
// ═══════════════════════════════════════════════════════════════════════════

fn test_process_derive() {
    print("--- process_derive ---\n");

    // Create a program with a struct that has @derive(Debug, Clone)
    var program: Program = program_new();
    var s: StructDef = StructDef_new("MyStruct", true);
    s.fields.push(Param_new("x", Type::I64, true));
    s.fields.push(Param_new("y", Type::Str, true));
    s.annotations.push(Annotation_new("derive", c_vec2_str("Debug", "Clone")));
    program.structs.push(s);

    process_derive(&mut program);

    // Should have generated MyStruct_debug_str and MyStruct_clone
    var found_debug: bool = false;
    var found_clone: bool = false;
    var i: i64 = 0;
    while i < program.funcs.len() {
        if str_equal(program.funcs.get(i).name, "MyStruct_debug_str") { found_debug = true; }
        if str_equal(program.funcs.get(i).name, "MyStruct_clone") { found_clone = true; }
        i = i + 1;
    }
    assert(found_debug);
    print("  OK: generated debug_str\n");
    assert(found_clone);
    print("  OK: generated clone\n");
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests for default_expr_for_type
// ═══════════════════════════════════════════════════════════════════════════

fn test_default_expr_for_type() {
    print("--- default_expr_for_type ---\n");

    var e1: Expr = default_expr_for_type(Type::I64);
    match e1 {
        Expr::IntLit(v) => { assert(v == 0); print("  OK: i64 -> 0\n"); }
        _ => { print("  FAIL: expected IntLit\n"); assert(false); }
    }

    var e2: Expr = default_expr_for_type(Type::Bool);
    match e2 {
        Expr::BoolLit(v) => { assert(v == false); print("  OK: bool -> false\n"); }
        _ => { print("  FAIL: expected BoolLit\n"); assert(false); }
    }

    var e3: Expr = default_expr_for_type(Type::Str);
    match e3 {
        Expr::StringLit(v) => { assert(str_equal(v, "")); print("  OK: str -> empty\n"); }
        _ => { print("  FAIL: expected StringLit\n"); assert(false); }
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests for strip_ungranted_caps
// ═══════════════════════════════════════════════════════════════════════════

fn test_strip_ungranted_caps() {
    print("--- strip_ungranted_caps ---\n");

    // Create an IR module with main + a function that uses Net effect
    var module: IrModule = IrModule_new();

    // Add main function (should never be stripped)
    var main_func: IrFunction = IrFunction_new("main", IrType::I64);
    module.functions.push(IrFunctionEntry_new("main", main_func));
    module.function_effects.push(StringEffectSetEntry_new("main", EffectSet_new()));

    // Add a net function (should be stripped if Net not granted)
    var net_func: IrFunction = IrFunction_new("fetch_url", IrType::I64);
    module.functions.push(IrFunctionEntry_new("fetch_url", net_func));
    var net_effects: EffectSet = EffectSet_new();
    EffectSet_add(&mut net_effects, Effect::Net);
    module.function_effects.push(StringEffectSetEntry_new("fetch_url", net_effects));

    // Strip without Net cap — fetch_url should be removed
    strip_ungranted_caps(&mut module, c_vec0_str());

    var has_main: bool = false;
    var has_fetch: bool = false;
    var i: i64 = 0;
    while i < module.functions.len() {
        if str_equal(module.functions.get(i).name, "main") { has_main = true; }
        if str_equal(module.functions.get(i).name, "fetch_url") { has_fetch = true; }
        i = i + 1;
    }
    assert(has_main);
    print("  OK: main preserved\n");
    assert(!has_fetch);
    print("  OK: fetch_url stripped (no Net cap)\n");
}

// ═══════════════════════════════════════════════════════════════════════════
// Main — run all tests
// ═══════════════════════════════════════════════════════════════════════════

pub fn main() {
    print("=== test_compiler.fd ===\n\n");

