// Test: Banking operations with linear Money + @conserve
//
// This test demonstrates a mini banking system where:
//   - Accounts hold linear Money (can't be duplicated)
//   - All operations are @conserve (compiler proves no money created/destroyed)
//   - Interest is @deterministic (no float, same inputs → same outputs)
//   - Transfer uses tuple destructuring: pv (from, to) = Account_transfer(a, b, 100)

use banking;
use money;

pf main() -> i64 {
    // Open account #1 with $1000.00 (100000 cents)
    pv acc1 = Account_open(1, 100000);

    // Deposit $500.00 into account #1
    pv deposit = Money_new(50000);
    pv acc1_after_deposit = Account_deposit(acc1, deposit);

    // Withdraw $200.00 — tuple destructuring gives us both the new account and cash
    pv (acc1_after_withdraw, withdrawn_cash) = Account_withdraw(acc1_after_deposit, 20000);

    // Check withdrawn cash: should be $200.00 (20000 cents)
    pv cash_cents = Money_to_cents(withdrawn_cash);
    print("Withdrawn cash: ");
    print(cash_cents);
    print("\n");

    // Transfer $100.00 from account #1 to a new account #2
    pv acc2 = Account_open(2, 0);
    pv (acc1_after_transfer, acc2_after_transfer) = Account_transfer(acc1_after_withdraw, acc2, 10000);

    // Accrue 5% interest (500 basis points) on account #1
    // balance = 100000 + 50000 - 20000 - 10000 = 120000
    // interest = 120000 * 500 / 10000 = 6000
    // new balance = 120000 + 6000 = 126000
    pv acc1_with_interest = Account_accrue_interest(acc1_after_transfer, 500);

    // Check final balances
    pv balance1 = Account_balance_cents(acc1_with_interest);
    print("Account #1 final balance: ");
    print(balance1);
    print("\n");

    pv balance2 = Account_balance_cents(acc2_after_transfer);
    print("Account #2 final balance: ");
    print(balance2);
    print("\n");

    // Summary:
    // Account #1: $1000 + $500 - $200 - $100 + 5% interest = $1265.00 (126500 cents)
    //   Wait: 120000 * 1.05 = 126000 cents = $1260.00
    // Account #2: $0 + $100 = $100.00 (10000 cents)
    // Cash out: $200.00 (20000 cents)
    print("OK\n");

    ret 0;
}
