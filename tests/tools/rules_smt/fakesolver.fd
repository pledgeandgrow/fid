// A stand-in solver for tests/tools/rules_smt/check.sh: `unknown` for an
// obligation whose file name holds "_8", `sat` (with a CRLF) for one with
// "_9", `unsat` for the rest.
use core;
use args;
fn main() -> i64 {
    val f: str = args_all().get(1);
    if str_contains(f, "_8") {
        println("unknown");
    } else if str_contains(f, "_9") {
        print("sat\r\n(model)\r\n");
    } else {
        println("unsat");
    }
    return 0;
}
