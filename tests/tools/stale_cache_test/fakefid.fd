// A stand-in compiler for tests/tools/stale_cache_test/check.sh: its
// `ccompile ... -o <exe>` copies $FAKE_EXE to <exe> (a program that always
// prints 42: a cache that never invalidates) and says "up to date" when
// FAKE_UPTODATE is set; FAKE_FAIL=n exits n without building.
use core;
use args;
use fs;
fn main() -> i64 {
    val a: Vec<str> = args_all();
    match env_var("FAKE_FAIL") {
        Option::Some(n) => { return str_parse_int(n); }
        Option::None => { }
    }
    var out: str = "";
    var i: i64 = 1;
    while i + 1 < a.len() {
        if a.get(i) == "-o" { out = a.get(i + 1); }
        i = i + 1;
    }
    match env_var("FAKE_EXE") {
        Option::Some(src) => { fs_copy_file(src, out); }
        Option::None => { }
    }
    match env_var("FAKE_UPTODATE") {
        Option::Some(u) => { println("main.exe is Up To Date"); }
        Option::None => { println("fake build of " + out); }
    }
    return 0;
}
