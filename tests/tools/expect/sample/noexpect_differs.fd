// sample: no expectations, and the backends print something else (the
// executable's name): "backends disagree"
use args;
fn main() -> i64 {
    val a: str = args_all().get(0);
    var i: i64 = str_len(a);
    while i > 0 && str_byte_at(a, i - 1) != 47 && str_byte_at(a, i - 1) != 92 { i = i - 1; }
    println(str_slice(a, i, str_len(a)));
    return 0;
}
