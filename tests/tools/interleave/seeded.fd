// tests/tools/interleave/check.sh: a program whose output is the seed
// --sched-random hands it (FIDES_SCHED_RANDOM; "none" in the reference
// run): every run differs from the reference, each in its own way.

fn main() -> i64 {
    match env_var("FIDES_SCHED_RANDOM") {
        Option::Some(v) => { println("seed " + v); }
        Option::None => { println("none"); }
    }
    return 0;
}
