// tests/tools/soak/check.sh: a service that stops after three heartbeats
// with an error on stderr (soak: "the process ended early (exit 3)").
use io;
use task;

fn main() -> i64 {
    var i: i64 = 0;
    while i < 3 {
        println("beat " + int_to_str(i));
        task_sleep(200);
        i = i + 1;
    }
    io_eprintln("early: giving up");
    return 3;
}
