// tests/tools/soak/check.sh: a service whose memory grows by about 2 MB a
// second and never shrinks (soak: "memory grows ... MB/hour").
use task;

fn main() -> i64 {
    var keep: Vec<str> = Vec::new();
    var i: i64 = 0;
    while true {
        keep.push(str_repeat("x", 200000) + int_to_str(i));
        println("beat " + int_to_str(i) + " " + int_to_str(keep.len()));
        task_sleep(100);
        i = i + 1;
    }
    return 0;
}
