// Examples for tests/tools/doctest/check.sh: tools/doctest.fd must print
// what scripts/doctest.py prints over this folder. The module is core, so
// each generated program finds it (`use core;`). Not a test program itself.
module core;

/// Passes.
///
/// Example:
///   assert_eq(str_len("abc"), 3);
pub fn ds_sample_pass() -> i64 { return 0; }

/// Fails an assertion.
///
/// Example:
///   assert_eq(str_len("ab"), 3);
pub fn ds_sample_fail() -> i64 { return 0; }

/// Panics: an index out of range.
///
/// Example:
///   val v: Vec<i64> = Vec::new();
///   print(v.get(3));
pub struct DsSample { pub a: i64 }

/// Its own main, and a use line.
///
/// Example:
///   use math;
///   fn main() -> i64 {
///       println("hi");
///       return 0;
///   }
pub const DS_SAMPLE: i64 = 1;

/// Does not compile.
///
/// Example:
///   val x: i64 = "text";
pub enum DsSampleE { A, B }

    /// Example (native only):
    ///   println(int_to_str(1 + 1));
pub fn ds_sample_native() -> i64 { return 0; }

/// Returns early.
///
/// Example:
///   if str_len("a") == 1 { return 0; }
///   return 1;
pub fn ds_sample_early() -> i64 { return 0; }
