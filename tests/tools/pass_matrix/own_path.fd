// tests/tools/pass_matrix/check.sh copies this into its tree as
// tests/bootstrap/test_own_path.fd: it prints the path of its own
// executable, which is in each run's own OUT folder, so its output differs
// from run to run ("output differs:" lines).
use args;
fn main() -> i64 {
    println(args_all().get(0));
    return 0;
}
