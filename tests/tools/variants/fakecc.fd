// A stand-in for a mutant compiler in tests/tools/variants/check.sh: it
// takes `fid`'s command line (<command> <test> ... -o <exe>) and "builds"
// every test into a copy of the program $FAKE_EXE names (one that prints
// something no sample test prints), so each test's output changes and the
// mutant is killed; a test whose name ends in _fail.fd does not build, as
// with the real compiler. It stands in for a build of the compiler with
// the mutant's edit, which takes minutes and gigabytes.
use core;
use args;
use fs;
use io;

fn main() -> i64 {
    val av: Vec<str> = args_all();
    var test: str = "";
    var out: str = "";
    var i: i64 = 1;
    while i < av.len() {
        if av.get(i) == "-o" && i + 1 < av.len() {
            out = av.get(i + 1);
        } else if i == 2 {
            test = av.get(i);
        }
        i = i + 1;
    }
    if str_ends_with(test, "_fail.fd") {
        io_eprintln("error: does not build");
        return 1;
    }
    var exe: str = "";
    match env_var("FAKE_EXE") {
        Option::Some(e) => {
            exe = e;
        }
        Option::None => {
            return 2;
        }
    }
    if str_len(out) == 0 || fs_copy_file(exe, out) < 0 {
        return 3;
    }
    return 0;
}
