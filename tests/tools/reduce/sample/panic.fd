// A program that divides by zero after some work that has nothing to do
// with it: tools/reduce.fd and scripts/fuzz/reduce.py --fails run must
// shrink it to the same few lines.
fn helper(n: i64) -> i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < n {
        acc = acc + i;
        i = i + 1;
    }
    return acc;
}

fn other(x: i64) -> i64 {
    if x > 10 {
        return x - 10;
    }
    return x;
}

fn main() -> i64 {
    var a: i64 = helper(5);
    var b: i64 = other(a);
    println(a);
    println(b);
    var z: i64 = 0;
    if a > 3 {
        println("big");
    }
    var q: i64 = 7 / z;
    println(q);
    return 0;
}
