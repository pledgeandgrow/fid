// test_shape_verify.fd — ML2: Comptime tensor shape verification
// Expected: PASS
// Tests compile-time shape checking for matmul, add, transpose, etc.
// The typechecker verifies shape compatibility at compile time.

use tensor;
use shape;

fn main() {
    // Create tensors with known shapes using from_vec
    // Tensor<f64, [2, 3]> — 2x3 matrix
    val a_data = Vec::new();
    a_data.push(1); a_data.push(2); a_data.push(3);
    a_data.push(4); a_data.push(5); a_data.push(6);
    val a = from_vec(a_data, shape_2x3);

    // Tensor<f64, [3, 2]> — 3x2 matrix (compatible for matmul with 2x3)
    val w_data = Vec::new();
    w_data.push(1); w_data.push(0);
    w_data.push(0); w_data.push(1);
    w_data.push(0); w_data.push(0);
    val w = from_vec(w_data, shape_3x2);

    // matmul(2x3, 3x2) = 2x2 — shape compatible, should compile
    val c = matmul(a, w);
    print(to_str(c));
    print("\n");

    // transpose(2x3) = 3x2
    val t = transpose(a);
    print(to_str(t));
    print("\n");

    // Elementwise ops on same-shaped tensors
    val b = ones(shape_2x3);
    val d = add(a, b);
    print(to_str(d));
    print("\n");

    return 0;
}
