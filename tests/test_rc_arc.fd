// test_rc_arc.fd -- Test Rc and Arc reference counting
//
// Verifies:
//   - rc_new creates with refcount 1
//   - rc_clone increments refcount
//   - rc_drop decrements refcount
//   - rc_get returns the wrapped value
//   - Arc works the same way (atomic)
//   - Multiple clones and drops work correctly

module test_rc_arc;

use core;
use rc;

pub fn main() -> i64 {
    // --- Test Rc ---

    // Create an Rc wrapping 42
    var r1 = rc_new(42);
    if rc_count(r1) != 1 {
        print("FAIL: rc_count should be 1 after new\n");
        return 1;
    }
    if rc_get(r1) != 42 {
        print("FAIL: rc_get should return 42\n");
        return 1;
    }

    // Clone it -- refcount should be 2
    var r2 = rc_clone(r1);
    if rc_count(r1) != 2 {
        print("FAIL: rc_count should be 2 after clone\n");
        return 1;
    }
    if rc_get(r2) != 42 {
        print("FAIL: rc_get on clone should return 42\n");
        return 1;
    }

    // Clone again -- refcount should be 3
    var r3 = rc_clone(r1);
    if rc_count(r1) != 3 {
        print("FAIL: rc_count should be 3 after second clone\n");
        return 1;
    }

    // Drop one -- refcount should be 2
    rc_drop(r3);
    if rc_count(r1) != 2 {
        print("FAIL: rc_count should be 2 after drop\n");
        return 1;
    }

    // Drop the rest
    rc_drop(r2);
    rc_drop(r1);

    // --- Test Arc ---

    var a1 = arc_new(100);
    if arc_count(a1) != 1 {
        print("FAIL: arc_count should be 1 after new\n");
        return 1;
    }
    if arc_get(a1) != 100 {
        print("FAIL: arc_get should return 100\n");
        return 1;
    }

    var a2 = arc_clone(a1);
    if arc_count(a1) != 2 {
        print("FAIL: arc_count should be 2 after clone\n");
        return 1;
    }
    if arc_get(a2) != 100 {
        print("FAIL: arc_get on clone should return 100\n");
        return 1;
    }

    arc_drop(a2);
    if arc_count(a1) != 1 {
        print("FAIL: arc_count should be 1 after drop\n");
        return 1;
    }

    arc_drop(a1);

    print("OK\n");
    return 0;
}
