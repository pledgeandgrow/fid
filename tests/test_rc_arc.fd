// Test: Rc/Arc — reference counting smart pointers
//
// Rc<T> = single-threaded reference counting
// Arc<T> = atomic reference counting (thread-safe)
//
// API: Rc::new(x), rc.clone(), rc.drop(), rc.get(), rc.count()
// Same for Arc.

pf test_rc_basic() -> i64 {
    // Create an Rc<i64> with value 42
    pv rc = Rc::new(42);
    // Get the value
    pv val = rc.get();
    // Refcount should be 1
    pv cnt = rc.count();
    // Clone — refcount becomes 2
    pv rc2 = rc.clone();
    pv cnt2 = rc.count();
    // Drop one — refcount back to 1
    rc2.drop();
    pv cnt3 = rc.count();
    // Clean up
    rc.drop();
    // Return 0 if all checks pass
    if val == 42 && cnt == 1 && cnt2 == 2 && cnt3 == 1 {
        ret 0;
    }
    ret 1;
}

pf test_rc_struct() -> i64 {
    // Rc with a struct value
    pv rc = Rc::new(100);
    pv rc2 = rc.clone();
    pv v1 = rc.get();
    pv v2 = rc2.get();
    rc2.drop();
    rc.drop();
    if v1 == 100 && v2 == 100 {
        ret 0;
    }
    ret 1;
}

pf test_arc_basic() -> i64 {
    // Arc<i64> — atomic reference counting
    pv arc = Arc::new(99);
    pv val = arc.get();
    pv cnt = arc.count();
    pv arc2 = arc.clone();
    pv cnt2 = arc.count();
    arc2.drop();
    pv cnt3 = arc.count();
    arc.drop();
    if val == 99 && cnt == 1 && cnt2 == 2 && cnt3 == 1 {
        ret 0;
    }
    ret 1;
}

pf main() -> i64 {
    pv r1 = test_rc_basic();
    pv r2 = test_rc_struct();
    pv r3 = test_arc_basic();
    print(r1);
    print(r2);
    print(r3);
    if r1 == 0 && r2 == 0 && r3 == 0 {
        print(0);
    } else {
        print(1);
    }
    ret 0;
}
