// Test: Rc/Arc — reference counting smart pointers
//
// Rc<T> = single-threaded reference counting
// Arc<T> = atomic reference counting (thread-safe)
//
// API: Rc::new(x), rc.clone(), rc.drop(), rc.get(), rc.count()
// Same for Arc.

fn test_rc_basic() -> i64 {
    // Create an Rc<i64> with value 42
    val rc = Rc::new(42);
    // Get the value
    val value = rc.get();
    // Refcount should be 1
    val cnt = rc.count();
    // Clone — refcount becomes 2
    val rc2 = rc.clone();
    val cnt2 = rc.count();
    // Drop one — refcount back to 1
    rc2.drop();
    val cnt3 = rc.count();
    // Clean up
    rc.drop();
    // Return 0 if all checks pass
    if value == 42 && cnt == 1 && cnt2 == 2 && cnt3 == 1 {
        return 0;
    }
    return 1;
}

fn test_rc_struct() -> i64 {
    // Rc with a struct value
    val rc = Rc::new(100);
    val rc2 = rc.clone();
    val v1 = rc.get();
    val v2 = rc2.get();
    rc2.drop();
    rc.drop();
    if v1 == 100 && v2 == 100 {
        return 0;
    }
    return 1;
}

fn test_arc_basic() -> i64 {
    // Arc<i64> — atomic reference counting
    val arc = Arc::new(99);
    val value = arc.get();
    val cnt = arc.count();
    val arc2 = arc.clone();
    val cnt2 = arc.count();
    arc2.drop();
    val cnt3 = arc.count();
    arc.drop();
    if value == 99 && cnt == 1 && cnt2 == 2 && cnt3 == 1 {
        return 0;
    }
    return 1;
}

fn main() -> i64 {
    val r1 = test_rc_basic();
    val r2 = test_rc_struct();
    val r3 = test_arc_basic();
    print(r1);
    print(r2);
    print(r3);
    if r1 == 0 && r2 == 0 && r3 == 0 {
        print(0);
    } else {
        print(1);
    }
    return 0;
}
