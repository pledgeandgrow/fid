// Fuzz driver for the stdlib parsers (roadmap VF15; scripts/fuzz/fuzz_parsers.py).
//
//   parsers <parser> <input file>
//
// Runs one parser on the bytes of the file and prints a short summary of
// the result, so a run that returns shows it reached the end. The parsers
// here are the stdlib's entry points for untrusted text; none of them is
// documented to panic (json_parse is; json_parse_safe is the one for
// untrusted input), so a panic, a crash or a hang is a finding.

use json;
use regex;
use http;
use csv;
use toml;
use xml;
use url;
use uuid;
use fs;
use tls_record;

fn xml_count(n: XmlNode) -> i64 {
    var total: i64 = 1;
    for c in n.children {
        total = total + xml_count(c);
    }
    return total;
}

fn main() -> i64 {
    val which: str = arg_at(1) ?? "";
    val path: str = arg_at(2) ?? "";
    val text: str = read_file(path) ?? "";
    if which == "json" {
        val r = json_parse_safe(text);
        println(str_len(r));
        println(json_is_valid(text));
    } else if which == "regex" {
        // first line: the pattern, the rest: the subject
        val nl = str_find(text, "\n");
        var pat: str = text;
        var subject: str = "";
        if nl >= 0 {
            pat = str_slice(text, 0, nl);
            subject = str_slice(text, nl + 1, str_len(text));
        }
        println(regex_match(subject, pat));
        println(regex_matches(subject, pat));
    } else if which == "http" {
        val req = http_parse_head(text);
        println(str_len(req.method) + str_len(req.path));
        val r2 = parse_request(text);
        println(str_len(r2));
    } else if which == "csv" {
        val rows = csv_parse(text);
        println(rows.len());
        val recs = csv_parse_records(text);
        println(recs.len());
    } else if which == "toml" {
        val es = toml_parse(text);
        println(es.len());
    } else if which == "xml" {
        val n = xml_parse(text);
        println(xml_count(n));
    } else if which == "url" {
        val u = url_parse(text);
        println(str_len(u.host) + u.port);
        println(str_len(url::url_decode(text)));  // encoding.fd (through http) has one too
    } else if which == "tls" {
        // the file's bytes as a TLS stream: records, then the handshake
        // messages and alerts in them, then each application_data record
        // opened under a fixed key (all fail to authenticate: no panic)
        val bytes: Vec<i64> = fs_read_bytes(path);
        val rs: TlsRecords = tls_records_parse(bytes);
        println(rs.records.len() + rs.consumed + rs.error);
        var hsdata: Vec<i64> = Vec::new();
        var key: Vec<i64> = Vec::new();
        var iv: Vec<i64> = Vec::new();
        var k: i64 = 0;
        while k < 32 { key.push(k); if k < 12 { iv.push(k); } k = k + 1; }
        var ri: i64 = 0;
        while ri < rs.records.len() {
            val rec: TlsRecord = rs.records.get(ri);
            if rec.ctype == TLS_CT_HANDSHAKE {
                var j: i64 = 0;
                while j < rec.fragment.len() { hsdata.push(rec.fragment.get(j)); j = j + 1; }
            } else if rec.ctype == TLS_CT_ALERT {
                println(tls_alert_parse(rec.fragment).error);
            } else if rec.ctype == TLS_CT_APPLICATION_DATA {
                println(tls_record_open(key, iv, ri, rec).error);
                println(tls_inner_parse(rec.fragment).error);
            }
            ri = ri + 1;
        }
        val hm: TlsHandshakes = tls_handshake_parse(hsdata);
        println(hm.messages.len() + hm.consumed + hm.error);
    } else if which == "uuid" {
        val id = uuid_parse(text);
        println(id.bytes.len());
    } else {
        println("unknown parser");
        return 2;
    }
    return 0;
}
