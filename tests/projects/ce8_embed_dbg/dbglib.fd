// CE8 (complaint-roadmap): a library built with `fid ccompile --lib -g`
// keeps a frame record per call (codegen_c.fd cg_dbg_prologue). A panic
// caught by fides_call's longjmp leaves the callee's record on a stack
// that is gone; fides_call makes the record current when it began current
// again (P_DBG_EMBED_RESTORE), on both its return paths. build.sh builds
// this with host.c and checks the generated C and the host's output.

@export
fn scaled_div(a: i64, b: i64) -> i64 {
    var scaled: i64 = a * 10;
    return scaled / b;
}

@export
fn twice(x: i64) -> i64 {
    var t: i64 = x + x;
    return t;
}
