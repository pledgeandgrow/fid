// CB9 (docs/roadmap/complaint-roadmap.md): the module of main.fd that
// declares a C function no library provides. `fid ccompile main.fd` fails
// at link time and the report names this file and line:
//   error: link: the C function 'fides_cb9_import_missing' is not in any library the program links
//     --> .../cb9_ffi.fd:9: declared in an extern "C" block that names no library
module cb9_ffi;

extern "C" {
    fn fides_cb9_import_missing(x: i64) -> i64;
}

@unsafe
pub fn call_missing(x: i64) -> i64 {
    return fides_cb9_import_missing(x);
}
