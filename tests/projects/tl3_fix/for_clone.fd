// TL3 (docs/roadmap/competitive-roadmap.md): input of
// tests/tooling/fix-tl3-check.sh. As written it is rejected (a borrow
// error): `v` is changed while a `for` loop iterates over it. `fid fix`
// makes the loop iterate over a copy (`for x in v.clone()`): the loop sees
// the three elements it started with, the pushes stay in `v`, and the
// program then prints:
//   5
//   1 2 3 20 30

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    for x in v {
        if x > 1 {
            v.push(x * 10);
        }
    }
    print(v.len());
    print("\n");
    var i: i64 = 0;
    while i < v.len() {
        if i > 0 {
            print(" ");
        }
        print(v.get(i));
        i = i + 1;
    }
    print("\n");
    return 0;
}
