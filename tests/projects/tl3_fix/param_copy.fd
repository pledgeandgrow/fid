// TL3 (docs/roadmap/competitive-roadmap.md): input of
// tests/tooling/fix-tl3-check.sh. As written it is rejected: `items` is a
// by-value parameter of `count_with_extra` and the body changes it.
// `fid fix` adds `var items = items;` as the first line of the body (the
// body changes a copy; the caller's Vec is unchanged), and the program
// then prints:
//   3
//   2

fn count_with_extra(items: Vec<i64>, extra: i64) -> i64 {
    items.push(extra);
    return items.len();
}

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    print(count_with_extra(v, 9));
    print("\n");
    print(v.len());
    print("\n");
    return 0;
}
