// CO5: a program that runs like a service (30 s, or until it is stopped),
// for `fid profile --pid <N>`: the profiler attaches to it while it runs
// (tests/tooling/co5-profile-pid-check.sh). co5_hot does three times the
// work of co5_cold, so it should take about three times the samples. Both
// recurse once, so the C compiler keeps them as functions of their own.

fn co5_hot(depth: i64, n: i64) -> i64 {
    if depth > 0 {
        return co5_hot(depth - 1, n) + 1;
    }
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n {
        s = (s * 31 + i) % 1000003;
        i = i + 1;
    }
    return s;
}

fn co5_cold(depth: i64, n: i64) -> i64 {
    if depth > 0 {
        return co5_cold(depth - 1, n) + 1;
    }
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n {
        s = (s * 17 + i) % 999983;
        i = i + 1;
    }
    return s;
}

fn co5_step(r: i64) -> i64 {
    return (co5_hot(1, 3000000) + co5_cold(1, 1000000) + r) % 7;
}

fn main() {
    println("co5 service running");
    val t0: i64 = p_clock_now_ms();
    var r: i64 = 0;
    var rounds: i64 = 0;
    while p_clock_now_ms() - t0 < 30000 {
        r = co5_step(r);
        rounds = rounds + 1;
    }
    println("co5 service done: " + int_to_str(rounds) + " rounds, " + int_to_str(r));
}
