// TL3: `fid fix stated.fd --edition 2027` (tests/tooling/fix-edition-check.sh).
// The file states edition 2026; the upgrade fixes the deprecated call and
// changes that line to `#[edition(2027)]` (one edition line, not two).
// Expected output:
// 6
#[edition(2026)]

@deprecated(use = "area_of")
fn area(w: i64, h: i64) -> i64 {
    return w * h;
}

fn area_of(w: i64, h: i64) -> i64 {
    return w * h;
}

fn main() -> i64 {
    println(area(2, 3));
    return 0;
}
