// TL3: `fid fix upgrade.fd --edition 2027` (tests/tooling/fix-edition-check.sh).
// In edition 2026 a call of a @deprecated function is a warning; in 2027 it
// is an error. The upgrade replaces each call that names its replacement
// (functions and a method, two on one line), then states edition 2027,
// since the file then checks clean under it.
// Expected output:
// 7
// 12
// 6

struct Meter {
    n: i64,
}

impl Meter {
    @deprecated(use = "value")
    fn old_value(self: Meter) -> i64 {
        return self.n;
    }

    fn value(self: Meter) -> i64 {
        return self.n;
    }
}

@deprecated(use = "add")
fn plus(a: i64, b: i64) -> i64 {
    return a + b;
}

fn add(a: i64, b: i64) -> i64 {
    return a + b;
}

@deprecated(use = "triple")
fn times3(x: i64) -> i64 {
    return x * 3;
}

fn triple(x: i64) -> i64 {
    return x * 3;
}

fn main() -> i64 {
    val s: i64 = plus(3, 4);
    println(s);
    println(times3(plus(1, 3)));
    val m: Meter = Meter { n: 6 };
    println(m.old_value());
    return 0;
}
