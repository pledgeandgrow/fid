// TL3: `fid fix stuck.fd --edition 2027` (tests/tooling/fix-edition-check.sh).
// `half` names its replacement, so its call is fixed; `twice` does not, so
// the file would not check clean under edition 2027: the edition is not
// stated (the file stays in 2026, where the call is a warning) and the
// status is 1.
// Expected output:
// 5
// 8

@deprecated(use = "half_of")
fn half(x: i64) -> i64 {
    return x / 2;
}

fn half_of(x: i64) -> i64 {
    return x / 2;
}

@deprecated("multiply by 2 where you need it")
fn twice(x: i64) -> i64 {
    return x * 2;
}

fn main() -> i64 {
    println(half(10));
    println(twice(4));
    return 0;
}
