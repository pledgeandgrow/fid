// CB1 (complaint-roadmap): the import cache keeps each imported module's
// parse on disk. tests/tooling/cb1-impcache-check.sh runs this program with
// the cache off, cold and warm: the output must not change.
use calc;
use geo as g;

fn main() -> i64 {
    print(int_to_str(calc::both(2)));
    print("\n");
    print(int_to_str(calc::boxed(3, 5)));
    print("\n");
    print(int_to_str(g::area(4, 6)));
    print("\n");
    return 0;
}
