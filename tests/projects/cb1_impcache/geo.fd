// CB1 import-cache fixture: a module whose function name `area` is also
// defined by calc.fd (both are renamed module__area; the qualified calls
// a parse records must come back on a cache hit).
module geo;

pub struct Rect {
    pub w: i64,
    pub h: i64,
}

pub enum Shape {
    Square(i64),
    Box(Rect),
}

pub fn area(w: i64, h: i64) -> i64 {
    return w * h;
}

pub fn shape_area(s: Shape) -> i64 {
    match s {
        Shape::Square(n) => {
            return n * n;
        }
        Shape::Box(r) => {
            return r.w * r.h;
        }
    }
}
