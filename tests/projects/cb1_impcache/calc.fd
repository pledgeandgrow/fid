// CB1 import-cache fixture: `geo::area` is a qualified call of the other
// module's `area` (the parser records it); `area` alone is this module's.
// The word Gadget only occurs here in this comment: a program that defines
// a struct Gadget parses this file under a different key.
module calc;
use geo;

pub fn area(r: i64) -> i64 {
    return 3 * r * r;
}

pub fn both(r: i64) -> i64 {
    return geo::area(r, 2) + area(r);
}

pub fn boxed(w: i64, h: i64) -> i64 {
    var r: Rect = Rect { w: w, h: h };
    return geo::shape_area(Shape::Box(r)) + geo::shape_area(Shape::Square(w));
}
