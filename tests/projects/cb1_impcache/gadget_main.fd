// CB1: the same modules imported by a program that defines struct Gadget
// (a word of calc.fd): calc.fd's cache key differs, so it is parsed again.
use calc;

pub struct Gadget {
    pub n: i64,
}

fn main() -> i64 {
    var gd: Gadget = Gadget { n: 7 };
    print(int_to_str(calc::both(gd.n)));
    print("\n");
    return 0;
}
