// tests/projects/library/app: an application of the textkit library
// (release-roadmap N11, N1). It is not built in place: scripts/ark-check.sh
// copies it into a fresh directory, runs `fid ark init`, `fid ark add
// textkit --path ...` and `fid ark install`, then runs and builds it.
// ../expected.txt is what it prints.
use textkit;

fn main() -> i64 {
    println(tk_reverse("stressed"));
    if tk_is_palindrome("Never odd or even") {
        println("palindrome");
    } else {
        println("not a palindrome");
    }
    if tk_is_palindrome("Fides") {
        println("palindrome");
    } else {
        println("not a palindrome");
    }
    println(int_to_str(tk_word_count("  the quick  brown fox ")));
    val secret: str = tk_caesar("Hello, Fides!", 3);
    println(secret);
    println(tk_caesar(secret, -3));
    return 0;
}
