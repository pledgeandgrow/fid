// CT8 / known-bugs 2g.30: `fid veil` on a program that panics prints the
// panic and the whole report (lines, branches) and does not crash
// (tests/tooling/test-coverage-check.sh).

fn checked_div(a: i64, b: i64) -> i64 {
    if b == 0 {
        panic("division by zero");
    }
    return a / b;
}

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(checked_div(6, 3));
    print(int_to_str(v.get(0)) + "\n");
    return checked_div(1, 0);
}
