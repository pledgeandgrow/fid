// CT8: a test suite whose second test panics, for `fid test --coverage`
// (tests/tooling/test-coverage-check.sh). `sign` has a branch the suite
// never takes (n < 0), for the branch report.

fn sign(n: i64) -> i64 {
    if n < 0 {
        return 0 - 1;
    }
    if n == 0 {
        return 0;
    }
    return 1;
}

fn checked_div(a: i64, b: i64) -> i64 {
    if b == 0 {
        panic("division by zero");
    }
    return a / b;
}

fn test_sign() {
    assert(sign(5) == 1);
    assert(sign(0) == 0);
}

fn test_div_panics() {
    assert(checked_div(1, 0) == 0);
}

fn test_div() {
    assert(checked_div(6, 3) == 2);
}
