// CO9: a program that panics two calls deep, for `fid run --crash-report`
// and `fid inspect` (tests/tooling/crash-report-check.sh).

fn parse_age(s: str) -> i64 {
    if s == "" {
        panic("empty age field");
    }
    return str_parse_int(s);
}

fn load_record(line: str) -> i64 {
    return parse_age(line);
}

fn main() {
    println("loading");
    println(load_record("42"));
    println(load_record(""));
    println("unreachable");
}
