// CE5 fixture: the lint asks for 'myVal' to be named my_val, but my_val is
// already a variable of the function: renaming would make the two one, so
// `fid fix` leaves the file as it is. The program prints:
//   3
fn main() {
    var my_val: i64 = 1;
    var myVal: i64 = 2;
    println(int_to_str(my_val + myVal));
}
