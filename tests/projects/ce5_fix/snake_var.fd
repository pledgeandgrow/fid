// CE5 fixture: `fid fix` renames a variable that is not snake_case (lint:
// "variable 'totalCount' in 'main' should be snake_case: total_count"),
// every use in its function with it; the struct field of the same name,
// the string and the comment keep their text. The program prints:
//   totalCount 6 6
struct Stats {
    totalCount: i64,
}

fn main() {
    var totalCount: i64 = 0;
    var i: i64 = 1;
    while i <= 3 {
        totalCount = totalCount + i;
        i = i + 1;
    }
    // totalCount stays in this comment
    val s: Stats = Stats { totalCount: totalCount };
    println("totalCount " + int_to_str(s.totalCount) + " " + int_to_str(totalCount));
}
