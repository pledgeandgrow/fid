// CE5 fixture: `fid fix` passes an owned copy of a borrowed string
// (Borrow error: parameter takes an owned str, given a borrowed string).
@scoped
struct Msg {
    text: str,
}

fn remember(n: i64, s: str) -> i64 {
    return n + str_len(s);
}

fn main() {
    val m: Msg = Msg { text: "a" };
    println(int_to_str(remember(1, m.text)));
}
