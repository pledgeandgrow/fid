// CE5 fixture: `fid fix` adds the fields a `S { .., .. }` literal leaves
// out that have no default (Type error: "the literal of struct 'Item'
// leaves out field 'count', which has no default"), each with the zero
// value of its type, before the `..`: in a literal on one line and in one
// written over several lines. `note` has a default and stays left out.
// The program prints:
//   pen 0 false 0 -
//   ink 0 true 0 -
struct Item {
    name: str,
    count: i64,
    sold: bool,
    tags: Vec<str>,
    note: str = "-",
}

fn show(it: & Item) {
    var s: str = "false";
    if it.sold {
        s = "true";
    }
    println(it.name + " " + int_to_str(it.count) + " " + s + " " + int_to_str(it.tags.len()) + " " + it.note);
}

fn main() {
    val a: Item = Item { name: "pen", sold: false, .. };
    val b: Item = Item {
        name: "ink",
        sold: true,
        ..
    };
    show(& a);
    show(& b);
}
