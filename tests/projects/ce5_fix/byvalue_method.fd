// CE5 fixture: `fid fix` on a by-value parameter of a method that its body
// changes (Type error: "'extra' is a by-value parameter of
// 'add_all' and cannot be changed"): the body changes a copy
// (`var extra = extra;`), the caller's Vec stays as it was. The program
// prints:
//   3 1
struct Basket {
    n: i64,
}

impl Basket {
    fn add_all(self: & mut Basket, extra: Vec<i64>) {
        extra.push(0);
        self.n = self.n + extra.len();
    }
}

fn main() {
    var b: Basket = Basket { n: 1 };
    var v: Vec<i64> = Vec::new();
    v.push(5);
    b.add_all(v);
    println(int_to_str(b.n) + " " + int_to_str(v.len()));
}
