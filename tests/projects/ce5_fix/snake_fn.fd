// CE5 fixture: `fid fix` renames a function that is not snake_case (lint:
// "function 'addTwo' should be snake_case: add_two") with every call of it
// in the file; the string "addTwo" keeps its text. The program prints:
//   addTwo 7
fn addTwo(n: i64) -> i64 {
    return n + 2;
}

fn main() {
    val a: i64 = addTwo(1);
    println("addTwo " + int_to_str(addTwo(a) + 2));
}
