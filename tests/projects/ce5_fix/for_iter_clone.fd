// CE5 fixture: `fid fix` on a borrow conflict (Borrow error: "cannot
// create &mut names while a `for` loop iterates over it"): the loop goes
// over a copy (`for n in names.clone() {`), and what add_mark pushes stays
// in `names`. The program prints:
//   4 b!
fn add_mark(v: & mut Vec<str>, s: str) {
    v.push(s + "!");
}

fn main() {
    var names: Vec<str> = Vec::new();
    names.push("a");
    names.push("b");
    for n in names {
        add_mark(& mut names, n);
    }
    println(int_to_str(names.len()) + " " + names.get(3));
}
