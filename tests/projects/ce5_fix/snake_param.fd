// CE5 fixture: `fid fix` renames a parameter that is not snake_case (lint:
// "parameter 'maxLen' of 'clip' should be snake_case: max_len") and its
// uses in the body; another function's own `maxLen` is left alone. The
// program prints:
//   abc 4
fn clip(s: str, maxLen: i64) -> str {
    if str_len(s) <= maxLen {
        return str_clone(s);
    }
    return str_slice(s, 0, maxLen);
}

fn other() -> i64 {
    var max_len_other: i64 = 4;
    return max_len_other;
}

fn main() {
    println(clip("abcdef", 3) + " " + int_to_str(other()));
}
