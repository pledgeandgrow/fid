// Known bug 2g.59 (tests/tooling/interp-io-check.sh): read_line() gives
// each line of standard input without its "\n" (or "\r\n") and None at the
// end, under `fid run` and in built programs.

fn main() -> i64 {
    var n: i64 = 0;
    var going: bool = true;
    while going {
        match read_line() {
            Option::Some(line) => {
                println("line [" + line + "] " + int_to_str(str_len(line)));
                n = n + 1;
            }
            Option::None => {
                going = false;
            }
        }
        if n > 100 {
            println("no end of input");
            return 1;
        }
    }
    println("lines " + int_to_str(n));
    return 0;
}
