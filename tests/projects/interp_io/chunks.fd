// Known bug 2g.59 (tests/tooling/interp-io-check.sh): read_stdin(n) gives
// up to n bytes of standard input and None once nothing is left, under
// `fid run` and in built programs. Fed "abcdefghij": prints
//   chunks 3 bytes 10
// and on empty input
//   chunks 0 bytes 0

fn main() -> i64 {
    var total: i64 = 0;
    var chunks: i64 = 0;
    var going: bool = true;
    while going {
        match read_stdin(4) {
            Option::Some(c) => {
                total = total + str_len(c);
                chunks = chunks + 1;
                if chunks > 100 {
                    println("no end of input");
                    return 1;
                }
            }
            Option::None => {
                going = false;
            }
        }
    }
    println("chunks " + int_to_str(chunks) + " bytes " + int_to_str(total));
    return 0;
}
