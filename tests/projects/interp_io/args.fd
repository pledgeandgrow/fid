// Known bug 2g.60 (tests/tooling/interp-io-check.sh): the program's
// arguments are the same under `fid run args.fd a b` as for a built
// `args.exe a b`: arg_at(1) is "a". Prints the count (p_argc) and arguments 1 on.

fn main() -> i64 {
    println("count " + int_to_str(p_argc()));
    var i: i64 = 1;
    var going: bool = true;
    while going {
        match arg_at(i) {
            Option::Some(s) => {
                println(int_to_str(i) + " " + s);
                i = i + 1;
            }
            Option::None => {
                going = false;
            }
        }
    }
    match arg_at(0) {
        Option::Some(p) => {
            if str_len(p) > 0 {
                println("program named");
            }
        }
        Option::None => {
            println("no program name");
        }
    }
    return 0;
}
