// TL5 (docs/roadmap/competitive-roadmap.md): line tables for a program of
// two files, on every path that writes them. tests/tooling/tl5-lines-check.sh
// builds this program with
//   fid ccompile -g ...          #line to main.fd and to shapes.fd
//   fid emit --target aarch64-macos / x86_64-macos
//                                 a __DWARF segment (tests/nattools/macho_dwarf_check.py)
//   fid emit -g (Windows, pe_ir) .debug_line in the PE (scripts/pe-dwarf-check.py)
// and runs what it can on this host.
// Expected output:
// area 12
// perimeter 14
// total 26
use shapes;

fn total(r: Rect) -> i64 {
    var t: i64 = r.area();
    t = t + perimeter(r.w, r.h);
    return t;
}

fn main() -> i64 {
    val r = Rect { w: 3, h: 4 };
    println("area " + int_to_str(r.area()));
    println("perimeter " + int_to_str(perimeter(3, 4)));
    println("total " + int_to_str(total(r)));
    return 0;
}
