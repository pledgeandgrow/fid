// TL5: the imported module of tests/projects/tl5_lines/main.fd. With -g
// its functions get line information against this file: `#line N
// ".../shapes.fd"` in the C of `fid ccompile -g` (compiler/codegen_c.fd
// cg_lines_file_for), and a second file in the DWARF line table of the
// machine layer's ELF and Mach-O images (nat_ir.fd DB1, nat_enc.fd
// nat_macho_dwarf).
module shapes;

pub struct Rect { pub w: i64, pub h: i64 }

impl Rect {
    pub fn area(self: Rect) -> i64 {
        var a: i64 = self.w * self.h;
        return a;
    }
}

// recursive, so that no inliner folds it into its callers: it keeps its
// own code and rows
pub fn perimeter(w: i64, h: i64) -> i64 {
    if w <= 0 {
        return 2 * h;
    }
    return 2 + perimeter(w - 1, h);
}
