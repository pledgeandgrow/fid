// tests/projects/cbind: a C binding (release-roadmap N11).
//
// Functions of the C library and of libm called through `extern "C"`, each
// under a Fides name (`as cb_...`), with the header the C path includes and
// the library it links. A C call is unsafe code: main is @unsafe.
//
// Built by scripts/projects-check.sh with `fid ccompile` and run; the
// interpreter cannot call C, so it is not run through `fid run`.

extern "C" include "<string.h>" {
    fn strlen as cb_strlen(s: str) -> u64;
    fn strcmp as cb_strcmp(a: str, b: str) -> i32;
}

extern "C" include "<stdlib.h>" {
    fn llabs as cb_llabs(x: i64) -> i64;
}

extern "C" include "<math.h>" link "m" {
    fn sqrt as cb_sqrt(x: f64) -> f64;
    fn pow as cb_pow(base: f64, exp: f64) -> f64;
    fn floor as cb_floor(x: f64) -> f64;
}

@unsafe
fn main() -> i64 {
    val len: u64 = cb_strlen("Fides");
    println("strlen: " + int_to_str(len as i64));
    val same: i32 = cb_strcmp("abc", "abc");
    println("strcmp equal: " + int_to_str(same as i64));
    val order: i32 = cb_strcmp("abc", "abd");
    if order < 0 {
        println("strcmp order: less");
    } else {
        println("strcmp order: not less");
    }
    println("llabs: " + int_to_str(cb_llabs(-42)));
    val root: f64 = cb_sqrt(144.0);
    println("sqrt: " + int_to_str(root as i64));
    val third: f64 = cb_floor(cb_pow(2.0, 10.0) / 3.0);
    println("floor(pow / 3): " + int_to_str(third as i64));
    return 0;
}
