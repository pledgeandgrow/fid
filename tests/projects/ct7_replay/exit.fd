// CT7: a run that reads a file as bytes (a byte 0 among them), runs a
// process and reads its output, and ends with p_exit(3).
// tests/tooling/replay-check.sh records it and replays it with the file
// gone and the command changed: the replay prints the same lines, reads
// the bytes and the process output from the trace, and exits with 3.
fn main() {
    var path: str = "ct7_missing.bin";
    match env_var("CT7_BYTES") {
        Option::Some(p) => { path = p; }
        Option::None => { }
    }
    val bytes: Vec<i64> = p_file_read_bytes(path);
    var sum: i64 = 0;
    var zeros: i64 = 0;
    var i: i64 = 0;
    while i < bytes.len() {
        sum = sum + bytes.get(i);
        if bytes.get(i) == 0 {
            zeros = zeros + 1;
        }
        i = i + 1;
    }
    println("bytes: " + int_to_str(bytes.len()) + " sum: " + int_to_str(sum) + " zeros: " + int_to_str(zeros));
    var cmd: str = "echo replay-unset";
    match env_var("CT7_CMD") {
        Option::Some(c) => { cmd = c; }
        Option::None => { }
    }
    val h: i64 = p_process_run(cmd);
    println("process: " + str_trim(p_process_stdout(h)));
    println("code: " + int_to_str(p_process_code(h)));
    p_process_close(h);
    println("exiting");
    p_exit(3);
}
