// CT7 (docs/roadmap/complaint-roadmap.md): a program whose output depends
// on what its effects bring in: a file named by an environment variable,
// the clock, the OS's random words, standard input. It also writes a file.
// tests/tooling/replay-check.sh records a run (`fid run --record`) and
// replays it (`fid replay`) with the file, the variable and stdin changed:
// the replay prints the same lines and writes no file.
fn main() {
    var path: str = "ct7_missing.txt";
    match env_var("CT7_INPUT") {
        Option::Some(p) => { path = p; }
        Option::None => { }
    }
    match read_file(path) {
        Option::Some(text) => { println("read: " + str_trim(text)); }
        Option::None => { println("no file " + path); }
    }
    val t: i64 = p_clock_now_ms();
    println("time: " + int_to_str(t));
    val r: i64 = p_os_random_u64();
    println("random: " + int_to_str(r));
    match read_line() {
        Option::Some(line) => { println("stdin: " + str_trim(line)); }
        Option::None => { println("stdin: (end)"); }
    }
    var out: str = "ct7_out.txt";
    match env_var("CT7_OUTPUT") {
        Option::Some(o) => { out = o; }
        Option::None => { }
    }
    p_file_write(out, "written at " + int_to_str(t) + "\n");
    println("done");
}
