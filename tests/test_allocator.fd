// Test allocator-as-parameter — Phase 2A.8
// Functions that declare !Alloc must take an Allocator parameter (like Zig, verified at compile time)

fn alloc_sum(alloc: &Allocator, a: i64, b: i64) -> i64 !Alloc {
    val ptr = allocator_alloc(alloc, 8);
    return a + b;
}

fn main() -> i64 {
    val alloc = create_allocator("my_pool");
    
    val result = alloc_sum(&alloc, 10, 20);
    print(result);  // 30
    
    val bytes = allocator_bytes_used(&alloc);
    print(bytes);  // 0 (simulated)
    
    return 0;
}
