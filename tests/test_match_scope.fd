enum Result {
    Ok(i64),
    Err(str),
}

fn process(r: Result) -> i64 {
    match r {
        Result::Ok(v) => {
            var x = v * 2;
            return x;
        }
        Result::Err(msg) => {
            println(msg);
            return 0;
        }
    }
    return 0;
}

fn main() {
    println(process(Result::Ok(21)));
    println(process(Result::Err("error")));
}
