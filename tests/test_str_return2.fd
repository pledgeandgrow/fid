// Reproduction with &mut self method

use core;
use vec;

enum ResultStr {
    Ok(str),
    Err(str),
}

struct Holder {
    pos: i64,
}

impl Holder {
    pub fn new() -> Holder {
        return Holder { pos: 0 };
    }

    fn get_name(self: &mut Holder) -> ResultStr {
        self.pos = self.pos + 1;
        return ResultStr::Ok("main");
    }
}

fn main() -> i64 {
    var h: Holder = Holder::new();
    match h.get_name() {
        ResultStr::Ok(s: str) => {
            print("name='");
            print(s);
            print("'\n");
            var name: str = s;
            print("after assign: name='");
            print(name);
            print("'\n");
        }
        ResultStr::Err(e: str) => {
            print("error: ");
            print(e);
            print("\n");
        }
    }
    return 0;
}
