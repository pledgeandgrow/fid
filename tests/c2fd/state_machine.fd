// Translated from state_machine.c by c2fd (C to Fid, best effort): review it before use.
// C headers: <stdio.h> (their calls are mapped to Fid's).

// A traffic light as an enum and a switch-based state machine.

// enum Light: C enum values are integers, so they stay constants
type Light = i64;
const RED: Light = 0;
const RED_AMBER: Light = 1;
const GREEN: Light = 2;
const AMBER: Light = 3;
const OFF: Light = 9;

// enum event: C enum values are integers, so they stay constants
type event = i64;
const TICK: event = 0;
const FAULT: event = 1;
const RESET: event = 2;

fn light_name(l: Light) -> str {
    if l == RED {
        return "red";
    } else if l == RED_AMBER {
        return "red+amber";
    } else if l == GREEN {
        return "green";
    } else if l == AMBER {
        return "amber";
    } else {
        return "off";
    }
}

fn step(l: Light, e: event) -> Light {
    if e == FAULT {
        return OFF;
    }
    if l == RED {
        l = RED_AMBER;
    } else if l == RED_AMBER {
        l = GREEN;
    } else if l == GREEN {
        l = AMBER;
    } else if l == AMBER {
        l = RED;
    } else if l == OFF {
        if e == RESET {
            l = RED;
        }
    }
    return l;
}

fn main() -> i64 {
    var script: Vec<event> = Vec::new();
    for x in [TICK, TICK, TICK, TICK, TICK, FAULT, TICK, RESET, TICK] {
        script.push(x);
    }
    val n: i64 = script.len();
    var l: Light = RED;
    var greens: i64 = 0;
    println(f"start: {light_name(l)}");
    for i in 0..n {
        l = step(l, script[i]);
        if l == GREEN {
            greens += 1;
        }
        println(f"{i}: {light_name(l)} ({l})");
    }
    println(f"green {greens} times");
    return 0;
}
