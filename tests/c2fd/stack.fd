// Translated from stack.c by c2fd (C to Fid, best effort): review it before use.
// C headers: <stdio.h> (their calls are mapped to Fid's).

// A fixed-capacity stack of ints in a struct, used to check brackets.

const CAPACITY: i64 = 64;

struct Stack {
    items: Vec<i64>,
    top: i64,
}

fn stack_init(s: &mut Stack) {
    s.top = 0;
}

fn stack_empty(s: &Stack) -> i64 {
    return if s.top == 0 { 1 } else { 0 };
}

fn stack_push(s: &mut Stack, value: i64) -> i64 {
    if s.top == CAPACITY {
        return 0;
    }
    val _t1: i64 = s.top;
    s.top += 1;
    s.items.set(_t1, value);
    return 1;
}

fn stack_pop(s: &mut Stack) -> i64 {
    s.top -= 1;
    return s.items[s.top];
}

fn stack_peek(s: &Stack) -> i64 {
    return s.items[s.top - 1];
}

// 1 when every bracket in text is closed in the right order.
fn balanced(text: str) -> i64 {
    var s: Stack = Stack { items: Vec::filled(CAPACITY, 0), top: 0 };
    stack_init(&mut s);
    var i: i64 = 0;
    while c_char(text, i) != '\0' {
        val c: i64 = c_char(text, i);
        if c == '(' || c == '[' || c == '{' {
            stack_push(&mut s, c);
        } else if c == ')' || c == ']' || c == '}' {
            if stack_empty(&s) != 0 {
                return 0;
            }
            val open: i64 = stack_pop(&mut s);
            if (c == ')' && open != '(') || (c == ']' && open != '[') || (c == '}' && open != '{') {
                return 0;
            }
        }
        i += 1;
    }
    return stack_empty(&s);
}

fn main() -> i64 {
    var s: Stack = Stack { items: Vec::filled(CAPACITY, 0), top: 0 };
    stack_init(&mut s);
    for i in 1..=5 {
        stack_push(&mut s, i * 10);
    }
    println(f"peek: {stack_peek(&s)}");
    while stack_empty(&s) == 0 {
        println(f"pop: {stack_pop(&mut s)}");
    }

    var tests: Vec<str> = Vec::new();
    tests.push("(a[b]{c})");
    tests.push("(]");
    tests.push("((x)");
    tests.push("{[()()]}");
    for i in 0..4 {
        println(c_ljust(tests[i], 10) + " " + (if balanced(tests[i]) != 0 { "balanced" } else { "unbalanced" }));
    }
    return 0;
}

// --- c2fd helpers: the C library behaviour this translation relies on ---

/// s[i] of a C string: its NUL (0) at the end.
fn c_char(s: str, i: i64) -> i64 {
    if i < 0 || i >= str_len(s) {
        return 0;
    }
    return str_byte_at(s, i);
}

/// printf's "-" flag: s left-aligned in w columns.
fn c_ljust(s: str, w: i64) -> str {
    var out: str = s;
    while str_len(out) < w {
        out = out + " ";
    }
    return out;
}
