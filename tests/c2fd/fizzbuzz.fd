// C headers: <stdio.h> (their calls are mapped to Fid's).

// FizzBuzz: the numbers 1 to 30, with multiples of 3 and 5 replaced.

const LIMIT: i64 = 30;

fn main() -> i64 {
    for i in 1..=LIMIT {
        if i % 15 == 0 {
            println("FizzBuzz");
        } else if i % 3 == 0 {
            println("Fizz");
        } else if i % 5 == 0 {
            println("Buzz");
        } else {
            println(i);
        }
    }
    return 0;
}
