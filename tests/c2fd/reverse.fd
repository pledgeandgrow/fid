// Translated from reverse.c by c2fd (C to Fid, best effort): review it before use.
// C headers: <stdio.h>, <string.h> (their calls are mapped to Fid's).

// Reverse strings in place, and count vowels.

fn reverse(s: &mut Vec<i64>) {
    val n: i64 = c_strlen(s);
    for i in 0..n / 2 {
        val tmp: i64 = s[i];
        s[i] = s[n - 1 - i];
        s[n - 1 - i] = tmp;
    }
}

fn count_vowels(s: str) -> i64 {
    var count: i64 = 0;
    while c_char(s, 0) != 0 {
        val _t1: i64 = c_char(s, 0);
        if _t1 == 'a' || _t1 == 'e' || _t1 == 'i' || _t1 == 'o' || _t1 == 'u' {
            count += 1;
        }
        s = c_skip(s, 1);
    }
    return count;
}

fn is_palindrome(s: str) -> i64 {
    var i: i64 = 0;
    var j: i64 = str_len(s) - 1;
    while i < j {
        if c_char(s, i) != c_char(s, j) {
            return 0;
        }
        i += 1;
        j -= 1;
    }
    return 1;
}

fn main() -> i64 {
    var word: Vec<i64> = c_bytes("hello, world");
    print(f"{c_cstr(&word)} -> ");
    reverse(&mut word);
    println(c_cstr(&word));
    println("vowels in \"programming\": " + int_to_str(count_vowels("programming")));
    var candidates: Vec<str> = Vec::new();
    candidates.push("level");
    candidates.push("fides");
    candidates.push("racecar");
    candidates.push("ab");
    for i in 0..4 {
        println(candidates[i] + ": " + (if is_palindrome(candidates[i]) != 0 { "yes" } else { "no" }));
    }
    return 0;
}

// --- c2fd helpers: the C library behaviour this translation relies on ---

/// s[i] of a C string: its NUL (0) at the end.
fn c_char(s: str, i: i64) -> i64 {
    if i < 0 || i >= str_len(s) {
        return 0;
    }
    return str_byte_at(s, i);
}

/// s + n for a C string: what follows its first n bytes.
fn c_skip(s: str, n: i64) -> str {
    if n >= str_len(s) {
        return "";
    }
    return str_slice(s, n, str_len(s));
}

/// A char array holding s and its NUL.
fn c_bytes(s: str) -> Vec<i64> {
    var b: Vec<i64> = str_bytes(s);
    b.push(0);
    return b;
}

/// strlen of a char array: the bytes before its first NUL.
fn c_strlen(b: &Vec<i64>) -> i64 {
    var n: i64 = 0;
    while n < b.len() && b[n] != 0 {
        n += 1;
    }
    return n;
}

/// The C string in a char array, as a str.
fn c_cstr(b: &Vec<i64>) -> str {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < b.len() && b[i] != 0 {
        v.push(b[i]);
        i += 1;
    }
    return str_from_bytes(v);
}
