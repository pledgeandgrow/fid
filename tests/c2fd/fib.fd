// Translated from fib.c by c2fd (C to Fid, best effort): review it before use.
// C headers: <stdio.h> (their calls are mapped to Fid's).

// Recursive Fibonacci, with a memoised version to compare.

var memo: Vec<i64> = Vec::filled(64, 0);

// The naive definition: exponential time.
fn fib(n: i64) -> i64 {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn fib_memo(n: i64) -> i64 {
    if n < 2 {
        return n;
    }
    if memo.get(n) != 0 {
        return memo.get(n);
    }
    memo.set(n, fib_memo(n - 1) + fib_memo(n - 2));
    return memo.get(n);
}

fn main() -> i64 {
    for i in 0..=20 {
        println(f"fib({i}) = {fib(i)}");
    }
    println(f"fib_memo(50) = {fib_memo(50)}");
    return 0;
}
