// Translated from linked_list.c by c2fd (C to Fid, best effort): review it before use.
// C headers: <stdio.h>, <stdlib.h> (their calls are mapped to Fid's).

// A singly linked list of ints built with malloc and freed with free.

struct Node {
    value: i64,
    next: *mut Node,
}

// Add a value at the front; returns the new head.
@unsafe
fn push_front(head: *mut Node, value: i64) -> *mut Node {
    val n: *mut Node = p_malloc(comptime struct_size(Node)) as *mut Node;
    if (n as i64) == 0 {
        p_eprint_str("out of memory\n");
        p_exit(1);
    }
    (*n).value = value;
    (*n).next = head;
    return n;
}

@unsafe
fn length(head: *mut Node) -> i64 {
    var count: i64 = 0;
    while (head as i64) != 0 {
        count += 1;
        head = (*head).next;
    }
    return count;
}

@unsafe
fn sum(head: *mut Node) -> i64 {
    var total: i64 = 0;
    var p: *mut Node = head;
    while (p as i64) != 0 {
        total += (*p).value;
        p = (*p).next;
    }
    return total;
}

@unsafe
fn reverse(head: *mut Node) -> *mut Node {
    var prev: *mut Node = 0 as *mut Node;
    while (head as i64) != 0 {
        val next: *mut Node = (*head).next;
        (*head).next = prev;
        prev = head;
        head = next;
    }
    return prev;
}

@unsafe
fn print_list(head: *mut Node) {
    print("[");
    var p: *mut Node = head;
    while (p as i64) != 0 {
        print((*p).value);
        if ((*p).next as i64) != 0 {
            print(", ");
        }
        p = (*p).next;
    }
    println("]");
}

@unsafe
fn free_list(head: *mut Node) {
    while (head as i64) != 0 {
        val next: *mut Node = (*head).next;
        p_free(head as i64);
        head = next;
    }
}

@unsafe
fn main() -> i64 {
    var list: *mut Node = 0 as *mut Node;
    for i in 1..=5 {
        list = push_front(list, i * i);
    }
    print_list(list);
    println(f"length {length(list)}, sum {sum(list)}");
    list = reverse(list);
    print_list(list);
    free_list(list);
    return 0;
}
