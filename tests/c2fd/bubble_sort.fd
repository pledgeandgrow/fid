// Translated from bubble_sort.c by c2fd (C to Fid, best effort): review it before use.
// C headers: <stdio.h>, <stdlib.h> (their calls are mapped to Fid's).

// Bubble sort on a static array and on a malloc'd copy.

fn swap(a: &mut i64, b: &mut i64) {
    val t: i64 = *a;
    *a = *b;
    *b = t;
}

fn bubble_sort(a: &mut Vec<i64>, n: i64) {
    var swapped: i64 = 0;
    loop {
        swapped = 0;
        for i in 1..n {
            if a[i - 1] > a[i] {
                var _t1: i64 = a[i - 1];
                var _t2: i64 = a[i];
                swap(&mut _t1, &mut _t2);
                a[i - 1] = _t1;
                a[i] = _t2;
                swapped = 1;
            }
        }
        n -= 1;
        if swapped == 0 {
            break;
        }
    }
}

fn print_array(a: &Vec<i64>, n: i64) {
    for i in 0..n {
        if i == 0 {
            print(a[i]);
        } else {
            print(f" {a[i]}");
        }
    }
    println("");
}

fn main() -> i64 {
    var data: Vec<i64> = Vec::new();
    for x in [42, 7, 19, 3, 88, -5, 23, 0, 61, 14] {
        data.push(x);
    }
    val n: i64 = data.len();

    // copy: malloc'd here and freed at the end of this region
    region r_copy {
        var copy: Vec<i64> = Vec::filled(n, 0);
        for i in 0..n {
            copy[i] = data[i] * 2;
        }

        print_array(&data, n);
        bubble_sort(&mut data, n);
        print_array(&data, n);

        bubble_sort(&mut copy, n);
        print_array(&copy, n);
        // free(copy): the end of the region frees it
    }
    return 0;
}
