// A fixture of scripts/determinism-check.sh (RL13): functions that walk a
// hash map, which the scans must report (they are not in
// scripts/determinism-allow.txt). Not a test of its own: the check runs
// scripts/determinism-scan.py on it and expects a failure: the source scan
// names walk_values (the .values() call), the C scan of its dump-c names
// walk_keys (the `for k in m` loop, lowered to HashMap_keys) and
// walk_values; neither names in_a_string nor this comment.
//
// A call in a comment is not one: HashMap_keys(m)
fn walk_keys(m: HashMap<str, i64>) -> i64 {
    var t: i64 = 0;
    for k in m {
        t = t + m.get(k);
    }
    return t;
}

fn walk_values(m: HashMap<str, i64>) -> i64 {
    var vs: Vec<i64> = m.values();
    return vs.len();
}

fn in_a_string() -> str {
    return "HashMap_values(m) is only text here";
}

fn main() -> i64 {
    var m: HashMap<str, i64> = HashMap::new();
    m.insert("one", 1);
    m.insert("two", 2);
    print(walk_keys(m) + walk_values(m));
    print("\n");
    print(in_a_string());
    print("\n");
    return 0;
}
