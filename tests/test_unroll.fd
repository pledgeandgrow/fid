// Test: Loop unrolling — a counted loop with constant trip count 3
// should be fully unrolled by the optimizer. Phase 4B.4
fn sum3() -> i64 {
    val total = 0;
    val i = 0;
    while i < 3 {
        total = total + i;
        i = i + 1;
    }
    return total;
}

fn main() -> i64 !IO {
    val result = sum3();
    if result != 3 {
        print(999);
        return 1;
    }
    print(42);
    return 0;
}
