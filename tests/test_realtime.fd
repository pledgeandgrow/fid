// test_realtime.fd — Real-Time Effect Enforcement (@realtime annotation)
// Expected: PASS
// @realtime functions must have bounded execution time:
// no allocation, no blocking IO, no unbounded loops, no recursion.
// This function is real-time safe: uses only stack memory, for-loops,
// and calls only other @realtime functions.

@realtime
fn rt_max(a: i64, b: i64) -> i64 {
    // No branches on secrets, no IO, no allocation
    val diff = a - b;
    val mask = diff >> 63;  // -1 if a < b, 0 if a >= b
    return a - (diff & mask);
}

@realtime
fn rt_min(a: i64, b: i64) -> i64 {
    // Constant-time min: returns the smaller of a, b
    // min(a,b) = a + ((b-a) & ((b-a) >> 63))
    val diff = b - a;
    val mask = diff >> 63;  // -1 if b < a, 0 if b >= a
    return a + (diff & mask);
}

@realtime
fn rt_clamp(val: i64, lo: i64, hi: i64) -> i64 {
    // Clamp val to [lo, hi] — all bounded, no IO, no allocation
    val v = rt_max(val, lo);
    return rt_min(v, hi);
}

@realtime
fn rt_abs(x: i64) -> i64 {
    val mask = x >> 63;
    return (x + mask) ^ mask;
}

fn main() {
    val m1 = rt_max(42, 99);
    print(m1);
    print("\n");

    val m2 = rt_max(100, 50);
    print(m2);
    print("\n");

    val c = rt_clamp(150, 0, 100);
    print(c);
    print("\n");

    val a = rt_abs(-42);
    print(a);
    print("\n");

    return 0;
}
