// Test FFI — comprehensive C library calls
// Phase 3D success metric: Call C library functions from Fides

// Declare extern C functions from math.h and string.h
extern "C" include "<math.h>" link "m" {
    fn sqrt as c_sqrt(x: f64) -> f64;
    fn pow as c_pow(base: f64, exp: f64) -> f64;
    fn floor as c_floor(x: f64) -> f64;
    fn ceil as c_ceil(x: f64) -> f64;
    fn sin as c_sin(x: f64) -> f64;
    fn cos as c_cos(x: f64) -> f64;
    fn fabs as c_fabs(x: f64) -> f64;
}

extern "C" include "<string.h>" {
    fn strlen as c_strlen(s: str) -> u64;
    fn strcmp as c_strcmp(a: str, b: str) -> i32;
}

fn main() -> i64 {
    // Math functions from libm
    val s = c_sqrt(144.0);
    print(s);  // 12

    val p = c_pow(2.0, 8.0);
    print(p);  // 256

    val f = c_floor(3.9);
    print(f);  // 3

    val c = c_ceil(3.1);
    print(c);  // 4

    val si = c_sin(0.0);
    print(si);  // 0

    val co = c_cos(0.0);
    print(co);  // 1

    val ab = c_fabs(-5.5);
    print(ab);  // 5.5

    // String functions from libc
    val len = c_strlen("hello");
    print(len);  // 5

    val cmp = c_strcmp("abc", "abc");
    print(cmp);  // 0

    return 0;
}
