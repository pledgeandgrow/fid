// Reproduction: extract string from enum variant, return via ResultStr

use core;
use vec;

enum ResultStr {
    Ok(str),
    Err(str),
}

enum TokenKind {
    Ident(str),
    Eof,
}

struct Token {
    kind: TokenKind,
}

struct Holder {
    tokens: Vec<Token>,
    pos: i64,
}

impl Holder {
    pub fn new() -> Holder {
        return Holder { pos: 0 };
    }

    fn peek_token(self: &Holder) -> Token {
        return self.tokens.get(self.pos);
    }

    fn advance(self: &mut Holder) {
        self.pos = self.pos + 1;
    }

    fn get_name(self: &mut Holder) -> ResultStr {
        var tok: Token = self.peek_token();
        match tok.kind {
            TokenKind::Ident(s: str) => {
                var saved: str = s;
                self.advance();
                return ResultStr::Ok(saved);
            }
        }
        return ResultStr::Err("not ident");
    }
}

fn main() -> i64 {
    var tokens: Vec<Token> = Vec::new();
    tokens.push(Token { kind: TokenKind::Ident("main") });

    var h: Holder = Holder::new();
    h.tokens = tokens;

    match h.get_name() {
        ResultStr::Ok(s: str) => {
            print("name='");
            print(s);
            print("'\n");
            var name: str = s;
            print("after assign: name='");
            print(name);
            print("'\n");
        }
        ResultStr::Err(e: str) => {
            print("error: ");
            print(e);
            print("\n");
        }
    }
    return 0;
}
