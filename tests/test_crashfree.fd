// Test: @crashfree annotation (Phase 7.5B)
// Functions marked @crashfree are proven to never panic at runtime.
// The compiler rejects: unwrap, p_panic, division by non-constant,
// unbounded while loops, and calls to non-@crashfree functions.
//
// This is the SPARK Ada "proof of absence of run-time errors" model,
// but as a pattern-based check. Primary use: aerospace, medical, automotive.

// Simple crashfree function — pure arithmetic, no crash risk
@crashfree
pf safe_add(a: i64, b: i64) -> i64 {
    ret a + b;
}

// Crashfree function with for loop (finite iteration — safe)
@crashfree
pf safe_sum(n: i64) -> i64 {
    pv total = 0;
    for i in 0..n {
        total = total + i;
    }
    ret total;
}

// Crashfree function calling another crashfree function — transitive safety
@crashfree
pf use_safe_add(x: i64) -> i64 {
    pv r = safe_add(x, 10);
    ret r * 2;
}

// Division by constant non-zero — safe (compiler allows this)
@crashfree
pf safe_div_by_const(n: i64) -> i64 {
    ret n / 4;
}

// Match on Option without unwrap — safe error handling
@crashfree
pf safe_option_handling(maybe_val: Option) -> i64 {
    pv result = match maybe_val {
        Option::Some(v: i64) => { ret v; }
        Option::None => { ret 0; }
    };
    ret result;
}

pf main() {
    pv r1 = safe_add(3, 4);
    print("safe_add(3,4) = ");
    print(r1);
    print("\n");

    pv r2 = safe_sum(10);
    print("safe_sum(10) = ");
    print(r2);
    print("\n");

    pv r3 = use_safe_add(5);
    print("use_safe_add(5) = ");
    print(r3);
    print("\n");

    pv r4 = safe_div_by_const(100);
    print("safe_div_by_const(100) = ");
    print(r4);
    print("\n");

    print("OK\n");
}
