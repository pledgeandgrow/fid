// Test: @send and @sync annotations for thread safety
// @send types can be safely sent across threads (via spawn, p_chan_send, p_thread_spawn)
// @sync types can be safely shared across threads (via &T)

@send
struct Message {
    id: i64,
    data: i64,
}

@sync
struct SharedCounter {
    value: i64,
}

pf main() {
    // @send struct can be sent through a channel
    pv msg = Message { id: 1, data: 42 };
    pv ch = p_chan_create(10);
    p_chan_send(ch, msg.id);
    pv result = p_chan_recv(ch);
    println(result);

    // @sync struct can be shared (just verify it compiles)
    pv counter = SharedCounter { value: 100 };
    println(counter.value);

    // Primitives are always @send
    pv n = 42;
    p_chan_send(ch, n);
    pv m = p_chan_recv(ch);
    println(m);

    p_chan_close(ch);
}
