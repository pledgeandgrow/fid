// test_deterministic.fd — @deterministic function that should compile successfully.
// A deterministic function: same inputs → same outputs, always.
// No IO, no Net, no Spawn, no Diverge, no floating-point.

@deterministic
pf compound_interest(principal: i64, rate_bps: i64, days: i64) -> i64 {
    // Integer-only arithmetic — deterministic across all CPUs
    // interest = principal * rate_bps * days / (10000 * 365)
    ret (principal * rate_bps * days) / (10000 * 365)
}

@deterministic
pf factorial(n: i64) -> i64 {
    if n <= 1 {
        ret 1
    }
    ret n * factorial(n - 1)
}

@deterministic
pf sum_range(start: i64, end: i64) -> i64 {
    pv total = 0
    pv i = start
    while i < end {
        total = total + i
        i = i + 1
    }
    ret total
}

pf main() {
    pv interest = compound_interest(10000, 500, 365)
    println(interest)

    pv fact = factorial(5)
    println(fact)

    pv sum = sum_range(1, 10)
    println(sum)
}
