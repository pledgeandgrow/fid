// Test generics in PE emitter
fn identity<T>(x: T) -> T {
    return x;
}

fn max_value<T>(a: T, b: T) -> T {
    if a > b {
        return a;
    } else {
        return b;
    }
}

fn main() -> i64 {
    val a = identity(42);
    print(a);
    val m = max_value(10, 20);
    print(m);
    val n: i64 = max_value(50, 30);
    print(n);
    return 0;
}
