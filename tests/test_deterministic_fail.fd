// test_deterministic_fail.fd — @deterministic functions that should be REJECTED.
// This test exercises all the rejection rules:
//   1. IO effect (print/println) inside @deterministic
//   2. Floating-point literal inside @deterministic
//   3. Floating-point parameter inside @deterministic

@deterministic
fn bad_io(x: i64) -> i64 {
    println(x)
    return x + 1
}

@deterministic
fn bad_float_literal(x: i64) -> i64 {
    val pi = 3.14159
    return x + 1
}

@deterministic
fn bad_float_param(x: f64) -> f64 {
    return x * 2.0
}

fn main() {
    val a = bad_io(1)
    println(a)
}
