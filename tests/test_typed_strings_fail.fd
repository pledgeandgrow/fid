// Test: F67 — Typed strings prevent injection (expected FAIL)
// This test tries to pass a raw str to a function expecting SQLString.
// The typechecker should reject this — preventing SQL injection at compile time.

use typed_strings;

// This function expects a SQLString, not a raw str
pf do_query(sql: SQLString) -> str {
    ret sql.value;
}

pf main() -> i64 {
    // Simulate reading user input from a file
    pv user_input = p_file_read("/tmp/malicious_input.txt");

    // COMPILE ERROR: passing raw str to function expecting SQLString
    // This is the exact pattern that causes SQL injection
    pv result = do_query(user_input);
    print(result);
    print("\n");
    ret 0;
}
