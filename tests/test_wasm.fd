// Test: WASM target — exercises integer arithmetic, control flow,
// function calls, and string printing. This is the subset the WASM
// backend fully supports (Phase 5D.1).

fn fib(n: i64) -> i64 {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 {
        return a;
    }
    return gcd(b, a % b);
}

fn main() {
    val r = fib(10);
    print(r);
    print("\n");
    val g = gcd(48, 36);
    print(g);
    print("\n");
    val sum = 0;
    val i = 1;
    while i <= 100 {
        sum = sum + i;
        i = i + 1;
    }
    print(sum);
    print("\n");
    return 0;
}
