// roadmap P12: keeps every string it builds; FID_MEM_LIMIT stops it.
fn main() {
    var keep: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < 20000 {
        keep.push("block " + int_to_str(i) + " " + str_repeat("x", 1000));
        i = i + 1;
    }
    println("kept " + int_to_str(keep.len()));
}
