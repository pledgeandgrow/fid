// roadmap P12: allocates about 1.6 MB in all (50 rounds of a 2000-element
// Vec and its growing buffers), but each round's Vec is freed before the
// next: live memory stays near 32 KB, so FID_MEM_LIMIT=1M does not stop it
// (freed blocks come off the count).
fn main() {
    var total: i64 = 0;
    var round: i64 = 0;
    while round < 50 {
        var v: Vec<i64> = Vec::new();
        var i: i64 = 0;
        while i < 2000 {
            v.push(i * round);
            i = i + 1;
        }
        total = total + v.len();
        round = round + 1;
    }
    println("churn " + int_to_str(total));
}
