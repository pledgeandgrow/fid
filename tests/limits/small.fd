// roadmap P12: well under the limits; runs as without them.
fn main() {
    var v: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < 1000 {
        v.push("item " + int_to_str(i));
        i = i + 1;
    }
    var j: i64 = 0;
    while j < 1000 {
        v.pop();
        j = j + 1;
    }
    println("small ok " + int_to_str(v.len()));
}
