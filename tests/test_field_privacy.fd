// Test: Field-level privacy (Phase 10A.5)
// Private fields are only accessible from within their defining module.
// Public fields are accessible from anywhere.

use privacy;

pf main() {
    pv c = PrivCounter::new();
    pv c2 = c.increment();
    pv c3 = c2.increment();

    // Access public field from outside the module — should work
    pv v = c3.value;
    print(v);

    // Access private field via public method — should work
    pv n = c3.get_count();
    print(n);
}
