// Test: linear Money type + @conserve functions
// This test verifies that Money can be moved and merged correctly,
// and that @conserve functions work as expected.

use money;

fn main() -> i64 {
    // Mint some money (not @conserve — creation is allowed here)
    val salary = Money_new(50000);  // $500.00
    val bonus = Money_from_dollars(100, 50);  // $100.50

    // Merge: add salary + bonus → total. Both consumed.
    val total = Money_add(salary, bonus);

    // Check the total (consumes total)
    val total_cents = Money_to_cents(total);

    // 50000 + 10050 = 60050
    print(total_cents);
    print("\n");

    // Test another merge
    val a = Money_new(1000);
    val b = Money_new(2000);
    val c = Money_add(a, b);
    print(Money_to_cents(c));
    print("\n");

    // Test subtraction
    val x = Money_new(5000);
    val y = Money_new(3000);
    val z = Money_sub(x, y);
    print(Money_to_cents(z));
    print("\n");

    // Test is_non_negative
    val p = Money_new(100);
    val q = Money_new(50);
    val merged = Money_add(p, q);
    print(Money_to_cents(merged));
    print("\n");

    return 0;
}
