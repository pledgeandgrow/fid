// Test: linear Money type + @conserve functions
// This test verifies that Money can be moved and merged correctly,
// and that @conserve functions work as expected.

use money;

pf main() -> i64 {
    // Mint some money (not @conserve — creation is allowed here)
    pv salary = Money_new(50000);  // $500.00
    pv bonus = Money_from_dollars(100, 50);  // $100.50

    // Merge: add salary + bonus → total. Both consumed.
    pv total = Money_add(salary, bonus);

    // Check the total (consumes total)
    pv total_cents = Money_to_cents(total);

    // 50000 + 10050 = 60050
    print(total_cents);
    print("\n");

    // Test another merge
    pv a = Money_new(1000);
    pv b = Money_new(2000);
    pv c = Money_add(a, b);
    print(Money_to_cents(c));
    print("\n");

    // Test subtraction
    pv x = Money_new(5000);
    pv y = Money_new(3000);
    pv z = Money_sub(x, y);
    print(Money_to_cents(z));
    print("\n");

    // Test is_non_negative
    pv p = Money_new(100);
    pv q = Money_new(50);
    pv merged = Money_add(p, q);
    print(Money_to_cents(merged));
    print("\n");

    ret 0;
}
