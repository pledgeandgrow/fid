// Test borrow checker — valid borrow patterns that should compile and run
// correctly under --borrowck=on (now the default).
//
// These patterns exercise:
// - Shared borrows (&x) that coexist
// - Mutable borrows (&mut x) that are exclusive
// - Temporary borrows passed to function calls (released after call)
// - Borrows that end when the borrower goes out of scope
// - unsafe {} blocks that skip borrow checking
// - Field-wise borrows (&s.x and &s.y coexist) — Phase 3
// - Two-phase borrows (&mut and & in same call) — Phase 4
// - NLL: borrows end at last use, not scope end — Phase 6

struct Point { x: i64, y: i64 }

fn increment(x: &mut i64) {
    *x = *x + 1;
}

fn read_val(x: &i64) -> i64 {
    *x
}

fn add_to(x: &mut i64, n: i64) {
    *x += n;
}

fn copy_first(dst: &mut i64, src: &i64) {
    *dst = *src;
}

fn main() -> i64 {
    // Temporary mutable borrow passed to a call — released after call returns.
    var v = 10;
    increment(&mut v);
    print(v);  // 11

    // Another temporary mutable borrow on the same var — previous one is gone.
    add_to(&mut v, 5);
    print(v);  // 16

    // Named mutable borrow, used, then borrower goes out of scope.
    {
        var w = 100;
        {
            var r = &mut w;
            *r = 42;
        }
        // r is out of scope here, so w is no longer borrowed.
        print(w);  // 42
    }

    // Temporary shared borrow passed to a call.
    var x = 99;
    val y = read_val(&x);
    print(y);  // 99

    // unsafe block skips borrow checking — raw aliasing is allowed.
    var z = 7;
    unsafe {
        var r1 = &mut z;
        var r2 = &mut z;
        *r1 = 1;
        *r2 = 2;
    }
    print(z);  // 2

    // Field-wise borrows: &p.x and &p.y can coexist (different fields).
    val p = Point { x: 10, y: 20 };
    val rx = &p.x;
    val ry = &p.y;
    print(*rx);  // 10
    print(*ry);  // 20

    // Phase 4: Two-phase borrows — &mut v and &v in the same call.
    // The &v is read before &mut v takes effect.
    var t = 42;
    copy_first(&mut t, &t);
    print(t);  // 42

    // Phase 6: NLL — borrow ends at last use, not scope end.
    var n = 10;
    val nr = &n;       // borrow n
    print(*nr);       // last use of nr — borrow ends here
    n = 20;           // mutation OK — nr is dead (NLL)
    print(n);         // 20

    return 0;
}

