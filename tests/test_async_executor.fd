// Test: Phase A1 — Executor + non-blocking task poll
//
// p_executor_new() creates an executor.
// p_executor_spawn(exec, func, nargs, args...) spawns a task, returns Future.
// p_task_poll(future) — non-blocking: returns value if ready, PENDING if not.
// p_task_is_ready(future) — returns true if the future is ready.
// p_executor_block_on(exec, future) — blocks until the future is ready.
// p_executor_run_all(exec) — joins all tasks on the executor.

pf worker(x: i64) -> i64 {
    ret x * x;
}

pf slow_worker(x: i64) -> i64 {
    // Simulate work with a busy loop
    pv sum = 0;
    pv i = 0;
    while i < x {
        sum = sum + i;
        i = i + 1;
    }
    ret sum;
}

pf main() {
    // Create an executor
    pv exec = p_executor_new();

    // Spawn tasks
    pv t1 = p_executor_spawn(exec, "worker", 1, 7);
    pv t2 = p_executor_spawn(exec, "worker", 1, 13);
    pv t3 = p_executor_spawn(exec, "slow_worker", 1, 100);

    // Block on each task and print results
    pv r1 = p_executor_block_on(exec, t1);
    pv r2 = p_executor_block_on(exec, t2);
    pv r3 = p_executor_block_on(exec, t3);

    print("t1 = ");
    print(r1);
    print("\n");
    print("t2 = ");
    print(r2);
    print("\n");
    print("t3 = ");
    print(r3);
    print("\n");

    // Test p_task_is_ready + p_task_poll (non-blocking poll)
    pv exec2 = p_executor_new();
    pv t4 = p_executor_spawn(exec2, "worker", 1, 42);
    // p_task_poll blocks until ready (for A1, same as block_on)
    pv result = p_task_poll(t4);
    print("t4 = ");
    print(result);
    print("\n");

    // Test run_all — joins all pending tasks on the executor
    pv exec3 = p_executor_new();
    p_executor_spawn(exec3, "worker", 1, 5);
    p_executor_spawn(exec3, "worker", 1, 6);
    p_executor_run_all(exec3);
    print("run_all done\n");

    // A2: Test non-blocking poll_all (round-robin scheduling)
    pv exec4 = p_executor_new();
    p_executor_spawn(exec4, "worker", 1, 10);
    p_executor_spawn(exec4, "worker", 1, 20);
    p_executor_spawn(exec4, "worker", 1, 30);
    // Poll until all tasks are done (pending == 0)
    pv pending = p_executor_poll_all(exec4);
    while pending > 0 {
        pending = p_executor_poll_all(exec4);
    }
    print("poll_all done\n");

    // A2: Test non-blocking task poll
    pv exec5 = p_executor_new();
    pv t5 = p_executor_spawn(exec5, "worker", 1, 99);
    // Non-blocking poll — might return PENDING_SENTINEL if not done yet
    pv poll_result = p_task_poll_nonblocking(t5);
    // If pending, block until ready
    if poll_result == -9223372036854775807 {
        poll_result = p_task_poll(t5);
    }
    print("t5 = ");
    print(poll_result);
    print("\n");

    print("OK\n");
}
