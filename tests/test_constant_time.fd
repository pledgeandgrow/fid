// test_constant_time.fd — @constant_time annotation (side-channel defense)
// Expected: PASS (no violations)
// This function is constant-time: no early returns, no IO, no allocation,
// no data-dependent branches on secrets.

@constant_time
fn ct_eq(a: i64, b: i64) -> i64 {
    // Compute difference
    val diff = a - b;
    // Constant-time equality: 1 if equal, 0 if not
    // No early return — always computes both branches
    val result = 0;
    if diff == 0 {
        result = 1;
    } else {
        result = 0;
    }
    return result;
}

@constant_time
fn ct_select(condition: i64, a: i64, b: i64) -> i64 {
    // Constant-time select: returns a if condition is 1, b if 0
    // No early return — always computes both
    val mask = 0 - condition;
    val result = (a & mask) | (b & ~mask);
    return result;
}

fn main() {
    val x = ct_eq(5, 5);
    val y = ct_eq(5, 6);
    print(x);
    print(y);
    val z = ct_select(1, 100, 200);
    print(z);
    val w = ct_select(0, 100, 200);
    print(w);
}
