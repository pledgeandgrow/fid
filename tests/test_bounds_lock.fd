// Test: F62 bounds checking lock
//
// Bounds checks ALWAYS fire in safe mode.
// Only skippable inside unsafe {} blocks.

pf main() {
    pv arr = Vec::new();
    arr.push(10);
    arr.push(20);
    arr.push(30);

    // Safe access — within bounds
    pv v0 = arr[0];
    pv v1 = arr[1];
    pv v2 = arr[2];
    print("arr[0] = ");
    print(v0);
    print("\n");
    print("arr[1] = ");
    print(v1);
    print("\n");
    print("arr[2] = ");
    print(v2);
    print("\n");

    // Unsafe access — skip bounds check (F62)
    // This would panic in safe mode, but in unsafe we get whatever is there
    unsafe {
        pv v3 = arr[2];  // last valid element, fine
        print("unsafe arr[2] = ");
        print(v3);
        print("\n");
    }

    // Normal arithmetic after unsafe block — bounds checks resume
    pv v4 = arr[1];
    print("after unsafe arr[1] = ");
    print(v4);
    print("\n");

    print("OK\n");
}
