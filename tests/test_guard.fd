// Test: guard => early exit syntax (Phase 7A — F6)
// guard cond => action desugars to if !cond { action }

fn check_positive(x: i64) -> i64 {
    guard x > 0 => return -1;
    return x;
}

fn check_positive_block(x: i64) -> i64 {
    guard x > 0 => {
        return -1;
    }
    return x;
}

fn classify(n: i64) -> str {
    guard n >= 0 => return "negative rejected";
    guard n <= 100 => return "too big";
    return "in range";
}

fn main() -> i64 {
    // Basic guard with single statement
    val r1 = check_positive(42);
    print(r1);
    print("\n");

    val r2 = check_positive(-5);
    print(r2);
    print("\n");

    // Guard with block
    val r3 = check_positive_block(10);
    print(r3);
    print("\n");

    val r4 = check_positive_block(-3);
    print(r4);
    print("\n");

    // Multiple guards in sequence
    val c1 = classify(50);
    print(c1);
    print("\n");

    val c2 = classify(-1);
    print(c2);
    print("\n");

    val c3 = classify(150);
    print(c3);
    print("\n");

    return 0;
}
