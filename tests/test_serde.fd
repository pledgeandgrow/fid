// Test: Serde — @derive(Serialize) and @derive(Deserialize) (Phase 7.7)
//
// @derive(Serialize) generates a to_json() method that returns a JSON string.
// @derive(Deserialize) generates a from_json() method that creates a struct from JSON.

@derive(Serialize)
@derive(Deserialize)
@derive(Debug)
struct User {
    id: i64,
    name: str,
    active: bool,
}

@derive(Serialize)
@derive(Deserialize)
struct Config {
    port: i64,
    host: str,
}

fn main() {
    // Test 1: @derive(Serialize) — to_json method
    val u = User { id: 42, name: "Alice", active: true };
    val json = User_to_json(u);
    print("json = ");
    print(json);
    print("\n");

    // Test 2: @derive(Deserialize) — from_json method
    val parsed = User_from_json("{\"id\":1,\"name\":\"Bob\"}");
    print("parsed id = ");
    print(parsed.id);
    print("\n");

    // Test 3: @derive(Debug) combined with Serialize
    val debug = User_debug_str(u);
    print("debug = ");
    print(debug);
    print("\n");

    // Test 4: Config serialize
    val c = Config { port: 8080, host: "localhost" };
    val config_json = Config_to_json(c);
    print("config = ");
    print(config_json);
    print("\n");

    // Test 5: Config deserialize
    val parsed_config = Config_from_json("{\"port\":3000}");
    print("parsed port = ");
    print(parsed_config.port);
    print("\n");

    print("OK\n");
}
