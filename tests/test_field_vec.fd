struct Container {
    items: Vec<i64>,
}

impl Container {
    fn new() -> Container {
        return Container { items: Vec::new() };
    }

    fn add(self: &mut Container, v: i64) {
        self.items.push(v);
    }

    fn count(self: &Container) -> i64 {
        return self.items.len();
    }
}

fn main() {
    var c = Container::new();
    c.add(1);
    c.add(2);
    c.add(3);
    println(c.count());
}
