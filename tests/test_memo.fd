// Test: Memoization stdlib helper (stdlib/memo.fd)
use memo;

pf fib(n: i64) -> i64 {
    if n < 2 { ret n; }
    ret fib(n - 1) + fib(n - 2);
}

pf main() {
    pv cache = Memo::new();

    // First call — computes and caches
    pv r1 = cache.get_or_compute(10, fib);
    print("fib(10) = ");
    print(r1);
    print("\n");

    // Second call — should be a cache hit
    pv r2 = cache.get_or_compute(10, fib);
    print("fib(10) cached = ");
    print(r2);
    print("\n");

    // Cache size
    pv sz = cache.size();
    print("cache size = ");
    print(sz);
    print("\n");

    // Different key — cache miss
    pv r3 = cache.get_or_compute(5, fib);
    print("fib(5) = ");
    print(r3);
    print("\n");

    pv sz2 = cache.size();
    print("cache size2 = ");
    print(sz2);
    print("\n");

    print("OK\n");
}
