// fmt fixture (BG174): statements written with no `;` keep their own
// lines (semicolons are optional, reference.md 1.10). Joined, `val z =
// id(4)` and `(z)` on the next line became the call `id(4)(z)`.
fn id(x: i64) -> i64 { return x }

fn main() -> i64 {
    val x = 1
    print(x)
    val z = id(4)
    (z)
    var w = 5
    w = w
    - 1
    val long = x +
        z
    if x == 1
        && z == 4 { println("both") }

    println(f"{z} {w} {long}")
    return 0
}
