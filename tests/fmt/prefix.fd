// fmt fixture (2g.62): a prefix operator sticks to its operand (`&v`,
// `&mut v`, `-1`, `-x`, `*p`) while a binary one keeps its spaces, a
// postfix `?` sticks to what it follows, and a declaration after an
// annotation and a blank line starts its own line, with no stray space.
use core;
use vec;

fn total(v: &Vec<i64>) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < v.len() {
        s = s + v.get(i);
        i = i + 1;
    }
    return s;
}

fn bump(v: &mut Vec<i64>) {
    v.push(-1);
}

fn half(x: i64) -> Option<i64> {
    if x % 2 != 0 {
        return Option::None;
    }
    return Option::Some(x / 2);
}

fn quarter(x: i64) -> Option<i64> {
    val h: i64 = half(x)?;
    return half(h);
}

@deterministic

fn neg(x: i64) -> i64 {
    return -x;
}

fn main() {
    var v: Vec<i64> = Vec::new();
    v.push(6);
    bump(&mut v);
    val a: i64 = total(&v) & 3;
    val b: i64 = a * -neg(2);
    println(int_to_str(a));
    println(int_to_str(b));
    println(int_to_str(-1 - a));
    println(int_to_str(quarter(12).unwrap_or(0)));
    println(int_to_str(quarter(6).unwrap_or(-7)));
}
