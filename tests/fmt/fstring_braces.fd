// fmt fixture (BG211): a `}` or `{` inside a string or char literal in an
// f-string's braces does not end the interpolation; the f-string comes
// out as it went in.
use core;

fn main() {
    println(f"{str_len("a}c")} and {str_len("a{c")}");
    val d: i64 = 125;
    println(f"{d == '}'}");
    val n: i64 = 1 + 2;
    println(n);
}
