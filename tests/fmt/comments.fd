// fmt fixture (release-roadmap N4): where comments go, and generic
// definitions. A trailing comment stays after the code it follows (`;`,
// `{`, `}`, a field's `,`); a comment written on its own line keeps its own
// line; a doc comment or a section rule joined onto a line by an earlier
// formatter goes back to its own line; `<T, const N: usize>` keeps its
// words apart and the fields of a generic struct one per line.
module fmt_comments;
use core;
use vec;
// --- Shapes ---------------------------------------
const SIDES: i64 = 4;  // a square
const SCALE: i64 = 2;
/// The area of a square of side `s`.
fn area(s: i64) -> i64 {  // no overflow check: small sides
    return s * s;
}  // end of area

struct Grid<T, const N: usize> {
    first: T,  // the first cell
    name: str,
}

enum Mark<T> {
    Empty,
    Full(T),
}

fn total(a: i64,
    // the second operand
    b: i64) -> i64 {
    return a + b;
}

fn main() {
    val a: i64 = area(SIDES);  // 16
    val t: i64 = total(1,
        // two
        2);
    val g: Grid<i64, 2> = Grid {
        first: a + t, name: "g"
    };
    val m: Mark<i64> = Mark::Full(SCALE);
    match m {
        Mark::Full(x) => {  // the scale
            println(int_to_str(x));
        }
        Mark::Empty => {
        }
    }
    println(int_to_str(g.first) + " " + g.name);
}
