// fmt fixture (release-roadmap N4): every top-level declaration ends its
// line at its `;`, and a comment on the next line stays there.
module fmt_toplevel;
// the imports
use core;
use vec;
type Count = i64;
const LIMIT: i64 = 3;  // a trailing comment stays after the `;` it follows
const MORE: i64 = 1; /// a doc comment documents what follows: it goes to its own line

/// The sum of 0..n.
fn sum_to(n: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n { s = s + i; i = i + 1; }
    return s;
}

fn main() {
    val c: Count = sum_to(LIMIT);
    println(int_to_str(c));
}
