// fmt fixture (BG101, BG102, BG103, BG107): what the formatter's
// tokenizer must keep whole. A string inside an f-string interpolation
// (`f"{tag("k")}"` became `f"{tag(" k ")}"`), a lifetime name (`&'a i64`
// became `&' a i64`), the char literals `'\x41'` and `'\u{1F600}'` (split
// into a quote, a name and a quote) and a block comment after `/` (joined
// into `//* two */`, a line comment) come out as they went in.
use core;

fn tag(s: str) -> str {
    return s;
}

fn first<'a>(x: &'a i64, y: &i64) -> &'a i64 {
    if *y > *x {
        return x;
    }
    return x;
}

fn main() {
    println(f"{tag("k")} and {tag("v")}");
    var a: i64 = 5;
    var b: i64 = 3;
    val r = first(&a, &b);
    println(*r);
    val x: i64 = '\x41';
    val u: i64 = '\u{1F600}';
    println(x);
    println(u);
    val q: i64 = 10 / /* two */ 2;
    println(q);
}
