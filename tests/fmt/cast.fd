// fmt fixture: a cast to a pointer type keeps `*mut` and `*const` together
// (`a as *mut u8`, `(a + 1) as *const u8`): after `as` a `*` starts the
// type and is no product, so it gets no space (`as * mut u8` before). A
// product keeps its spaces.
use core;
use vec;

fn as_ptr(a: i64) -> i64 {
    return (a as *mut u8) as i64;
}

fn main() {
    val a: i64 = 4096;
    val p = a as *mut u8;
    val q = (a + 1) as *const u8;
    println(int_to_str(as_ptr(a)));
    println(int_to_str(p as i64));
    println(int_to_str(q as i64));
    println(int_to_str(2 * 3));
}
