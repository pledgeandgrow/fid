pub struct Inner {
    pub a: i64,
    pub b: i64,
    pub c: i64,
    pub d: i64,
    pub e: i64,
}

pub struct BigStruct {
    pub a: i64,
    pub b: i64,
    pub c: i64,
    pub d: i64,
    pub e: i64,
    pub inner: Inner,
    pub f: i64,
    pub g: i64,
    pub h: i64,
    pub i: i64,
    pub j: i64,
    pub k: i64,
    pub l: i64,
    pub m: i64,
    pub n: i64,
    pub o: i64,
}

pub enum OptBig {
    Some(BigStruct),
    None,
}

pub fn make_big(b: BigStruct) -> OptBig {
    return OptBig::Some(b);
}

pub fn extract_big(opt: OptBig) -> i64 {
    match opt {
        OptBig::Some(b) => {
            return b.a + b.f + b.o + b.inner.a + b.inner.e;
        }
        OptBig::None => {
            return 0;
        }
    }
}

fn main() {
    var b: BigStruct = BigStruct {
        a: 1, b: 2, c: 3, d: 4, e: 5,
        inner: Inner { a: 10, b: 20, c: 30, d: 40, e: 50 },
        f: 6, g: 7, h: 8, i: 9, j: 10,
        k: 11, l: 12, m: 13, n: 14, o: 15,
    };
    var opt: OptBig = make_big(b);
    var result: i64 = extract_big(opt);
    print(result);
}
