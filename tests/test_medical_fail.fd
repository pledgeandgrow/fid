// Test: F48 @medical annotation — IEC 62304 violations (expected fail)
//
// This function violates multiple @medical rules:
//   1. Uses Vec (dynamic allocation)
//   2. Uses recursion (self-call)
//   3. Missing @audit (no logging)

@medical
pf bad_medical_func(n: i64) -> i64 {
    // BAD: dynamic allocation
    pv arr = Vec::new();
    arr.push(n);
    
    // BAD: recursion (self-call)
    if n > 0 {
        ret bad_medical_func(n - 1) + 1;
    }
    
    // BAD: while loop (unbounded)
    pv i = 0;
    while i < 10 {
        i = i + 1;
    }
    
    ret n;
}

pf main() {
    pv result = bad_medical_func(5);
    print(result);
}
