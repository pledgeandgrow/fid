use time;

pf main() -> i64 {
    // Test construction from date
    pv t1 = time_new(2024, 1, 15, 10, 30, 45);
    print("Date: ");
    print(time_to_iso(t1));
    print("\n");

    // Test extraction
    print("Year: ");
    print(time_get_year(t1));
    print("\n");
    print("Month: ");
    print(time_get_month(t1));
    print("\n");
    print("Day: ");
    print(time_get_day(t1));
    print("\n");
    print("Hour: ");
    print(time_get_hour(t1));
    print("\n");
    print("Minute: ");
    print(time_get_minute(t1));
    print("\n");
    print("Second: ");
    print(time_get_second(t1));
    print("\n");

    // Test weekday (2024-01-15 is Monday = 1)
    print("Weekday: ");
    print(time_get_weekday(t1));
    print("\n");

    // Test date arithmetic
    pv t2 = time_add_days(t1, 30);
    print("Date + 30 days: ");
    print(time_to_iso(t2));
    print("\n");

    // Test difference
    pv diff = time_diff_days(t2, t1);
    print("Diff days: ");
    print(diff);
    print("\n");

    // Test comparison
    print("t1 before t2: ");
    print(time_before(t1, t2));
    print("\n");

    // Test from_timestamp
    pv t3 = time_from_timestamp(0);
    print("Epoch: ");
    print(time_to_iso(t3));
    print("\n");

    // Test leap year
    print("2024 leap: ");
    print(is_leap_year(2024));
    print("\n");
    print("2023 leap: ");
    print(is_leap_year(2023));
    print("\n");
    print("2000 leap: ");
    print(is_leap_year(2000));
    print("\n");
    print("1900 leap: ");
    print(is_leap_year(1900));
    print("\n");

    // Test days_in_month
    print("Feb 2024 days: ");
    print(days_in_month(2024, 2));
    print("\n");
    print("Feb 2023 days: ");
    print(days_in_month(2023, 2));
    print("\n");

    // Test day_of_year
    print("Day of year (Jan 15): ");
    print(time_get_day_of_year(t1));
    print("\n");

    // Test date string
    print("Date string: ");
    print(time_to_date_string(t1));
    print("\n");

    ret 0;
}
