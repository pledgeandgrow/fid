// Test stdlib modules: math, env, args, process, regex
use math;
use env;
use args;
use regex;

fn main() -> i64 {
    val s = math_sqrt(16.0);
    print(s);
    val p = math_pow(2.0, 10.0);
    print(p);
    val f = math_floor(3.7);
    print(f);
    val c = math_ceil(3.2);
    print(c);
    val a = math_fabs(-5.5);
    print(a);
    val m1 = regex_matches("hello", "h?llo");
    print(m1);
    val m2 = regex_matches("hello", "world");
    print(m2);
    val m3 = regex_matches("hello world", "*world");
    print(m3);
    val f1 = regex_find("hello world", "world");
    print(f1);
    val f2 = regex_find("hello world", "xyz");
    print(f2);
    val c1 = regex_contains("hello world", "lo wo");
    print(c1);
    val sw = regex_starts_with("hello", "hel");
    print(sw);
    val ew = regex_ends_with("hello", "llo");
    print(ew);
    val path = env_get("PATH");
    if path != "" {
        print(true);
    } else {
        print(false);
    }
    val argc = args_len();
    print(argc > 0);
    return 0;
}
