// Test stdlib modules: math, env, args, process, regex
use math;
use env;
use args;
use regex;

pf main() -> i64 {
    pv s = math_sqrt(16.0);
    print(s);
    pv p = math_pow(2.0, 10.0);
    print(p);
    pv f = math_floor(3.7);
    print(f);
    pv c = math_ceil(3.2);
    print(c);
    pv a = math_fabs(-5.5);
    print(a);
    pv m1 = regex_matches("hello", "h?llo");
    print(m1);
    pv m2 = regex_matches("hello", "world");
    print(m2);
    pv m3 = regex_matches("hello world", "*world");
    print(m3);
    pv f1 = regex_find("hello world", "world");
    print(f1);
    pv f2 = regex_find("hello world", "xyz");
    print(f2);
    pv c1 = regex_contains("hello world", "lo wo");
    print(c1);
    pv sw = regex_starts_with("hello", "hel");
    print(sw);
    pv ew = regex_ends_with("hello", "llo");
    print(ew);
    pv path = env_get("PATH");
    if path != "" {
        print(true);
    } else {
        print(false);
    }
    pv argc = args_len();
    print(argc > 0);
    ret 0;
}
