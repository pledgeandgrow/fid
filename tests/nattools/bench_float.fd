// MI14's float benchmark (tests/nattools/mi14_bench.sh, beside
// bench/fides/{fib,loop,sieve,hashmap}.fd): a float loop with no call
// (the float register class, MI25), then a float loop with a call in it
// (floats live across the call: live-range splitting of floats, RA4).
// Prints two integers; every backend must print the same.

// a real call: recursive, so never inlined
fn bump(k: i64) -> i64 {
    if k <= 0 {
        return 0;
    }
    return (k & 1) + bump(k >> 6);
}

fn main() -> i64 {
    var x: f64 = 0.0;
    var y: f64 = 1.0;
    var i: i64 = 0;
    while i < 200000000 {
        x = x + y * 0.5;
        y = y * 0.999999 + 0.000001;
        i = i + 1;
    }
    var a: f64 = 0.0;
    var b: f64 = 0.5;
    var t: i64 = 0;
    i = 0;
    while i < 20000000 {
        a = a + b * 0.25;
        b = b * 0.5 + 0.25;
        t = t + bump(i);
        a = a - b * 0.125;
        b = b + 0.0625;
        i = i + 1;
    }
    println(x as i64);
    println((a as i64) + t);
    return 0;
}
