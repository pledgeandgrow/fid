// RA4 (docs/roadmap/llvm-roadmap.md): live-range splitting through the
// whole register allocation of compiler/nat_ir.fd (ng_mir_alloc_split: the
// first allocation, ng_split_plan, the second allocation with the split
// moves kept out of coalescing, the cost model), with the MIR verifier,
// the allocation checker and the split checker on (as FID_VERIFY=1), on
// hand-made machine IR for AArch64, RISC-V and x86-64, through
// nat_split_alloc_unit. tests/nattools/split_unit.fd checks the planner
// and the split checker alone; this file checks what the allocator makes
// of the pieces. Each function is allocated three ways: no splitting
// (FID_NAT_OFF=split), the default (the split kept when it costs less) and
// every value split and kept (FID_NAT_ON=splitall). The allocated function
// is then run by the interpreter below over the registers and frame slots
// the allocation gave (a call overwrites every register that is not
// callee-saved; a rematerialized value is its constant) and must give what
// the function computes over its vregs:
//   wide      twenty values made before a call and live across it, then
//             changed in a call-free loop and read after a second call:
//             more values than callee-saved registers, so some spill; in
//             the loop their pieces take caller-saved registers on AArch64
//             (x8-x11: the split is kept). RISC-V's caller-saved pool is
//             t4 alone, which the loop's counter holds, and x86-64 has
//             none: there the pieces get no register and the split is not
//             kept
//   calls     values read and written between calls (runs)
//   midexit   a loop left from its middle (a store in an edge block)
//   random    24 random programs per target (20 values, calls, nested
//             loops, loops left from the middle, if and if/else)
// The cost numbers (with and without the split, summed over the random
// programs) go to stderr as [split_alloc] lines; the lines checked hold
// what must hold whatever the cost model decides, except that wide's split
// must be kept on AArch64. Before the coalescing fix of Nov 17 (nat_ir.fd
// ng_mir_alloc, the first round's second rule: s's definition and the copy
// in one block) the random programs were rejected by the allocation
// checker on RISC-V and x86-64 (`writes register N while another live
// value holds it`), and one x86-64 split computed something else.
// SPLIT_ALLOC_DUMP=a64|rv64|x64 prints every allocation of that target's
// three cases on stderr. FID_NAT_MUTATE=split (no stores at loop exits):
// some random allocations must then be rejected and none may differ.
// Op codes are compiler/mir.fd's MO_* numbers (MO_LI 1, MO_MOV 2, MO_CALL
// 9, MO_JMP 11, MO_BNEZ 12, MO_BEQZ 13, MO_ADD 16, MO_SUB 17, MO_MUL 18,
// MO_AND 19, MO_PROLOGUE 36, MO_EPILOGUE 37, MO_PLACE 41); values are vregs
// 64 and up.
// Run (natively: `fid run` interprets all of compiler::nat_ir, which is
// slow):
//   fid ccompile tests/nattools/split_alloc_unit.fd -o split_alloc_unit.exe && ./split_alloc_unit.exe
// Expected output:
// a64 wide: off same, default same, all same; split
// a64 wide: kept by default: yes
// a64 calls: off same, default same, all same; split
// a64 midexit: off same, default same, all same; split
// a64 random: 24 programs, 0 rejected, 0 differ, splits made: yes
// rv64 wide: off same, default same, all same; split
// rv64 calls: off same, default same, all same; split
// rv64 midexit: off same, default same, all same; split
// rv64 random: 24 programs, 0 rejected, 0 differ, splits made: yes
// x64 wide: off same, default same, all same; split
// x64 calls: off same, default same, all same; split
// x64 midexit: off same, default same, all same; split
// x64 random: 24 programs, 0 rejected, 0 differ, splits made: yes
use core;
use vec;
use string;
use compiler::nat_enc;
use compiler::nat_ir;

fn op(v: & mut Vec<i64>, o: i64, r0: i64, r1: i64, r2: i64, i0: i64) {
    v.push(o);
    v.push(r0);
    v.push(r1);
    v.push(r2);
    v.push(i0);
    v.push(0);
    v.push(0);
}

/// The allocation's location of operand x: a physical register (x < 64,
/// or the vreg's register), -1 for a slot, -2 for a constant.
struct Alloc {
    assign: Vec<i64>,
    remat: Vec<i64>,
    remat_val: Vec<i64>,
    spill: Vec<i64>,
}

const POISON: i64 = 7777;

/// Run machine IR rows with the result in register `res`; when `alloc`,
/// the vregs live where `al` puts them (registers, slots, constants) and a
/// call overwrites every register outside `keep`; otherwise every vreg is
/// a cell of its own and a call overwrites the physical registers only.
/// -1 when it runs too long, jumps nowhere or meets an unknown operation.
fn eval(flat: & Vec<i64>, res: i64, alloc: bool, al: & Alloc, keep: i64) -> i64 {
    var regs: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 4096 {
        regs.push(0);
        i = i + 1;
    }
    var slots: i64 = HashMap_new();
    var n: i64 = flat.len() / 7;
    var labels: i64 = HashMap_new();
    var k: i64 = 0;
    while k < n {
        if flat.get(7 * k) == 41 {
            HashMap_insert_i(labels, flat.get(7 * k + 4), k);
        }
        k = k + 1;
    }
    var pc: i64 = 0;
    var steps: i64 = 0;
    while pc < n && steps < 200000 {
        steps = steps + 1;
        var o: i64 = flat.get(7 * pc);
        var r0: i64 = flat.get(7 * pc + 1);
        var r1: i64 = flat.get(7 * pc + 2);
        var r2: i64 = flat.get(7 * pc + 3);
        var i0: i64 = flat.get(7 * pc + 4);
        var to: i64 = pc + 1;
        if o == 1 {
            wr(& mut regs, slots, alloc, al, r0, i0);
        } else if o == 2 {
            var a2: i64 = rd(& regs, slots, alloc, al, r1);
            wr(& mut regs, slots, alloc, al, r0, a2);
        } else if o >= 16 && o <= 19 {
            var x: i64 = rd(& regs, slots, alloc, al, r1);
            var y: i64 = rd(& regs, slots, alloc, al, r2);
            var z: i64 = x & y;
            if o == 16 {
                z = x + y;
            } else if o == 17 {
                z = x - y;
            } else if o == 18 {
                z = x * y;
            }
            wr(& mut regs, slots, alloc, al, r0, z);
        } else if o == 9 {
            var c: i64 = 0;
            while c < 64 {
                if (keep & (1 << c)) == 0 {
                    regs.set(c, POISON + steps + c);
                }
                c = c + 1;
            }
        } else if o == 11 || (o == 12 && rd(& regs, slots, alloc, al, r0) != 0) || (o == 13 && rd(& regs, slots, alloc, al, r0) == 0) {
            if !HashMap_contains_i(labels, i0) {
                return 0 - 1;
            }
            to = HashMap_get_i(labels, i0);
        } else if o == 37 {
            return regs.get(res);
        } else if o != 12 && o != 13 && o != 36 && o != 41 {
            return 0 - 1;
        }
        pc = to;
    }
    return 0 - 1;
}

/// Where operand x lives: >= 0 a register (regs index), -1 its slot, -2
/// its constant.
fn where_is(alloc: bool, al: & Alloc, x: i64) -> i64 {
    if x < 64 {
        return x;
    }
    if !alloc {
        return x;
    }
    var vi: i64 = x - 64;
    var a: i64 = al.assign.get(vi);
    if a >= 0 {
        return a;
    }
    if al.remat.get(vi) != 0 {
        return 0 - 2;
    }
    return 0 - 1;
}

fn rd(regs: & Vec<i64>, slots: i64, alloc: bool, al: & Alloc, x: i64) -> i64 {
    var w: i64 = where_is(alloc, al, x);
    if w >= 0 {
        return regs.get(w);
    }
    var vi: i64 = x - 64;
    if w == 0 - 2 {
        return al.remat_val.get(vi);
    }
    var s: i64 = al.spill.get(vi);
    if HashMap_contains_i(slots, s) {
        return HashMap_get_i(slots, s);
    }
    return 0;
}

fn wr(regs: & mut Vec<i64>, slots: i64, alloc: bool, al: & Alloc, x: i64, v: i64) {
    var w: i64 = where_is(alloc, al, x);
    if w >= 0 {
        regs.set(w, v);
    } else if w == 0 - 1 {
        // (a constant is computed again where used: its definition and the
        // moves into it emit nothing)
        HashMap_insert_i(slots, al.spill.get(x - 64), v);
    }
}

fn no_alloc() -> Alloc {
    return Alloc { assign: Vec::new(), remat: Vec::new(), remat_val: Vec::new(), spill: Vec::new() };
}

/// One allocation of `flat`: the checkers' verdict, the result of the
/// allocated function, and the header numbers (pieces, loops, edges, cost
/// without, cost with, kept).
struct Run {
    err: str,
    result: i64,
    head: Vec<i64>,
    why: str,
    // values in a slot (spilled, not constants) and in registers
    spilled: i64,
    in_regs: i64,
}

fn why_of(w: str) -> str {
    if w == "" {
        return "";
    }
    return " (not split: " + w + ")";
}

fn run_alloc(arch: i64, flat: & Vec<i64>, nv: i64, mode: i64) -> Run {
    var out: Vec<i64> = nat_split_alloc_unit(arch, flat, nv, mode);
    var err: str = nat_split_alloc_unit_err();
    var why: str = nat_split_alloc_unit_why();
    var head: Vec<i64> = Vec::new();
    var h: i64 = 0;
    while h < 8 {
        head.push(out.get(h));
        h = h + 1;
    }
    var keep: i64 = out.get(8);
    var res: i64 = out.get(9);
    var nrows: i64 = out.get(10);
    var rows: Vec<i64> = Vec::new();
    var p: i64 = 11;
    while p < 11 + 7 * nrows {
        rows.push(out.get(p));
        p = p + 1;
    }
    var nvf: i64 = out.get(p);
    p = p + 1;
    var va: Vec<i64> = Vec::new();
    var vr: Vec<i64> = Vec::new();
    var vv: Vec<i64> = Vec::new();
    var vs: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nvf {
        va.push(out.get(p));
        vr.push(out.get(p + 1));
        vv.push(out.get(p + 2));
        vs.push(out.get(p + 3));
        p = p + 4;
        i = i + 1;
    }
    var al: Alloc = Alloc { assign: va, remat: vr, remat_val: vv, spill: vs };
    var r: i64 = eval(& rows, res, true, & al, keep);
    if g_dump_all {
        dump_alloc(& rows, & al, "(SPLIT_ALLOC_DUMP) mode " + int_to_str(mode) + " " + err);
    }
    if err != "" && g_dumps > 0 {
        g_dumps = g_dumps - 1;
        dump_alloc(& rows, & al, err);
    }
    var nsp: i64 = 0;
    var nrg: i64 = 0;
    i = 0;
    while i < nvf {
        if al.assign.get(i) == 0 - 1 && al.remat.get(i) == 0 {
            nsp = nsp + 1;
        }
        if al.assign.get(i) >= 0 {
            nrg = nrg + 1;
        }
        i = i + 1;
    }
    return Run { err: err, result: r, head: head, why: why, spilled: nsp, in_regs: nrg };
}

/// How many rejected allocations dump_alloc still prints (stderr).
var g_dumps: i64 = 2;
/// SPLIT_ALLOC_DUMP=<target> (a64, rv64, x64): every allocation of that
/// target's three cases printed (stderr).
var g_dump_all: bool = false;
var g_dump_target: i64 = 0;

fn loc(al: & Alloc, x: i64) -> str {
    if x < 64 {
        return "p" + int_to_str(x);
    }
    var vi: i64 = x - 64;
    var s: str = "v" + int_to_str(x);
    if vi >= al.assign.len() {
        return s + "?";
    }
    var a: i64 = al.assign.get(vi);
    if a >= 0 {
        return s + "=r" + int_to_str(a);
    }
    if al.remat.get(vi) != 0 {
        return s + "=c" + int_to_str(al.remat_val.get(vi));
    }
    return s + "=s" + int_to_str(al.spill.get(vi));
}

/// A rejected allocation, row by row, on stderr.
fn dump_alloc(rows: & Vec<i64>, al: & Alloc, err: str) {
    p_eprint_str("[split_alloc] rejected: " + err + "\n");
    var k: i64 = 0;
    while k < rows.len() / 7 {
        var o: i64 = rows.get(7 * k);
        var line: str = int_to_str(k) + ": op " + int_to_str(o);
        var f: i64 = 1;
        while f <= 3 {
            var x: i64 = rows.get(7 * k + f);
            if x >= 64 || (f == 1 && x != 0) {
                line = line + " " + loc(al, x);
            }
            f = f + 1;
        }
        line = line + " i " + int_to_str(rows.get(7 * k + 4));
        p_eprint_str("[split_alloc]   " + line + "\n");
        k = k + 1;
    }
}

fn res_reg(arch: i64) -> i64 {
    if arch == NAT_RV64 {
        return 10;
    }
    return 0;
}

/// The function computed over its vregs.
fn want_of(arch: i64, flat: & Vec<i64>) -> i64 {
    var none: Alloc = no_alloc();
    return eval(flat, res_reg(arch), false, & none, 0);
}

fn verdict(r: & Run, want: i64) -> str {
    if r.err != "" {
        return "rejected (" + r.err + ")";
    }
    if r.result != want {
        return "differs (" + int_to_str(want) + " " + int_to_str(r.result) + ")";
    }
    return "same";
}

fn show(arch: i64, name: str, cname: str, flat: & Vec<i64>, nv: i64) {
    var want: i64 = want_of(arch, flat);
    var off: Run = run_alloc(arch, flat, nv, 1);
    var def: Run = run_alloc(arch, flat, nv, 0);
    var all: Run = run_alloc(arch, flat, nv, 2);
    var split: str = "split";
    if all.head.get(0) == 0 {
        split = "nothing split";
    }
    println(name + " " + cname + ": off " + verdict(& off, want) + ", default " + verdict(& def, want) + ", all " + verdict(& all, want) + "; " + split);
    p_eprint_str("[split_alloc] " + name + " " + cname + ": result " + int_to_str(want) + ", pieces " + int_to_str(def.head.get(0)) + " (" + int_to_str(def.head.get(1)) + " around loops), " + int_to_str(def.head.get(2)) + " edge blocks, cost " + int_to_str(def.head.get(3)) + " -> " + int_to_str(def.head.get(4)) + ", kept " + int_to_str(def.head.get(5)) + ", candidates " + int_to_str(def.head.get(6)) + ", left whole " + int_to_str(def.head.get(7)) + why_of(def.why) + "; without the split " + int_to_str(off.spilled) + " values in slots, " + int_to_str(off.in_regs) + " in registers\n");
    if cname == "wide" && arch == NAT_A64 {
        var k: str = "no";
        if def.head.get(5) == 1 {
            k = "yes";
        }
        println(name + " wide: kept by default: " + k);
    }
}

// twenty values x0..x19 (v64..v83), made from a counter so that none is a
// constant; base (v84), one (v85), n (v86), acc (v87)
fn case_wide(res: i64) -> Vec<i64> {
    var f: Vec<i64> = Vec::new();
    op(& mut f, 36, 0, 0, 0, 0);
    op(& mut f, 1, 84, 0, 0, 3);
    op(& mut f, 1, 85, 0, 0, 1);
    op(& mut f, 1, 87, 0, 0, 0);
    var v: i64 = 64;
    while v < 84 {
        op(& mut f, 16, 84, 84, 85, 0);
        op(& mut f, 16, v, 84, 84, 0);
        v = v + 1;
    }
    op(& mut f, 9, 0, 0, 0, 50);
    op(& mut f, 1, 86, 0, 0, 5);
    op(& mut f, 41, 0, 0, 0, 1);
    v = 64;
    while v < 84 {
        op(& mut f, 16, 87, 87, v, 0);
        op(& mut f, 16, v, v, 85, 0);
        v = v + 1;
    }
    op(& mut f, 17, 86, 86, 85, 0);
    op(& mut f, 12, 86, 0, 0, 1);
    op(& mut f, 9, 0, 0, 0, 50);
    v = 64;
    while v < 84 {
        op(& mut f, 18, 87, 87, 85, 0);
        op(& mut f, 16, 87, 87, v, 0);
        v = v + 1;
    }
    op(& mut f, 2, res, 87, 0, 0);
    op(& mut f, 37, 0, 0, 0, 0);
    return f;
}

// x (v64), y (v65) and twelve others (v70..v81) across two calls
fn case_calls(res: i64) -> Vec<i64> {
    var f: Vec<i64> = Vec::new();
    op(& mut f, 36, 0, 0, 0, 0);
    op(& mut f, 1, 82, 0, 0, 1);
    op(& mut f, 1, 64, 0, 0, 7);
    op(& mut f, 16, 64, 64, 82, 0);
    var v: i64 = 70;
    while v < 82 {
        op(& mut f, 16, v, 64, 82, 0);
        op(& mut f, 16, 64, 64, 82, 0);
        v = v + 1;
    }
    op(& mut f, 16, 65, 64, 64, 0);
    op(& mut f, 18, 66, 65, 64, 0);
    op(& mut f, 9, 0, 0, 0, 50);
    op(& mut f, 16, 67, 64, 66, 0);
    op(& mut f, 16, 64, 64, 67, 0);
    op(& mut f, 17, 68, 64, 65, 0);
    op(& mut f, 16, 65, 65, 68, 0);
    op(& mut f, 9, 0, 0, 0, 50);
    op(& mut f, 16, 69, 64, 68, 0);
    op(& mut f, 18, 69, 69, 65, 0);
    v = 70;
    while v < 82 {
        op(& mut f, 16, 69, 69, v, 0);
        v = v + 1;
    }
    op(& mut f, 2, res, 69, 0, 0);
    op(& mut f, 37, 0, 0, 0, 0);
    return f;
}

// x (v64) written in a loop left in its middle when i == three (v69),
// with sixteen values (v71..v86) live across a call around it
fn case_midexit(res: i64) -> Vec<i64> {
    var f: Vec<i64> = Vec::new();
    op(& mut f, 36, 0, 0, 0, 0);
    op(& mut f, 1, 67, 0, 0, 1);
    op(& mut f, 1, 64, 0, 0, 2);
    op(& mut f, 16, 64, 64, 67, 0);
    var v: i64 = 71;
    while v < 87 {
        op(& mut f, 16, v, 64, 64, 0);
        op(& mut f, 16, 64, 64, 67, 0);
        v = v + 1;
    }
    op(& mut f, 9, 0, 0, 0, 50);
    op(& mut f, 1, 65, 0, 0, 0);
    op(& mut f, 1, 66, 0, 0, 6);
    op(& mut f, 1, 69, 0, 0, 3);
    op(& mut f, 41, 0, 0, 0, 1);
    op(& mut f, 16, 64, 64, 67, 0);
    op(& mut f, 16, 65, 65, 64, 0);
    op(& mut f, 17, 68, 66, 69, 0);
    op(& mut f, 13, 68, 0, 0, 2);
    op(& mut f, 17, 66, 66, 67, 0);
    op(& mut f, 12, 66, 0, 0, 1);
    op(& mut f, 41, 0, 0, 0, 2);
    op(& mut f, 9, 0, 0, 0, 50);
    op(& mut f, 18, 70, 65, 64, 0);
    op(& mut f, 16, 70, 70, 64, 0);
    op(& mut f, 16, 70, 70, 66, 0);
    op(& mut f, 16, 70, 70, 69, 0);
    v = 71;
    while v < 87 {
        op(& mut f, 16, 70, 70, v, 0);
        v = v + 1;
    }
    op(& mut f, 2, res, 70, 0, 0);
    op(& mut f, 37, 0, 0, 0, 0);
    return f;
}

// random programs: values v64..v83, the mask v84, temporaries from v85
const NVAL: i64 = 20;
var g_seed: i64 = 20261117;
var g_lab: i64 = 1;
var g_tmp: i64 = 85;

fn rnd(n: i64) -> i64 {
    g_seed = (g_seed * 1103515245 + 12345) % 2147483648;
    return (g_seed / 65536) % n;
}

fn new_tmp() -> i64 {
    var t: i64 = g_tmp;
    g_tmp = g_tmp + 1;
    return t;
}

fn new_lab() -> i64 {
    var l: i64 = g_lab;
    g_lab = g_lab + 1;
    return l;
}

fn val() -> i64 {
    return 64 + rnd(NVAL);
}

fn gen_block(f: & mut Vec<i64>, depth: i64, count: i64) {
    var i: i64 = 0;
    while i < count {
        gen_stmt(f, depth);
        i = i + 1;
    }
}

fn gen_stmt(f: & mut Vec<i64>, depth: i64) {
    var r: i64 = rnd(10);
    if r == 5 {
        op(f, 9, 0, 0, 0, 50);
    } else if r == 6 {
        op(f, 2, val(), val(), 0, 0);
    } else if r == 7 && depth < 2 {
        var t: i64 = new_tmp();
        var one: i64 = new_tmp();
        var top: i64 = new_lab();
        op(f, 1, t, 0, 0, 1 + rnd(3));
        op(f, 1, one, 0, 0, 1);
        op(f, 41, 0, 0, 0, top);
        gen_block(f, depth + 1, 1 + rnd(5));
        var out: i64 = 0 - 1;
        if rnd(2) == 0 {
            out = new_lab();
            var c: i64 = new_tmp();
            op(f, 17, c, val(), val(), 0);
            op(f, 13, c, 0, 0, out);
            gen_block(f, depth + 1, rnd(3));
        }
        op(f, 17, t, t, one, 0);
        op(f, 12, t, 0, 0, top);
        if out >= 0 {
            op(f, 41, 0, 0, 0, out);
        }
    } else if r == 8 && depth < 2 {
        var c2: i64 = new_tmp();
        var skip: i64 = new_lab();
        op(f, 17, c2, val(), val(), 0);
        op(f, 12 + rnd(2), c2, 0, 0, skip);
        gen_block(f, depth + 1, 1 + rnd(3));
        op(f, 41, 0, 0, 0, skip);
    } else if r == 9 && depth < 2 {
        var c3: i64 = new_tmp();
        var els: i64 = new_lab();
        var end: i64 = new_lab();
        op(f, 17, c3, val(), val(), 0);
        op(f, 13, c3, 0, 0, els);
        gen_block(f, depth + 1, 1 + rnd(3));
        op(f, 11, 0, 0, 0, end);
        op(f, 41, 0, 0, 0, els);
        gen_block(f, depth + 1, 1 + rnd(3));
        op(f, 41, 0, 0, 0, end);
    } else {
        var d: i64 = val();
        op(f, 16 + rnd(3), d, val(), val(), 0);
        op(f, 19, d, d, 64 + NVAL, 0);
    }
}

fn gen_prog(res: i64) -> Vec<i64> {
    g_lab = 1;
    g_tmp = 64 + NVAL + 1;
    var f: Vec<i64> = Vec::new();
    op(& mut f, 36, 0, 0, 0, 0);
    // each value made by an addition (a constant would be rematerialized,
    // never split)
    var seed: i64 = new_tmp();
    op(& mut f, 1, seed, 0, 0, 1 + rnd(9));
    var v: i64 = 64;
    while v < 64 + NVAL {
        var c: i64 = new_tmp();
        op(& mut f, 1, c, 0, 0, rnd(50));
        op(& mut f, 16, v, c, seed, 0);
        v = v + 1;
    }
    op(& mut f, 1, 64 + NVAL, 0, 0, 255);
    gen_block(& mut f, 0, 6 + rnd(8));
    var acc: i64 = new_tmp();
    op(& mut f, 1, acc, 0, 0, 0);
    v = 64;
    while v < 64 + NVAL {
        op(& mut f, 16, acc, acc, v, 0);
        op(& mut f, 18, acc, acc, v, 0);
        op(& mut f, 19, acc, acc, 64 + NVAL, 0);
        v = v + 1;
    }
    op(& mut f, 2, res, acc, 0, 0);
    op(& mut f, 37, 0, 0, 0, 0);
    return f;
}

fn random_progs(arch: i64, name: str, count: i64) {
    g_seed = 4242 + arch;
    var n_rej: i64 = 0;
    var n_differ: i64 = 0;
    var n_split: i64 = 0;
    var n_kept: i64 = 0;
    var cost_off: i64 = 0;
    var cost_on: i64 = 0;
    var pieces: i64 = 0;
    var p: i64 = 0;
    while p < count {
        var f: Vec<i64> = gen_prog(res_reg(arch));
        var nv: i64 = g_tmp - 64;
        var want: i64 = want_of(arch, & f);
        var m: i64 = 0;
        while m < 3 {
            var r: Run = run_alloc(arch, & f, nv, m);
            if r.err != "" {
                n_rej = n_rej + 1;
                var rs: str = "same result";
                if r.result != want {
                    rs = "result differs";
                }
                println(name + " random " + int_to_str(p) + " mode " + int_to_str(m) + ": rejected (" + rs + "): " + r.err);
            } else if r.result != want {
                n_differ = n_differ + 1;
                println(name + " random " + int_to_str(p) + " mode " + int_to_str(m) + ": differs (" + int_to_str(want) + " " + int_to_str(r.result) + ")");
            }
            if m == 2 && r.head.get(0) > 0 {
                n_split = n_split + 1;
            }
            if m == 0 && r.head.get(0) > 0 {
                pieces = pieces + r.head.get(0);
                cost_off = cost_off + r.head.get(3);
                if r.head.get(5) == 1 {
                    n_kept = n_kept + 1;
                    cost_on = cost_on + r.head.get(4);
                } else {
                    cost_on = cost_on + r.head.get(3);
                }
            }
            m = m + 1;
        }
        p = p + 1;
    }
    p_eprint_str("[split_alloc] " + name + " random: " + int_to_str(count) + " programs, " + int_to_str(n_split) + " split (splitall), default: " + int_to_str(pieces) + " pieces, " + int_to_str(n_kept) + " kept, estimated cost " + int_to_str(cost_off) + " -> " + int_to_str(cost_on) + "\n");
    var made: str = "no";
    if n_split > 0 {
        made = "yes";
    }
    println(name + " random: " + int_to_str(count) + " programs, " + int_to_str(n_rej) + " rejected, " + int_to_str(n_differ) + " differ, splits made: " + made);
}

fn target(arch: i64, name: str) {
    g_dump_all = g_dump_target == arch;
    var res: i64 = res_reg(arch);
    var w: Vec<i64> = case_wide(res);
    show(arch, name, "wide", & w, 24);
    var c: Vec<i64> = case_calls(res);
    show(arch, name, "calls", & c, 19);
    var m: Vec<i64> = case_midexit(res);
    show(arch, name, "midexit", & m, 23);
    g_dump_all = false;
    random_progs(arch, name, 24);
}

fn main() {
    var dt: str = p_str_take(p_getenv("SPLIT_ALLOC_DUMP"));
    if dt == "a64" {
        g_dump_target = NAT_A64;
    } else if dt == "rv64" {
        g_dump_target = NAT_RV64;
    } else if dt == "x64" {
        g_dump_target = NAT_X64;
    }
    target(NAT_A64, "a64");
    target(NAT_RV64, "rv64");
    target(NAT_X64, "x64");
}
