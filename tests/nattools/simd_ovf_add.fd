// K10 (tests/nattools/simd_native_check.sh): a checked elementwise + in a
// @simd function where element 37 overflows. The pre-scan
// (compiler/nat_ir.fd ng_vz_guard) sees elements past 2^31 and skips the
// vector loop: every path prints "start" and panics on the overflow at
// element 37, never "done" (a wrapping vector loop would finish).

@simd
fn add_into(c: & mut Vec<i64>, a: Vec<i64>, b: Vec<i64>) {
    var i: i64 = 0;
    while i < a.len() {
        c.set(i, a.get(i) + b.get(i));
        i = i + 1;
    }
}

fn main() {
    var a: Vec<i64> = Vec::new();
    var b: Vec<i64> = Vec::new();
    var c: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 64 {
        a.push(i);
        if i == 37 {
            b.push(9223372036854775807);
        } else {
            b.push(i * 2);
        }
        c.push(0);
        i = i + 1;
    }
    println("start");
    add_into(& mut c, a, b);
    println("done " + int_to_str(c.get(5)));
}
