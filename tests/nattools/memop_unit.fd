// OP18 (docs/roadmap/competitive-roadmap.md): the memory-operand folds of
// compiler/nat_ir.fd on small MIR sequences, through nat_memop_unit_check
// (which `FID_VERIFY=1` builds also run, from nat_sel_check), on AArch64,
// RISC-V and x86-64:
//   ng_fuse_ldext   an extension of a load read once is the narrower load
//                   (every target); not across a store or a write of the
//                   base, not for a value read twice or a wider extension
//   ng_fuse_memcmp  compares, branches on a byte and SETCCs against
//                   memory (x86-64 only); not across a store, not for a
//                   constant outside the field's range
//   ng_fuse_rmw     `p.f = p.f op x` as one `op [m], x` (x86-64 only); not
//                   for x - p.f, another field or a result read again
// Run:
//   fid run tests/nattools/memop_unit.fd
// Expected output:
// a64 ok
// rv64 ok
// x64 ok
use core;
use vec;
use string;
use compiler::nat_enc;
use compiler::nat_ir;

fn report(name: str, arch: i64) {
    val err: str = nat_memop_unit_check(arch);
    if err == "" {
        println(name + " ok");
    } else {
        println(name + " " + err);
    }
}

fn main() {
    report("a64", NAT_A64);
    report("rv64", NAT_RV64);
    report("x64", NAT_X64);
}
