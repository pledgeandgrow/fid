// OP12 (docs/roadmap/competitive-roadmap.md), llvm ME27 / LF24: struct
// results in two registers on small MIR functions, through
// nat_retfwd_unit_check of compiler/nat_ir.fd (which `FID_VERIFY=1`
// builds also run, from nat_sel_check), on AArch64, RISC-V and x86-64:
//   callee  the stores through the hidden result address become the two
//           words in vregs, returned in argument registers 0 and 1
//           (ng_rr_analyze, ng_rr_callee_rewrite); a callee that loads
//           from its result is not taken
//   caller  the result slot read back field by field is kept in vregs:
//           no load or store is left, a byte field is a sign extension of
//           the second register (ng_rr_caller_rewrite, ng_rf_promote); a
//           slot whose address goes to another call stays in memory
// Run:
//   fid run tests/nattools/retfwd_unit.fd
// Expected output:
// a64 ok
// rv64 ok
// x64 ok
use core;
use vec;
use string;
use compiler::nat_enc;
use compiler::nat_ir;

fn report(name: str, arch: i64) {
    val err: str = nat_retfwd_unit_check(arch);
    if err == "" {
        println(name + " ok");
    } else {
        println(name + " " + err);
    }
}

fn main() {
    report("a64", NAT_A64);
    report("rv64", NAT_RV64);
    report("x64", NAT_X64);
}
