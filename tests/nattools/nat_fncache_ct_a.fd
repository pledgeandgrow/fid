// BG44: the first version of a program for
// tests/nattools/nat_fncache_ct_check.sh (the second is nat_fncache_ct_b.fd:
// the same functions, only ct_check's body differs). Built first, it fills
// the function cache; built second, nat_fncache_ct_b.fd takes ct_sum from
// the cache and compiles ct_check again. ct_check is @constant_time and
// calls ct_sum, @constant_time too: before the fix the replayed ct_sum's
// label was not marked @constant_time, so the build of the second version
// failed ("call to a function that is not @constant_time").
// Expected output:
// 84
// 87

/// Sum of a secret buffer: the loop runs to its (public) length.
@constant_time
@wrapping
fn ct_sum(v: & Vec<i64>) -> i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < v.len() {
        acc = acc + v.get(i);
        i = i + 1;
    }
    return acc;
}

@constant_time
@wrapping
fn ct_check(v: & Vec<i64>, k: i64) -> i64 {
    var r: i64 = 0;
    var j: i64 = 0;
    while j < 2 {
        r = ct_sum(v) ^ k;
        j = j + 1;
    }
    return r;
}

fn main() {
    var a: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 8 {
        a.push(i * 3);
        i = i + 1;
    }
    println(ct_sum(& a));
    println(ct_check(& a, 3));
}
