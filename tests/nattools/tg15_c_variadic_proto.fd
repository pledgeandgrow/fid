// TG15: the C declaration of a variadic extern without a header. Not run
// (nothing defines fides_va_probe); its C is checked:
//   fid dump-c tests/nattools/tg15_c_variadic_proto.fd | grep -F 'fides_va_probe(int64_t a, ...);'
// must find the line (codegen_c.fd emit_extern_decls writes C's `...` for
// `...rest: T`), and `fid check` accepts the calls with 1, 2 and 4
// arguments (typechecker.fd tc_is_c_variadic).

extern "C" {
    fn fides_va_probe(a: i64, ...rest: i64) -> i64;
}

@unsafe
fn main() -> i64 {
    var s: i64 = fides_va_probe(1);
    s = s + fides_va_probe(1, 2);
    s = s + fides_va_probe(1, 2, 3.5, 4);
    println(s);
    return 0;
}
