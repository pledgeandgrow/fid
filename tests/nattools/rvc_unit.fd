// TG9 (docs/roadmap/llvm-roadmap.md): RVC, RISC-V's 2-byte instructions,
// through nat_rvc_unit_check of compiler/nat_enc.fd:
//   (a) the 2-byte encodings an assembler prints for common forms
//       (`addi sp, sp, -16` = 1141, `ret` = 8082, `sd ra, 8(sp)` = e406,
//       ...) and the words kept at 4 bytes (calls, branches, ebreak, ...)
//   (b) every compressible shape over many registers and immediates:
//       nat_rvc_of, then nat_rvc_expand, then nat_rvc_of again gives the
//       same 2-byte word, and the expansion does what the word did (the
//       same word for memory and jumps; the operations run on random
//       registers in the RISC-V simulator)
//   (c) nat_rvc_compress on a laid-out function: the prologue kept, a
//       branch by a constant offset, a short branch, a jump and an AUIPC
//       pair reach their moved targets after NatEnc_resolve, the
//       jump-table entry 4-aligned after a 2-byte padding
//   (d) the code left as it was when it holds an absolute word, or when
//       a short branch would be pushed out of its reach
// Run:
//   fid run tests/nattools/rvc_unit.fd
// Expected output:
// rvc ok
use core;
use vec;
use string;
use compiler::nat_enc;

fn main() {
    val err: str = nat_rvc_unit_check();
    if err == "" {
        println("rvc ok");
    } else {
        println("rvc " + err);
    }
}
