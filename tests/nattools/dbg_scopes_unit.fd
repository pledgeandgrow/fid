// DB4 (docs/roadmap/llvm-roadmap.md): lexical scopes in .debug_info
// (compiler/nat_enc.fd nat_dbg_put_vars, abbreviation 18). A function
// `shadow` of 100 bytes has a parameter, a variable of the whole function,
// and two bindings of `x` in scopes (the text compiler/nat_ir.fd
// ng_dbg_scope_blocks makes: "B" lines, then each scoped variable once per
// code range of its scope, the range's id as a seventh field): the outer
// `x` over [0, 52) and [70, 80), the inner one over [20, 36) inside the
// first. A second function has a scope whose parent was dropped (cut to
// nothing by the function's end) and one past its end, cut to it. The
// test walks .debug_info the way a debugger does (abbreviations read from
// .debug_abbrev) and prints the tree of subprograms, parameters,
// variables and lexical blocks, then checks the unit ends where its
// length says with every children list closed.
// Run (from the repository root):
//   fid run tests/nattools/dbg_scopes_unit.fd
// Expected output:
// subprogram shadow
//   formal_parameter n expr
//   variable total expr
//   variable acc list
//     loc 0 10 [145 96] 10 40 [83] end
//   lexical_block 4194304 52
//     variable x list
//     lexical_block 4194324 16
//       variable x list
//   lexical_block 4194374 10
//     variable x list
// subprogram cut
//   variable y expr
//   lexical_block 4194408 16
//     variable y expr
// unit closed true
// subprogram shadow
//   formal_parameter n expr
//   variable total expr
// subprogram cut
//   variable y expr
// flat unit closed true

use core;
use vec;
use string;
use compiler::nat_enc;

var g_pos: i64 = 0;

fn le32(b: &Vec<i64>, at: i64) -> i64 {
    return b.get(at) | (b.get(at + 1) << 8) | (b.get(at + 2) << 16) | (b.get(at + 3) << 24);
}

fn le64(b: &Vec<i64>, at: i64) -> i64 {
    return le32(b, at) | (le32(b, at + 4) << 32);
}

fn uleb(b: &Vec<i64>) -> i64 {
    var v: i64 = 0;
    var s: i64 = 0;
    var more: bool = true;
    while more {
        var c: i64 = b.get(g_pos);
        g_pos = g_pos + 1;
        v = v | ((c & 127) << s);
        s = s + 7;
        if c < 128 {
            more = false;
        }
    }
    return v;
}

fn cstr(b: &Vec<i64>) -> str {
    var out: str = "";
    while b.get(g_pos) != 0 {
        out = out + char_to_str(b.get(g_pos));
        g_pos = g_pos + 1;
    }
    g_pos = g_pos + 1;
    return out;
}

// The entries of the location list at `off` of .debug_loc: begin end
// [expression bytes] ..., then "end"
fn loc_list(b: &Vec<i64>, off: i64) -> str {
    var out: str = "loc";
    var p: i64 = off;
    var going: bool = true;
    while going && p + 16 <= b.len() {
        var s: i64 = le64(b, p);
        var e: i64 = le64(b, p + 8);
        p = p + 16;
        if s == 0 && e == 0 {
            going = false;
        } else {
            var n: i64 = b.get(p) | (b.get(p + 1) << 8);
            p = p + 2;
            out = out + " " + int_to_str(s) + " " + int_to_str(e) + " [";
            var k: i64 = 0;
            while k < n {
                if k > 0 {
                    out = out + " ";
                }
                out = out + int_to_str(b.get(p + k));
                k = k + 1;
            }
            out = out + "]";
            p = p + n;
        }
    }
    return out + " end";
}

fn tag_name(t: i64) -> str {
    if t == 0x2E {
        return "subprogram";
    }
    if t == 0x05 {
        return "formal_parameter";
    }
    if t == 0x34 {
        return "variable";
    }
    if t == 0x0B {
        return "lexical_block";
    }
    return "";
}

fn indent(d: i64) -> str {
    var s: str = "";
    var i: i64 = 1;
    while i < d {
        s = s + "  ";
        i = i + 1;
    }
    return s;
}

// The DIE tree of `info` with the abbreviations of `ab`; returns whether
// the unit ends where its length says with every children list closed.
fn walk(ab: &Vec<i64>, info: &Vec<i64>, dloc: &Vec<i64>) -> bool {
    // code -> tag, children, first attribute pair in `pairs`, pairs
    var tags: Vec<i64> = Vec::new();
    var kids: Vec<i64> = Vec::new();
    var first: Vec<i64> = Vec::new();
    var count: Vec<i64> = Vec::new();
    var pairs: Vec<i64> = Vec::new();
    while tags.len() < 64 {
        tags.push(0 - 1);
        kids.push(0);
        first.push(0);
        count.push(0);
    }
    g_pos = 0;
    var going: bool = true;
    while going && g_pos < ab.len() {
        var code: i64 = uleb(ab);
        if code == 0 {
            going = false;
        } else {
            tags.set(code, uleb(ab));
            kids.set(code, ab.get(g_pos));
            g_pos = g_pos + 1;
            first.set(code, pairs.len());
            var n: i64 = 0;
            var more: bool = true;
            while more {
                var a: i64 = uleb(ab);
                var f: i64 = uleb(ab);
                if a == 0 && f == 0 {
                    more = false;
                } else {
                    pairs.push(a);
                    pairs.push(f);
                    n = n + 1;
                }
            }
            count.set(code, n);
        }
    }
    var end: i64 = le32(info, 0) + 4;
    g_pos = 11;
    var depth: i64 = 0;
    var closed: bool = false;
    while g_pos < end {
        var c: i64 = uleb(info);
        if c == 0 {
            depth = depth - 1;
            if depth == 0 {
                closed = g_pos == end;
            }
        } else {
            var name: str = "";
            var low: i64 = 0;
            var high: i64 = 0;
            var lk: str = "";
            var loff: i64 = 0 - 1;
            var k: i64 = 0;
            while k < count.get(c) {
                var a2: i64 = pairs.get(first.get(c) + 2 * k);
                var f2: i64 = pairs.get(first.get(c) + 2 * k + 1);
                if f2 == 0x08 {
                    var s: str = cstr(info);
                    if a2 == 0x03 {
                        name = s;
                    }
                } else if f2 == 0x0B {
                    g_pos = g_pos + 1;
                } else if f2 == 0x05 {
                    g_pos = g_pos + 2;
                } else if f2 == 0x06 || f2 == 0x13 || f2 == 0x17 {
                    if a2 == 0x02 {
                        lk = "list";
                        loff = le32(info, g_pos);
                    }
                    g_pos = g_pos + 4;
                } else if f2 == 0x07 || f2 == 0x01 {
                    var v: i64 = le64(info, g_pos);
                    if a2 == 0x11 {
                        low = v;
                    }
                    if a2 == 0x12 {
                        high = v;
                    }
                    g_pos = g_pos + 8;
                } else if f2 == 0x18 {
                    var ln: i64 = uleb(info);
                    if a2 == 0x02 {
                        lk = "expr";
                    }
                    g_pos = g_pos + ln;
                }
                k = k + 1;
            }
            var t: i64 = tags.get(c);
            var tn: str = tag_name(t);
            if str_len(tn) > 0 {
                var line: str = indent(depth) + tn;
                if t == 0x0B {
                    line = line + " " + int_to_str(low) + " " + int_to_str(high);
                } else {
                    line = line + " " + name;
                }
                if str_len(lk) > 0 {
                    line = line + " " + lk;
                }
                println(line);
                if name == "acc" && loff >= 0 {
                    println(indent(depth) + "  " + loc_list(dloc, loff));
                }
            }
            if kids.get(c) != 0 {
                depth = depth + 1;
            }
        }
    }
    return closed && depth == 0;
}

fn build(vars: Vec<str>) -> NatDwarf {
    nat_line_files_reset("main.fd");
    var names: Vec<str> = Vec::new();
    names.push("shadow");
    names.push("cut");
    var starts: Vec<i64> = Vec::new();
    starts.push(0);
    starts.push(100);
    var ends: Vec<i64> = Vec::new();
    ends.push(100);
    ends.push(120);
    var img: Vec<i64> = Vec::new();
    while img.len() < 128 {
        img.push(0x90);
    }
    var rows: Vec<i64> = Vec::new();
    rows.push(0);
    rows.push(23);
    rows.push(0);
    rows.push(100);
    rows.push(40);
    rows.push(0);
    rows.push(120);
    rows.push(0);
    rows.push(1);
    g_nat_dbg_ext = true;
    g_nat_dbg_vars = vars;
    var cfi: Vec<i64> = Vec::new();
    var d: NatDwarf = nat_dwarf_build(NAT_X64, img, 0x400000, names, starts, ends, "main.fd", rows, cfi, true);
    g_nat_dbg_ext = false;
    g_nat_dbg_vars = Vec::new();
    return d;
}

fn main() {
    var vars: Vec<str> = Vec::new();
    var s: str = "P\tn\ti64\t8\t5\tr5\nV\ttotal\ti64\t8\t5\tf-24";
    // a value split into pieces: its slot over [0, 10), a register after
    s = s + "\nV\tacc\ti64\t8\t5\tf-32@0:10;r3@10:40";
    s = s + "\nB\t1\t0\t0\t52\nB\t2\t1\t20\t36\nB\t3\t0\t70\t80";
    s = s + "\nV\tx\ti64\t8\t5\tr3@8:60\t1\nV\tx\ti64\t8\t5\tr3@8:60\t3\nV\tx\ti64\t8\t5\tr4@20:44\t2";
    vars.push(s);
    // `cut` (20 bytes): block 1 past the end is cut to [4, 20); block 2
    // starts at the end (nothing left: dropped) and block 3 inside it
    // goes with it
    var c: str = "V\ty\ti64\t8\t5\tf-16";
    c = c + "\nB\t1\t0\t4\t30\nB\t2\t0\t20\t40\nB\t3\t2\t22\t30";
    c = c + "\nV\ty\ti64\t8\t5\tc7\t1\nV\ty\ti64\t8\t5\tc8\t2\nV\ty\ti64\t8\t5\tc9\t3";
    vars.push(c);
    var d: NatDwarf = build(vars);
    println("unit closed " + bool_to_str(walk(& d.abbrev, & d.info, & d.dloc)));
    // the same functions without scopes: the tree as before DB4's scopes
    var flat: Vec<str> = Vec::new();
    flat.push("P\tn\ti64\t8\t5\tr5\nV\ttotal\ti64\t8\t5\tf-24");
    flat.push("V\ty\ti64\t8\t5\tf-16");
    var d2: NatDwarf = build(flat);
    println("flat unit closed " + bool_to_str(walk(& d2.abbrev, & d2.info, & d2.dloc)));
}
