// SP16 (llvm-roadmap): a negative case for tests/nattools/selfhost_builtins_check.py.
// It reaches an `extern "C"` function the machine layer cannot run
// (stdlib/net.fd's pledge_net_socket: no pert_c_pledge_net_socket, and the C
// runtime's own header is in no system library), so
//   python3 tests/nattools/selfhost_builtins_check.py --main tests/nattools/selfhost_extern_probe.fd
// must exit 1 and name pledge_net_socket. Not a program to run.
use core;
use net;

fn main() -> i64 {
    var s: i64 = net_socket_create();
    println(int_to_str(s));
    return 0;
}
