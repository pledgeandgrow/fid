// SP16 (llvm-roadmap): a negative case for tests/nattools/selfhost_builtins_check.py.
// It reaches an `extern "C"` function the machine layer cannot run: no
// runtime has a pert_c_sp16_no_such_c_function, nat_ir emits no code of
// that name and no runtime imports it, so
//   python3 tests/nattools/selfhost_builtins_check.py --main tests/nattools/selfhost_extern_probe.fd
// must exit 1 and name sp16_no_such_c_function. Not a program to run.
// (Until Nov 27 the probe reached stdlib/net.fd's pledge_net_socket, which
// got pert_c_pledge_net_socket in stdlib/linux_runtime/sys.fd: the check
// then passed the probe it had to reject.)
use core;

extern "C" {
    fn sp16_no_such_c_function(x: i64) -> i64;
}

fn main() -> i64 {
    var s: i64 = unsafe {
        sp16_no_such_c_function(7)
    };
    println(int_to_str(s));
    return 0;
}
