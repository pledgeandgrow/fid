// SP20: version B of tests/nattools/sp20_tail_a.fd (read its header).
// Only `look` differs: it keeps the address it is given (in g_kept), so
// its MI28 summary is no longer clean and `walk`'s tail call stays a call.
// Its result is the same as A's; g_kept is cleared before it is printed.
// `walk` must sit on the same lines as in A (the machine layer keeps a
// function's source lines in its code, so its cache key holds them):
// these lines pad this header to A's length.
// .
// .
// .
// .
// .
// .
// Expected output:
// 4398
// 87

struct Acc { a: i64, b: i64, c: i64 }

var g_kept: i64 = 0;

fn walk(n: i64, total: i64) -> i64 {
    if n == 0 {
        return total;
    }
    var t: Acc = Acc { a: n % 7, b: n % 5, c: 1 };
    return walk(n - 1, total + look(&t, 1));
}

// recursive, so never inlined
fn look(t: &Acc, d: i64) -> i64 {
    if d <= 0 {
        g_kept = t as i64;
        return t.a + t.b * 2 + t.c * 3;
    }
    return look(t, d - 1) + 1;
}

fn main() {
    println(walk(400, 0));
    g_kept = 0;
    println(g_kept + 87);
}
