// SP7: tests/nattools/relink_check.sh's first edit of
// tests/bootstrap/test_machine_relink.fd, built after it in the same
// `fid serve`: rl_shrink smaller (compiled again into its old place),
// rl_grow much larger (placed after the code), another string in rl_text
// (compiled again into its old place). Its image must run as a fresh
// build of this file.

struct RlPair {
    a: i64,
    b: i64,
}

// (each function that an edit changes has more than one block: the IR
// inliner takes only straight-line callees, so it stays a function)
fn rl_grow(x: i64) -> i64 {
    var t: i64 = x + 1;
    var i: i64 = 0;
    while i < 9 {
        t = t * 3 + i;
        if t % 7 == 3 {
            t = t / 2 + 11;
        } else if t % 5 == 1 {
            t = t - 17;
        }
        t = t % 1000003;
        i = i + 1;
    }
    var j: i64 = 0;
    while j < 6 {
        t = t + (t >> 3) + j * 13;
        t = t ^ (j * 0x55);
        t = t % 999983;
        j = j + 1;
    }
    var k: i64 = t % 97;
    if k < 10 {
        t = t + 100;
    }
    if k > 80 {
        t = t - 50;
    }
    return t % 100000 + 1;
}

fn rl_shrink(x: i64) -> i64 {
    if x < 0 {
        return 0;
    }
    return x * 7 + 3;
}

fn rl_sum(n: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n {
        s = s + i * 3;
        i = i + 1;
    }
    return s;
}

fn rl_mid(x: i64) -> i64 {
    return rl_shrink(x) + rl_grow(x);
}

fn rl_text(n: i64) -> str {
    if n < 0 {
        return "negative";
    }
    return "m=" + int_to_str(n);
}

fn rl_pair(x: i64) -> RlPair {
    return RlPair { a: x, b: x * 2 };
}

fn rl_fold(n: i64) -> i64 {
    var p: i64 = 1;
    var i: i64 = 1;
    while i <= n {
        p = p * i;
        i = i + 1;
    }
    return p;
}

fn main() -> i64 {
    println("sum " + int_to_str(rl_sum(10)));
    println("shrink " + int_to_str(rl_shrink(11)));
    println("grow " + int_to_str(rl_grow(7)));
    println("mid " + int_to_str(rl_mid(7)));
    println(rl_text(42));
    val p = rl_pair(5);
    println("pair " + int_to_str(p.a) + " " + int_to_str(p.b));
    println("fold " + int_to_str(rl_fold(10)));
    println("done");
    return 0;
}
