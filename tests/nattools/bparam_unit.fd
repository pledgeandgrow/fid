// MI1 (docs/roadmap/llvm-roadmap.md): block parameters of the machine IR
// (compiler/mir.fd). The MIR module needs nothing of a target, so this
// runs on its own: `fid run tests/nattools/bparam_unit.fd` (or through C,
// `fid ccompile`), and must print the expected lines below.
//
//   loop       a counted loop: two vregs written in the loop become two
//              parameters of its head, passed by the entry's fall-through
//              and by the back edge (the listing of the form); the form
//              passes the verifier and the SSA check, and the program
//              computes the same before the form, in it (BPARAM / BARG
//              run as parallel copies on the edges) and after it is
//              lowered again (moves, an edge block for the taken branch)
//   parmoves   a parallel copy that is a cycle (a, b, c = b, c, a) goes
//              through one temporary and rotates the values
//   mutants    the verifier rejects a form with an argument left out, an
//              argument for a parameter the block does not have, a
//              parameter written by another operation, a parameter in the
//              middle of a block, a block without a label with
//              parameters; the SSA check rejects a vreg written twice
//   random     random functions (multi-written vregs, loops, conditional
//              branches both ways, fall-throughs, selects): every form
//              passes the verifier and the SSA check, no vreg written
//              more than once in the original is live into a labeled
//              block (values enter blocks as parameters only), the
//              lowered MIR passes the verifier, and all three run to the
//              same output
//
// Expected output:
// loop: form ok, 2 parameters
// loop: 0: prologue p0 p0 p0 i 0 0
// loop: 1: li v69 p0 p0 i 3 0
// loop: 2: li v70 p0 p0 i 0 0
// loop: 3: li v66 p0 p0 i 1 0
// loop: 4: barg v69 p0 p0 i 100 0
// loop: 5: barg v70 p0 p0 i 100 1
// loop: 6: place p0 p0 p0 i 100 0
// loop: 7: bparam v67 p0 p0 i 0 0
// loop: 8: bparam v68 p0 p0 i 1 0
// loop: 9: add v71 v68 v67 i 0 0
// loop: 10: sub v72 v67 v66 i 0 0
// loop: 11: barg v72 p0 p0 i 100 0
// loop: 12: barg v71 p0 p0 i 100 1
// loop: 13: bnez v72 p0 p0 i 100 0
// loop: 14: stslot v71 p0 p0 i 0 0
// loop: 15: epilogue p0 p0 p0 i 0 0
// loop: lowered ok, 1 edge blocks
// loop: outputs 6 / 6 / 6
// parmoves: 4 moves, a=2 b=3 c=1
// mutant drop-arg: rejected
// mutant bad-index: rejected
// mutant param-written: rejected
// mutant param-late: rejected
// mutant unlabeled-param: rejected
// mutant not-ssa: rejected
// random: 300 functions, all equal


use core;
use vec;
use string;
use compiler::mir;

fn mk(op: i64, r0: i64, r1: i64, r2: i64, i0: i64, i1: i64) -> MInst {
    return mi_new(op, r0, r1, r2, i0, i1, 0);
}

// --- A small MIR interpreter ---------------------------------------------
// LI, MOV, ADD (mod 2^16), SUB (mod 2^16), XOR, CSEL, STSLOT (prints r0),
// JMP, BNEZ, BEQZ, PLACE, PROLOGUE, LINE, EPILOGUE, and the block
// parameters: a BARG records its value, the jump that takes an edge
// assigns the edge's recorded values to the target's parameters at once.
// Every register starts at 0. At most `fuel` counted operations (the
// arithmetic, the stores and the conditional branches, which no form or
// lowering adds or removes), so a loop that does not end ends the run at
// the same point in every version.

fn run_mir(mir: & Vec<MInst>, nregs: i64, fuel: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var regs: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nregs + 64 {
        regs.push(0);
        i = i + 1;
    }
    var lab: i64 = HashMap_new();
    var n: i64 = mir.len();
    var k: i64 = 0;
    while k < n {
        if mir.get(k).op == MO_PLACE {
            HashMap_insert_i(lab, mir.get(k).i0, k);
        }
        k = k + 1;
    }
    var pend: Vec<i64> = Vec::new();
    var pc: i64 = 0;
    var used: i64 = 0;
    while true {
        if pc >= n {
            out.push(0 - 999);
            return out;
        }
        if used > fuel {
            out.push(0 - 2);
            return out;
        }
        var m: MInst = mir.get(pc);
        var op: i64 = m.op;
        var next: i64 = pc + 1;
        if op == MO_PLACE {
            if pend.len() > 0 {
                take_edge(mir, & mut regs, & pend, lab, m.i0);
                pend.clear();
            }
        } else if op == MO_BARG {
            pend.push(regs.get(m.r0));
            pend.push(m.i0);
            pend.push(m.i1);
        } else if op == MO_LI {
            regs.set(m.r0, m.i0);
        } else if op == MO_MOV {
            regs.set(m.r0, regs.get(m.r1));
        } else if op == MO_ADD {
            regs.set(m.r0, (regs.get(m.r1) + regs.get(m.r2)) & 65535);
            used = used + 1;
        } else if op == MO_SUB {
            regs.set(m.r0, (regs.get(m.r1) - regs.get(m.r2)) & 65535);
            used = used + 1;
        } else if op == MO_XOR {
            regs.set(m.r0, regs.get(m.r1) ^ regs.get(m.r2));
            used = used + 1;
        } else if op == MO_CSEL {
            if regs.get(m.r1) != 0 {
                regs.set(m.r0, regs.get(m.r2));
            }
            used = used + 1;
        } else if op == MO_STSLOT {
            out.push(regs.get(m.r0));
            used = used + 1;
        } else if op == MO_JMP {
            take_edge(mir, & mut regs, & pend, lab, m.i0);
            pend.clear();
            next = HashMap_get_i(lab, m.i0);
        } else if op == MO_BNEZ || op == MO_BEQZ {
            used = used + 1;
            var taken: bool = regs.get(m.r0) != 0;
            if op == MO_BEQZ {
                taken = !taken;
            }
            if taken {
                take_edge(mir, & mut regs, & pend, lab, m.i0);
                next = HashMap_get_i(lab, m.i0);
            } else if pc + 1 < n && mir.get(pc + 1).op == MO_PLACE {
                take_edge(mir, & mut regs, & pend, lab, mir.get(pc + 1).i0);
            }
            pend.clear();
        } else if op == MO_EPILOGUE {
            out.push(0 - 1);
            return out;
        }
        pc = next;
    }
    return out;
}

/// The edge to `label`: its recorded arguments into the parameters of the
/// block placed at the label (the BPARAMs after its PLACE).
fn take_edge(mir: & Vec<MInst>, regs: & mut Vec<i64>, pend: & Vec<i64>, lab: i64, label: i64) {
    if !HashMap_contains_i(lab, label) {
        return;
    }
    var at: i64 = HashMap_get_i(lab, label);
    var i: i64 = 0;
    while i + 2 < pend.len() {
        if pend.get(i + 1) == label {
            var p: MInst = mir.get(at + 1 + pend.get(i + 2));
            regs.set(p.r0, pend.get(i));
        }
        i = i + 3;
    }
}

fn same(a: & Vec<i64>, b: & Vec<i64>) -> bool {
    if a.len() != b.len() {
        return false;
    }
    var i: i64 = 0;
    while i < a.len() {
        if a.get(i) != b.get(i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn outs(a: & Vec<i64>) -> str {
    var s: str = "";
    var i: i64 = 0;
    while i < a.len() {
        if a.get(i) >= 0 {
            if s != "" {
                s = s + ",";
            }
            s = s + int_to_str(a.get(i));
        }
        i = i + 1;
    }
    return s;
}

// --- The loop ------------------------------------------------------------

fn case_loop() -> Vec<MInst> {
    // i = 3; s = 0; one = 1
    // L100: s = s + i; i = i - one; if i != 0 goto L100
    // print s
    var v: Vec<MInst> = Vec::new();
    v.push(mk(MO_PROLOGUE, 0, 0, 0, 0, 0));
    v.push(mk(MO_LI, 64, 0, 0, 3, 0));
    v.push(mk(MO_LI, 65, 0, 0, 0, 0));
    v.push(mk(MO_LI, 66, 0, 0, 1, 0));
    v.push(mk(MO_PLACE, 0, 0, 0, 100, 0));
    v.push(mk(MO_ADD, 65, 65, 64, 0, 0));
    v.push(mk(MO_SUB, 64, 64, 66, 0, 0));
    v.push(mk(MO_BNEZ, 64, 0, 0, 100, 0));
    v.push(mk(MO_STSLOT, 65, 0, 0, 0, 0));
    v.push(mk(MO_EPILOGUE, 0, 0, 0, 0, 0));
    return v;
}

fn show_loop() {
    var orig: Vec<MInst> = case_loop();
    var fm: MirBp = mir_bparams_form(& orig, 67, 0 - 1);
    var e1: str = mir_verify("loop", & fm.mir, fm.nvreg, 0, 0 - 1);
    if e1 == "" {
        e1 = mir_bparams_ssa_check("loop", & orig, & fm.mir, fm.nvreg, 0 - 1);
    }
    if e1 != "" {
        println("loop: form rejected: " + e1);
        return;
    }
    println("loop: form ok, " + int_to_str(fm.n_params) + " parameters");
    var lines: Vec<str> = str_split(mir_listing(& fm.mir), "\n");
    var i: i64 = 0;
    while i < lines.len() {
        if lines.get(i) != "" {
            println("loop: " + lines.get(i));
        }
        i = i + 1;
    }
    var lw: MirBp = mir_bparams_lower(& fm.mir, fm.nvreg, 500);
    var e2: str = lw.err;
    if e2 == "" {
        e2 = mir_verify("loop", & lw.mir, lw.nvreg, 0, 0 - 1);
    }
    if e2 != "" {
        println("loop: lowering rejected: " + e2);
        return;
    }
    println("loop: lowered ok, " + int_to_str(lw.n_labels) + " edge blocks");
    var a: Vec<i64> = run_mir(& orig, 67, 1000);
    var b: Vec<i64> = run_mir(& fm.mir, fm.nvreg, 1000);
    var c: Vec<i64> = run_mir(& lw.mir, lw.nvreg, 1000);
    println("loop: outputs " + outs(& a) + " / " + outs(& b) + " / " + outs(& c));
}

// --- Parallel copies -----------------------------------------------------

fn show_parmoves() {
    var out: Vec<MInst> = Vec::new();
    var dst: Vec<i64> = Vec::new();
    var src: Vec<i64> = Vec::new();
    // a = b, b = c, c = a (a v64, b v65, c v66)
    dst.push(64);
    src.push(65);
    dst.push(65);
    src.push(66);
    dst.push(66);
    src.push(64);
    var nv: i64 = mir_par_moves(& mut out, & dst, & src, 67);
    var regs: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        regs.push(0);
        i = i + 1;
    }
    regs.set(64, 1);
    regs.set(65, 2);
    regs.set(66, 3);
    i = 0;
    while i < out.len() {
        var m: MInst = out.get(i);
        regs.set(m.r0, regs.get(m.r1));
        i = i + 1;
    }
    println("parmoves: " + int_to_str(out.len()) + " moves, a=" + int_to_str(regs.get(64)) + " b=" + int_to_str(regs.get(65)) + " c=" + int_to_str(regs.get(66)));
}

// --- Mutants -------------------------------------------------------------

fn verdict(name: str, mir: & Vec<MInst>, nvreg: i64) {
    var e: str = mir_verify("m", mir, nvreg, 0, 0 - 1);
    if e == "" {
        println("mutant " + name + ": accepted (wrong)");
    } else {
        println("mutant " + name + ": rejected");
    }
}

/// The formed loop with operation `at` replaced by `m` (or removed when
/// m.op is -1, or `m` inserted before it when ins).
fn edit(mir: & Vec<MInst>, at: i64, m: MInst, ins: bool) -> Vec<MInst> {
    var o: Vec<MInst> = Vec::new();
    var i: i64 = 0;
    while i < mir.len() {
        if i == at {
            if ins {
                o.push(m);
                o.push(mir.get(i));
            } else if m.op >= 0 {
                o.push(m);
            }
        } else {
            o.push(mir.get(i));
        }
        i = i + 1;
    }
    return o;
}

fn show_mutants() {
    var orig: Vec<MInst> = case_loop();
    var fm: MirBp = mir_bparams_form(& orig, 67, 0 - 1);
    var f: Vec<MInst> = fm.mir;
    // (positions and vregs as in the listing above: v67 and v68 the
    // loop's parameters, v66 the constant 1 written once)
    var m1: Vec<MInst> = edit(& f, 12, mi_nop(), false);
    verdict("drop-arg", & m1, fm.nvreg);
    var m2: Vec<MInst> = edit(& f, 12, mk(MO_BARG, 71, 0, 0, 100, 7), false);
    verdict("bad-index", & m2, fm.nvreg);
    var m3: Vec<MInst> = edit(& f, 10, mk(MO_MOV, 67, 66, 0, 0, 0), true);
    verdict("param-written", & m3, fm.nvreg);
    var m4: Vec<MInst> = edit(& f, 10, mk(MO_BPARAM, 73, 0, 0, 2, 0), true);
    verdict("param-late", & m4, fm.nvreg + 1);
    // the loop's PLACE gone: its parameters follow the entry's last op
    var m5: Vec<MInst> = edit(& f, 6, mi_nop(), false);
    verdict("unlabeled-param", & m5, fm.nvreg);
    var m6: Vec<MInst> = edit(& f, 10, mk(MO_LI, 71, 0, 0, 5, 0), true);
    var e6: str = mir_bparams_ssa_check("m", & orig, & m6, fm.nvreg, 0 - 1);
    if e6 == "" {
        println("mutant not-ssa: accepted (wrong)");
    } else {
        println("mutant not-ssa: rejected");
    }
}

// --- Random functions ----------------------------------------------------

var g_seed: i64 = 12345;

fn rnd(n: i64) -> i64 {
    g_seed = (g_seed * 1103515245 + 12345) & 2147483647;
    return (g_seed >> 8) % n;
}

/// A random function over nvr vregs (64..) in nb blocks: block 0 the
/// entry (every vreg set), blocks 1.. labeled 100 + b.
fn random_fn(nb: i64, nvr: i64) -> Vec<MInst> {
    var v: Vec<MInst> = Vec::new();
    v.push(mk(MO_PROLOGUE, 0, 0, 0, 0, 0));
    var i: i64 = 0;
    while i < nvr {
        v.push(mk(MO_LI, 64 + i, 0, 0, 1 + rnd(9), 0));
        i = i + 1;
    }
    var b: i64 = 0;
    while b < nb {
        if b > 0 {
            v.push(mk(MO_PLACE, 0, 0, 0, 100 + b, 0));
        }
        // one counted operation first, then up to three more
        var nops: i64 = 1 + rnd(4);
        var j: i64 = 0;
        while j < nops {
            var d: i64 = 64 + rnd(nvr);
            var a: i64 = 64 + rnd(nvr);
            var c: i64 = 64 + rnd(nvr);
            var kind: i64 = rnd(7);
            if j == 0 && kind == 4 {
                kind = 0;
            }
            if kind == 0 {
                v.push(mk(MO_ADD, d, a, c, 0, 0));
            } else if kind == 1 {
                v.push(mk(MO_SUB, d, a, c, 0, 0));
            } else if kind == 2 {
                v.push(mk(MO_XOR, d, a, c, 0, 0));
            } else if kind == 3 {
                v.push(mk(MO_CSEL, d, a, c, 0, 0));
            } else if kind == 4 {
                v.push(mk(MO_LI, d, 0, 0, 1 + rnd(9), 0));
            } else {
                v.push(mk(MO_STSLOT, a, 0, 0, 0, 0));
            }
            j = j + 1;
        }
        var last: bool = b == nb - 1;
        var t: i64 = rnd(5);
        var target: i64 = 100 + 1 + rnd(nb - 1);
        if last {
            if t < 3 {
                v.push(mk(MO_EPILOGUE, 0, 0, 0, 0, 0));
            } else {
                v.push(mk(MO_JMP, 0, 0, 0, target, 0));
            }
        } else if t == 0 {
            // fall through
        } else if t == 1 {
            v.push(mk(MO_JMP, 0, 0, 0, target, 0));
        } else if t == 2 {
            v.push(mk(MO_BNEZ, 64 + rnd(nvr), 0, 0, target, 0));
        } else if t == 3 {
            v.push(mk(MO_BEQZ, 64 + rnd(nvr), 0, 0, target, 0));
        } else {
            // a branch to the block it would fall into anyway
            v.push(mk(MO_BNEZ, 64 + rnd(nvr), 0, 0, 100 + b + 1, 0));
        }
        b = b + 1;
    }
    return v;
}

/// Vregs written more than once in `orig` that are live into a labeled
/// block of `formed` (none may be: values enter blocks as parameters).
fn crossing(orig: & Vec<MInst>, formed: & Vec<MInst>, nvreg: i64) -> i64 {
    var nv: i64 = nvreg - 64;
    var ndef: Vec<i64> = Vec::new();
    var sel: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        ndef.push(0);
        sel.push(i);
        i = i + 1;
    }
    i = 0;
    while i < orig.len() {
        var m: MInst = orig.get(i);
        if mi_defines(m.op) && m.r0 >= 64 && m.r0 - 64 < nv {
            ndef.set(m.r0 - 64, ndef.get(m.r0 - 64) + 1);
        }
        i = i + 1;
    }
    var mb: MBlocks = mi_blocks(formed);
    var words: i64 = (nv + 63) / 64;
    var lin: Vec<i64> = Vec::new();
    var lout: Vec<i64> = Vec::new();
    mi_liveness(formed, & mb, & sel, words, & mut lin, & mut lout);
    var bad: i64 = 0;
    var b: i64 = 1;
    while b < mb.start.len() {
        if formed.get(mb.start.get(b)).op == MO_PLACE {
            i = 0;
            while i < nv {
                if (lin.get(b * words + i / 64) & (1 << (i % 64))) != 0 && ndef.get(i) > 1 {
                    bad = bad + 1;
                }
                i = i + 1;
            }
        }
        b = b + 1;
    }
    return bad;
}

fn random_fns(count: i64) {
    var fails: i64 = 0;
    var k: i64 = 0;
    while k < count {
        var nb: i64 = 2 + rnd(6);
        var nvr: i64 = 2 + rnd(4);
        var orig: Vec<MInst> = random_fn(nb, nvr);
        var nvreg: i64 = 64 + nvr;
        var e0: str = mir_verify("r", & orig, nvreg, 0, 0 - 1);
        var fm: MirBp = mir_bparams_form(& orig, nvreg, 0 - 1);
        var e1: str = mir_verify("r", & fm.mir, fm.nvreg, 0, 0 - 1);
        if e1 == "" {
            e1 = mir_bparams_ssa_check("r", & orig, & fm.mir, fm.nvreg, 0 - 1);
        }
        var cr: i64 = crossing(& orig, & fm.mir, fm.nvreg);
        var lw: MirBp = mir_bparams_lower(& fm.mir, fm.nvreg, 1000);
        var e2: str = lw.err;
        if e2 == "" {
            e2 = mir_verify("r", & lw.mir, lw.nvreg, 0, 0 - 1);
        }
        var a: Vec<i64> = run_mir(& orig, nvreg, 300);
        var b: Vec<i64> = run_mir(& fm.mir, fm.nvreg, 300);
        var c: Vec<i64> = run_mir(& lw.mir, lw.nvreg, 300);
        var why: str = "";
        if e0 != "" {
            why = "original rejected: " + e0;
        } else if e1 != "" {
            why = "form rejected: " + e1;
        } else if cr != 0 {
            why = int_to_str(cr) + " multi-written vregs live into labeled blocks";
        } else if e2 != "" {
            why = "lowering rejected: " + e2;
        } else if !same(& a, & b) {
            why = "the form computes something else: " + outs(& a) + " / " + outs(& b);
        } else if !same(& a, & c) {
            why = "the lowering computes something else: " + outs(& a) + " / " + outs(& c);
        }
        if why != "" {
            fails = fails + 1;
            if fails <= 3 {
                println("random " + int_to_str(k) + ": " + why);
                println(mir_listing(& orig));
            }
        }
        k = k + 1;
    }
    if fails == 0 {
        println("random: " + int_to_str(count) + " functions, all equal");
    } else {
        println("random: " + int_to_str(fails) + " of " + int_to_str(count) + " functions FAILED");
    }
}

fn main() {
    show_loop();
    show_parmoves();
    show_mutants();
    random_fns(300);
}
