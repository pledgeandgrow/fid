// PL5 (tests/nattools/thumb_check.sh): an i64 addition that overflows must
// panic on thumbv7m as on every other target: "Panic: Integer overflow on
// addition" on stderr, exit status 1, after the line printed before it.

fn grow(v: Vec<i64>) -> i64 {
    var x: i64 = v.get(0);
    var i: i64 = 0;
    while i < 70 {
        x = x + x;
        i = i + 1;
    }
    return x;
}

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(3);
    println("before");
    println(int_to_str(grow(v)));
    return 0;
}
