// LG13 probe for scripts/nat-tools-check.sh (x86-64): prints what the
// template computes, 42 where asm! runs in a process, 0 with
// FID_NAT_OFF=asm (and on the C path and the interpreter). Not in
// tests/bootstrap: its output depends on the backend by design.

fn main() {
    var a: i64 = 40;
    var b: i64 = 2;
    print(asm!("mov rax, rdi; add rax, rsi", in("rdi") a, in("rsi") b, out("rax") a));
    print("\n");
}
