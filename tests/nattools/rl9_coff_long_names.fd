// RL9 (own-backend roadmap): a program whose functions have names longer
// than the 8 bytes a COFF symbol record holds inline, for
// tests/nattools/rl9_writer_fixes_check.sh: `fid codegen <this> --coff`
// must give each of them a string-table offset that names it (the old
// coff.fd writer gave every long name offset 0, which names nothing).
// Run as a program it prints:
// 42
// 7
// done
use core;

fn a_function_with_a_long_name(x: i64) -> i64 {
    return x * 2;
}

fn another_quite_long_function_name(x: i64, y: i64) -> i64 {
    return x - y;
}

fn short8nm(x: i64) -> i64 {
    return x + 1;
}

fn main() {
    println(int_to_str(a_function_with_a_long_name(21)));
    println(int_to_str(another_quite_long_function_name(short8nm(9), 3)));
    println("done");
}
