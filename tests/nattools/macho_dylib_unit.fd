// TG15 (docs/roadmap/llvm-roadmap.md): Mach-O executables that bind
// C functions of dylibs other than libSystem through our own tables
// (compiler/nat_enc.fd nat_macho / nat_macho_img, nat_macho_import,
// nat_macho_dylib_path; compiler/image_writer.fd img_macho_bind_ords).
// A stand-in image (code page, then a data page holding the GOT) is
// written with five imports from four dylibs; the test reads the result
// back the way dyld does: the load commands (one LC_LOAD_DYLIB per dylib,
// libSystem first), then the bind opcodes of LC_DYLD_INFO_ONLY (dylib
// ordinal, symbol, segment, offset of each slot). The last part checks
// that an image importing only from libSystem keeps 12 load commands and
// ordinal 1 (the bytes earlier compilers wrote).
// Run (from the repository root):
//   fid run tests/nattools/macho_dylib_unit.fd
// Expected output:
// path sqlite3 /usr/lib/libsqlite3.dylib
// path m /usr/lib/libSystem.B.dylib
// path  /usr/lib/libSystem.B.dylib
// path z.1.dylib /usr/lib/libz.1.dylib
// path /opt/lib/libfoo.dylib /opt/lib/libfoo.dylib
// path @rpath/libbar.dylib @rpath/libbar.dylib
// path CoreFoundation.framework /System/Library/Frameworks/CoreFoundation.framework/CoreFoundation
// path framework:Security /System/Library/Frameworks/Security.framework/Security
// import _write
// import /usr/lib/libsqlite3.dylib|_sqlite3_libversion
// a64 magic feedfacf cpu 16777228 ncmds 15
// dylib 1 /usr/lib/libSystem.B.dylib
// dylib 2 /usr/lib/libsqlite3.dylib
// dylib 3 /usr/lib/libz.dylib
// dylib 4 /System/Library/Frameworks/CoreFoundation.framework/CoreFoundation
// bind 1 _write seg 2 off 0
// bind 2 _sqlite3_libversion seg 2 off 8
// bind 1 _sqrt seg 2 off 16
// bind 3 _zlibVersion seg 2 off 24
// bind 2 _sqlite3_open seg 2 off 32
// bind 4 _CFRelease seg 2 off 40
// x64 magic feedfacf cpu 16777223 ncmds 15
// dylib 1 /usr/lib/libSystem.B.dylib
// dylib 2 /usr/lib/libsqlite3.dylib
// dylib 3 /usr/lib/libz.dylib
// dylib 4 /System/Library/Frameworks/CoreFoundation.framework/CoreFoundation
// bind 1 _write seg 2 off 0
// bind 2 _sqlite3_libversion seg 2 off 8
// bind 1 _sqrt seg 2 off 16
// bind 3 _zlibVersion seg 2 off 24
// bind 2 _sqlite3_open seg 2 off 32
// bind 4 _CFRelease seg 2 off 40
// libsystem magic feedfacf cpu 16777228 ncmds 12
// dylib 1 /usr/lib/libSystem.B.dylib
// bind 1 _write seg 2 off 0
// bind 1 _read seg 2 off 8
use core;
use vec;
use string;
use compiler::nat_enc;

fn le32(b: &Vec<i64>, at: i64) -> i64 {
    return b.get(at) | (b.get(at + 1) << 8) | (b.get(at + 2) << 16) | (b.get(at + 3) << 24);
}

fn hex8(v: i64) -> str {
    var digits: str = "0123456789abcdef";
    var out: str = "";
    var i: i64 = 7;
    while i >= 0 {
        var d: i64 = (v >> (i * 4)) & 15;
        out = out + str_slice(digits, d, d + 1);
        i = i - 1;
    }
    return out;
}

fn cstr_at(b: &Vec<i64>, at: i64) -> str {
    var out: str = "";
    var i: i64 = at;
    while i < b.len() && b.get(i) != 0 {
        out = out + char_to_str(b.get(i));
        i = i + 1;
    }
    return out;
}

fn uleb_at(b: &Vec<i64>, at: i64, next: &mut Vec<i64>) -> i64 {
    var v: i64 = 0;
    var shift: i64 = 0;
    var i: i64 = at;
    while true {
        var c: i64 = b.get(i);
        v = v | ((c & 127) << shift);
        shift = shift + 7;
        i = i + 1;
        if (c & 128) == 0 {
            break;
        }
    }
    next.set(0, i);
    return v;
}

// The load commands and binds of Mach-O `m`, printed as in the header.
fn show(label: str, m: &Vec<i64>) {
    if m.len() < 32 {
        println(label + " empty image");
        return;
    }
    var ncmds: i64 = le32(m, 16);
    println(label + " magic " + hex8(le32(m, 0)) + " cpu " + int_to_str(le32(m, 4)) + " ncmds " + int_to_str(ncmds));
    var at: i64 = 32;
    var k: i64 = 0;
    var nd: i64 = 0;
    var bind_off: i64 = 0;
    var bind_size: i64 = 0;
    while k < ncmds {
        var cmd: i64 = le32(m, at);
        var size: i64 = le32(m, at + 4);
        if cmd == 0xC {
            nd = nd + 1;
            println("dylib " + int_to_str(nd) + " " + cstr_at(m, at + le32(m, at + 8)));
        }
        if cmd == 0x80000022 {
            bind_off = le32(m, at + 16);
            bind_size = le32(m, at + 20);
        }
        at = at + size;
        k = k + 1;
    }
    // dyld's bind opcodes
    var ord: i64 = 0;
    var sym: str = "";
    var seg: i64 = 0;
    var off: i64 = 0;
    var i: i64 = bind_off;
    var next: Vec<i64> = Vec::new();
    next.push(0);
    while i < bind_off + bind_size {
        var b: i64 = m.get(i);
        var op: i64 = b & 0xF0;
        var imm: i64 = b & 0x0F;
        i = i + 1;
        if op == 0x00 {
            break;
        } else if op == 0x10 {
            ord = imm;
        } else if op == 0x20 {
            ord = uleb_at(m, i, &mut next);
            i = next.get(0);
        } else if op == 0x40 {
            sym = cstr_at(m, i);
            i = i + str_len(sym) + 1;
        } else if op == 0x50 {
            // SET_TYPE_IMM
        } else if op == 0x70 {
            seg = imm;
            off = uleb_at(m, i, &mut next);
            i = next.get(0);
        } else if op == 0x90 {
            println("bind " + int_to_str(ord) + " " + sym + " seg " + int_to_str(seg) + " off " + int_to_str(off));
            off = off + 8;
        } else {
            println("unexpected bind opcode " + int_to_str(b));
            break;
        }
    }
}

// A stand-in image: `code` bytes of code, then a data page of 64 bytes
// (the GOT at its start).
fn image(code: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    while v.len() < code {
        v.push(0);
    }
    var j: i64 = 0;
    while j < 64 {
        v.push(0);
        j = j + 1;
    }
    return v;
}

fn build(arch: i64, imps: Vec<str>) -> Vec<i64> {
    var code: i64 = 0x4000;
    var offs: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < imps.len() {
        offs.push(code + i * 8);
        i = i + 1;
    }
    var none: Vec<i64> = Vec::new();
    var nn: Vec<str> = Vec::new();
    var ns: Vec<i64> = Vec::new();
    return nat_macho(arch, image(code), 0, code, none, imps, offs, nn, ns);
}

fn imports() -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push(nat_macho_import("", "_write"));
    v.push(nat_macho_import("sqlite3", "_sqlite3_libversion"));
    v.push(nat_macho_import("m", "_sqrt"));
    v.push(nat_macho_import("z", "_zlibVersion"));
    v.push(nat_macho_import("sqlite3", "_sqlite3_open"));
    v.push(nat_macho_import("CoreFoundation.framework", "_CFRelease"));
    return v;
}

fn main() -> i64 {
    var libs: Vec<str> = Vec::new();
    libs.push("sqlite3");
    libs.push("m");
    libs.push("");
    libs.push("z.1.dylib");
    libs.push("/opt/lib/libfoo.dylib");
    libs.push("@rpath/libbar.dylib");
    libs.push("CoreFoundation.framework");
    libs.push("framework:Security");
    var li: i64 = 0;
    while li < libs.len() {
        println("path " + libs.get(li) + " " + nat_macho_dylib_path(libs.get(li)));
        li = li + 1;
    }
    var imps: Vec<str> = imports();
    println("import " + imps.get(0));
    println("import " + imps.get(1));
    var a: Vec<i64> = build(NAT_A64, imports());
    show("a64", &a);
    var x: Vec<i64> = build(NAT_X64, imports());
    show("x64", &x);
    var plain: Vec<str> = Vec::new();
    plain.push("_write");
    plain.push("_read");
    var p: Vec<i64> = build(NAT_A64, plain);
    show("libsystem", &p);
    return 0;
}
