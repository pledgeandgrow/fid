// K10 (tests/nattools/simd_native_check.sh): a checked + reduction in a
// @simd function whose elements are small but whose start is near the
// top of i64: the sum overflows after a few elements. The pre-scan
// (compiler/nat_ir.fd ng_vz_guard) sees the start past 2^61 and skips the
// vector loop, so every path prints "start" and then panics on the
// overflow, never "sum" (a vector loop without that check would wrap).

@simd
fn sum_from(v: Vec<i64>, start: i64) -> i64 {
    var s: i64 = start;
    var i: i64 = 0;
    while i < v.len() {
        s = s + v.get(i);
        i = i + 1;
    }
    return s;
}

fn main() {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 64 {
        v.push(1000);
        i = i + 1;
    }
    println("start");
    println("sum " + int_to_str(sum_from(v, 9223372036854770000)));
}
