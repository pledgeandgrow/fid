// llvm-roadmap WP20: a library build. This file has no `main`: on the
// machine layer (`fid emit --target x86_64-linux`, the other Linux targets
// and --nat) nat_ir.fd's library mode compiles every function of the file
// (ng_lib_roots), so FID_LIBFACTS=<path> gets an `ext <name> mask=N
// size=M` line for each of them, which a later build of a program using
// the library reads with FID_LIBFACTS_IN (IPRA keeps values live across
// calls into it). The image's entry only traps: it is for its facts or
// its object (TG12), not to run. Not in tests/bootstrap (no main to run);
// scripts/nat-tools-check.sh builds it.

pub fn lib_add(a: i64, b: i64) -> i64 {
    return a + b;
}

pub fn lib_scale(a: i64) -> i64 {
    return lib_add(a, a) * 3;
}

pub struct LibPair {
    pub x: i64,
    pub y: i64,
}

impl LibPair {
    pub fn total(self: LibPair) -> i64 {
        return lib_add(self.x, self.y);
    }
}
