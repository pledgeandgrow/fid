// B5 (inc-roadmap): the first version of a program for
// tests/nattools/pe_fncache_check.sh. pe_fncache_edit_b.fd is the same
// program with `scale` changed: built after this one with the same
// per-function cache, it must take the unchanged functions from the cache,
// generate `scale` again, and give the same image as an uncached build.
struct Pt {
    x: i64,
    y: i64,
}

fn scale(p: Pt, k: i64) -> Pt {
    return Pt { x: p.x * k, y: p.y * k };
}

fn norm1(p: Pt) -> i64 {
    var a: i64 = p.x;
    if a < 0 {
        a = 0 - a;
    }
    var b: i64 = p.y;
    if b < 0 {
        b = 0 - b;
    }
    return a + b;
}

fn label(n: i64) -> str {
    if n > 10 {
        return "big";
    }
    return "small";
}

fn main() -> i64 {
    var pts: Vec<Pt> = Vec::new();
    pts.push(Pt { x: 1, y: 0 - 2 });
    pts.push(Pt { x: 3, y: 4 });
    var i: i64 = 0;
    while i < pts.len() {
        var q: Pt = scale(pts.get(i), 2);
        println(norm1(q));
        println(label(norm1(q)));
        i = i + 1;
    }
    return 0;
}
