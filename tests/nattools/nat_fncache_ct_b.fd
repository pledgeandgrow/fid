// BG44: the second version of nat_fncache_ct_a.fd (see there and
// tests/nattools/nat_fncache_ct_check.sh): ct_sum is the same, so it comes
// from the cache; ct_check's body differs, so it is compiled again, and its
// machine-level @constant_time check must still see ct_sum as one.
// Expected output:
// 84
// 88

/// Sum of a secret buffer: the loop runs to its (public) length.
@constant_time
@wrapping
fn ct_sum(v: & Vec<i64>) -> i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < v.len() {
        acc = acc + v.get(i);
        i = i + 1;
    }
    return acc;
}

@constant_time
@wrapping
fn ct_check(v: & Vec<i64>, k: i64) -> i64 {
    var r: i64 = 0;
    var j: i64 = 0;
    while j < 2 {
        r = (ct_sum(v) ^ k) + j;
        j = j + 1;
    }
    return r;
}

fn main() {
    var a: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 8 {
        a.push(i * 3);
        i = i + 1;
    }
    println(ct_sum(& a));
    println(ct_check(& a, 3));
}
