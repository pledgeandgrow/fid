// K10 (tests/nattools/simd_native_check.sh): a checked + reduction in a
// @simd function whose sum overflows. Its elements are past 2^31, so the
// pre-scan (compiler/nat_ir.fd ng_vz_guard) skips the vector loop and the
// loop panics where it would as written: `fid run`, the C path and every
// image print "start" and then panic on the overflow, never "sum".

@simd
fn sum_i(v: Vec<i64>) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < v.len() {
        s = s + v.get(i);
        i = i + 1;
    }
    return s;
}

fn main() {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 64 {
        v.push(1152921504606846976);
        i = i + 1;
    }
    println("start");
    println("sum " + int_to_str(sum_i(v)));
}
