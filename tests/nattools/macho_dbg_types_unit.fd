// CT9 (docs/roadmap/complaint-roadmap.md) on macOS: a debug build's
// __DWARF segment holds what a Linux image's DWARF holds (compiler/
// nat_enc.fd nat_macho_debug_cfi, nat_macho_dwarf_full, nat_dwarf_build):
// the method as Fides writes it (`Point::len2`, linkage name `Point_len2`),
// the structs Point and Seg with their fields, each function's frame base
// and declaration, its parameters and variables with their types and
// locations (a frame slot, a register over code ranges as a location list
// in __debug_loc, none: optimized out; a struct held by its address shows
// as the struct), and __debug_frame. The test builds the sections for two
// stand-in functions and walks __debug_info as lldb does (abbreviations,
// then the DIE tree), then checks that nat_macho_dwarf hands the full
// sections to nat_macho_img when nat_macho_debug_cfi set them. (The second
// `base i64` is the variables' own entry, nat_dbg_var_types.)
// Run (from the repository root):
//   fid run tests/nattools/macho_dbg_types_unit.fd
// Expected output:
// parts 5
// cu main.fd
// base i64 enc 5 size 8
// base u8 enc 7 size 1
// struct Point size 16
//   member x type i64 at 0
//   member y type i64 at 8
// struct Seg size 40
//   member a type Point at 0
//   member b type Point at 16
//   member tag type u8 at 32
// base i64 enc 5 size 8
// fn main frame cfa decl 1:10
//   var p type Point loc 91 50
//   var s type Seg loc 91 a0 7f
//   var n type i64 list 0:16 53
// fn Point::len2 link Point_len2 frame cfa decl 1:20
//   param self type Point loc 75 00
//   var sq type i64 optimized out
// frame cie 1 fde 2
// split same true
use core;
use vec;
use string;
use compiler::nat_enc;

fn le16(b: &Vec<i64>, at: i64) -> i64 {
    return b.get(at) | (b.get(at + 1) << 8);
}

fn le32(b: &Vec<i64>, at: i64) -> i64 {
    return b.get(at) | (b.get(at + 1) << 8) | (b.get(at + 2) << 16) | (b.get(at + 3) << 24);
}

fn cstr_at(b: &Vec<i64>, at: i64) -> str {
    var out: str = "";
    var i: i64 = at;
    while i < b.len() && b.get(i) != 0 {
        out = out + char_to_str(b.get(i));
        i = i + 1;
    }
    return out;
}

// LEB128 at `at`; next.get(0) becomes the offset after it.
fn leb_at(b: &Vec<i64>, at: i64, signed: bool, next: &mut Vec<i64>) -> i64 {
    var v: i64 = 0;
    var shift: i64 = 0;
    var i: i64 = at;
    var c: i64 = 0;
    while true {
        c = b.get(i);
        v = v | ((c & 127) << shift);
        shift = shift + 7;
        i = i + 1;
        if (c & 128) == 0 {
            break;
        }
    }
    if signed && (c & 64) != 0 && shift < 64 {
        v = v - (1 << shift);
    }
    next.set(0, i);
    return v;
}

fn hex2(v: i64) -> str {
    var d: str = "0123456789abcdef";
    return str_slice(d, (v >> 4) & 15, ((v >> 4) & 15) + 1) + str_slice(d, v & 15, (v & 15) + 1);
}

// A stand-in image: `code` bytes of code, then 64 bytes of data.
fn image(code: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    while v.len() < code + 64 {
        v.push(0);
    }
    return v;
}

// One abbreviation: its tag, whether it has children, then its
// (attribute, form) pairs, flattened.
struct Abbrev {
    code: i64,
    tag: i64,
    children: i64,
    attrs: Vec<i64>,
}

fn read_abbrevs(b: &Vec<i64>) -> Vec<Abbrev> {
    var out: Vec<Abbrev> = Vec::new();
    var nx: Vec<i64> = Vec::new();
    nx.push(0);
    var p: i64 = 0;
    while p < b.len() {
        var code: i64 = leb_at(b, p, false, &mut nx);
        p = nx.get(0);
        if code == 0 {
            break;
        }
        var tag: i64 = leb_at(b, p, false, &mut nx);
        p = nx.get(0);
        var ch: i64 = b.get(p);
        p = p + 1;
        var attrs: Vec<i64> = Vec::new();
        while true {
            var a: i64 = leb_at(b, p, false, &mut nx);
            p = nx.get(0);
            var f: i64 = leb_at(b, p, false, &mut nx);
            p = nx.get(0);
            if a == 0 && f == 0 {
                break;
            }
            attrs.push(a);
            attrs.push(f);
        }
        out.push(Abbrev { code: code, tag: tag, children: ch, attrs: attrs });
    }
    return out;
}

fn find_abbrev(abs: &Vec<Abbrev>, code: i64) -> i64 {
    var i: i64 = 0;
    while i < abs.len() {
        if abs.get(i).code == code {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// The name of the DIE at `at` (its first attribute is DW_AT_name, string,
// for every DIE this writer refers to).
fn name_of(info: &Vec<i64>, abs: &Vec<Abbrev>, at: i64) -> str {
    var nx: Vec<i64> = Vec::new();
    nx.push(0);
    var code: i64 = leb_at(info, at, false, &mut nx);
    var ai: i64 = find_abbrev(abs, code);
    if ai < 0 {
        return "?";
    }
    var ab: Abbrev = abs.get(ai);
    if ab.attrs.len() >= 2 && ab.attrs.get(0) == 0x03 && ab.attrs.get(1) == 0x08 {
        return cstr_at(info, nx.get(0));
    }
    if ab.tag == 0x0F {
        return "*";
    }
    return "?";
}

fn expr_text(info: &Vec<i64>, at: i64, n: i64) -> str {
    var s: str = "";
    var k: i64 = 0;
    while k < n {
        if k > 0 {
            s = s + " ";
        }
        s = s + hex2(info.get(at + k));
        k = k + 1;
    }
    return s;
}

// The location list at `off` of __debug_loc: "<start>:<end> <expr>" of its
// first entry, from the function's start `fpc` (unit-relative).
fn list_text(loc: &Vec<i64>, off: i64, fpc: i64) -> str {
    var s: i64 = le32(loc, off) - fpc;
    var e: i64 = le32(loc, off + 8) - fpc;
    var n: i64 = le16(loc, off + 16);
    return int_to_str(s) + ":" + int_to_str(e) + " " + expr_text(loc, off + 18, n);
}

fn walk(info: &Vec<i64>, abs: &Vec<Abbrev>, loc: &Vec<i64>) {
    var nx: Vec<i64> = Vec::new();
    nx.push(0);
    var p: i64 = 11;
    var end: i64 = le32(info, 0) + 4;
    var cu_low: i64 = 0;
    var fn_low: i64 = 0;
    while p < end {
        var code: i64 = leb_at(info, p, false, &mut nx);
        p = nx.get(0);
        if code == 0 {
            continue;
        }
        var ai: i64 = find_abbrev(abs, code);
        if ai < 0 {
            println("bad abbrev " + int_to_str(code));
            return;
        }
        var ab: Abbrev = abs.get(ai);
        var name: str = "";
        var link: str = "";
        var tref: i64 = 0 - 1;
        var low: i64 = 0;
        var enc: i64 = 0;
        var size: i64 = 0;
        var mloc: i64 = 0;
        var fbase: str = "";
        var dfile: i64 = 0;
        var dline: i64 = 0;
        var lexpr: str = "";
        var list_off: i64 = 0 - 1;
        var k: i64 = 0;
        while k < ab.attrs.len() {
            var a: i64 = ab.attrs.get(k);
            var f: i64 = ab.attrs.get(k + 1);
            var v: i64 = 0;
            if f == 0x08 {
                var sv: str = cstr_at(info, p);
                p = p + str_len(sv) + 1;
                if a == 0x03 {
                    name = sv;
                } else if a == 0x6E {
                    link = sv;
                }
            } else if f == 0x01 || f == 0x07 {
                v = le32(info, p) | (le32(info, p + 4) << 32);
                p = p + 8;
            } else if f == 0x06 || f == 0x13 || f == 0x17 {
                v = le32(info, p);
                p = p + 4;
            } else if f == 0x05 {
                v = le16(info, p);
                p = p + 2;
            } else if f == 0x0B {
                v = info.get(p);
                p = p + 1;
            } else if f == 0x18 {
                var n: i64 = leb_at(info, p, false, &mut nx);
                var ep: i64 = nx.get(0);
                if a == 0x40 {
                    if n == 1 && info.get(ep) == 0x9C {
                        fbase = "cfa";
                    } else {
                        fbase = expr_text(info, ep, n);
                    }
                } else {
                    lexpr = expr_text(info, ep, n);
                }
                p = ep + n;
            }
            if a == 0x49 {
                tref = v;
            } else if a == 0x11 {
                low = v;
            } else if a == 0x3E {
                enc = v;
            } else if a == 0x0B {
                size = v;
            } else if a == 0x38 {
                mloc = v;
            } else if a == 0x3A {
                dfile = v;
            } else if a == 0x3B {
                dline = v;
            } else if a == 0x02 && f == 0x17 {
                list_off = v;
            }
            k = k + 2;
        }
        var tname: str = "";
        if tref >= 0 {
            tname = name_of(info, abs, tref);
        }
        if ab.tag == 0x11 {
            cu_low = low;
            println("cu " + name);
        } else if ab.tag == 0x24 {
            println("base " + name + " enc " + int_to_str(enc) + " size " + int_to_str(size));
        } else if ab.tag == 0x13 {
            println("struct " + name + " size " + int_to_str(size));
        } else if ab.tag == 0x0D {
            println("  member " + name + " type " + tname + " at " + int_to_str(mloc));
        } else if ab.tag == 0x2E {
            fn_low = low - cu_low;
            var line: str = "fn " + name;
            if str_len(link) > 0 {
                line = line + " link " + link;
            }
            if str_len(fbase) > 0 {
                line = line + " frame " + fbase + " decl " + int_to_str(dfile) + ":" + int_to_str(dline);
            }
            println(line);
        } else if ab.tag == 0x05 || ab.tag == 0x34 {
            var kind: str = "var";
            if ab.tag == 0x05 {
                kind = "param";
            }
            var place: str = "optimized out";
            if list_off >= 0 {
                place = "list " + list_text(loc, list_off, fn_low);
            } else if str_len(lexpr) > 0 {
                place = "loc " + lexpr;
            }
            println("  " + kind + " " + name + " type " + tname + " " + place);
        }
    }
}

// The CIE and FDE count of a .debug_frame.
fn frame_counts(fr: &Vec<i64>) -> str {
    var cie: i64 = 0;
    var fde: i64 = 0;
    var p: i64 = 0;
    while p + 8 <= fr.len() {
        var len: i64 = le32(fr, p);
        if len == 0 {
            break;
        }
        if le32(fr, p + 4) == 4294967295 {
            cie = cie + 1;
        } else {
            fde = fde + 1;
        }
        p = p + 4 + len;
    }
    return "frame cie " + int_to_str(cie) + " fde " + int_to_str(fde);
}

fn same_parts(a: &Vec<Vec<i64>>, b: &Vec<Vec<i64>>) -> bool {
    if a.len() != b.len() {
        return false;
    }
    var i: i64 = 0;
    while i < a.len() {
        var x: Vec<i64> = a.get(i);
        var y: Vec<i64> = b.get(i);
        if x.len() != y.len() {
            return false;
        }
        var j: i64 = 0;
        while j < x.len() {
            if x.get(j) != y.get(j) {
                return false;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return true;
}

fn main() {
    nat_line_files_reset("main.fd");
    var names: Vec<str> = Vec::new();
    names.push("main");
    names.push("Point_len2");
    var starts: Vec<i64> = Vec::new();
    starts.push(0);
    starts.push(0x40);
    var ends: Vec<i64> = Vec::new();
    ends.push(0x40);
    ends.push(0x80);
    var shown: Vec<str> = Vec::new();
    shown.push("main");
    shown.push("Point::len2");
    var types: Vec<str> = Vec::new();
    types.push("Point\t16\tx\t0\ti64\t8\t5\ty\t8\ti64\t8\t5");
    types.push("Seg\t40\ta\t0\tPoint\t16\tS\tb\t16\tPoint\t16\tS\ttag\t32\tu8\t1\t7");
    var vars: Vec<str> = Vec::new();
    vars.push("V\tp\tPoint\t16\tS\tf-48\nV\ts\tSeg\t40\tS\tf-96\nV\tn\ti64\t8\t5\tr3@0:16");
    vars.push("P\tself\tPoint\t8\tP\tr5\nV\tsq\ti64\t8\t5\t");
    g_nat_dbg_shown = shown;
    g_nat_dbg_types = types;
    g_nat_dbg_ext = true;
    g_nat_dbg_vars = vars;
    var rows: Vec<i64> = Vec::new();
    rows.push(0);
    rows.push(10);
    rows.push(0);
    rows.push(8);
    rows.push(11);
    rows.push(0);
    rows.push(0x40);
    rows.push(0);
    rows.push(1);
    rows.push(0x40);
    rows.push(20);
    rows.push(0);
    rows.push(0x80);
    rows.push(0);
    rows.push(1);
    var cfi: Vec<i64> = Vec::new();
    var parts: Vec<Vec<i64>> = nat_macho_dwarf_full(NAT_A64, image(0x80), names, starts, ends, "main.fd", rows, cfi);
    println("parts " + int_to_str(parts.len()));
    var abbrev: Vec<i64> = parts.get(0);
    var info: Vec<i64> = parts.get(1);
    var frame: Vec<i64> = parts.get(3);
    var loc: Vec<i64> = Vec::new();
    if parts.len() > 4 {
        loc = parts.get(4);
    }
    var abs: Vec<Abbrev> = read_abbrevs(&abbrev);
    walk(&info, &abs, &loc);
    println(frame_counts(&frame));
    // nat_macho_img takes these sections through nat_macho_dwarf once
    // nat_macho_debug_cfi has set them (flattened in the globals)
    var flat: Vec<i64> = Vec::new();
    var lens: Vec<i64> = Vec::new();
    var pi: i64 = 0;
    while pi < parts.len() {
        var part: Vec<i64> = parts.get(pi);
        lens.push(part.len());
        var j: i64 = 0;
        while j < part.len() {
            flat.push(part.get(j));
            j = j + 1;
        }
        pi = pi + 1;
    }
    g_nat_macho_dw_full = flat;
    g_nat_macho_dw_lens = lens;
    var back: Vec<Vec<i64>> = nat_macho_dwarf(&names, &starts, ends, "main.fd", rows, NAT_MACHO_BASE + NAT_MACHO_HDR);
    g_nat_macho_dw_full = Vec::new();
    g_nat_macho_dw_lens = Vec::new();
    println("split same " + bool_to_str(same_parts(&parts, &back)));
    g_nat_dbg_shown = Vec::new();
    g_nat_dbg_types = Vec::new();
    g_nat_dbg_ext = false;
    g_nat_dbg_vars = Vec::new();
}
