// TG11 (docs/roadmap/llvm-roadmap.md): the machine layer's vector liveness
// check (compiler/nat_ir.fd ng_vec_live_check, part of the MIR verifier
// under FID_VERIFY=1) on small MIR sequences, through nat_vlive_unit_check:
// a vector value read after a call, on a path that skips its write, at 32
// bytes after VEND, or never written is caught; a loop over a splat, a lane
// read after VEND, the zeroing idiom with a copy, and a value carried
// through a frame slot around a call (the vectorizer's spill slots) pass.
//   $FID run tests/nattools/vlive_unit.fd   ->   vlive ok
use core;
use vec;
use string;
use compiler::nat_ir;

fn main() {
    val err: str = nat_vlive_unit_check();
    if err == "" {
        println("vlive ok");
    } else {
        println("vlive " + err);
    }
}
