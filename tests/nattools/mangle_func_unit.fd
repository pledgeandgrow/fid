// BG236 (docs/roadmap/bugs-roadmap.md): two function types whose parts read
// alike in a row, `fn(fn(i64) -> f64, i64) -> i64` and `fn(fn(i64, f64) ->
// i64) -> i64`, gave one mangled name (id__fn_fn_i64_f64_i64_i64): one
// instance for two T. Each part of a function type now carries its length,
// as a tuple's do. Checked directly on mangle_type (the monomorphizer's
// own test, tests/selfhost/test_mono.fd, no longer compiles for reasons of
// its own, with the compiler of Nov 25 as with this one).
//
// Expected output:
// fn_2_16_fn_1_3_i64_3_f64_3_i64_3_i64
// fn_1_22_fn_2_3_i64_3_f64_3_i64_3_i64
// true
// fn_0__3_i64
// i64
use core;
use vec;
use string;
use compiler::ast;
use compiler::mono;

fn main() -> i64 {
    // fn(fn(i64) -> f64, i64) -> i64
    var p1a: Vec<Type> = Vec::new();
    p1a.push(Type::I64);
    val inner1: Type = Type::Func(p1a, Box::new(Type::F64));
    var p1: Vec<Type> = Vec::new();
    p1.push(inner1);
    p1.push(Type::I64);
    val f1: Type = Type::Func(p1, Box::new(Type::I64));
    // fn(fn(i64, f64) -> i64) -> i64
    var p2a: Vec<Type> = Vec::new();
    p2a.push(Type::I64);
    p2a.push(Type::F64);
    val inner2: Type = Type::Func(p2a, Box::new(Type::I64));
    var p2: Vec<Type> = Vec::new();
    p2.push(inner2);
    val f2: Type = Type::Func(p2, Box::new(Type::I64));
    println(mangle_type(f1));
    println(mangle_type(f2));
    println(mangle_type(f1) != mangle_type(f2));
    println(mangle_type(Type::Func(Vec::new(), Box::new(Type::I64))));
    // the types of the other kinds are as before
    println(mangle_type(Type::I64));
    return 0;
}
