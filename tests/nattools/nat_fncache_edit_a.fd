// SP6: the first version of an edited program for
// tests/nattools/machine_fncache_check.sh (the second is
// nat_fncache_edit_b.fd: the same functions, structs and globals, so the
// cache's module salt is the same and unchanged functions hit). Built
// first, it fills the cache. In this version:
//   - mk returns its Pair in two registers (ME27 / LF24), and use_mk
//     calls it so;
//   - inner clobbers few registers, so outer keeps a, b and c in
//     registers inner leaves alone (IPRA).
// Expected output:
// 180
// 50
// 15

struct Pair {
    a: i64,
    b: i64,
}

fn mk(n: i64) -> Pair {
    return Pair { a: n, b: n + 1 };
}

fn use_mk(n: i64) -> i64 {
    val p: Pair = mk(n);
    return p.a * p.b + n;
}

// (two blocks each: the mid-end inlines only one-block functions, and
// these must stay calls, as in nat_fncache_edit_b.fd)
fn pick(n: i64) -> i64 {
    if n > 1000000 {
        println("big");
    }
    return n + 1;
}

fn inner(x: i64) -> i64 {
    if x > 1000000 {
        return 0;
    }
    return x + 1;
}

fn outer(n: i64) -> i64 {
    val a: i64 = n * 3;
    val b: i64 = n * 5 + 1;
    val c: i64 = n * 7 + 2;
    val d: i64 = inner(n);
    return a + b + c + d;
}

fn main() {
    var s: i64 = 0;
    var u: i64 = 0;
    var k: i64 = 0;
    var i: i64 = 0;
    while i < 5 {
        s = s + outer(i);
        u = u + use_mk(i);
        k = k + pick(i);
        i = i + 1;
    }
    println(s);
    println(u);
    println(k);
}
