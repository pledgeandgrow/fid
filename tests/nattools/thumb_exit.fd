// PL5 (tests/nattools/thumb_check.sh): main's result is the exit status, on
// Linux (exit_group) and with no OS (semihosting SYS_EXIT_EXTENDED); a
// division by zero in a callee is caught before it.

fn div(a: i64, b: i64) -> i64 {
    return a / b;
}

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(84);
    v.push(2);
    println("half " + int_to_str(div(v.get(0), v.get(1))));
    return 3;
}
