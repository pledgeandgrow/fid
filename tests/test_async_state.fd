// Test: async/await state machine — cooperative scheduling (Phase 7.6)
//
// This test demonstrates that async functions can suspend at await points
// and resume later, allowing other tasks to run in between.
//
// Without state machine transform: async functions run eagerly (all the way
// to completion before returning). With the transform, an async function
// that awaits another future will suspend, letting other tasks run.

async fn step1(x: i64) -> Future<i64> {
    return x + 1;
}

async fn step2(x: i64) -> Future<i64> {
    return x * 2;
}

// Chain two async operations
async fn pipeline(x: i64) -> Future<i64> {
    val a = await step1(x);
    val b = await step2(a);
    return b;
}

fn main() {
    // Test basic chaining
    val result = await pipeline(10);
    print("pipeline(10) = ");
    print(result);
    print("\n");

    // Test multiple concurrent pipelines
    var f1 = pipeline(1);
    var f2 = pipeline(2);
    var f3 = pipeline(3);

    val r1 = await f1;
    val r2 = await f2;
    val r3 = await f3;

    print("f1 = ");
    print(r1);
    print("\n");
    print("f2 = ");
    print(r2);
    print("\n");
    print("f3 = ");
    print(r3);
    print("\n");

    // Verify: pipeline(1) = (1+1)*2 = 4
    //         pipeline(2) = (2+1)*2 = 6
    //         pipeline(3) = (3+1)*2 = 8

    if r1 == 4 && r2 == 6 && r3 == 8 {
        print("OK\n");
    } else {
        print("FAIL\n");
    }
}
