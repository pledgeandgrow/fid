// Test: async/await state machine — cooperative scheduling (Phase 7.6)
//
// This test demonstrates that async functions can suspend at await points
// and resume later, allowing other tasks to run in between.
//
// Without state machine transform: async functions run eagerly (all the way
// to completion before returning). With the transform, an async function
// that awaits another future will suspend, letting other tasks run.

async pf step1(x: i64) -> Future<i64> {
    ret x + 1;
}

async pf step2(x: i64) -> Future<i64> {
    ret x * 2;
}

// Chain two async operations
async pf pipeline(x: i64) -> Future<i64> {
    pv a = await step1(x);
    pv b = await step2(a);
    ret b;
}

pf main() {
    // Test basic chaining
    pv result = await pipeline(10);
    print("pipeline(10) = ");
    print(result);
    print("\n");

    // Test multiple concurrent pipelines
    pv f1 = pipeline(1);
    pv f2 = pipeline(2);
    pv f3 = pipeline(3);

    pv r1 = await f1;
    pv r2 = await f2;
    pv r3 = await f3;

    print("f1 = ");
    print(r1);
    print("\n");
    print("f2 = ");
    print(r2);
    print("\n");
    print("f3 = ");
    print(r3);
    print("\n");

    // Verify: pipeline(1) = (1+1)*2 = 4
    //         pipeline(2) = (2+1)*2 = 6
    //         pipeline(3) = (3+1)*2 = 8

    if r1 == 4 && r2 == 6 && r3 == 8 {
        print("OK\n");
    } else {
        print("FAIL\n");
    }
}
