// Phase 3B.2 — Associated types.
// A trait with an associated type, like Rust's Iterator.

cap Container {
    type Item;
    fn first(self) -> Item;
    fn count(self) -> i64;
}

struct IntBox {
    value: i64,
    count: i64,
}

impl Container for IntBox {
    type Item = i64;
    pub fn first(self: IntBox) -> i64 {
        return self.value;
    }
    pub fn count(self: IntBox) -> i64 {
        return self.count;
    }
}

// A generic function that uses the associated type.
// T::Item is resolved to the concrete type during monomorphization.
fn get_first<T: Container>(c: T) -> T::Item {
    return c.first();
}

fn main() -> i64 {
    val box = IntBox { value: 42, count: 3 };
    val v = get_first(box);
    print(v);

    val c = box.count();
    print(c);

    return 0;
}
