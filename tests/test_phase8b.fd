// tests/test_phase8b.fd — Phase 8B: ECS, State Machines, Event Handlers
//
// Tests:
//   F18: Component declaration, entity creation, component add/get/has/remove
//   F18: System with query statement
//   F19: State machine with states, transitions, and event handlers
//   F20: Event handler declaration and dispatch

// ─── F18: ECS Components ──────────────────────────────────────────────

component Position { x: f64, y: f64 }
component Velocity { dx: f64, dy: f64 }
component Health { hp: i64 }

// ─── F18: ECS System with Query ──────────────────────────────────────

system MoveSystem(dt: f64) {
    query(Position, Velocity) {
        // For each entity with Position and Velocity:
        // In a full implementation, we would update position based on velocity
        // For now, just count matching entities
        print("entity ");
        print(entity);
        print(" has Position+Velocity\n");
    }
}

system HealthSystem() {
    query(Health) {
        print("entity ");
        print(entity);
        print(" has Health\n");
    }
}

// ─── F19: State Machine ──────────────────────────────────────────────

state PlayerState {
    Idle {
        on move => Running
        on attack => Attacking
    }
    Running {
        on stop => Idle
        on attack => Attacking
    }
    Attacking {
        on done => Idle
    }
}

// ─── F20: Event Handlers ─────────────────────────────────────────────

on player_died(name: str) {
    print("Player died: ");
    print(name);
    print("\n");
}

on level_loaded(level: i64) {
    print("Level ");
    print(level);
    print(" loaded\n");
}

// ─── Main Test ────────────────────────────────────────────────────────

pf main() {
    print("=== Phase 8B Tests ===\n");

    // ── F18: Entity creation ──
    print("\n--- ECS Entity Creation ---\n");
    pv e1 = __ecs_create_entity();
    pv e2 = __ecs_create_entity();
    pv e3 = __ecs_create_entity();

    print("entity count: ");
    print(__ecs_entity_count());
    print("\n");

    // ── F18: Component add/has ──
    print("\n--- ECS Component Add/Has ---\n");
    __ecs_add("Position", e1, Position { x: 10.0, y: 20.0 });
    __ecs_add("Velocity", e1, Velocity { dx: 1.0, dy: 0.0 });
    __ecs_add("Health", e1, Health { hp: 100 });
    __ecs_add("Position", e2, Position { x: 30.0, y: 40.0 });
    // e3 has no components

    print("e1 has Position: ");
    print(__ecs_has("Position", e1));
    print("\n");
    print("e2 has Position: ");
    print(__ecs_has("Position", e2));
    print("\n");
    print("e3 has Position: ");
    print(__ecs_has("Position", e3));
    print("\n");
    print("e1 has Velocity: ");
    print(__ecs_has("Velocity", e1));
    print("\n");
    print("e2 has Velocity: ");
    print(__ecs_has("Velocity", e2));
    print("\n");

    // ── F18: Component remove ──
    print("\n--- ECS Component Remove ---\n");
    __ecs_remove("Position", e2);
    print("e2 has Position after remove: ");
    print(__ecs_has("Position", e2));
    print("\n");

    // ── F18: System with query ──
    print("\n--- ECS System Query ---\n");
    MoveSystem(0.016);
    print("\n");
    HealthSystem();

    // ── F19: State Machine ──
    print("\n--- State Machine ---\n");
    pv ps = PlayerState_initial();
    print("initial state created\n");

    // Transition: Idle -> Running
    ps = PlayerState_handle(ps, "move");
    print("after move: transitioned\n");

    // Transition: Running -> Idle
    ps = PlayerState_handle(ps, "stop");
    print("after stop: transitioned\n");

    // Transition: Idle -> Attacking
    ps = PlayerState_handle(ps, "attack");
    print("after attack: transitioned\n");

    // Transition: Attacking -> Idle
    ps = PlayerState_handle(ps, "done");
    print("after done: transitioned\n");

    // Unknown event — should stay in current state
    ps = PlayerState_handle(ps, "unknown");
    print("after unknown: stayed\n");

    // ── F20: Event Handlers ──
    print("\n--- Event Handlers ---\n");
    __on_player_died("hero");
    __on_level_loaded(5);

    print("\n=== All Phase 8B Tests Passed ===\n");
}
