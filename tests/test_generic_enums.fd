// Test generic Option<T> and Result<T, E> syntax
// These are declared with type params in stdlib/core.fd

fn main() -> i64 {
    // Option<T> should work as a type
    val x = Option::Some(42);
    print(x.is_some());  // true
    print(x.unwrap());   // 42

    val n = Option::None;
    print(n.is_none());  // true
    print(n.unwrap_or(99));  // 99

    // Result<T, E> should work as a type
    val ok = Result::Ok(100);
    print(ok.is_ok());   // true
    print(ok.unwrap());  // 100

    val err = Result::Err(5);
    print(err.is_err());  // true
    print(err.unwrap_or(0));  // 0

    // Result.ok() returns Option
    val o = ok.ok();
    print(o.is_some());  // true

    // Result.err() returns Option
    val e = err.err();
    print(e.is_some());  // true

    return 0;
}
