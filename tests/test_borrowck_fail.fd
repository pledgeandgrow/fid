// Test: borrow checker — violations that should be caught
//
// This test exercises borrow checker violations:
// - Rule 1: &mut x while any borrow on x is active
// - Rule 2: &x while &mut x is active
// - Rule 3: mutating x while any borrow on x is active
// - NLL violation: mutating x while a borrow is still live (used after mutation)
//
// This test is expected to FAIL under --borrowck=on (now the default).
// Use --borrowck=off to run without borrow checking.

fn main() -> i64 {
    // Rule 1: two mutable borrows on the same variable
    var v = 10;
    val r1 = &mut v;
    val r2 = &mut v;  // VIOLATION: cannot create &mut v, mut borrow already active
    *r1 = 20;
    *r2 = 30;
    print(v);

    // NLL violation: borrow is still live because r is used after the mutation
    var n = 10;
    val nr = &n;       // borrow n
    n = 20;           // VIOLATION: cannot mutate n, shared borrow still active
    print(*nr);       // nr is used AFTER mutation — borrow is still live

    return 0;
}
