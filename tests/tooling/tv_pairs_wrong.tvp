# RL5: pairs whose expectations are wrong on purpose, so that the runner
# of tests/verify/tv is shown to fail when a verdict is not the one
# expected (tests/tooling/tv-check.sh: "3 pairs, 0 as expected", exit 3).
# Not in tests/verify/tv, which must pass.

# a wrong fold, said to be right
pair wrong_expect_accept
pass fold
expect accept
before
fn f(%0: i64) -> i64
b0:
  %1 = const i64 2
  %2 = const i64 3
  %3 = mul i64 %1 %2
  %4 = add i64 %0 %3
  %5 = ret %4
after
fn f(%0: i64) -> i64
b0:
  %1 = const i64 2
  %2 = const i64 3
  %3 = const i64 7
  %4 = add i64 %0 %3
  %5 = ret %4

# a rejection, but not for the reason the pair names
pair wrong_reason
pass fold
expect reject
why calls or prints differ
before
fn f(%0: i64) -> i64
b0:
  %1 = const i64 2
  %2 = const i64 3
  %3 = mul i64 %1 %2
  %4 = ret %3
after
fn f(%0: i64) -> i64
b0:
  %1 = const i64 2
  %2 = const i64 3
  %3 = const i64 5
  %4 = ret %3

# a line the format does not have: an error, never a pass
pair malformed
pass fold
expect accept
before
fn f(%0: i64) -> i64
b0:
  %1 = frobnicate i64 %0
  %2 = ret %0
after
fn f(%0: i64) -> i64
b0:
  %2 = ret %0
