// Fixture of tests/tooling/lint-unused-check.sh (roadmap L7E): a method of
// a trait impl takes the parameters the trait gives it, so one it does not
// read is not reported; the same parameter in a plain function is. A name
// read only inside a string, as a range's end or through a field of a
// struct it holds counts as read.
// `fid lint` on this file prints exactly:
//   warning: line 32: unused parameter 'scale' of 'plain_area' — it is never read.
//   (and its Fix: line), then "1 lint warning(s)."

cap Area {
    fn area(self, scale: i64) -> i64;
}

struct Sq { s: i64 }

impl Area for Sq {
    pub fn area(self: Sq, scale: i64) -> i64 {
        return self.s * self.s;
    }
}

fn reads_everything(n: i64, p: Sq) -> i64 {
    var total: i64 = 0;
    for j in 0..n {
        total = total + j;
    }
    var label: str = "total";
    println(f"{label}");
    return total + p.s;
}

fn plain_area(q: Sq, scale: i64) -> i64 {
    return q.s * q.s;
}

fn main() -> i64 {
    val sq: Sq = Sq { s: 3 };
    println(sq.area(2));
    println(reads_everything(4, sq));
    println(plain_area(sq, 1));
    return 0;
}
