// Fixture of tests/tooling/lint-style-check.sh (roadmap L7E, style lints):
// the naming and import-order cases tests/bootstrap/test_style_lint.fd does
// not reach. The check compares the style warnings `fid lint` prints for
// this file with the list in "Expected style warnings" below (in order;
// unused-import warnings are another lint and are not counted).
// Not reported: a group after a blank line is not compared with the one
// before it, HTTPServer (a run of capitals is UpperCamelCase), a @repr(C)
// struct, the Type_method free function HTTPServer_port, the constant-like
// DEFAULT_PORT(), names starting with `_`, and the parameter a cap's method
// takes in an `impl Cap for T` (the cap gives it).
// Expected style warnings:
//   line 27: imports are not sorted: 'use iter' should come before 'use sort'.
//   line 32: constant 'bufSize' should be SCREAMING_SNAKE_CASE: BUF_SIZE
//   line 38: struct 'http_conn' should be UpperCamelCase: HttpConn
//   line 48: enum 'color_kind' should be UpperCamelCase: ColorKind
//   line 58: cap 'measure_like' should be UpperCamelCase: MeasureLike
//   line 68: function 'parseHTTPHeader' should be snake_case: parse_http_header
//   line 68: parameter 'lineText' of 'parseHTTPHeader' should be snake_case: line_text
//   line 76: function 'HTTPServer_portNumber' should be snake_case: http_server_port_number
//   line 84: function 'BAD_WITH_ARG' should be snake_case: bad_with_arg
//   line 93: variable 'totalCount' in 'counts' should be snake_case: total_count
//   line 94: variable 'idxVar' in 'counts' should be snake_case: idx_var
use core;
use vec;
use string;
use sort;
use iter;

use bits;

const MAX_LEN: i64 = 4;
const bufSize: i64 = 8;

struct HTTPServer {
    port: i64,
}

struct http_conn {
    fd: i64,
}

@repr(C)
struct c_point {
    x: i64,
    y: i64,
}

enum color_kind {
    Red,
    Green,
}

enum Shade {
    Light,
    Dark,
}

cap measure_like {
    fn measure(self, scaleBy: i64) -> i64;
}

impl measure_like for HTTPServer {
    pub fn measure(self: HTTPServer, scaleBy: i64) -> i64 {
        return self.port * scaleBy;
    }
}

fn parseHTTPHeader(lineText: str) -> i64 {
    return str_len(lineText);
}

fn HTTPServer_port(s: HTTPServer) -> i64 {
    return s.port;
}

fn HTTPServer_portNumber(s: HTTPServer) -> i64 {
    return s.port + 1;
}

fn DEFAULT_PORT() -> i64 {
    return 80;
}

fn BAD_WITH_ARG(n: i64) -> i64 {
    return n + MAX_LEN;
}

fn _InternalHelper() -> i64 {
    return 1;
}

fn counts() -> i64 {
    var totalCount: i64 = 0;
    for idxVar in 0..3 {
        totalCount = totalCount + idxVar;
    }
    var _skipMe: i64 = bufSize;
    return totalCount + _skipMe;
}

fn main() -> i64 {
    val srv: HTTPServer = HTTPServer { port: 8 };
    val conn: http_conn = http_conn { fd: 3 };
    val pt: c_point = c_point { x: 1, y: 2 };
    println(srv.measure(2));
    println(parseHTTPHeader("GET /"));
    println(HTTPServer_port(srv) + HTTPServer_portNumber(srv));
    println(DEFAULT_PORT() + BAD_WITH_ARG(1) + _InternalHelper());
    println(counts() + conn.fd + pt.x + pt.y);
    return 0;
}
