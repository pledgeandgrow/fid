// VF6: compiler/tv.fd's self-test as a program of its own: pairs (before,
// after a pass) built by hand, each of which a check of the translation
// validator must accept (the pass's rule) or reject (a mistake): fold,
// dce, gvn, licm, inline, gconst, icf, ipcp, devirt, an injected fault, and
// the SMT-LIB writer. The compiler runs the same cases with
// FID_TV_SELFTEST=1 (tv_report); this program runs them without a build of
// the compiler. tests/tooling/tv-check.sh builds it (C backend) and reads
// the line on stderr ("tv selftest: N cases, N as expected").
//
// With FID_VALIDATE_SMT=<dir> it also writes the SMT-LIB examples of
// tv_smt_examples to <dir>/tvx<N>.smt2 (rewrites z3 must prove, mistakes
// it must refute; the first line of each says which) and prints
// "tv smt examples: N written" on stderr.
//
// Expected output (stdout):
// tv selftest ok
use core;
use vec;
use string;
use compiler::ast;
use compiler::ir;
use compiler::checks;
use compiler::ssa;
use compiler::ir_ser;
use compiler::tv;

fn main() {
    var bad: i64 = tv_selftest();
    if bad == 0 {
        print("tv selftest ok\n");
    } else {
        print("tv selftest: " + int_to_str(bad) + " cases not as expected\n");
    }
    match env_var("FID_VALIDATE_SMT") {
        Option::Some(dir) => {
            if str_len(dir) > 0 {
                var n: i64 = tv_smt_examples(dir);
                p_eprint_str("tv smt examples: " + int_to_str(n) + " written\n");
            }
        }
        Option::None => {
        }
    }
}
