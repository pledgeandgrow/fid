// CA10: a green task that blocks its worker thread. `worker` runs as a task
// (p_co_go) and reaches p_read_line (through wait_for_input) and
// p_chan_recv: both block the OS thread instead of parking the task, so
// `fid lint` warns about each.

fn wait_for_input() -> i64 {
    val line: i64 = p_read_line();
    return line;
}

fn worker(ch: i64) -> i64 {
    val got: i64 = p_chan_recv(ch);
    return wait_for_input() + got;
}

fn main() -> i64 {
    val ch: i64 = p_chan_create(1);
    val t: i64 = p_co_go("worker", ch);
    p_co_run();
    return 0;
}
