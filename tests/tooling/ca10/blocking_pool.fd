// CA10: the same blocking read, run on the blocking pool. `worker` hands
// wait_for_input to p_co_pool_call (task_pool_call in stdlib/task.fd) by
// name, and waits with p_co_sleep (task_sleep): the task parks, its worker
// runs other tasks, and `fid lint` does not warn.

fn wait_for_input() -> i64 {
    val line: i64 = p_read_line();
    return line;
}

fn worker(n: i64) -> i64 {
    p_co_sleep(1);
    return p_co_pool_call("wait_for_input", 0, 0) + n;
}

fn main() -> i64 {
    val t: i64 = p_co_go("worker", 1);
    p_co_run();
    return 0;
}
