// RL5: the before/after pairs of tests/verify/tv (*.tvp) run through
// compiler/tv.fd's checks as a program of its own, without a build of the
// compiler: each pair is a function (or a few) as it was before a pass and
// as the pass left it, with the verdict the checks must give (accept,
// reject, n/a). The format is described above tv_pairs_text in
// compiler/tv.fd. The compiler runs the same pairs with
// FID_TV_PAIRS=tests/verify/tv (tv_report, at the end of the mid-end).
//
// Usage: tv_pairs [<file.tvp or directory>]   (default tests/verify/tv,
// relative to the current directory: run it from the repository root).
// Prints a line per pair on stderr ("tv pairs: ok   ..." / "tv pairs:
// FAIL ...") and the totals ("tv pairs: N pairs, N as expected"); stdout
// gets "tv pairs ok" when every pair is as expected. Exit status: the
// number not as expected. tests/tooling/tv-check.sh builds and runs it.
//
// Expected output (stdout):
// tv pairs ok
use core;
use vec;
use string;
use compiler::ast;
use compiler::ir;
use compiler::checks;
use compiler::ssa;
use compiler::ir_ser;
use compiler::tv;

fn main() -> i64 {
    var path: str = "tests/verify/tv";
    match arg_at(1) {
        Option::Some(a) => {
            if str_len(a) > 0 {
                path = a;
            }
        }
        Option::None => {
        }
    }
    var bad: i64 = tv_pairs_run(path, true);
    if bad == 0 {
        print("tv pairs ok\n");
    } else {
        print("tv pairs: " + int_to_str(bad) + " not as expected\n");
    }
    return bad;
}
