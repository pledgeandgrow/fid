// Recursive enum via Box<T> — enables AST-like data structures.
// This is the key test for self-hosting: the Fides compiler's AST is
// defined as recursive enums with Box<T> indirection.
enum Expr {
    Num(i64),
    Add(Box<Expr>, Box<Expr>),
    Mul(Box<Expr>, Box<Expr>),
}

pf eval(e: Box<Expr>) -> i64 {
    match e {
        Expr::Num(n) => { ret n; }
        Expr::Add(left, right) => { ret eval(left) + eval(right); }
        Expr::Mul(left, right) => { ret eval(left) * eval(right); }
    }
}

pf count_nodes(e: Box<Expr>) -> i64 {
    match e {
        Expr::Num(_) => { ret 1; }
        Expr::Add(left, right) => { ret count_nodes(left) + count_nodes(right) + 1; }
        Expr::Mul(left, right) => { ret count_nodes(left) + count_nodes(right) + 1; }
    }
}

pf main() -> i64 {
    // Build: (1 + 2) * (3 + 4) = 21
    pv one = Box::new(Expr::Num(1));
    pv two = Box::new(Expr::Num(2));
    pv three = Box::new(Expr::Num(3));
    pv four = Box::new(Expr::Num(4));
    pv left = Box::new(Expr::Add(one, two));
    pv right = Box::new(Expr::Add(three, four));
    pv root = Box::new(Expr::Mul(left, right));

    print(eval(root));        // 21
    print(count_nodes(root)); // 7 (3 internal + 4 leaves)

    ret 0;
}
