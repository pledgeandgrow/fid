// Matrix multiplication kernel using const generics for fixed-size matrices.
// Combines Phase 3C features: const generics ([T; N]) + SIMD-style operations.
//
// This is the Phase 3C success metric: a matrix multiplication kernel using
// const generics for compile-time matrix dimensions.

use simd;

// 2x2 matrix multiply: C = A * B
// All matrices are 2x2 stored as flat 4-element arrays.
// Returns the sum of all elements of C (for easy verification).
fn matmul2x2(a: [i64; 4], b: [i64; 4]) -> i64 {
    // C[0] = A[0]*B[0] + A[1]*B[2]
    // C[1] = A[0]*B[1] + A[1]*B[3]
    // C[2] = A[2]*B[0] + A[3]*B[2]
    // C[3] = A[2]*B[1] + A[3]*B[3]
    val c0 = a[0] * b[0] + a[1] * b[2];
    val c1 = a[0] * b[1] + a[1] * b[3];
    val c2 = a[2] * b[0] + a[3] * b[2];
    val c3 = a[2] * b[1] + a[3] * b[3];
    return c0 + c1 + c2 + c3;
}

// 3x3 matrix multiply: C = A * B
// All matrices are 3x3 stored as flat 9-element arrays.
fn matmul3x3(a: [i64; 9], b: [i64; 9]) -> i64 {
    val result = 0;
    for i in 0..3 {
        for j in 0..3 {
            val s = 0;
            for k in 0..3 {
                s = s + a[i * 3 + k] * b[k * 3 + j];
            }
            result = result + s;
        }
    }
    return result;
}

// Dot product using const generics
fn dot_product<N: i64>(a: [i64; N], b: [i64; N]) -> i64 {
    val s = 0;
    for i in 0..N {
        s = s + a[i] * b[i];
    }
    return s;
}

// Sum of array using const generics
fn sum<N: i64>(arr: [i64; N]) -> i64 {
    val s = 0;
    for i in 0..N {
        s = s + arr[i];
    }
    return s;
}

fn main() -> i64 {
    // 2x2 matrix multiply: A = [1,2,3,4], B = [5,6,7,8]
    // C = A*B = [1*5+2*7, 1*6+2*8, 3*5+4*7, 3*6+4*8]
    //         = [19, 22, 43, 50]
    // Sum = 19 + 22 + 43 + 50 = 134
    val a = [1, 2, 3, 4];
    val b = [5, 6, 7, 8];
    print(matmul2x2(a, b));  // 134

    // 3x3 matrix multiply
    val a3 = [1, 0, 0, 0, 1, 0, 0, 0, 1];  // Identity
    val b3 = [1, 2, 3, 4, 5, 6, 7, 8, 9];
    print(matmul3x3(a3, b3));  // 1+5+9 = 15 (trace of identity*B = trace of B)

    // Dot product using const generics
    val v1 = [1, 2, 3];
    val v2 = [4, 5, 6];
    print(dot_product(v1, v2));  // 1*4 + 2*5 + 3*6 = 32

    // Sum using const generics
    val arr = [10, 20, 30, 40, 50];
    print(sum(arr));  // 150

    // SIMD-style operations via stdlib
    val sv1 = Vec::new();
    sv1.push(1.0);
    sv1.push(2.0);
    sv1.push(3.0);
    sv1.push(4.0);

    val sv2 = Vec::new();
    sv2.push(10.0);
    sv2.push(20.0);
    sv2.push(30.0);
    sv2.push(40.0);

    // SIMD dot product (from simd stdlib module)
    val d = dot(sv1, sv2);
    print(d);  // 1*10 + 2*20 + 3*30 + 4*40 = 300

    return 0;
}
