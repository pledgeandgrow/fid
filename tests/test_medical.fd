// Test: F48 @medical annotation — IEC 62304 compliance
//
// @medical functions must:
//   1. No dynamic allocation (no Vec::new, push, malloc, etc.)
//   2. No recursion (no self-calls)
//   3. Full logging (must also be @audit)
//   4. No while loops (bounded iteration only)
//   5. No unwrap/panic

@medical @audit
fn calculate_dose(weight_kg: i64, mg_per_kg: i64) -> i64 {
    // Safe: no allocation, no recursion, no while, no unwrap
    val dose = weight_kg * mg_per_kg;
    return dose;
}

@medical @audit
fn validate_range(value: i64, min_val: i64, max_val: i64) -> i64 {
    // Safe: bounded for loop, no allocation
    val result = value;
    if value < min_val {
        result = min_val;
    }
    if value > max_val {
        result = max_val;
    }
    return result;
}

@medical @audit
fn sum_5(r0: i64, r1: i64, r2: i64, r3: i64, r4: i64) -> i64 {
    // Safe: stack values only, no allocation, no recursion
    return r0 + r1 + r2 + r3 + r4;
}

fn main() {
    val dose = calculate_dose(70, 5);
    print("dose = ");
    print(dose);
    print("\n");

    val clamped = validate_range(150, 80, 120);
    print("clamped = ");
    print(clamped);
    print("\n");

    val total = sum_5(80, 82, 79, 85, 81);
    print("total = ");
    print(total);
    print("\n");

    print("OK\n");
}
