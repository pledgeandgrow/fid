// Test: F63 — Init guarantee
// Verifies that `var` (uninitialized mutable) variables work correctly
// and that definite assignment analysis prevents reads before assignment.

fn main() -> i64 {
    // Basic: declare without initializer, assign, then read
    var x: i64;
    x = 42;
    print(x);
    print("\n");

    // Conditional: both branches assign → safe to read after
    var y: i64;
    val cond = 0;
    if cond > 0 {
        y = 10;
    } else {
        y = 20;
    }
    print(y);
    print("\n");

    // Chain assignment through multiple var variables
    var a: i64;
    var b: i64;
    a = 100;
    b = a + 1;
    print(b);
    print("\n");

    // var with string type
    var s: str;
    s = "hello";
    print(s);
    print("\n");

    // Reassignment is fine
    var z: i64;
    z = 1;
    z = 2;
    z = 3;
    print(z);
    print("\n");

    return 0;
}
