// Test: F63 — Init guarantee
// Verifies that `pm` (uninitialized mutable) variables work correctly
// and that definite assignment analysis prevents reads before assignment.

pf main() -> i64 {
    // Basic: declare without initializer, assign, then read
    pm x: i64;
    x = 42;
    print(x);
    print("\n");

    // Conditional: both branches assign → safe to read after
    pm y: i64;
    pv cond = 0;
    if cond > 0 {
        y = 10;
    } else {
        y = 20;
    }
    print(y);
    print("\n");

    // Chain assignment through multiple pm variables
    pm a: i64;
    pm b: i64;
    a = 100;
    b = a + 1;
    print(b);
    print("\n");

    // pm with string type
    pm s: str;
    s = "hello";
    print(s);
    print("\n");

    // Reassignment is fine
    pm z: i64;
    z = 1;
    z = 2;
    z = 3;
    print(z);
    print("\n");

    ret 0;
}
