// Test basic trait (cap) system
cap Printable {
    fn format(self) -> i64;
}

cap Addable {
    fn add(self, other: i64) -> i64;
}

struct Point {
    x: i64,
    y: i64,
}

impl Point {
    pub fn new(x: i64, y: i64) -> Point {
        return Point { x: x, y: y };
    }
}

impl Printable for Point {
    pub fn format(self: Point) -> i64 {
        return self.x + self.y;
    }
}

impl Addable for Point {
    pub fn add(self: Point, other: i64) -> i64 {
        return self.x + self.y + other;
    }
}

// Generic function with trait bound
fn print_value<T: Printable>(item: T) -> i64 {
    return item.format();
}

fn add_value<T: Addable>(item: T, n: i64) -> i64 {
    return item.add(n);
}

fn main() -> i64 {
    val p = Point::new(10, 20);
    print(p.format());
    print(p.add(5));

    val r = print_value(p);
    print(r);

    val s = add_value(p, 100);
    print(s);

    return 0;
}
