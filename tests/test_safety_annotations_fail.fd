// Test: Safety annotation enforcement (expected FAIL)
// @safety-critical includes @no-unbounded — while loops are forbidden

@safety-critical @audit
fn bad_avionics(altitude: i64) -> i64 {
    val x = 0;
    while x < altitude {
        x = x + 1;
    }
    return x;
}

fn main() -> i64 {
    val r = bad_avionics(100);
    print(r);
    return 0;
}
