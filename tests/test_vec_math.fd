// Test: Phase 8A — vec2/vec3/vec4, mat4, quat math types (F16)
//
// Tests vector arithmetic, dot/cross products, length/normalize,
// matrix operations, quaternion rotation, and construction functions.

use math;

fn main() {
    // ─── vec2 tests ───────────────────────────────────────────
    val a2 = vec2(1.0, 2.0);
    val b2 = vec2(3.0, 4.0);

    val sum2 = a2.add(b2);
    print("vec2 add: ");
    print(sum2.x);
    print(", ");
    print(sum2.y);
    print("\n");

    val dot2 = a2.dot(b2);
    print("vec2 dot: ");
    print(dot2);
    print("\n");

    // ─── vec3 tests ───────────────────────────────────────────
    val a3 = vec3(1.0, 2.0, 3.0);
    val b3 = vec3(4.0, 5.0, 6.0);

    val sum3 = a3.add(b3);
    print("vec3 add: ");
    print(sum3.x);
    print(", ");
    print(sum3.y);
    print(", ");
    print(sum3.z);
    print("\n");

    val sub3 = a3.sub(b3);
    print("vec3 sub: ");
    print(sub3.x);
    print(", ");
    print(sub3.y);
    print(", ");
    print(sub3.z);
    print("\n");

    val scaled = a3.scale(2.0);
    print("vec3 scale: ");
    print(scaled.x);
    print(", ");
    print(scaled.y);
    print(", ");
    print(scaled.z);
    print("\n");

    val dot3 = a3.dot(b3);
    print("vec3 dot: ");
    print(dot3);
    print("\n");

    val cross3 = a3.cross(b3);
    print("vec3 cross: ");
    print(cross3.x);
    print(", ");
    print(cross3.y);
    print(", ");
    print(cross3.z);
    print("\n");

    // ─── operator overloading tests ───────────────────────────
    val op_sum = a3 + b3;
    print("operator a + b: ");
    print(op_sum.x);
    print(", ");
    print(op_sum.y);
    print(", ");
    print(op_sum.z);
    print("\n");

    val op_diff = a3 - b3;
    print("operator a - b: ");
    print(op_diff.x);
    print(", ");
    print(op_diff.y);
    print(", ");
    print(op_diff.z);
    print("\n");

    val op_scaled = a3 * 2.0;
    print("operator a * 2: ");
    print(op_scaled.x);
    print(", ");
    print(op_scaled.y);
    print(", ");
    print(op_scaled.z);
    print("\n");

    val op_scaled2 = 3.0 * a3;
    print("operator 3 * a: ");
    print(op_scaled2.x);
    print(", ");
    print(op_scaled2.y);
    print(", ");
    print(op_scaled2.z);
    print("\n");

    val op_div = a3 / 2.0;
    print("operator a / 2: ");
    print(op_div.x);
    print(", ");
    print(op_div.y);
    print(", ");
    print(op_div.z);
    print("\n");

    val len3 = a3.length();
    print("vec3 length: ");
    print(len3);
    print("\n");

    val norm3 = a3.normalize();
    print("vec3 normalize: ");
    print(norm3.x);
    print(", ");
    print(norm3.y);
    print(", ");
    print(norm3.z);
    print("\n");

    val lerp3 = a3.lerp(b3, 0.5);
    print("vec3 lerp: ");
    print(lerp3.x);
    print(", ");
    print(lerp3.y);
    print(", ");
    print(lerp3.z);
    print("\n");

    // ─── vec4 tests ───────────────────────────────────────────
    val a4 = vec4(1.0, 2.0, 3.0, 4.0);
    val b4 = vec4(5.0, 6.0, 7.0, 8.0);

    val sum4 = a4.add(b4);
    print("vec4 add: ");
    print(sum4.x);
    print(", ");
    print(sum4.y);
    print(", ");
    print(sum4.z);
    print(", ");
    print(sum4.w);
    print("\n");

    val dot4 = a4.dot(b4);
    print("vec4 dot: ");
    print(dot4);
    print("\n");

    // vec4.xyz -> vec3
    val xyz = a4.xyz();
    print("vec4.xyz: ");
    print(xyz.x);
    print(", ");
    print(xyz.y);
    print(", ");
    print(xyz.z);
    print("\n");

    // ─── swizzle tests (F17) ──────────────────────────────────
    val color = vec4(1.0, 0.5, 0.2, 1.0);
    val rgb = color.rgb;
    print("swizzle .rgb: ");
    print(rgb.x);
    print(", ");
    print(rgb.y);
    print(", ");
    print(rgb.z);
    print("\n");

    val xy = color.xy;
    print("swizzle .xy: ");
    print(xy.x);
    print(", ");
    print(xy.y);
    print("\n");

    val yzx = color.yzx;
    print("swizzle .yzx: ");
    print(yzx.x);
    print(", ");
    print(yzx.y);
    print(", ");
    print(yzx.z);
    print("\n");

    val xxx = color.xxx;
    print("swizzle .xxx: ");
    print(xxx.x);
    print(", ");
    print(xxx.y);
    print(", ");
    print(xxx.z);
    print("\n");

    // ─── mat4 tests ───────────────────────────────────────────
    val ident = mat4::identity();
    val v = vec4(1.0, 2.0, 3.0, 4.0);
    val transformed = ident.transform_vec4(v);
    print("mat4 identity transform: ");
    print(transformed.x);
    print(", ");
    print(transformed.y);
    print(", ");
    print(transformed.z);
    print(", ");
    print(transformed.w);
    print("\n");

    // Translation matrix
    val t = translate(vec3(10.0, 20.0, 30.0));
    val point = vec3(1.0, 2.0, 3.0);
    val translated = t.transform_vec3(point);
    print("translate: ");
    print(translated.x);
    print(", ");
    print(translated.y);
    print(", ");
    print(translated.z);
    print("\n");

    // Scale matrix
    val s = mat_scale(2.0);
    val scaled_point = s.transform_vec3(point);
    print("scale: ");
    print(scaled_point.x);
    print(", ");
    print(scaled_point.y);
    print(", ");
    print(scaled_point.z);
    print("\n");

    // Matrix multiply: translate * scale
    val ts = t.mul(s);
    val ts_result = ts.transform_vec3(point);
    print("translate*mat_scale: ");
    print(ts_result.x);
    print(", ");
    print(ts_result.y);
    print(", ");
    print(ts_result.z);
    print("\n");

    // ─── quat tests ───────────────────────────────────────────
    val q = quat::from_axis_angle(vec3(0.0, 1.0, 0.0), radians(90.0));
    print("quat w: ");
    print(q.w);
    print("\n");
    print("quat x: ");
    print(q.x);
    print("\n");
    print("quat y: ");
    print(q.y);
    print("\n");
    print("quat z: ");
    print(q.z);
    print("\n");

    // Rotate a vector by quaternion
    val v_to_rotate = vec3(1.0, 0.0, 0.0);
    val rotated = q.rotate_vec3(v_to_rotate);
    print("rotated: ");
    print(rotated.x);
    print(", ");
    print(rotated.y);
    print(", ");
    print(rotated.z);
    print("\n");

    // ─── Free function tests ──────────────────────────────────
    print("radians(90): ");
    print(radians(90.0));
    print("\n");

    print("degrees(3.14159): ");
    print(degrees(3.14159));
    print("\n");

    print("lerp(0, 10, 0.5): ");
    print(lerp(0.0, 10.0, 0.5));
    print("\n");

    print("distance: ");
    print(distance(vec3(0.0, 0.0, 0.0), vec3(3.0, 4.0, 0.0)));
    print("\n");

    print("OK\n");
}
