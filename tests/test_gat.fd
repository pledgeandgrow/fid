// Test GATs (Generic Associated Types) — Phase 3C
// Tests basic associated types, bare self, and GAT type declarations.

cap Container {
    type Item;
    fn first(self) -> Item;
    fn count(self) -> i64;
}

// GAT: an associated type with a type parameter
cap Factory {
    type Product<T>;
    fn make_int(self) -> Product<i64>;
    fn make_str(self) -> Product<str>;
}

struct IntBox {
    value: i64,
}

impl Container for IntBox {
    type Item = i64;
    fn first(self) -> i64 {
        return self.value;
    }
    fn count(self) -> i64 {
        return 1;
    }
}

struct StringBox {
    value: str,
}

impl Container for StringBox {
    type Item = str;
    fn first(self) -> str {
        return self.value;
    }
    fn count(self) -> i64 {
        return 1;
    }
}

// Factory impl: Product<T> = T (identity)
struct IntFactory {
    _marker: i64,
}

impl Factory for IntFactory {
    type Product<T> = T;
    fn make_int(self) -> i64 {
        return 42;
    }
    fn make_str(self) -> str {
        return "made";
    }
}

// Generic function using associated type
fn get_first<T: Container>(c: T) -> T::Item {
    return c.first();
}

fn main() -> i64 {
    // Test 1: basic associated types with bare self
    val ib = IntBox { value: 42 };
    val r1 = get_first(ib);
    print(r1);  // 42

    val sb = StringBox { value: "hello" };
    val r2 = get_first(sb);
    print(r2);  // hello

    // Test 2: container count
    val c = IntBox { value: 99 };
    print(c.count());  // 1

    // Test 3: GAT — Factory trait with Product<T> associated type
    val f = IntFactory { _marker: 0 };
    val i = f.make_int();
    print(i);  // 42

    val s = f.make_str();
    print(s);  // made

    return 0;
}
