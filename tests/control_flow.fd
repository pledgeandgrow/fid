// Test if/else and for loops
fn main() {
    // if/else
    val x = 10;
    if x > 5 {
        print(1);
    } else {
        print(0);
    }

    // if/else if/else
    val y = 20;
    if y < 10 {
        print(10);
    } else if y < 20 {
        print(20);
    } else {
        print(30);
    }

    // for loop over range
    var sum = 0;
    for i in 0..5 {
        sum += i;
    }
    print(sum);

    // for loop with inclusive range
    var count = 0;
    for j in 1..=3 {
        count += j;
    }
    print(count);
}
