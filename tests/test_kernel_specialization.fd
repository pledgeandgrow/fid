// test_kernel_specialization.fd — ML8: comptime Kernel Specialization
// Expected: PASS
// Tests @kernel annotation with GPU codegen integration.
// The @kernel annotation marks a function as a GPU entry point.
// comptime gen can generate specialized kernels for exact shapes.

@kernel(32, 1, 1)
fn gemm_kernel(a: i64, b: i64) -> i64 {
    // Simple kernel: multiply two values
    // In real usage, this would be a GPU compute shader
    return a * b;
}

// comptime function that generates a specialized kernel name
comptime fn kernel_name(m: i64, n: i64, k: i64) -> str {
    return f"gemm_{m}_{n}_{k}";
}

fn main() {
    // Call the kernel (runs on CPU in interpreter mode, GPU in gpu codegen)
    val result = gemm_kernel(3, 4);
    print(result);
    print("\n");

    // comptime kernel name generation — evaluated at compile time
    val name = comptime kernel_name(128, 128, 64);
    print(name);
    print("\n");

    return 0;
}
