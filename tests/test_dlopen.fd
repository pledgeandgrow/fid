// Test: Dynamic loading — dlopen/dlsym/dlclose (Phase 7.7)
//
// p_dl_open(path) opens a shared library and returns a handle.
// p_dl_sym(handle, symbol) looks up a symbol in the library.
// p_dl_close(handle) closes the library.
// p_dl_call(func_ptr, arg) calls a dynamically loaded function.

fn main() {
    // Test 1: Open a shared library (libm.so on Linux)
    val lib = p_dl_open("libm.so.6");
    print("lib = ");
    print(lib);
    print("\n");

    // Test 2: Look up a symbol (sqrt)
    if lib != 0 {
        val sqrt_ptr = p_dl_sym(lib, "sqrt");
        print("sqrt_ptr = ");
        print(sqrt_ptr);
        print("\n");

        // Test 3: Call the dynamically loaded function
        if sqrt_ptr != 0 {
            val result = p_dl_call(sqrt_ptr, 16);
            print("sqrt(16) = ");
            print(result);
            print("\n");
        } else {
            print("sqrt not found\n");
        }

        // Test 4: Close the library
        p_dl_close(lib);
        print("closed\n");
    } else {
        print("could not open libm\n");
    }

    // Test 5: Open a non-existent library (should return 0)
    val bad = p_dl_open("nonexistent.so");
    print("bad = ");
    print(bad);
    print("\n");

    print("OK\n");
}
