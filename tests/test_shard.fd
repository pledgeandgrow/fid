// test_shard.fd — ML13: Tensor Parallelism with Capability Channels
// Expected: PASS
// Tests @shard annotation with Comm effect enforcement.

use tensor;
use shard;

fn vec2(a: i64, b: i64) -> Vec<i64> {
    val v = Vec::new();
    v.push(a);
    v.push(b);
    return v;
}

@shard(dim=0)
fn sharded_matmul(a: Tensor, b: Tensor) -> Tensor {
    // Each rank computes a partial matmul, then all-reduce
    val local_result = matmul(a, b);
    val global_result = all_reduce(local_result);
    return global_result;
}

fn main() {
    val a = ones(vec2(2, 2));
    val b = ones(vec2(2, 2));
    val result = sharded_matmul(a, b);
    print(to_str(result));
    print("\n");
    return 0;
}
