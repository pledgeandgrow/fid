// Minimal reproduction of the string-return-from-match bug

use core;

enum ResultStr {
    Ok(str),
    Err(str),
}

fn get_name() -> ResultStr {
    return ResultStr::Ok("main");
}

fn main() -> i64 {
    match get_name() {
        ResultStr::Ok(s: str) => {
            print("name='");
            print(s);
            print("'\n");
            var name: str = s;
            print("after assign: name='");
            print(name);
            print("'\n");
        }
        ResultStr::Err(e: str) => {
            print("error: ");
            print(e);
            print("\n");
        }
    }
    return 0;
}
