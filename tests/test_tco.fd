// Test: Tail call optimization — self-recursive factorial should be
// rewritten as a loop (no stack growth). Phase 4B.5
fn fact(n: i64, acc: i64) -> i64 {
    if n <= 1 {
        return acc;
    }
    return fact(n - 1, n * acc);
}

fn main() -> i64 !IO {
    val result = fact(5, 1);
    if result != 120 {
        print(999);
        return 1;
    }
    print(42);
    return 0;
}
