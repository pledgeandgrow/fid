// Test: txn {} rollback semantics
// Successful txn commits changes; panicking txn rolls back.
// This test verifies the successful path — the panicking path
// is tested in test_txn_rollback_fail.fd (expected fail).

pf main() {
    pv balance = 100;

    print("before: ");
    print(balance);
    print("\n");

    // Successful txn — changes persist
    txn {
        balance = balance + 50;
    }

    print("after txn: ");
    print(balance);
    print("\n");

    // Nested txn — outer commits, inner changes persist too
    txn {
        balance = balance + 25;
        txn {
            balance = balance + 10;
        }
    }

    print("after nested txn: ");
    print(balance);
    print("\n");

    // Txn with for loop inside
    txn {
        for i in 0..10 {
            balance = balance + i;
        }
    }

    print("after loop txn: ");
    print(balance);
    print("\n");

    print("OK\n");
}
