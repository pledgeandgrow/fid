fn main() {
    var v1 = Vec::new();
    v1.push(1);
    v1.push(2);
    var v2 = Vec::new();
    v2.push(10);
    v2.push(20);
    v2.push(30);
    if v1.len() > 0 {
        var i = 0;
        while i < v1.len() {
            println(v1.get(i));
            i = i + 1;
        }
    }
    if v2.len() > 0 {
        var i = 0;
        while i < v2.len() {
            println(v2.get(i));
            i = i + 1;
        }
    }
}
