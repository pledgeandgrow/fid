// Test: Raw pointer types (*mut T, *const T)
// Raw pointers can only be used inside unsafe {} blocks.
// They lower to the same IR as references (Ptr<T>) but without
// the safety guarantees — no borrow checking, no aliasing rules.

pf main() {
    pv value: i64 = 42;

    // Raw pointer access inside unsafe block
    unsafe {
        // Get raw pointer to value
        pv ptr: *mut i64 = &value;
        // Dereference and read
        pv v = *ptr;
        print("value via *mut ptr = ");
        print(v);
        print("\n");
    }

    // *const T pointer
    unsafe {
        pv cptr: *const i64 = &value;
        pv cv = *cptr;
        print("value via *const ptr = ");
        print(cv);
        print("\n");
    }

    // Raw pointer to array element
    pv arr = [10, 20, 30];
    unsafe {
        pv aptr: *mut i64 = &arr[0];
        pv av = *aptr;
        print("arr[0] via ptr = ");
        print(av);
        print("\n");
    }

    print("OK\n");
}
