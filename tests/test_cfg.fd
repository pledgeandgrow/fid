// Test: Conditional compilation — @cfg annotation (Phase 7.7)
//
// @cfg(platform = "linux") includes the item only on Linux.
// @cfg(platform = "windows") includes the item only on Windows.
// @cfg(platform = "macos") includes the item only on macOS.

@cfg(platform = "linux")
pf platform_name() -> i64 {
    ret 1;
}

@cfg(platform = "windows")
pf platform_name() -> i64 {
    ret 2;
}

@cfg(platform = "macos")
pf platform_name() -> i64 {
    ret 3;
}

// Always included — no @cfg annotation
pf always_here() -> i64 {
    ret 42;
}

pf main() {
    // always_here should always be available
    pv val = always_here();
    print("always = ");
    print(val);
    print("\n");

    // platform_name() is defined only for the current platform
    // On Linux: returns 1, On Windows: returns 2, On macOS: returns 3
    pv platform = platform_name();
    print("platform = ");
    print(platform);
    print("\n");

    print("OK\n");
}
