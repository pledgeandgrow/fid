// Test: @crashfree annotation — expected FAIL (uses unwrap)
// This function calls unwrap() which can panic on None/Err.
// The compiler should reject it at compile time.

@crashfree
pf unsafe_func(maybe_val: Option) -> i64 {
    // BUG: unwrap() panics on None — @crashfree functions can't use it
    pv v = maybe_val.unwrap();
    ret v + 1;
}

pf main() {
    pv r = unsafe_func(Option::Some(42));
    print(r);
}
