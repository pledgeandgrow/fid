// Test: F10 given/ensure contracts — Design by Contract
//
// `given` declares preconditions (must be true on entry).
// The typechecker verifies preconditions at call sites with known constant args.

pf sqrt_approx(x: i64) -> i64
    given x >= 0
{
    if x == 0 { ret 0; }
    pv r = x;
    for _ in 0..10 {
        r = (r + x / r) / 2;
    }
    ret r;
}

pf clamp(value: i64, lo: i64, hi: i64) -> i64
    given lo <= hi
{
    if value < lo { ret lo; }
    if value > hi { ret hi; }
    ret value;
}

pf safe_divide(a: i64, b: i64) -> i64
    given b != 0
{
    ret a / b;
}

pf main() {
    // OK: 16 >= 0
    pv s = sqrt_approx(16);
    print("sqrt(16) = ");
    print(s);
    print("\n");

    // OK: 0 >= 0
    pv s0 = sqrt_approx(0);
    print("sqrt(0) = ");
    print(s0);
    print("\n");

    // OK: 10 <= 20
    pv c = clamp(15, 10, 20);
    print("clamp(15, 10, 20) = ");
    print(c);
    print("\n");

    // OK: 5 != 0
    pv d = safe_divide(100, 5);
    print("100 / 5 = ");
    print(d);
    print("\n");

    // OK: variable argument — can't check at compile time, no error
    pv x = 25;
    pv s2 = sqrt_approx(x);
    print("sqrt(25) = ");
    print(s2);
    print("\n");

    print("OK\n");
}
