// Test impl methods on structs

struct Point {
    x: i32,
    y: i32,
}

impl Point {
    fn new(x: i32, y: i32) -> Point {
        Point { x: x, y: y }
    }

    fn distance_from_origin(self: Point) -> i32 {
        // Simplified: just return x + y (not real distance)
        return self.x + self.y;
    }

    fn translate(self: Point, dx: i32, dy: i32) -> Point {
        return Point { x: self.x + dx, y: self.y + dy };
    }
}

fn main() -> i32 {
    val p = Point::new(3, 4);
    val d = p.distance_from_origin();
    print(d);

    val p2 = p.translate(10, 20);
    print(p2.x);
    print(p2.y);

    return 0;
}
