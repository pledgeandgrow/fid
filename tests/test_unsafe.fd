// Test: unsafe { } blocks (Phase 10A)
// Unsafe blocks permit operations that would otherwise be rejected by the
// safety type system. Currently transparent (no raw pointers yet), but the
// block parses and executes correctly.

fn main() {
    val x = 10;
    val y = 0;

    // unsafe block — currently transparent, just runs the body
    unsafe {
        val z = x + 20;
        y = z;
    }

    print(y);
    print("\n");

    // unsafe block with just arithmetic
    unsafe {
        val w = x * 2;
        print(w);
        print("\n");
    }
}
