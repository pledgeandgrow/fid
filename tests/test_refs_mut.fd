// Test mutable references
fn increment(x: &mut i64) {
    *x = *x + 1;
}

fn add_to(x: &mut i64, n: i64) {
    *x += n;
}

fn main() -> i64 {
    var v = 10;
    increment(&mut v);
    print(v);

    add_to(&mut v, 5);
    print(v);

    var w = 100;
    val r = &mut w;
    *r = 42;
    print(w);

    return 0;
}
