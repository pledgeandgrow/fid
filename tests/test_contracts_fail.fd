// Test: F10 given/ensure contracts — precondition violation (expected fail)
//
// This test violates the `given x >= 0` precondition with a constant argument.

pf sqrt_approx(x: i64) -> i64
    given x >= 0
{
    if x == 0 { ret 0; }
    pv r = x;
    for _ in 0..10 {
        r = (r + x / r) / 2;
    }
    ret r;
}

pf safe_divide(a: i64, b: i64) -> i64
    given b != 0
{
    ret a / b;
}

pf main() {
    // BAD: -1 >= 0 is false — compile error
    pv bad = sqrt_approx(-1);
    print(bad);

    // BAD: 0 != 0 is false — compile error
    pv bad2 = safe_divide(100, 0);
    print(bad2);
}
