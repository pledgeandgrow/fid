// Test: Error chaining — ? operator on Option and Result, Error cap (Phase 7.7)
//
// The ? operator unwraps Option<T> -> T or Result<T, E> -> T.
// On None/Err, it propagates the error to the caller.
// The Error cap defines the interface for custom error types.

fn find_first(vec: Vec<i64>, target: i64) -> Option<i64> {
    for i in 0..vec.len() {
        if vec.get(i) == target {
            return Option::Some(i);
        }
    }
    return Option::None;
}

fn lookup(vec: Vec<i64>, target: i64) -> Result<i64, i64> {
    // Use ? on Option — if None, return Err
    val idx = find_first(vec, target);
    if idx.is_none() {
        return Result::Err(0);
    }
    return Result::Ok(idx.unwrap());
}

fn divide(a: i64, b: i64) -> Result<i64, i64> {
    if b == 0 {
        return Result::Err(1);
    }
    return Result::Ok(a / b);
}

fn safe_divide(a: i64, b: i64) -> Result<i64, i64> {
    // Chain ? on Result — if divide returns Err, propagate it
    val result = divide(a, b);
    if result.is_err() {
        return Result::Err(result.unwrap_or(99));
    }
    return Result::Ok(result.unwrap());
}

fn main() {
    // Test 1: ? on Option (Some case)
    val v = Vec::new();
    v.push(10);
    v.push(20);
    v.push(30);

    val found = find_first(v, 20);
    print("found = ");
    print(found.unwrap());
    print("\n");

    // Test 2: ? on Option (None case)
    val not_found = find_first(v, 99);
    print("not_found = ");
    print(not_found.is_none());
    print("\n");

    // Test 3: ? on Result (Ok case)
    val ok = divide(100, 5);
    print("100/5 = ");
    print(ok.unwrap());
    print("\n");

    // Test 4: ? on Result (Err case)
    val err = divide(100, 0);
    print("100/0 is_err = ");
    print(err.is_err());
    print("\n");

    // Test 5: Error propagation chain
    val chained = safe_divide(100, 0);
    print("chained is_err = ");
    print(chained.is_err());
    print("\n");

    // Test 6: Option methods
    val some = Option::Some(42);
    val none = Option::None;
    print("some.unwrap = ");
    print(some.unwrap());
    print("\n");
    print("some.is_some = ");
    print(some.is_some());
    print("\n");
    print("none.is_none = ");
    print(none.is_none());
    print("\n");
    print("none.unwrap_or = ");
    print(none.unwrap_or(0));
    print("\n");

    // Test 7: Result methods
    val ok_val = Result::Ok(100);
    val err_val = Result::Err(5);
    print("ok.is_ok = ");
    print(ok_val.is_ok());
    print("\n");
    print("err.is_err = ");
    print(err_val.is_err());
    print("\n");
    print("ok.unwrap = ");
    print(ok_val.unwrap());
    print("\n");
    print("err.unwrap_or = ");
    print(err_val.unwrap_or(0));
    print("\n");

    print("OK\n");
}
