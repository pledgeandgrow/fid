struct Lexer {
    source: str,
    pos: i64,
    source_len: i64,
}

impl Lexer {
    fn new(source: str) -> Lexer {
        return Lexer { source: source, pos: 0, source_len: str_len(source) };
    }

    fn peek(self: &Lexer) -> i64 {
        if self.pos >= self.source_len {
            return 0;
        }
        return str_byte_at(self.source, self.pos);
    }

    fn advance(self: &mut Lexer) -> i64 {
        var c: i64 = self.peek();
        self.pos = self.pos + 1;
        return c;
    }

    fn tokenize(self: &mut Lexer) -> Vec<i64> {
        var tokens: Vec<i64> = Vec::new();
        while self.pos < self.source_len {
            var c: i64 = self.peek();
            tokens.push(c);
            self.pos = self.pos + 1;
        }
        return tokens;
    }
}

fn main() {
    var lex = Lexer::new("hello");
    var tokens = lex.tokenize();
    println(tokens.len());
}
