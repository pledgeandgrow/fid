// Roadmap P6: when main ends, rank 0 waits for the other ranks, and the run
// fails when one of them did. Rank 1 finishes the collective, then ends
// with status 3; rank 0 prints the sum, then must report rank 1 on stderr
// ("tp: rank 1 exited with status 3") and exit with 1, not 0
// (tests/tp/check.sh). Also uses the shard.fd wrappers tp_init,
// tp_rank and tp_world_size.
use tensor;
use shard;

fn vec1(a: i64) -> Vec<i64> {
    val v = Vec::new();
    v.push(a);
    return v;
}

fn main() -> i64 {
    val rank = tp_init(2);
    val s = all_reduce(filled(vec1(2), 1.0 + tp_rank() as f64));
    if rank == 1 {
        return 3;
    }
    print("world " + int_to_str(tp_world_size()) + " sum " + float_to_str(sum(s)) + "\n");
    return 0;
}
