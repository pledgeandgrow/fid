// Roadmap P6: a rank that fails must not leave the others waiting.
// Rank 1 panics before the all-reduce; rank 0 must stop with an error
// naming rank 1 (tests/tp/check.sh: non-zero exit, no hang).
use tensor;
use shard;

fn vec1(a: i64) -> Vec<i64> {
    val v = Vec::new();
    v.push(a);
    return v;
}

fn main() {
    val rank = p_tp_init(2) as i64;
    if rank == 1 {
        panic("rank 1 gives up");
    }
    val s = all_reduce(filled(vec1(2), 1.0));
    print("not reached " + to_str(s) + "\n");
    return 0;
}
