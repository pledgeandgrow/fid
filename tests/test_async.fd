// Test: async/await — basic cooperative concurrency (Phase 7.6)
//
// async pf declares an async function that returns Future<T>.
// await <expr> suspends until the Future is ready, then returns T.
// spawn <expr> creates a concurrent task, returns Future<T>.

async pf compute_value(x: i64) -> Future<i64> {
    ret x * 2;
}

async pf add_one(x: i64) -> Future<i64> {
    ret x + 1;
}

pf main() {
    // Await a future directly
    pv future = compute_value(21);
    pv result = await future;
    print("result = ");
    print(result);
    print("\n");

    // Spawn a concurrent task
    pv task1 = spawn compute_value(50);
    pv task2 = spawn add_one(99);

    // Await both tasks
    pv r1 = await task1;
    pv r2 = await task2;

    print("task1 = ");
    print(r1);
    print("\n");
    print("task2 = ");
    print(r2);
    print("\n");

    // Chained async calls
    pv chained = await add_one(await compute_value(10));
    print("chained = ");
    print(chained);
    print("\n");

    print("OK\n");
}
