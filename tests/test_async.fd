// Test: async/await — basic cooperative concurrency (Phase 7.6)
//
// async fn declares an async function that returns Future<T>.
// await <expr> suspends until the Future is ready, then returns T.
// spawn <expr> creates a concurrent task, returns Future<T>.

async fn compute_value(x: i64) -> Future<i64> {
    return x * 2;
}

async fn add_one(x: i64) -> Future<i64> {
    return x + 1;
}

fn main() {
    // Await a future directly
    val future = compute_value(21);
    val result = await future;
    print("result = ");
    print(result);
    print("\n");

    // Spawn a concurrent task
    val task1 = spawn compute_value(50);
    val task2 = spawn add_one(99);

    // Await both tasks
    val r1 = await task1;
    val r2 = await task2;

    print("task1 = ");
    print(r1);
    print("\n");
    print("task2 = ");
    print(r2);
    print("\n");

    // Chained async calls
    val chained = await add_one(await compute_value(10));
    print("chained = ");
    print(chained);
    print("\n");

    print("OK\n");
}
