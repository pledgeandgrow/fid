use core;
use vec;
use string;

struct Pair {
    a: i64,
    b: i64,
    c: i64,
}

fn make_pair() -> Pair {
    return Pair { a: 1, b: 2, c: 3 };
}

fn main() -> i64 {
    var p: Pair = make_pair();
    print("a = "); print(int_to_str(p.a)); print(" (expected 1)\n");
    print("b = "); print(int_to_str(p.b)); print(" (expected 2)\n");
    print("c = "); print(int_to_str(p.c)); print(" (expected 3)\n");
    return 0;
}
