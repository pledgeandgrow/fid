use core;
use vec;
use string;
use compiler::ir;
use compiler::pe_ir_enc;
use compiler::pe_ir_stubs;
use compiler::pe_ir;
fn main() -> i64 {
    var frame: PeStackFrame = PeStackFrame_new();
    var o0: i64 = PeStackFrame_alloc(&mut frame, 0, 8);
    var o5: i64 = PeStackFrame_alloc(&mut frame, 5, 8);
    var o2: i64 = PeStackFrame_alloc(&mut frame, 2, 8);
    var o7: i64 = PeStackFrame_alloc(&mut frame, 7, 8);
    println("alloc o0=" + int_to_str(o0) + " o5=" + int_to_str(o5) + " o2=" + int_to_str(o2) + " o7=" + int_to_str(o7));
    println("get 0=" + int_to_str(PeStackFrame_offset(&frame, 0)));
    println("get 2=" + int_to_str(PeStackFrame_offset(&frame, 2)));
    println("get 5=" + int_to_str(PeStackFrame_offset(&frame, 5)));
    println("get 7=" + int_to_str(PeStackFrame_offset(&frame, 7)));
    println("get 1(absent)=" + int_to_str(PeStackFrame_offset(&frame, 1)));
    println("get 99(oob)=" + int_to_str(PeStackFrame_offset(&frame, 99)));
    // now many allocs like a real function: 0..150 in order
    var f2: PeStackFrame = PeStackFrame_new();
    var i: i64 = 0;
    while i < 150 {
        PeStackFrame_alloc(&mut f2, i, 8);
        i = i + 1;
    }
    println("f2 size=" + int_to_str(f2.size) + " offsets.len=" + int_to_str(f2.offsets.len()));
    println("f2 get 0=" + int_to_str(PeStackFrame_offset(&f2, 0)));
    println("f2 get 42=" + int_to_str(PeStackFrame_offset(&f2, 42)));
    println("f2 get 149=" + int_to_str(PeStackFrame_offset(&f2, 149)));
    return 0;
}
