// test_sl_debug.fd — Self-hosted parser/lexer debug test
// Uses correct APIs: p_argc/p_argv(index), Lexer::new + tokenize, Parser::new + parse

use core;
use vec;
use string;
use compiler::token;
use compiler::ast;
use compiler::diag;
use compiler::lexer;
use compiler::parser;

fn main() -> i64 {
    var argc: i64 = p_argc();
    if argc < 2 {
        print("usage: test_sl_debug <file.fd>\n");
        return 1;
    }
    var path_ptr: i64 = p_argv(1);
    var path: str = p_char_to_str(path_ptr);
    var source: str = p_read_file(path);
    if str_len(source) == 0 {
        print("error: could not read file or empty file: ");
        print(path);
        print("\n");
        return 1;
    }
    var lexer: Lexer = Lexer::new(source);
    var tokens: Vec<Token> = lexer.tokenize();
    print("tokens: ");
    print(int_to_str(tokens.len()));
    print("\n");

    var parser: Parser = Parser::new(tokens);
    match parser.parse() {
        ParseResultProgram::Ok(program) => {
            print("OK funcs: ");
            print(int_to_str(program.funcs.len()));
            print("\n");
        }
        ParseResultProgram::Err(e) => {
            print("ERR\n");
            print("Parse error: ");
            print(e);
            print("\n");
            return 1;
        }
    }
    return 0;
}
