use core;
use vec;
use string;
use compiler::token;
use compiler::ast;
use compiler::diag;
use compiler::lexer;
use compiler::parser;

fn main() -> i64 {
    var args: Vec<str> = p_argv();
    if args.len() < 2 {
        print("usage: test_parser_harness <file.fd>\n");
        return 1;
    }
    var path: str = args.get(1);
    var source: str = p_read_file(path);
    if str_len(source) == 0 {
        print("error: could not read file or empty file: ");
        print(path);
        print("\n");
        return 1;
    }
    var lexer: Lexer = Lexer::new(source);
    var tokens: Vec<Token> = lexer.lex_all();
    var parser: Parser = Parser::new(tokens);
    match parser.parse() {
        ParseResultProgram::Ok(program) => {
            print("OK\n");
            print(program_flat(program));
            print("\n");
        }
        ParseResultProgram::Err(e) => {
            print("ERR\n");
            print("Parse error: ");
            print(e);
            print("\n");
            return 1;
        }
    }
    return 0;
}
