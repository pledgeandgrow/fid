use core;
use vec;
use string;
use fs;
use compiler::ir;
use compiler::pe_ir_enc;
use compiler::pe_ir_stubs;
use compiler::pe_ir;
fn main() -> i64 {
    var m: IrModule = IrModule_new();
    // main(env: *u8) -> i64  — mirrors lowered hello.fd main
    var f: IrFunction = IrFunction_new("main", IrType::I64);
    var b: i64 = IrFunction_new_block(&mut f);
    f.entry = b;
    // env param %0
    var envp: i64 = IrFunction_new_value(&mut f, ValueMeta_new(IrType::Ptr(IrType::U8)));
    f.params.push(ValueIdType_new(envp, IrType::Ptr(IrType::U8)));

    var s1: i64 = IrFunction_emit(&mut f, Inst::ConstStr("Hello, Fides!"));
    IrFunction_emit(&mut f, Inst::Print(s1, IrType::Ptr(IrType::U8)));
    var k42: i64 = IrFunction_emit(&mut f, Inst::ConstInt(42, IrType::I64));
    var a1: i64 = IrFunction_emit(&mut f, Inst::Alloca(IrType::I64, Region::Stack));
    IrFunction_emit(&mut f, Inst::Store(a1, k42, OptIrType::None));
    var x: i64 = IrFunction_emit(&mut f, Inst::Load(a1, IrType::I64));
    var k8: i64 = IrFunction_emit(&mut f, Inst::ConstInt(8, IrType::I64));
    var y: i64 = IrFunction_emit(&mut f, Inst::BinOp(BinOp::Add, x, k8, IrType::I64));
    var a2: i64 = IrFunction_emit(&mut f, Inst::Alloca(IrType::I64, Region::Stack));
    IrFunction_emit(&mut f, Inst::Store(a2, y, OptIrType::None));
    var yv: i64 = IrFunction_emit(&mut f, Inst::Load(a2, IrType::I64));
    IrFunction_emit(&mut f, Inst::Print(yv, IrType::I64));
    var yv2: i64 = IrFunction_emit(&mut f, Inst::Load(a2, IrType::I64));
    var k40: i64 = IrFunction_emit(&mut f, Inst::ConstInt(40, IrType::I64));
    var cond: i64 = IrFunction_emit(&mut f, Inst::BinOp(BinOp::Gt, yv2, k40, IrType::Bool));
    var bb1: i64 = IrFunction_new_block(&mut f);
    var bb2: i64 = IrFunction_new_block(&mut f);
    var bb3: i64 = IrFunction_new_block(&mut f);
    IrFunction_emit(&mut f, Inst::Branch(cond, bb1, bb2));
    // bb1: print "y is big"; jump bb3  (block idx == id, dense)
    f.current_block_idx = bb1;
    var sb: i64 = IrFunction_emit(&mut f, Inst::ConstStr("y is big"));
    IrFunction_emit(&mut f, Inst::Print(sb, IrType::Ptr(IrType::U8)));
    IrFunction_emit(&mut f, Inst::Jump(bb3));
    // bb2: print "y is small"; jump bb3
    f.current_block_idx = bb2;
    var ss: i64 = IrFunction_emit(&mut f, Inst::ConstStr("y is small"));
    IrFunction_emit(&mut f, Inst::Print(ss, IrType::Ptr(IrType::U8)));
    IrFunction_emit(&mut f, Inst::Jump(bb3));
    // bb3: return y
    f.current_block_idx = bb3;
    IrFunction_emit(&mut f, Inst::Return(OptValueId::Some(y)));
    m.functions.push(IrFunctionEntry_new("main", f));
    var r: ResultBytes = pe_ir_generate_pe(m);
    match r {
        ResultBytes::Err(errs) => {
            var i: i64 = 0;
            while i < errs.len() { println("err: " + errs.get(i)); i = i + 1; }
            return 1;
        }
        ResultBytes::Ok(bytes) => {
            if !fs_write_bytes("t_pe_ir\\probe3.exe", bytes) { println("write fail"); return 1; }
            println("wrote " + int_to_str(bytes.len()));
            return 0;
        }
    }
    return 0;
}
