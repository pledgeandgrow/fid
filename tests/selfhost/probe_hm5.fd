use core;
fn main() -> i64 {
    var m: i64 = HashMap_new();
    var i: i64 = 0;
    while i < 2400 {
        var key: str = "fn" + int_to_str(i / 5) + ":" + int_to_str(i % 5);
        HashMap_insert(m, key, i * 10 + 7);
        i = i + 1;
    }
    var bad: i64 = 0;
    i = 0;
    while i < 2400 {
        var key2: str = "fn" + int_to_str(i / 5) + ":" + int_to_str(i % 5);
        var v: i64 = HashMap_get(m, key2);
        if v != i * 10 + 7 { bad = bad + 1; }
        i = i + 1;
    }
    println(bad);
    return 0;
}
