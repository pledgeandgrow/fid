use core;
use vec;
use compiler::ast;

fn main() -> i64 {
    var v: Vec<FieldInit> = Vec::new();
    v.push(FieldInit_new("x", Expr::IntLit(42)));
    print("len=");
    print(int_to_str(v.len()));
    print("\n");
    var fi: FieldInit = v.get(0);
    print("name=");
    print(fi.name);
    print("\n");
    return 0;
}
