use core;
use vec;
use string;
use fs;
use compiler::ir;
use compiler::pe_ir_enc;
use compiler::pe_ir_stubs;
use compiler::pe_ir;
fn main() -> i64 {
    var m: IrModule = IrModule_new();
    var f: IrFunction = IrFunction_new("main", IrType::I64);
    var b: i64 = IrFunction_new_block(&mut f);
    f.entry = b;
    // env param %0
    var envp: i64 = IrFunction_new_value(&mut f, ValueMeta_new(IrType::Ptr(IrType::U8)));
    f.params.push(ValueIdType_new(envp, IrType::Ptr(IrType::U8)));
    // ~160 distinct values, each = previous + 1
    var prev: i64 = IrFunction_emit(&mut f, Inst::ConstInt(1, IrType::I64));
    var one: i64 = IrFunction_emit(&mut f, Inst::ConstInt(1, IrType::I64));
    var i: i64 = 0;
    while i < 160 {
        prev = IrFunction_emit(&mut f, Inst::BinOp(BinOp::Add, prev, one, IrType::I64));
        i = i + 1;
    }
    IrFunction_emit(&mut f, Inst::Print(prev, IrType::I64));
    IrFunction_emit(&mut f, Inst::Return(OptValueId::Some(prev)));
    m.functions.push(IrFunctionEntry_new("main", f));
    var r: ResultBytes = pe_ir_generate_pe(m);
    match r {
        ResultBytes::Err(errs) => {
            var j: i64 = 0;
            while j < errs.len() { println("err: " + errs.get(j)); j = j + 1; }
            return 1;
        }
        ResultBytes::Ok(bytes) => {
            if !fs_write_bytes("t_pe_ir\\probe5.exe", bytes) { println("write fail"); return 1; }
            println("wrote " + int_to_str(bytes.len()));
            return 0;
        }
    }
    return 1;
}
