// test_annotations.fd — probe: can we drive the self-hosted TypeChecker?
use core;
use vec;
use string;
use compiler::lexer;
use compiler::token;
use compiler::ast;
use compiler::parser;
use compiler::typechecker;

fn main() -> i64 {
    var source: str = "@gas(3)\nfn too_expensive(a: i64, b: i64, c: i64) -> i64 {\n    val x = a + b;\n    val y = x + c;\n    val z = y * 2;\n    return z + 1;\n}\nfn main() { val r = too_expensive(1, 2, 3); print(r); }\n";
    var lex: Lexer = Lexer::new(source);
    var tokens: Vec<Token> = lex.tokenize();
    var p: Parser = Parser::new(tokens);
    match p.parse() {
        ParseResultProgram::Ok(program) => {
            var tc: TypeChecker = TypeChecker::new();
            TypeChecker_register_program(&mut tc, program, "main");
            TypeChecker_check_bodies(&mut tc, program);
            print("errors: ");
            print(int_to_str(tc.errors.len()));
            print("\n");
            var i: i64 = 0;
            while i < tc.errors.len() {
                print(tc.errors.get(i));
                print("\n");
                i = i + 1;
            }
        }
        ParseResultProgram::Err(e) => {
            print("Parse error: ");
            print(e);
            print("\n");
            return 1;
        }
    }
    return 0;
}
