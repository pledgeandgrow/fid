// Minimal probe: struct literal with enum constructor as field value, in push()
use core;
use vec;

enum E {
    A(i64),
    B(str),
}

struct S {
    name: str,
    val: E,
}

fn main() -> i64 {
    var v = Vec::new();

    // Case 1: struct literal with enum constructor, direct push
    v.push(S { name: "x", val: E::A(1) });

    // Case 2: assign to var first, then push
    val s = S { name: "y", val: E::B("hi") };
    v.push(s);

    print(int_to_str(v.len()));
    return 0;
}
