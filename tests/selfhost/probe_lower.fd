use core;
use compiler::compiler;
use compiler::ir;
use compiler::interp;

fn main() -> i64 {
    var src = "fn main() -> i64 { return 42; }\n";
    match lower_to_ir_module_with_path(src, "t.fd", "off") {
        ResultIrModule::Ok(m) => {
            print("lowered\n");
            var it: Interpreter = Interpreter_new(m);
            match Interpreter_run(&mut it) {
                RunResult::Return(v) => { print("ran\n"); return 0; }
                _ => { print("bad\n"); return 1; }
            }
        }
        ResultIrModule::Err(e) => { print("err\n"); return 1; }
    }
    return 1;
}
