use core;
use compiler::ir;
use compiler::lower;

fn main() -> i64 {
    var l: Lowerer = Lowerer_new();
    Lowerer_add_extern_1(&mut l, "test_func", IrType::I64, IrType::Void);
    print("externs after add: ");
    print(int_to_str(l.module.extern_functions.len()));
    print("\n");
    return 0;
}
