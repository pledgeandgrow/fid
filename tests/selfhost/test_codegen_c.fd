// tests/compiler/test_codegen_c.fd
// Basic self-host test for the Fides C code generator.

use core;
use vec;
use string;
use compiler::ir;
use compiler::codegen_c;

fn assert_true(value: bool, label: str) -> void {
    if !value {
        print("FAIL: ");
        print(label);
        print("\n");
        p_panic("test failed");
    }
}

fn test_codegen_c_basic() -> void {
    var module: IrModule = IrModule_new();
    var gen: CCodeGen = CCodeGen_new();
    var c: str = CCodeGen_generate(&mut gen, module);
    assert_true(str_len(c) > 0, "C output is non-empty");
    print("codegen_c basic OK\n");
}

fn main() -> void {
    test_codegen_c_basic();
}
