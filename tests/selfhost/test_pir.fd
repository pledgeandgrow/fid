// ── Test 19: L1 fmt_inst ──
fn test_l1_fmt_inst() -> void {
    print("Test 19: L1 fmt_inst...\n");
    var ci: L1Inst = L1Inst::ConstInt(42, IrType::I64);
    var s1: str = fmt_l1_inst(ci);
    assert_true(str_contains(s1, "42"), "ConstInt fmt has value");
    assert_true(str_contains(s1, "i64"), "ConstInt fmt has type");

    var cs: L1Inst = L1Inst::ConstStr("hello");
    var s2: str = fmt_l1_inst(cs);
    assert_true(str_contains(s2, "hello"), "ConstStr fmt has value");

    var jmp: L1Inst = L1Inst::Jump(1);
    var s3: str = fmt_l1_inst(jmp);
    assert_true(str_contains(s3, "jmp"), "Jump fmt has jmp");

    var ret: L1Inst = L1Inst::Return(OptValueId::None);
    var s4: str = fmt_l1_inst(ret);
    assert_true(str_contains(s4, "ret"), "Return fmt has ret");
}

// ── Test 20: L2 fmt_inst ──
fn test_l2_fmt_inst() -> void {
    print("Test 20: L2 fmt_inst...\n");
    var ci: L2Inst = L2Inst::ConstInt(10, IrType::I32);
    var s1: str = fmt_l2_inst(ci);
    assert_true(str_contains(s1, "10"), "L2 ConstInt fmt has value");

    var alloca: L2Inst = L2Inst::Alloca(IrType::I64, MemRegion::Stack);
    var s2: str = fmt_l2_inst(alloca);
    assert_true(str_contains(s2, "alloca"), "L2 Alloca fmt has alloca");
    assert_true(str_contains(s2, "stack"), "L2 Alloca fmt has stack");

    var call: L2Inst = L2Inst::Call("foo", Vec::new(), IrType::I64);
    var s3: str = fmt_l2_inst(call);
    assert_true(str_contains(s3, "call"), "L2 Call fmt has call");
    assert_true(str_contains(s3, "foo"), "L2 Call fmt has function name");
}

// ── Test 21: L3 fmt_inst ──
fn test_l3_fmt_inst() -> void {
    print("Test 21: L3 fmt_inst...\n");
    var mov: L3Inst = L3Inst::Mov(VReg_new(0), Operand::ImmI(42));
    var s1: str = fmt_l3_inst(mov);
    assert_true(str_contains(s1, "v0"), "L3 Mov fmt has v0");
    assert_true(str_contains(s1, "#42"), "L3 Mov fmt has #42");

    var bin: L3Inst = L3Inst::Bin(BinOp::Add, VReg_new(0), Operand::VReg(VReg_new(1)), Operand::VReg(VReg_new(2)), IrType::I64);
    var s2: str = fmt_l3_inst(bin);
    assert_true(str_contains(s2, "Add"), "L3 Bin fmt has Add");
    assert_true(str_contains(s2, "v0"), "L3 Bin fmt has v0");
    assert_true(str_contains(s2, "v1"), "L3 Bin fmt has v1");
    assert_true(str_contains(s2, "v2"), "L3 Bin fmt has v2");

    var ret: L3Inst = L3Inst::Ret(OptOperand::None);
    var s3: str = fmt_l3_inst(ret);
    assert_true(str_contains(s3, "ret"), "L3 Ret fmt has ret");
}

// ── Test 22: Lowering with BinOp ──
fn test_lower_binop() -> void {
    print("Test 22: Lowering with BinOp...\n");

    var module: IrModule = IrModule_new();
    var f: IrFunction = IrFunction_new("add_fn", IrType::I64);
    IrFunction_new_block(&mut f);

    var v1: i64 = IrFunction_emit(&mut f, Inst::ConstInt(10, IrType::I64));
    var v2: i64 = IrFunction_emit(&mut f, Inst::ConstInt(20, IrType::I64));
    var v3: i64 = IrFunction_emit(&mut f, Inst::BinOp(BinOp::Add, v1, v2, IrType::I64));
    IrFunction_emit(&mut f, Inst::Return(OptValueId::Some(v3)));
    IrModule_add_function(&mut module, f);

    var all: PirAllLevels = build_all(&module);

    // L1 should have BinOp
    var l1_f: L1Function = all.l1.functions.get(0);
    var has_binop: bool = false;
    var i: i64 = 0;
    while i < l1_f.values.len() {
        match l1_f.values.get(i).entry.inst {
            L1Inst::BinOp(_, _, _, _) => { has_binop = true; }
            _ => {}
        }
        i = i + 1;
    }
    assert_true(has_binop, "L1 has BinOp instruction");

    // L3 should have Bin instruction
    var l3_f: L3Function = all.l3.functions.get(0);
    var has_bin: bool = false;
    var j: i64 = 0;
    while j < l3_f.blocks.len() {
        var k: i64 = 0;
        while k < l3_f.blocks.get(j).instructions.len() {
            match l3_f.blocks.get(j).instructions.get(k) {
                L3Inst::Bin(_, _, _, _, _) => { has_bin = true; }
                _ => {}
            }
            k = k + 1;
        }
        j = j + 1;
    }
    assert_true(has_bin, "L3 has Bin instruction");
}

// ── Test 23: Lowering with Branch ──
fn test_lower_branch() -> void {
    print("Test 23: Lowering with Branch...\n");

    var module: IrModule = IrModule_new();
    var f: IrFunction = IrFunction_new("br_fn", IrType::I64);
    // IrFunction_new already creates block 0
    var b0: i64 = 0;  // block 0 already exists
    var b1: i64 = IrFunction_new_block(&mut f);  // block 1
    var b2: i64 = IrFunction_new_block(&mut f);  // block 2

    var cond: i64 = IrFunction_emit(&mut f, Inst::ConstBool(true));
    IrFunction_emit(&mut f, Inst::Branch(cond, b1, b2));

    // block 1
    var v1: i64 = IrFunction_emit(&mut f, Inst::ConstInt(1, IrType::I64));
    IrFunction_emit(&mut f, Inst::Return(OptValueId::Some(v1)));

    // block 2
    var v2: i64 = IrFunction_emit(&mut f, Inst::ConstInt(2, IrType::I64));
    IrFunction_emit(&mut f, Inst::Return(OptValueId::Some(v2)));

    IrModule_add_function(&mut module, f);

    var all: PirAllLevels = build_all(&module);

    // L1 should have Branch
    var l1_f: L1Function = all.l1.functions.get(0);
    assert_eq_i64(l1_f.blocks.len(), 3, "L1 has 3 blocks");

    // L3 should have Br instruction
    var l3_f: L3Function = all.l3.functions.get(0);
    assert_eq_i64(l3_f.blocks.len(), 3, "L3 has 3 blocks");

    var has_br: bool = false;
    var i: i64 = 0;
    while i < l3_f.blocks.len() {
        var j: i64 = 0;
        while j < l3_f.blocks.get(i).instructions.len() {
            match l3_f.blocks.get(i).instructions.get(j) {
                L3Inst::Br(_, _, _) => { has_br = true; }
                _ => {}
            }
            j = j + 1;
        }
        i = i + 1;
    }
    assert_true(has_br, "L3 has Br instruction");
}

// ── Test 24: Lowering with Call ──
fn test_lower_call() -> void {
    print("Test 24: Lowering with Call...\n");

    var module: IrModule = IrModule_new();

    // Create a simple callee
    var callee: IrFunction = IrFunction_new("callee", IrType::I64);
    IrFunction_new_block(&mut callee);
    var v: i64 = IrFunction_emit(&mut callee, Inst::ConstInt(42, IrType::I64));
    IrFunction_emit(&mut callee, Inst::Return(OptValueId::Some(v)));
    IrModule_add_function(&mut module, callee);

    // Create caller that calls callee
    var caller: IrFunction = IrFunction_new("caller", IrType::I64);
    IrFunction_new_block(&mut caller);
    var args: Vec<i64> = Vec::new();
    var call_result: i64 = IrFunction_emit(&mut caller, Inst::Call("callee", args, IrType::I64, EffectSet_new()));
    IrFunction_emit(&mut caller, Inst::Return(OptValueId::Some(call_result)));
    IrModule_add_function(&mut module, caller);

    var all: PirAllLevels = build_all(&module);

    assert_eq_i64(all.l1.functions.len(), 2, "L1 has 2 functions");
    assert_eq_i64(all.l2.functions.len(), 2, "L2 has 2 functions");
    assert_eq_i64(all.l3.functions.len(), 2, "L3 has 2 functions");

    // Check L3 has a Call instruction in caller
    var l3_caller: L3Function = all.l3.functions.get(0);  // sorted: "callee" < "caller"
    // Find the caller function
    var found_caller: bool = false;
    var i: i64 = 0;
    while i < all.l3.functions.len() {
        if str_equal(all.l3.functions.get(i).name, "caller") {
            found_caller = true;
            var has_call: bool = false;
            var j: i64 = 0;
            while j < all.l3.functions.get(i).blocks.len() {
                var k: i64 = 0;
                while k < all.l3.functions.get(i).blocks.get(j).instructions.len() {
                    match all.l3.functions.get(i).blocks.get(j).instructions.get(k) {
                        L3Inst::Call(_, name, _, _) => {
                            assert_true(str_contains(name, "callee"), "L3 Call target is callee");
                            has_call = true;
                        }
                        _ => {}
                    }
                    k = k + 1;
                }
                j = j + 1;
            }
            assert_true(has_call, "L3 caller has Call instruction");
        }
        i = i + 1;
    }
    assert_true(found_caller, "found caller function in L3");
}

// ── Test 25: vec_sort_str and vec_sort_i64 ──
fn test_sort_helpers() -> void {
    print("Test 25: sort helpers...\n");
    // Note: these are private fns, but we can test indirectly via sorted output
    var module: IrModule = IrModule_new();

    // Add functions in non-sorted order
    var f3: IrFunction = IrFunction_new("zebra", IrType::Void);
    IrFunction_new_block(&mut f3);
    IrFunction_emit(&mut f3, Inst::Return(OptValueId::None));
    IrModule_add_function(&mut module, f3);

    var f1: IrFunction = IrFunction_new("alpha", IrType::Void);
    IrFunction_new_block(&mut f1);
    IrFunction_emit(&mut f1, Inst::Return(OptValueId::None));
    IrModule_add_function(&mut module, f1);

    var f2: IrFunction = IrFunction_new("middle", IrType::Void);
    IrFunction_new_block(&mut f2);
    IrFunction_emit(&mut f2, Inst::Return(OptValueId::None));
    IrModule_add_function(&mut module, f2);

    var l1: L1Module = lower_ir_to_l1(&module);
    // Functions should be sorted alphabetically
    assert_eq(l1.functions.get(0).name, "alpha", "first function is alpha");
    assert_eq(l1.functions.get(1).name, "middle", "second function is middle");
    assert_eq(l1.functions.get(2).name, "zebra", "third function is zebra");
}

// ── Test 26: str_join helper ──
fn test_str_join() -> void {
    print("Test 26: str_join...\n");
    var v: Vec<str> = Vec::new();
    assert_eq(str_join(v, ", "), "", "empty join");

    v.push("a");
    assert_eq(str_join(v, ", "), "a", "single element join");

    v.push("b");
    v.push("c");
    assert_eq(str_join(v, ", "), "a, b, c", "three elements join");
    assert_eq(str_join(v, ""), "abc", "three elements no separator");
}

// ── Test 27: escape_str helper ──
fn test_escape_str() -> void {
    print("Test 27: escape_str...\n");
    assert_eq(escape_str("hello"), "hello", "no special chars");
    assert_eq(escape_str("a\"b"), "a\\\"b", "escape double quote");
    assert_eq(escape_str("a\\b"), "a\\\\b", "escape backslash");
}

// ── Test 28: Lowering with Alloca ──
fn test_lower_alloca() -> void {
    print("Test 28: Lowering with Alloca...\n");

    var module: IrModule = IrModule_new();
    var f: IrFunction = IrFunction_new("alloca_fn", IrType::I64);
    IrFunction_new_block(&mut f);

    var ptr: i64 = IrFunction_emit(&mut f, Inst::Alloca(IrType::I64, Region::Stack));
    var val: i64 = IrFunction_emit(&mut f, Inst::ConstInt(42, IrType::I64));
    IrFunction_emit(&mut f, Inst::Store(ptr, val, OptIrType::Some(IrType::I64)));
    var loaded: i64 = IrFunction_emit(&mut f, Inst::Load(ptr, IrType::I64));
    IrFunction_emit(&mut f, Inst::Return(OptValueId::Some(loaded)));
    IrModule_add_function(&mut module, f);

    var all: PirAllLevels = build_all(&module);

    // L1 should have AllocaIn
    var l1_f: L1Function = all.l1.functions.get(0);
    var has_alloca_in: bool = false;
    var i: i64 = 0;
    while i < l1_f.values.len() {
        match l1_f.values.get(i).entry.inst {
            L1Inst::AllocaIn(_, _) => { has_alloca_in = true; }
            _ => {}
        }
        i = i + 1;
    }
    assert_true(has_alloca_in, "L1 has AllocaIn");

    // L2 should have Alloca
    var l2_f: L2Function = all.l2.functions.get(0);
    var has_alloca: bool = false;
    var j: i64 = 0;
    while j < l2_f.values.len() {
        match l2_f.values.get(j).inst {
            L2Inst::Alloca(_, _) => { has_alloca = true; }
            _ => {}
        }
        j = j + 1;
    }
    assert_true(has_alloca, "L2 has Alloca");

    // L3 should have AddrOfSlot or StackAlloc
    var l3_f: L3Function = all.l3.functions.get(0);
    assert_true(l3_f.frame_size > 0, "L3 has non-zero frame size");
    var has_addr: bool = false;
    var k: i64 = 0;
    while k < l3_f.blocks.len() {
        var m: i64 = 0;
        while m < l3_f.blocks.get(k).instructions.len() {
            match l3_f.blocks.get(k).instructions.get(m) {
                L3Inst::AddrOfSlot(_, _) => { has_addr = true; }
                L3Inst::StackAlloc(_, _, _) => { has_addr = true; }
                _ => {}
            }
            m = m + 1;
        }
        k = k + 1;
    }
    assert_true(has_addr, "L3 has AddrOfSlot or StackAlloc");
}

// ── Test 29: PirAllLevels ──
fn test_pir_all_levels() -> void {
    print("Test 29: PirAllLevels...\n");

    var module: IrModule = IrModule_new();
    var f: IrFunction = IrFunction_new("test_all", IrType::Void);
    IrFunction_new_block(&mut f);
    IrFunction_emit(&mut f, Inst::Return(OptValueId::None));
    IrModule_add_function(&mut module, f);

    var all: PirAllLevels = build_all(&module);
    assert_eq_i64(all.l1.functions.len(), 1, "PirAllLevels L1 has 1 function");
    assert_eq_i64(all.l2.functions.len(), 1, "PirAllLevels L2 has 1 function");
    assert_eq_i64(all.l3.functions.len(), 1, "PirAllLevels L3 has 1 function");
}

