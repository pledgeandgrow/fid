// SH-9: Test for compiler::pir module (rewritten from pir.rs)
// Tests L1/L2/L3 types, lowering IR→L1→L2→L3, printers, and helpers.
use core;
use vec;
use compiler::ir;
use compiler::pir;

fn assert_eq(actual: str, expected: str, label: str) -> void {
    if actual != expected {
        print("FAIL: ");
        print(label);
        print(" — expected '");
        print(expected);
        print("', got '");
        print(actual);
        print("'\n");
        p_panic("test failed");
    }
    print("  OK: ");
    print(label);
    print("\n");
}

fn assert_eq_i64(actual: i64, expected: i64, label: str) -> void {
    if actual != expected {
        print("FAIL: ");
        print(label);
        print(" — expected ");
        print(int_to_str(expected));
        print(", got ");
        print(int_to_str(actual));
        print("\n");
        p_panic("test failed");
    }
    print("  OK: ");
    print(label);
    print("\n");
}

fn assert_true(b: bool, label: str) -> void {
    if !b {
        print("FAIL: ");
        print(label);
        print(" — expected true\n");
        p_panic("test failed");
    }
    print("  OK: ");
    print(label);
    print("\n");
}

fn assert_false(b: bool, label: str) -> void {
    if b {
        print("FAIL: ");
        print(label);
        print(" — expected false\n");
        p_panic("test failed");
    }
    print("  OK: ");
    print(label);
    print("\n");
}

// ── Test 1: CapSet ──
fn test_capset() -> void {
    print("Test 1: CapSet...\n");
    var cs: CapSet = CapSet_new();
    assert_true(CapSet_is_empty(&cs), "empty CapSet");
    assert_eq(CapSet_to_str(&cs), "no_cap", "empty CapSet to_str");

    CapSet_add(&mut cs, "io");
    assert_false(CapSet_is_empty(&cs), "non-empty CapSet");
    assert_true(CapSet_contains(&cs, "io"), "contains io");
    assert_false(CapSet_contains(&cs, "net"), "does not contain net");

    CapSet_add(&mut cs, "io");  // duplicate — should not add
    assert_eq_i64(cs.caps.len(), 1, "no duplicate caps");

    CapSet_add(&mut cs, "net");
    assert_eq(CapSet_to_str(&cs), "cap[io,net]", "two caps to_str");
}

// ── Test 2: RegionRef helpers ──
fn test_region_ref() -> void {
    print("Test 2: RegionRef...\n");
    var r1: RegionRef = RegionRef::Builtin(Region::Stack);
    var r2: RegionRef = RegionRef::Builtin(Region::Stack);
    var r3: RegionRef = RegionRef::Builtin(Region::Heap);
    var r4: RegionRef = RegionRef::Handle(42);
    var r5: RegionRef = RegionRef::Unknown;

    assert_true(region_ref_eq(r1, r2), "Stack == Stack");
    assert_false(region_ref_eq(r1, r3), "Stack != Heap");
    assert_true(region_ref_eq(r4, RegionRef::Handle(42)), "Handle(42) == Handle(42)");
    assert_false(region_ref_eq(r4, RegionRef::Handle(1)), "Handle(42) != Handle(1)");
    assert_true(region_ref_eq(r5, RegionRef::Unknown), "Unknown == Unknown");
    assert_false(region_ref_eq(r5, r1), "Unknown != Stack");

    assert_eq(region_ref_to_str(RegionRef::Builtin(Region::Stack)), "stack", "stack to_str");
    assert_eq(region_ref_to_str(RegionRef::Handle(7)), "region(7)", "handle to_str");
    assert_eq(region_ref_to_str(RegionRef::Unknown), "region?", "unknown to_str");
}

// ── Test 3: MemRegion ──
fn test_mem_region() -> void {
    print("Test 3: MemRegion...\n");
    assert_eq(mem_region_to_str(MemRegion::Stack), "stack", "Stack to_str");
    assert_eq(mem_region_to_str(MemRegion::Heap), "heap", "Heap to_str");
    assert_eq(mem_region_to_str(MemRegion::Static), "static", "Static to_str");
    assert_eq(mem_region_to_str(MemRegion::Named("foo")), "region.foo", "Named to_str");

    assert_true(mem_region_eq(MemRegion::Stack, MemRegion::Stack), "Stack == Stack");
    assert_false(mem_region_eq(MemRegion::Stack, MemRegion::Heap), "Stack != Heap");
    assert_true(mem_region_eq(MemRegion::Named("a"), MemRegion::Named("a")), "Named(a) == Named(a)");
    assert_false(mem_region_eq(MemRegion::Named("a"), MemRegion::Named("b")), "Named(a) != Named(b)");
}

// ── Test 4: VReg and Slot ──
fn test_vreg_slot() -> void {
    print("Test 4: VReg and Slot...\n");
    var r1: VReg = VReg_new(0);
    var r2: VReg = VReg_new(1);
    assert_eq(vreg_to_str(r1), "v0", "vreg 0 to_str");
    assert_eq(vreg_to_str(r2), "v1", "vreg 1 to_str");
    assert_true(vreg_eq(r1, VReg_new(0)), "vreg eq 0");
    assert_false(vreg_eq(r1, r2), "vreg neq 0/1");

    var s1: Slot = Slot_new(16);
    var s2: Slot = Slot_new(32);
    assert_eq(slot_to_str(s1), "[fp-16]", "slot 16 to_str");
    assert_eq(slot_to_str(s2), "[fp-32]", "slot 32 to_str");
    assert_true(slot_eq(s1, Slot_new(16)), "slot eq 16");
    assert_false(slot_eq(s1, s2), "slot neq 16/32");
}

// ── Test 5: Operand ──
fn test_operand() -> void {
    print("Test 5: Operand...\n");
    assert_eq(operand_to_str(Operand::VReg(VReg_new(3))), "v3", "VReg operand");
    assert_eq(operand_to_str(Operand::Slot(Slot_new(8))), "[fp-8]", "Slot operand");
    assert_eq(operand_to_str(Operand::ImmI(42)), "#42", "ImmI operand");
    assert_eq(operand_to_str(Operand::ImmF(0)), "#f:0", "ImmF operand");
    assert_eq(operand_to_str(Operand::ImmStr("hello")), "\"hello\"", "ImmStr operand");
    assert_eq(operand_to_str(Operand::ImmFunc("foo")), "&foo", "ImmFunc operand");
    assert_eq(operand_to_str(Operand::ImmNull), "#null", "ImmNull operand");
}

// ── Test 6: CastKind ──
fn test_cast_kind() -> void {
    print("Test 6: CastKind...\n");
    assert_eq(cast_kind_to_str(CastKind::BitCast), "bitcast", "BitCast to_str");
    assert_eq(cast_kind_to_str(CastKind::IntExtend), "int_extend", "IntExtend to_str");
    assert_eq(cast_kind_to_str(CastKind::IntTrunc), "int_trunc", "IntTrunc to_str");
    assert_eq(cast_kind_to_str(CastKind::IntToFloat), "int_to_float", "IntToFloat to_str");
    assert_eq(cast_kind_to_str(CastKind::FloatToInt), "float_to_int", "FloatToInt to_str");
}

// ── Test 7: L1Inst kind names and terminator check ──
fn test_l1inst() -> void {
    print("Test 7: L1Inst...\n");
    var ci: L1Inst = L1Inst::ConstInt(42, IrType::I64);
    assert_eq(l1inst_kind_name(&ci), "ConstInt", "ConstInt kind");

    var jmp: L1Inst = L1Inst::Jump(1);
    assert_eq(l1inst_kind_name(&jmp), "Jump", "Jump kind");
    assert_true(l1inst_is_terminator(&jmp), "Jump is terminator");

    var br: L1Inst = L1Inst::Branch(0, 1, 2);
    assert_true(l1inst_is_terminator(&br), "Branch is terminator");

    var ret: L1Inst = L1Inst::Return(OptValueId::None);
    assert_true(l1inst_is_terminator(&ret), "Return is terminator");

    var unreach: L1Inst = L1Inst::Unreachable;
    assert_true(l1inst_is_terminator(&unreach), "Unreachable is terminator");

    var panic: L1Inst = L1Inst::Panic("oops");
    assert_true(l1inst_is_terminator(&panic), "Panic is terminator");

    var binop: L1Inst = L1Inst::BinOp(BinOp::Add, 0, 1, IrType::I64);
    assert_false(l1inst_is_terminator(&binop), "BinOp is not terminator");
    assert_eq(l1inst_kind_name(&binop), "BinOp", "BinOp kind");
}

// ── Test 8: L2Inst kind names and terminator check ──
fn test_l2inst() -> void {
    print("Test 8: L2Inst...\n");
    var ci: L2Inst = L2Inst::ConstInt(10, IrType::I32);
    assert_eq(l2inst_kind_name(&ci), "ConstInt", "L2 ConstInt kind");

    var jmp: L2Inst = L2Inst::Jump(0);
    assert_true(l2inst_is_terminator(&jmp), "L2 Jump is terminator");

    var ret: L2Inst = L2Inst::Return(0 - 1);
    assert_true(l2inst_is_terminator(&ret), "L2 Return is terminator");

    var load: L2Inst = L2Inst::Load(0, IrType::I64);
    assert_false(l2inst_is_terminator(&load), "L2 Load is not terminator");
    assert_eq(l2inst_kind_name(&load), "Load", "L2 Load kind");
}

// ── Test 9: L1Module/L1Function/L1Block construction ──
fn test_l1_construction() -> void {
    print("Test 9: L1 construction...\n");
    var m: L1Module = L1Module_new();
    assert_eq_i64(m.functions.len(), 0, "no functions initially");
    assert_eq_i64(m.struct_layouts.len(), 0, "no struct layouts initially");

    var f: L1Function = L1Function_new("foo", IrType::I64);
    assert_eq(f.name, "foo", "function name");
    assert_eq_i64(f.blocks.len(), 0, "no blocks initially");
    assert_eq_i64(f.values.len(), 0, "no values initially");
    assert_false(f.is_wrapping, "not wrapping by default");
    assert_false(f.is_deterministic, "not deterministic by default");

    var b: L1Block = L1Block_new(0);
    assert_eq_i64(b.id, 0, "block id 0");
    assert_eq_i64(b.instructions.len(), 0, "no instructions initially");

    // Test set/get value
    var entry: L1ValueEntry = L1ValueEntry_new(L1Inst::ConstInt(5, IrType::I64), RegionRef::Builtin(Region::Stack), EffectSet_new(), OptU64::None);
    L1Function_set_value(&mut f, 0, entry);
    assert_eq_i64(f.values.len(), 1, "one value after set");

    match L1Function_get_value(&f, 0) {
        OptL1ValueEntry::Some(e) => {
            match e.inst {
                L1Inst::ConstInt(v, _) => { assert_eq_i64(v, 5, "retrieved ConstInt value"); }
                _ => { p_panic("wrong inst type"); }
            }
        }
        OptL1ValueEntry::None => { p_panic("value not found"); }
    }
}

// ── Test 10: L2Module/L2Function construction ──
fn test_l2_construction() -> void {
    print("Test 10: L2 construction...\n");
    var m: L2Module = L2Module_new();
    assert_eq_i64(m.functions.len(), 0, "no functions initially");

    var f: L2Function = L2Function_new("bar", IrType::Void);
    assert_eq(f.name, "bar", "function name");
    assert_eq_i64(f.values.len(), 0, "no values initially");
    assert_false(f.is_pure, "not pure by default");

    L2Function_set_value(&mut f, 0, L2Inst::ConstInt(7, IrType::I64));
    assert_eq_i64(f.values.len(), 1, "one value after set");

    match L2Function_get_value(&f, 0) {
        OptL2Inst::Some(inst) => {
            match inst {
                L2Inst::ConstInt(v, _) => { assert_eq_i64(v, 7, "retrieved L2 ConstInt"); }
                _ => { p_panic("wrong inst type"); }
            }
        }
        OptL2Inst::None => { p_panic("value not found"); }
    }
}

// ── Test 11: L3Module/L3Function construction ──
fn test_l3_construction() -> void {
    print("Test 11: L3 construction...\n");
    var m: L3Module = L3Module_new();
    assert_eq_i64(m.functions.len(), 0, "no functions initially");
    assert_false(L3Module_has_pure(&m, "foo"), "no pure functions");

    m.pure_functions.push("foo");
    assert_true(L3Module_has_pure(&m, "foo"), "foo is pure");

    m.no_alloc_functions.push("bar");
    assert_true(L3Module_has_no_alloc(&m, "bar"), "bar is no-alloc");

    var f: L3Function = L3Function_new("baz", IrType::I64);
    assert_eq(f.name, "baz", "function name");
    assert_eq_i64(f.frame_size, 0, "frame size 0 initially");
    assert_eq_i64(f.next_vreg, 0, "next_vreg 0 initially");

    var r1: VReg = L3Function_new_vreg(&mut f);
    assert_eq_i64(r1.id, 0, "first vreg id 0");
    var r2: VReg = L3Function_new_vreg(&mut f);
    assert_eq_i64(r2.id, 1, "second vreg id 1");
    assert_eq_i64(f.next_vreg, 2, "next_vreg is 2");
}

// ── Test 12: PirLevel parsing ──
fn test_pir_level() -> void {
    print("Test 12: PirLevel...\n");
    match PirLevel_parse("1") {
        OptPirLevel::Some(l) => { assert_true(pir_level_eq(l, PirLevel::L1), "parse '1' as L1"); }
        OptPirLevel::None => { p_panic("failed to parse '1'"); }
    }
    match PirLevel_parse("l2") {
        OptPirLevel::Some(l) => { assert_true(pir_level_eq(l, PirLevel::L2), "parse 'l2' as L2"); }
        OptPirLevel::None => { p_panic("failed to parse 'l2'"); }
    }
    match PirLevel_parse("3") {
        OptPirLevel::Some(l) => { assert_true(pir_level_eq(l, PirLevel::L3), "parse '3' as L3"); }
        OptPirLevel::None => { p_panic("failed to parse '3'"); }
    }
    match PirLevel_parse("all") {
        OptPirLevel::Some(l) => { assert_true(pir_level_eq(l, PirLevel::All), "parse 'all' as All"); }
        OptPirLevel::None => { p_panic("failed to parse 'all'"); }
    }
    match PirLevel_parse("xyz") {
        OptPirLevel::Some(_) => { p_panic("should not parse 'xyz'"); }
        OptPirLevel::None => { assert_true(true, "parse 'xyz' as None"); }
    }
}

// ── Test 13: Full IR→L1→L2→L3 lowering pipeline ──
fn test_full_pipeline() -> void {
    print("Test 13: Full lowering pipeline...\n");

    // Build a simple IrModule with one function: fn main() -> i64 { return 42; }
    var module: IrModule = IrModule_new();
    var f: IrFunction = IrFunction_new("main", IrType::I64);
    IrFunction_new_block(&mut f);  // block 0

    var v1: i64 = IrFunction_emit(&mut f, Inst::ConstInt(42, IrType::I64));
    IrFunction_emit(&mut f, Inst::Return(OptValueId::Some(v1)));

    IrModule_add_function(&mut module, f);

    // Lower to all levels
    var all: PirAllLevels = build_all(&module);

    // L1 checks
    assert_eq_i64(all.l1.functions.len(), 1, "L1 has 1 function");
    assert_eq(all.l1.functions.get(0).name, "main", "L1 function name");

    // L2 checks
    assert_eq_i64(all.l2.functions.len(), 1, "L2 has 1 function");
    assert_eq(all.l2.functions.get(0).name, "main", "L2 function name");

    // L3 checks
    assert_eq_i64(all.l3.functions.len(), 1, "L3 has 1 function");
    assert_eq(all.l3.functions.get(0).name, "main", "L3 function name");
    assert_true(all.l3.functions.get(0).next_vreg > 0, "L3 has vregs allocated");
}

// ── Test 14: L1 printer output ──
fn test_l1_printer() -> void {
    print("Test 14: L1 printer...\n");

    var module: IrModule = IrModule_new();
    var f: IrFunction = IrFunction_new("test_fn", IrType::I64);
    IrFunction_new_block(&mut f);  // block 0
    var v1: i64 = IrFunction_emit(&mut f, Inst::ConstInt(100, IrType::I64));
    IrFunction_emit(&mut f, Inst::Return(OptValueId::Some(v1)));
    IrModule_add_function(&mut module, f);

    var l1: L1Module = lower_ir_to_l1(&module);
    var output: str = format_l1(&l1);
    assert_true(str_contains(output, "PIR Level 1"), "L1 header present");
    assert_true(str_contains(output, "test_fn"), "function name in output");
    assert_true(str_contains(output, "const"), "const instruction in output");
}

// ── Test 15: L2 printer output ──
fn test_l2_printer() -> void {
    print("Test 15: L2 printer...\n");

    var module: IrModule = IrModule_new();
    var f: IrFunction = IrFunction_new("print_test", IrType::Void);
    IrFunction_new_block(&mut f);
    IrFunction_emit(&mut f, Inst::Return(OptValueId::None));
    IrModule_add_function(&mut module, f);

    var l1: L1Module = lower_ir_to_l1(&module);
    var l2: L2Module = lower_l1_to_l2(&l1);
    var output: str = format_l2(&l2);
    assert_true(str_contains(output, "PIR Level 2"), "L2 header present");
    assert_true(str_contains(output, "print_test"), "function name in L2 output");
}

// ── Test 16: L3 printer output ──
fn test_l3_printer() -> void {
    print("Test 16: L3 printer...\n");

    var module: IrModule = IrModule_new();
    var f: IrFunction = IrFunction_new("l3_test", IrType::I64);
    IrFunction_new_block(&mut f);
    var v1: i64 = IrFunction_emit(&mut f, Inst::ConstInt(99, IrType::I64));
    IrFunction_emit(&mut f, Inst::Return(OptValueId::Some(v1)));
    IrModule_add_function(&mut module, f);

    var l1: L1Module = lower_ir_to_l1(&module);
    var l2: L2Module = lower_l1_to_l2(&l1);
    var l3: L3Module = lower_l2_to_l3(&l2, &module);
    var output: str = format_l3(&l3);
    assert_true(str_contains(output, "PIR Level 3"), "L3 header present");
    assert_true(str_contains(output, "l3_test"), "function name in L3 output");
    assert_true(str_contains(output, "frame="), "frame size in L3 output");
}

// ── Test 17: generate_pir with All level ──
fn test_generate_pir_all() -> void {
    print("Test 17: generate_pir All...\n");

    var module: IrModule = IrModule_new();
    var f: IrFunction = IrFunction_new("gen_test", IrType::I64);
    IrFunction_new_block(&mut f);
    var v1: i64 = IrFunction_emit(&mut f, Inst::ConstInt(1, IrType::I64));
    IrFunction_emit(&mut f, Inst::Return(OptValueId::Some(v1)));
    IrModule_add_function(&mut module, f);

    var output: str = generate_pir(&module, PirLevel::All);
    assert_true(str_contains(output, "Level 1"), "All includes L1");
    assert_true(str_contains(output, "Level 2"), "All includes L2");
    assert_true(str_contains(output, "Level 3"), "All includes L3");
}

