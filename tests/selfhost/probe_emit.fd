use core;
use vec;
use string;
use fs;
use compiler::ir;
use compiler::compiler;
use compiler::pe_ir_enc;
use compiler::pe_ir_stubs;
use compiler::pe_ir;
fn main() -> i64 {
    var src: str = p_file_read("tests\\bootstrap\\struct.fd");
    var r: ResultIrModule = lower_to_ir_module_with_path(src, "tests\\bootstrap\\struct.fd", "warn");
    match r {
        ResultIrModule::Err(errs) => {
            var j: i64 = 0;
            while j < errs.len() { println("err: " + errs.get(j)); j = j + 1; }
            return 1;
        }
        ResultIrModule::Ok(m) => {
            println("lowered " + int_to_str(m.functions.len()) + " fns");
            var res: ResultBytes = pe_ir_generate_pe(m);
            match res {
                ResultBytes::Err(e2) => {
                    var k: i64 = 0;
                    while k < e2.len() { println("gen err: " + e2.get(k)); k = k + 1; }
                    return 1;
                }
                ResultBytes::Ok(bytes) => {
                    if !fs_write_bytes("t_pe_ir\\fides_nomerge.exe", bytes) { println("write fail"); return 1; }
                    println("wrote " + int_to_str(bytes.len()));
                    return 0;
                }
            }
        }
    }
    return 1;
}
