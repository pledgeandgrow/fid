use core;
use vec;
use string;
fn main() -> i64 {
    var h: i64 = HashMap_new();
    var i: i64 = 1;
    while i <= 10 {
        HashMap_insert(h, i, -i * 8);
        i = i + 1;
    }
    i = 1;
    while i <= 10 {
        println(int_to_str(i) + " -> " + int_to_str(HashMap_get(h, i)));
        i = i + 1;
    }
    return 0;
}
