use core;
use vec;
use string;
use compiler::ir;
use compiler::pe_ir_enc;
use compiler::pe_ir_stubs;
use compiler::pe_ir;
fn mk(id: i64) -> ValueIdMeta {
    return ValueIdMeta_new(id, ValueMeta_new(IrType::I64));
}
fn main() -> i64 {
    // UNSORTED metas — insertion sort must reorder; watch ids survive intact
    var v: Vec<ValueIdMeta> = Vec::new();
    v.push(mk(5));
    v.push(mk(0));
    v.push(mk(3));
    v.push(mk(1));
    v.push(mk(4));
    v.push(mk(2));
    var i: i64 = 0;
    while i < v.len() {
        println("before " + int_to_str(i) + " id=" + int_to_str(v.get(i).id));
        i = i + 1;
    }
    // insertion sort (same algorithm as pe_sort_value_id_metas)
    i = 1;
    while i < v.len() {
        var key: ValueIdMeta = v.get(i);
        var j: i64 = i - 1;
        while j >= 0 && v.get(j).id > key.id {
            v.set(j + 1, v.get(j));
            j = j - 1;
        }
        v.set(j + 1, key);
        i = i + 1;
    }
    i = 0;
    while i < v.len() {
        println("after " + int_to_str(i) + " id=" + int_to_str(v.get(i).id));
        i = i + 1;
    }
    return 0;
}
