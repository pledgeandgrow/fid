use core;
use vec;
use string;
use fs;
use compiler::ir;
use compiler::pe_ir_enc;
use compiler::pe_ir_stubs;
use compiler::pe_ir;
fn main() -> i64 {
    var m: IrModule = IrModule_new();
    var f: IrFunction = IrFunction_new("main", IrType::I64);
    var b: i64 = IrFunction_new_block(&mut f);
    f.entry = b;
    var a: i64 = IrFunction_emit(&mut f, Inst::ConstInt(20, IrType::I64));
    var c: i64 = IrFunction_emit(&mut f, Inst::ConstInt(22, IrType::I64));
    var s: i64 = IrFunction_emit(&mut f, Inst::BinOp(BinOp::Add, a, c, IrType::I64));
    IrFunction_emit(&mut f, Inst::Print(s, IrType::I64));
    IrFunction_emit(&mut f, Inst::Return(OptValueId::Some(s)));
    m.functions.push(IrFunctionEntry_new("main", f));
    var r: ResultBytes = pe_ir_generate_pe(m);
    match r {
        ResultBytes::Err(errs) => {
            var i: i64 = 0;
            while i < errs.len() { println("err: " + errs.get(i)); i = i + 1; }
            return 1;
        }
        ResultBytes::Ok(bytes) => {
            if !fs_write_bytes("t_probe_pe.exe", bytes) { println("write fail"); return 1; }
            println("wrote " + int_to_str(bytes.len()));
            return 0;
        }
    }
    return 0;
}
