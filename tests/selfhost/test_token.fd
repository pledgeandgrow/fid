// SH-6.1: Differential test for token.fd (rewritten from token.rs)
// Tests TokenKind enum construction, token_kind_to_str, and is_word_keyword.
// Verifies that all token variants produce the correct string representation.
use core;
use compiler::token;

fn assert_eq(actual: str, expected: str, label: str) -> void {
    if actual != expected {
        print("FAIL: ");
        print(label);
        print(" — expected '");
        print(expected);
        print("', got '");
        print(actual);
        print("'\n");
        p_panic("test failed");
    }
}

fn assert_eq_i64(actual: i64, expected: i64, label: str) -> void {
    if actual != expected {
        print("FAIL: ");
        print(label);
        print(" — expected ");
        print(int_to_str(expected));
        print(", got ");
        print(int_to_str(actual));
        print("\n");
        p_panic("test failed");
    }
}

fn assert_eq_bool(actual: bool, expected: bool, label: str) -> void {
    if actual != expected {
        print("FAIL: ");
        print(label);
        print(" — expected ");
        if expected { print("true"); } else { print("false"); }
        print(", got ");
        if actual { print("true"); } else { print("false"); }
        print("\n");
        p_panic("test failed");
    }
}

fn main() -> i64 {
    print("SH-6.1: Token module test\n");
    print("=========================\n\n");

    // ── Test 1: Keyword tokens → lowercase strings ──
    print("Test 1: Keyword to_str...\n");
    assert_eq(token_kind_to_str(TokenKind::Fn), "fn", "Fn");
    assert_eq(token_kind_to_str(TokenKind::Val), "val", "Val");
    assert_eq(token_kind_to_str(TokenKind::Var), "var", "Var");
    assert_eq(token_kind_to_str(TokenKind::Mut), "mut", "Mut");
    assert_eq(token_kind_to_str(TokenKind::Const), "const", "Const");
    assert_eq(token_kind_to_str(TokenKind::If), "if", "If");
    assert_eq(token_kind_to_str(TokenKind::Else), "else", "Else");
    assert_eq(token_kind_to_str(TokenKind::Match), "match", "Match");
    assert_eq(token_kind_to_str(TokenKind::Return), "return", "Return");
    assert_eq(token_kind_to_str(TokenKind::Struct), "struct", "Struct");
    assert_eq(token_kind_to_str(TokenKind::Enum), "enum", "Enum");
    assert_eq(token_kind_to_str(TokenKind::For), "for", "For");
    assert_eq(token_kind_to_str(TokenKind::While), "while", "While");
    assert_eq(token_kind_to_str(TokenKind::Break), "break", "Break");
    assert_eq(token_kind_to_str(TokenKind::Continue), "continue", "Continue");
    assert_eq(token_kind_to_str(TokenKind::True), "true", "True");
    assert_eq(token_kind_to_str(TokenKind::False), "false", "False");
    assert_eq(token_kind_to_str(TokenKind::Pub), "pub", "Pub");
    assert_eq(token_kind_to_str(TokenKind::Use), "use", "Use");
    assert_eq(token_kind_to_str(TokenKind::Module), "module", "Module");
    assert_eq(token_kind_to_str(TokenKind::Async), "async", "Async");
    assert_eq(token_kind_to_str(TokenKind::Await), "await", "Await");
    assert_eq(token_kind_to_str(TokenKind::Comptime), "comptime", "Comptime");
    assert_eq(token_kind_to_str(TokenKind::Unsafe), "unsafe", "Unsafe");
    assert_eq(token_kind_to_str(TokenKind::Extern), "extern", "Extern");
    print("  OK\n\n");

    // ── Test 2: ML + Game keywords ──
    print("Test 2: ML/Game keyword to_str...\n");
    assert_eq(token_kind_to_str(TokenKind::Layer), "layer", "Layer");
    assert_eq(token_kind_to_str(TokenKind::Model), "model", "Model");
    assert_eq(token_kind_to_str(TokenKind::Grad), "grad", "Grad");
    assert_eq(token_kind_to_str(TokenKind::Backward), "backward", "Backward");
    assert_eq(token_kind_to_str(TokenKind::Kernel), "kernel", "Kernel");
    assert_eq(token_kind_to_str(TokenKind::Component), "component", "Component");
    assert_eq(token_kind_to_str(TokenKind::System), "system", "System");
    assert_eq(token_kind_to_str(TokenKind::Query), "query", "Query");
    assert_eq(token_kind_to_str(TokenKind::State), "state", "State");
    assert_eq(token_kind_to_str(TokenKind::On), "on", "On");
    print("  OK\n\n");

    // ── Test 3: Literal tokens with payloads ──
    print("Test 3: Literal token to_str...\n");
    assert_eq(token_kind_to_str(TokenKind::IntLit(42)), "42", "IntLit(42)");
    assert_eq(token_kind_to_str(TokenKind::IntLit(0)), "0", "IntLit(0)");
    assert_eq(token_kind_to_str(TokenKind::IntLit(0 - 1)), "-1", "IntLit(-1)");
    assert_eq(token_kind_to_str(TokenKind::IntLit(1000000)), "1000000", "IntLit(1M)");
    assert_eq(token_kind_to_str(TokenKind::StringLit("hello")), "\"hello\"", "StringLit");
    assert_eq(token_kind_to_str(TokenKind::StringLit("")), "\"\"", "StringLit(empty)");
    assert_eq(token_kind_to_str(TokenKind::Ident("foo")), "foo", "Ident");
    assert_eq(token_kind_to_str(TokenKind::Ident("bar123")), "bar123", "Ident(bar123)");
    print("  OK\n\n");

    // ── Test 4: Operator tokens (Debug format = variant name) ──
    print("Test 4: Operator to_str...\n");
    assert_eq(token_kind_to_str(TokenKind::Plus), "Plus", "Plus");
    assert_eq(token_kind_to_str(TokenKind::Minus), "Minus", "Minus");
    assert_eq(token_kind_to_str(TokenKind::Star), "Star", "Star");
    assert_eq(token_kind_to_str(TokenKind::Slash), "Slash", "Slash");
    assert_eq(token_kind_to_str(TokenKind::Eq), "Eq", "Eq");
    assert_eq(token_kind_to_str(TokenKind::EqEq), "EqEq", "EqEq");
    assert_eq(token_kind_to_str(TokenKind::BangEq), "BangEq", "BangEq");
    assert_eq(token_kind_to_str(TokenKind::Lt), "Lt", "Lt");
    assert_eq(token_kind_to_str(TokenKind::Gt), "Gt", "Gt");
    assert_eq(token_kind_to_str(TokenKind::LtEq), "LtEq", "LtEq");
    assert_eq(token_kind_to_str(TokenKind::GtEq), "GtEq", "GtEq");
    assert_eq(token_kind_to_str(TokenKind::Arrow), "Arrow", "Arrow");
    assert_eq(token_kind_to_str(TokenKind::FatArrow), "FatArrow", "FatArrow");
    assert_eq(token_kind_to_str(TokenKind::PipeArrow), "PipeArrow", "PipeArrow");
    assert_eq(token_kind_to_str(TokenKind::DotDot), "DotDot", "DotDot");
    assert_eq(token_kind_to_str(TokenKind::DotDotEq), "DotDotEq", "DotDotEq");
    print("  OK\n\n");

    // ── Test 5: Punctuation tokens ──
    print("Test 5: Punctuation to_str...\n");
    assert_eq(token_kind_to_str(TokenKind::Dot), "Dot", "Dot");
    assert_eq(token_kind_to_str(TokenKind::Comma), "Comma", "Comma");
    assert_eq(token_kind_to_str(TokenKind::Colon), "Colon", "Colon");
    assert_eq(token_kind_to_str(TokenKind::Semicolon), "Semicolon", "Semicolon");
    assert_eq(token_kind_to_str(TokenKind::DoubleColon), "DoubleColon", "DoubleColon");
    assert_eq(token_kind_to_str(TokenKind::Question), "Question", "Question");
    assert_eq(token_kind_to_str(TokenKind::Hash), "Hash", "Hash");
    assert_eq(token_kind_to_str(TokenKind::At), "At", "At");
    assert_eq(token_kind_to_str(TokenKind::LBracket), "LBracket", "LBracket");
    assert_eq(token_kind_to_str(TokenKind::RBracket), "RBracket", "RBracket");
    assert_eq(token_kind_to_str(TokenKind::LParen), "LParen", "LParen");
    assert_eq(token_kind_to_str(TokenKind::RParen), "RParen", "RParen");
    assert_eq(token_kind_to_str(TokenKind::LBrace), "LBrace", "LBrace");
    assert_eq(token_kind_to_str(TokenKind::RBrace), "RBrace", "RBrace");
    print("  OK\n\n");

    // ── Test 6: Type keyword tokens ──
    print("Test 6: Type keyword to_str...\n");
    assert_eq(token_kind_to_str(TokenKind::I8), "I8", "I8");
    assert_eq(token_kind_to_str(TokenKind::I16), "I16", "I16");
    assert_eq(token_kind_to_str(TokenKind::I32), "I32", "I32");
    assert_eq(token_kind_to_str(TokenKind::I64), "I64", "I64");
    assert_eq(token_kind_to_str(TokenKind::I128), "I128", "I128");
    assert_eq(token_kind_to_str(TokenKind::U8), "U8", "U8");
    assert_eq(token_kind_to_str(TokenKind::U64), "U64", "U64");
    assert_eq(token_kind_to_str(TokenKind::F32), "F32", "F32");
    assert_eq(token_kind_to_str(TokenKind::F64), "F64", "F64");
    assert_eq(token_kind_to_str(TokenKind::Bool), "Bool", "Bool");
    assert_eq(token_kind_to_str(TokenKind::Str), "Str", "Str");
    assert_eq(token_kind_to_str(TokenKind::Void), "Void", "Void");
    print("  OK\n\n");

    // ── Test 7: Eof ──
    print("Test 7: Special tokens...\n");
    assert_eq(token_kind_to_str(TokenKind::Eof), "EOF", "Eof");
    print("  OK\n\n");

    // ── Test 8: is_word_keyword ──
    print("Test 8: is_word_keyword...\n");
    // Keywords → true
    assert_eq_bool(is_word_keyword(TokenKind::Fn), true, "Fn");
    assert_eq_bool(is_word_keyword(TokenKind::Val), true, "Val");
    assert_eq_bool(is_word_keyword(TokenKind::Match), true, "Match");
    assert_eq_bool(is_word_keyword(TokenKind::For), true, "For");
    assert_eq_bool(is_word_keyword(TokenKind::True), true, "True");
    assert_eq_bool(is_word_keyword(TokenKind::Query), true, "Query");
    assert_eq_bool(is_word_keyword(TokenKind::State), true, "State");
    assert_eq_bool(is_word_keyword(TokenKind::On), true, "On");
    // Non-keywords → false
    assert_eq_bool(is_word_keyword(TokenKind::Plus), false, "Plus");
    assert_eq_bool(is_word_keyword(TokenKind::Eq), false, "Eq");
    assert_eq_bool(is_word_keyword(TokenKind::Semicolon), false, "Semicolon");
    assert_eq_bool(is_word_keyword(TokenKind::LBrace), false, "LBrace");
    assert_eq_bool(is_word_keyword(TokenKind::I64), false, "I64");
    assert_eq_bool(is_word_keyword(TokenKind::Bool), false, "Bool");
    assert_eq_bool(is_word_keyword(TokenKind::Eof), false, "Eof");
    assert_eq_bool(is_word_keyword(TokenKind::IntLit(42)), false, "IntLit");
    assert_eq_bool(is_word_keyword(TokenKind::Ident("x")), false, "Ident");
    print("  OK\n\n");

    // ── Test 9: Token struct construction + field access ──
    print("Test 9: Token struct...\n");
    val t1 = token_new(TokenKind::Fn, 10, 3);
    assert_eq_i64(t1.line, 10, "t1.line");
    assert_eq_i64(t1.col, 3, "t1.col");
    assert_eq(token_kind_to_str(t1.kind), "fn", "t1.kind");

    val t2 = token_new(TokenKind::IntLit(12345), 42, 7);
    assert_eq_i64(t2.line, 42, "t2.line");
    assert_eq_i64(t2.col, 7, "t2.col");
    assert_eq(token_kind_to_str(t2.kind), "12345", "t2.kind");

    val t3 = token_new(TokenKind::Ident("my_var"), 1, 1);
    assert_eq_i64(t3.line, 1, "t3.line");
    assert_eq_i64(t3.col, 1, "t3.col");
    assert_eq(token_kind_to_str(t3.kind), "my_var", "t3.kind");
    print("  OK\n\n");

    // ── Test 10: Enum payload preservation through function calls ──
    print("Test 10: Enum payload round-trip...\n");
    // Test that enum payloads survive being passed to a function and stored
    // in a local struct (which was the original bug — enum payload overlapping
    // with the next struct field).
    val t_a = token_new(TokenKind::IntLit(111), 1, 1);
    val t_b = token_new(TokenKind::StringLit("world"), 2, 1);
    val t_c = token_new(TokenKind::Ident("test"), 3, 1);

    assert_eq(token_kind_to_str(t_a.kind), "111", "t_a.kind");
    assert_eq_i64(t_a.line, 1, "t_a.line");
    assert_eq(token_kind_to_str(t_b.kind), "\"world\"", "t_b.kind");
    assert_eq_i64(t_b.line, 2, "t_b.line");
    assert_eq(token_kind_to_str(t_c.kind), "test", "t_c.kind");
    assert_eq_i64(t_c.line, 3, "t_c.line");
    print("  OK\n\n");

    print("SH-6.1: All tests passed!\n");
    return 0;
}
