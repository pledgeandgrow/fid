use core;
use vec;
use string;
use compiler::ir;
use compiler::pe_ir_enc;
use compiler::pe_ir_stubs;
use compiler::pe_ir;
fn main() -> i64 {
    // Vec<ValueIdInst> — sort integrity on UNSORTED ids (enum payload inside)
    var v: Vec<ValueIdInst> = Vec::new();
    v.push(ValueIdInst_new(5, Inst::ConstInt(50, IrType::I64)));
    v.push(ValueIdInst_new(0, Inst::ConstInt(0, IrType::I64)));
    v.push(ValueIdInst_new(3, Inst::ConstInt(30, IrType::I64)));
    v.push(ValueIdInst_new(1, Inst::ConstInt(10, IrType::I64)));
    v.push(ValueIdInst_new(4, Inst::ConstInt(40, IrType::I64)));
    v.push(ValueIdInst_new(2, Inst::ConstInt(20, IrType::I64)));
    var i: i64 = 1;
    while i < v.len() {
        var key: ValueIdInst = v.get(i);
        var j: i64 = i - 1;
        while j >= 0 && v.get(j).id > key.id {
            v.set(j + 1, v.get(j));
            j = j - 1;
        }
        v.set(j + 1, key);
        i = i + 1;
    }
    var k: i64 = 0;
    while k < v.len() {
        var e: ValueIdInst = v.get(k);
        match e.inst {
            Inst::ConstInt(cv, _) => { println("inst[" + int_to_str(k) + "] id=" + int_to_str(e.id) + " val=" + int_to_str(cv)); }
            _ => { println("inst[" + int_to_str(k) + "] id=" + int_to_str(e.id) + " nonconst"); }
        }
        k = k + 1;
    }
    return 0;
}
