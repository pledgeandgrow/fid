use core;
fn main() -> i64 {
    print("argc: ");
    print(int_to_str(p_argc()));
    print("\n");
    var i: i64 = 0;
    while i < p_argc() {
        print("argv[");
        print(int_to_str(i));
        print("]: ");
        print(p_argv(i));
        print("\n");
        i = i + 1;
    }
    return 0;
}
