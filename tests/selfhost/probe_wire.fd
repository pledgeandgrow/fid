use core;
use vec;
use string;
use compiler::ir;
use compiler::compiler;
use compiler::pe_ir_enc;
use compiler::pe_ir_stubs;
use compiler::pe_ir;
fn main() -> i64 {
    // Exercise the touched APIs so the typecheck covers them:
    // set_pe_runtime_merge / build_executable signature / pe_ir_generate_pe.
    set_pe_runtime_merge(false);
    var m: IrModule = IrModule_new();
    var r: ResultBytes = pe_ir_generate_pe(m);
    match r {
        ResultBytes::Err(e) => { println("gen err (expected, no main): " + int_to_str(e.len())); }
        ResultBytes::Ok(_) => { println("unexpected ok"); }
    }
    return 0;
}
