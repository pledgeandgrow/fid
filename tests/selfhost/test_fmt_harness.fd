// test_fmt_harness.fd — Differential test harness for compiler/fmt.fd
// Reads a file given as argv, formats it with the Fides formatter, prints to stdout.
// Usage:
//   Interpreter: fidesc run test_fmt_harness.fd -- <file.fd>
//   Native:      ./test_fmt_harness <file.fd>
//
// Output: the formatted source code (printed to stdout).
// Compare with `fidesc fmt` (Rust formatter) to check for mismatches.

use core;
use vec;
use string;
use compiler::fmt;

fn main() -> i64 {
    // Parse argv — support both "-- <file>" and direct "<file>" modes
    var argc: i64 = p_argc();
    var path: str = "";
    var i: i64 = 0;
    var found_sep: bool = false;
    while i < argc {
        var a: str = p_str_take(p_argv(i));
        if a == "--" {
            found_sep = true;
            if i + 1 < argc {
                path = p_str_take(p_argv(i + 1));
            }
            break;
        }
        i = i + 1;
    }
    // Native mode: no "--" separator, take argv[1] directly
    if !found_sep && str_len(path) == 0 && argc >= 2 {
        path = p_str_take(p_argv(1));
    }
    if str_len(path) == 0 {
        print("usage: fidesc run test_fmt_harness.fd -- <file.fd>\n");
        print("   or: ./test_fmt_harness <file.fd>\n");
        return 1;
    }

    var source: str = p_str_take(p_file_read(path));
    if str_len(source) == 0 {
        print("error: could not read file or empty file: ");
        print(path);
        print("\n");
        return 1;
    }

    var formatted: str = format_source(source);
    print(formatted);
    return 0;
}
