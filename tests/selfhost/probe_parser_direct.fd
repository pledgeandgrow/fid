use core;
use vec;
use compiler::lexer;
use compiler::token;
use compiler::ast;
use compiler::parser;

fn main() -> i64 {
    var source: str = "fn main() -> i64 { val x = 42; return x; }";
    var lex: Lexer = Lexer::new(source);
    var tokens: Vec<Token> = lex.tokenize();
    print("tokens: ");
    print(int_to_str(tokens.len()));
    print("\n");
    var parser: Parser = Parser::new(tokens);
    match parser.parse() {
        ParseResultProgram::Ok(program) => {
            print("funcs: ");
            print(int_to_str(program.funcs.len()));
            print("\n");
        }
        ParseResultProgram::Err(e) => {
            print("Parse error: ");
            print(e);
            print("\n");
            return 1;
        }
    }
    return 0;
}
