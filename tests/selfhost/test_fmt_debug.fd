use core;
use vec;
use string;
use compiler::fmt;

fn main() -> i64 {
    var src: str = "fn main(){val x=1;}";
    var tokens: Vec<FTok> = fmt_tokenize(src);
    print("Tokens:\n");
    var i: i64 = 0;
    while i < tokens.len() {
        var t: FTok = tokens.get(i);
        var text: str = ftok_text(t);
        print("[");
        print(int_to_str(i));
        print("] '");
        print(text);
        print("'\n");
        i = i + 1;
    }
    print("\nFormatted:\n");
    var out: str = format_source(src);
    print(out);
    print("\n");
    return 0;
}
