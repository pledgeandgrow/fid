// ── Test 22: Lower a function with a let binding ──
fn test_lower_let() -> void {
    print("Test 22: lower let binding...\n");
    var l: Lowerer = Lowerer_new();
    Lowerer_register_runtime(&mut l);

    var let_stmt: Stmt = Stmt::Let("x", OptType::Some(Type::I64), Expr::IntLit(42), false, false, 0);
    var ret: Expr = Expr::Ident("x");
    var ret_stmt: Stmt = Stmt::Return(Box::new(ret), 0);

    var body: Vec<Stmt> = Vec::new();
    body.push(let_stmt);
    body.push(ret_stmt);

    var f: Func = make_func("let_test", Type::I64, body);

    var prog: Program = program_new();
    prog.funcs.push(f);

    var mod: IrModule = Lowerer_lower_program(&mut l, prog);
    assert_eq_i64(mod.functions.len(), 1, "let function lowered");
}

// ── Test 23: Lower a function with binary expression ──
fn test_lower_binary() -> void {
    print("Test 23: lower binary expression...\n");
    var l: Lowerer = Lowerer_new();
    Lowerer_register_runtime(&mut l);

    val lhs = Box::new(Expr::IntLit(1));
    val rhs = Box::new(Expr::IntLit(2));
    var bin_expr: Expr = Expr::Binary(BinOp::Add, lhs, rhs);
    var ret_stmt: Stmt = Stmt::Return(Box::new(bin_expr), 0);

    var body: Vec<Stmt> = Vec::new();
    body.push(ret_stmt);

    var f: Func = make_func("add_1_2", Type::I64, body);

    var prog: Program = program_new();
    prog.funcs.push(f);

    var mod: IrModule = Lowerer_lower_program(&mut l, prog);
    assert_eq_i64(mod.functions.len(), 1, "binary function lowered");
}

// ── Test 24: Infer expr type ──
fn test_infer_expr_type() -> void {
    print("Test 24: infer_expr_type...\n");
    var l: Lowerer = Lowerer_new();

    assert_true(ir_type_eq(Lowerer_infer_expr_type(&l, Expr::IntLit(42)), IrType::I64), "IntLit -> I64");
    assert_true(ir_type_eq(Lowerer_infer_expr_type(&l, Expr::BoolLit(true)), IrType::Bool), "BoolLit -> Bool");
    assert_true(ir_type_eq(Lowerer_infer_expr_type(&l, Expr::StringLit("hi")), ptr_u8()), "StringLit -> Ptr");
    assert_true(ir_type_eq(Lowerer_infer_expr_type(&l, Expr::FloatLit(3.14)), IrType::F64), "FloatLit -> F64");

    val lt_l = Box::new(Expr::IntLit(1));
    val lt_r = Box::new(Expr::IntLit(2));
    var cmp: Expr = Expr::Binary(BinOp::Lt, lt_l, lt_r);
    assert_true(ir_type_eq(Lowerer_infer_expr_type(&l, cmp), IrType::Bool), "Lt -> Bool");

    val add_l = Box::new(Expr::IntLit(1));
    val add_r = Box::new(Expr::IntLit(2));
    var add: Expr = Expr::Binary(BinOp::Add, add_l, add_r);
    assert_true(ir_type_eq(Lowerer_infer_expr_type(&l, add), IrType::I64), "Add -> I64");
}

// ── Test 25: Infer binop type ──
fn test_infer_binop_type() -> void {
    print("Test 25: infer_binop_type...\n");
    var l: Lowerer = Lowerer_new();

    assert_true(ir_type_eq(Lowerer_infer_binop_type(&l, BinOp::Eq, Expr::IntLit(1), Expr::IntLit(2)), IrType::Bool), "Eq -> Bool");
    assert_true(ir_type_eq(Lowerer_infer_binop_type(&l, BinOp::Neq, Expr::IntLit(1), Expr::IntLit(2)), IrType::Bool), "Neq -> Bool");
    assert_true(ir_type_eq(Lowerer_infer_binop_type(&l, BinOp::Lt, Expr::IntLit(1), Expr::IntLit(2)), IrType::Bool), "Lt -> Bool");
    assert_true(ir_type_eq(Lowerer_infer_binop_type(&l, BinOp::Gt, Expr::IntLit(1), Expr::IntLit(2)), IrType::Bool), "Gt -> Bool");
    assert_true(ir_type_eq(Lowerer_infer_binop_type(&l, BinOp::And, Expr::BoolLit(true), Expr::BoolLit(false)), IrType::Bool), "And -> Bool");
    assert_true(ir_type_eq(Lowerer_infer_binop_type(&l, BinOp::Or, Expr::BoolLit(true), Expr::BoolLit(false)), IrType::Bool), "Or -> Bool");
    assert_true(ir_type_eq(Lowerer_infer_binop_type(&l, BinOp::Add, Expr::IntLit(1), Expr::IntLit(2)), IrType::I64), "Add(I64,I64) -> I64");
}

// ── Test 26: Lower a function with struct literal ──
fn test_lower_struct_lit() -> void {
    print("Test 26: lower struct literal...\n");
    var l: Lowerer = Lowerer_new();
    Lowerer_register_runtime(&mut l);

    // Define a struct
    var s: StructDef = StructDef_new("Point", false);
    s.fields.push(make_param("x", Type::I64));
    s.fields.push(make_param("y", Type::I64));

    // Function that creates a Point
    var fields: Vec<FieldInit> = Vec::new();
    fields.push(FieldInit_new("x", Expr::IntLit(1)));
    fields.push(FieldInit_new("y", Expr::IntLit(2)));
    var struct_expr: Expr = Expr::StructLit("Point", fields, OptBoxExpr::None);
    var ret_stmt: Stmt = Stmt::Return(Box::new(struct_expr), 0);

    var body: Vec<Stmt> = Vec::new();
    body.push(ret_stmt);

    var f: Func = make_func("make_point", Type::Named("Point"), body);

    var prog: Program = program_new();
    prog.structs.push(s);
    prog.funcs.push(f);

    var mod: IrModule = Lowerer_lower_program(&mut l, prog);
    assert_eq_i64(mod.functions.len(), 1, "struct lit function lowered");
}

// ── Test 27: Lower a function with match ──
fn test_lower_match() -> void {
    print("Test 27: lower match...\n");
    var l: Lowerer = Lowerer_new();
    Lowerer_register_runtime(&mut l);

    // match x { _ => return 0; }
    var arms: Vec<MatchArm> = Vec::new();
    var arm_body: Vec<Stmt> = Vec::new();
    var ret_expr: Expr = Expr::IntLit(0);
    arm_body.push(Stmt::Return(Box::new(ret_expr), 0));
    arms.push(MatchArm_new(Pattern::Wildcard, OptBoxExpr::None, arm_body));

    var match_expr: Expr = Expr::Ident("x");
    var match_stmt: Stmt = Stmt::Match(match_expr, arms, 0);

    var body: Vec<Stmt> = Vec::new();
    body.push(match_stmt);

    var f: Func = make_func("match_test", Type::I64, body);
    f.params.push(make_param("x", Type::I64));

    var prog: Program = program_new();
    prog.funcs.push(f);

    var mod: IrModule = Lowerer_lower_program(&mut l, prog);
    assert_eq_i64(mod.functions.len(), 1, "match function lowered");
}

// ── Test 28: Lower a function with extern declaration ──
fn test_lower_extern() -> void {
    print("Test 28: lower extern declaration...\n");
    var l: Lowerer = Lowerer_new();
    Lowerer_register_runtime(&mut l);

    // Function that calls an extern
    var args: Vec<Expr> = Vec::new();
    args.push(Expr::IntLit(42));
    var call_expr: Expr = Expr::Call("p_print_int", args);
    var body: Vec<Stmt> = Vec::new();
    body.push(Stmt::Expr(call_expr, 0));
    var ret: Expr = Expr::IntLit(0);
    body.push(Stmt::Return(Box::new(ret), 0));

    var f: Func = make_func("call_extern", Type::I64, body);

    var prog: Program = program_new();
    prog.funcs.push(f);

    var mod: IrModule = Lowerer_lower_program(&mut l, prog);
    assert_eq_i64(mod.functions.len(), 1, "extern call function lowered");
}

// ── Test 29: Lower a function with call ──
fn test_lower_call() -> void {
    print("Test 29: lower function call...\n");
    var l: Lowerer = Lowerer_new();
    Lowerer_register_runtime(&mut l);

    // Define helper function
    var helper_body: Vec<Stmt> = Vec::new();
    var helper_ret: Expr = Expr::IntLit(7);
    helper_body.push(Stmt::Return(Box::new(helper_ret), 0));
    var helper: Func = make_func("get_seven", Type::I64, helper_body);

    // Define caller function
    var args: Vec<Expr> = Vec::new();
    var call_expr: Expr = Expr::Call("get_seven", args);
    var caller_body: Vec<Stmt> = Vec::new();
    caller_body.push(Stmt::Return(Box::new(call_expr), 0));
    var caller: Func = make_func("caller", Type::I64, caller_body);

    var prog: Program = program_new();
    prog.funcs.push(helper);
    prog.funcs.push(caller);

    var mod: IrModule = Lowerer_lower_program(&mut l, prog);
    assert_eq_i64(mod.functions.len(), 2, "two functions lowered");
}

// ── Test 30: Lower a function with defer ──
fn test_lower_defer() -> void {
    print("Test 30: lower defer...\n");
    var l: Lowerer = Lowerer_new();
    Lowerer_register_runtime(&mut l);

    var defer_body: Vec<Stmt> = Vec::new();
    var args: Vec<Expr> = Vec::new();
    args.push(Expr::IntLit(1));
    defer_body.push(Stmt::Expr(Expr::Call("p_print_int", args), 0));

    var body: Vec<Stmt> = Vec::new();
    body.push(Stmt::Defer(defer_body, 0));
    var ret: Expr = Expr::IntLit(0);
    body.push(Stmt::Return(Box::new(ret), 0));

    var f: Func = make_func("with_defer", Type::I64, body);

    var prog: Program = program_new();
    prog.funcs.push(f);

    var mod: IrModule = Lowerer_lower_program(&mut l, prog);
    assert_eq_i64(mod.functions.len(), 1, "defer function lowered");
}

