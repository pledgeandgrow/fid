// roadmap L7C (memory and allocation profiles): `fid run --mem` prints at
// exit the allocations, the peak of live bytes, and the bytes each function
// and each source line allocated. fill allocates and frees five 100-byte
// blocks (line 12); keep allocates two 256-byte blocks (line 23) and holds
// them (tests/memprof/check.sh checks the rows).

fn fill(n: i64) -> i64 {
    var k: i64 = 0;
    while k < n {
        unsafe {
            var p: i64 = 0;
            p = p_malloc(100) as i64;
            p_free(p as *u8);
        }
        k = k + 1;
    }
    return n;
}

fn keep() -> i64 {
    var p: i64 = 0;
    unsafe {
        p = p_malloc(256) as i64;
    }
    return p;
}

fn main() {
    var a: i64 = keep();
    var b: i64 = keep();
    val n: i64 = fill(5);
    if a != 0 && b != 0 {
        println("filled " + int_to_str(n));
    }
}
