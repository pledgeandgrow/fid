// roadmap L7C, region usage in the memory profile: built with
// FID_REGION_ARENA=1 (proposal 0005) each region gets an arena, and
// `fid run --mem` reports what the regions' arenas gave out: the regions
// by depth (how many, their allocations and bytes, the largest one), the
// peak of bytes live in regions at once, and the region bytes by function
// and by line. build() runs twice: an outer region (depth 1) filling a
// Vec, with an inner region (depth 2) making a string.
// tests/memprof/check.sh checks the report.

fn build(n: i64) -> i64 {
    var total: i64 = 0;
    region outer {
        var v: Vec<i64> = Vec::new();
        var i: i64 = 0;
        while i < n {
            v.push(i * 3);
            i = i + 1;
        }
        total = v.len();
        region inner {
            val s: str = "x" + int_to_str(n * 1000);
            total = total + str_len(s);
        }
    }
    return total;
}

fn main() {
    val a: i64 = build(100);
    val b: i64 = build(200);
    println("built " + int_to_str(a + b));
}
