// CM8: `fid run --leaks` names the line that allocated each block never
// freed. make_buf leaks three 40-byte blocks allocated on line 8; the
// report must say "leak_line.fd:8" (tests/memprof/check.sh).

fn make_buf(n: i64) -> i64 {
    var raw: i64 = 0;
    unsafe {
        raw = p_malloc(n) as i64;
    }
    return raw;
}

fn main() {
    var made: i64 = 0;
    var i: i64 = 0;
    while i < 3 {
        if make_buf(40) != 0 {
            made = made + 1;
        }
        i = i + 1;
    }
    println("made " + int_to_str(made));
}
