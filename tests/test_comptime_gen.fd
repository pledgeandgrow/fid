// Test comptime code generation — Phase 3A
// `comptime gen { block }` evaluates a block at compile time, parses the
// resulting string as Fides source code, and injects the declarations.

struct Point {
    x: i64,
    y: i64,
}

// A comptime function that generates a getter function for a struct field
comptime fn make_getter(struct_name: str, field_name: str, field_type: str) -> str {
    return "fn get_" + field_name + "(p: " + struct_name + ") -> " + field_type + " { return p." + field_name + "; }";
}

fn main() -> i64 {
    // Generate a getter function using comptime reflection
    comptime gen {
        val name = comptime type_name(Point);
        val src = comptime make_getter("Point", "x", "i64");
        return src;
    }

    // Use the generated function
    val pt = Point { x: 10, y: 20 };
    print(get_x(pt));  // 10

    // Generate another function
    comptime gen {
        return "fn get_y(p: Point) -> i64 { return p.y; }";
    }

    print(get_y(pt));  // 20

    // Generate a standalone function
    comptime gen {
        return "fn double(n: i64) -> i64 { return n * 2; }";
    }

    print(double(21));  // 42

    return 0;
}
