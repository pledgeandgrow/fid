// stdlib/net.fd byte-vector UDP I/O (release M10): a socket sends three
// bytes, NUL and 255 among them, to itself on 127.0.0.1 and reads them
// back. Needs the C net runtime (runtime/pledge_net.c, found when
// pledge_net.h is on the include path); not in the suite.
//
// Expected output:
// sent 3
// got 3: 0 255 65
use net;

fn main() -> i64 {
    val sock: i64 = net_socket_create();
    net_bind(sock, 47913);
    net_set_recv_timeout(sock, 2000);
    val to: NetAddr = net_addr_create("127.0.0.1", 47913);
    var data: Vec<i64> = Vec::new();
    data.push(0);
    data.push(255);
    data.push(65);
    println("sent " + int_to_str(net_send_bytes_to(sock, data, & to)));
    var from: NetAddr = net_addr_none();
    val got: Vec<i64> = net_recv_bytes_from(sock, 64, & mut from);
    var line: str = "got " + int_to_str(got.len()) + ":";
    var i: i64 = 0;
    while i < got.len() {
        line = line + " " + int_to_str(got.get(i));
        i = i + 1;
    }
    println(line);
    net_close(sock);
    return 0;
}
