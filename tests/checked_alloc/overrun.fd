// emit --checked-alloc (release M7, complaint CM9): a write past the end of
// a block faults on its guard page, and the report names the block.
// Run by tests/checked_alloc/run.sh.
// expect-checked: Access past the end of a block (--checked-alloc): the block of 48 bytes at 0x
// expect-checked: accessed at offset 48;
// expect-linux: ; allocated in main
@unsafe
fn main() -> i64 {
    var p: i64 = p_malloc(48);
    var i: i64 = 0;
    while i < 6 {
        *((p + i * 8) as *i64) = i;
        i = i + 1;
    }
    print("in bounds\n");
    *((p + 48) as *i64) = 7;
    print("past the end\n");
    return 0;
}
