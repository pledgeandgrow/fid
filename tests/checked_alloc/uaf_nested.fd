// emit --checked-alloc (release M7, complaint CM9): a block allocated two
// calls down and written after it was freed. The report names the block
// and, on the Linux runtime, the program functions that allocated it.
// Run by tests/checked_alloc/run.sh and run-linux.sh. (make_block and fill
// call themselves, which keeps the optimizer from inlining them; the calls
// made here never recurse.)
// expect-checked: Use after free (--checked-alloc): the block of 24 bytes at 0x
// expect-checked: was freed; accessed at offset 16;
// expect-linux: ; allocated in make_block <- fill
@unsafe
fn make_block(extra: i64) -> i64 {
    if extra > 0 {
        return make_block(extra - 1);
    }
    var p: i64 = p_malloc(24);
    *(p as *i64) = 1;
    return p;
}

@unsafe
fn fill(depth: i64) -> i64 {
    if depth > 0 {
        return fill(depth - 1);
    }
    val p: i64 = make_block(0);
    *((p + 16) as *i64) = 3;
    return p;
}

@unsafe
fn main() -> i64 {
    val p: i64 = fill(0);
    print(*((p + 16) as *i64));
    print("\n");
    p_free(p);
    print("freed\n");
    *((p + 16) as *i64) = 9;
    print("written after free\n");
    return 0;
}
