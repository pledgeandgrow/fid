// emit --checked-alloc (release M7): printing an f64 on native Windows
// (stdlib/pe_runtime/base.fd pert_to_str_float) must not touch a freed
// block. Found Nov 18 by `SUITE=1 bash tests/checked_alloc/run.sh`
// (test_autodiff_grad): pert_to_str_float keeps its 512-byte buffer in a
// `str` local (`var back: str = pe_buf_str(buf)`), pe_trim_fraction_zeros
// frees the buffer (p_str_adopt), and the local's drop at the function's end
// then reads the freed buffer's header: "Use after free (--checked-alloc):
// the block of 512 bytes ... accessed at offset -16". A plain build reads
// freed memory and goes on. Run by tests/checked_alloc/run.sh.
// expect-output: loss = 4
// expect-output: 2.5
// expect-output: -0.125
// expect-output: done
fn main() -> i64 {
    val y: f64 = 4.0;
    print("loss = ");
    print(y);
    print("\n");
    println(2.5);
    val z: f64 = 0.0 - 0.125;
    println(z);
    println("done");
    return 0;
}
