// emit --checked-alloc (release M7, complaint CM9): reading a freed block
// faults, and the report names the block. Run by tests/checked_alloc/run.sh.
// expect-checked: Use after free (--checked-alloc): the block of 32 bytes at 0x
// expect-checked: was freed; accessed at offset 8;
// expect-linux: ; allocated in main
@unsafe
fn main() -> i64 {
    var p: i64 = p_malloc(32);
    *((p + 8) as *i64) = 42;
    val a: i64 = *((p + 8) as *i64);
    print(a);
    print("\n");
    p_free(p);
    print("freed\n");
    val v: i64 = *((p + 8) as *i64);
    print(v);
    print("\n");
    return 0;
}
