// emit --checked-alloc: a program that frees correctly runs as usual.
// Run by tests/checked_alloc/run.sh.
// expect-output: 4950
// expect-output: done
@unsafe
fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 100 {
        var p: i64 = p_malloc(24);
        *(p as *i64) = i;
        total = total + *(p as *i64);
        p_free(p);
        i = i + 1;
    }
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    print(total);
    print("\n");
    print("done\n");
    return 0;
}
