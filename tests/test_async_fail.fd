// Test: async/await type violations (Phase 7.6)
//
// This test exercises typechecker violations:
// - await on a non-Future value
// - Using a Future<T> without awaiting it
//
// This test is expected to FAIL under --borrowck=on (default).

pf regular_fn(x: i64) -> i64 {
    ret x + 1;
}

pf main() -> i64 {
    // VIOLATION: await on a non-Future value
    pv x = regular_fn(42);
    pv y = await x;  // ERROR: await requires Future<T>, got i64
    print(y);
    ret 0;
}
