// Test: Lost money bug — COBOL allows this, Fides rejects at compile time.
//
// THE BUG: A programmer withdraws money from an account but forgets
// to do anything with the withdrawn cash. The money just disappears.
// In COBOL, this is a silent runtime bug. In Fides, the linear type
// system catches it — linear values must be consumed (used exactly once).

use banking;
use money;

pf main() -> i64 {
    pv acc = Account_open(1, 100000);

    // Withdraw $200.00 — this produces a new account AND cash
    pv acc_after = Account_withdraw(acc, 20000);
    pv cash = Account_withdraw_cash(20000);

    // BUG: We forgot to use 'cash' — it's just dropped on the floor.
    // In COBOL: the money silently disappears. The books don't balance.
    // In Fides: compile error — 'cash' is linear but was never consumed.
    // The compiler forces us to either deposit it somewhere, return it,
    // or explicitly account for it.

    pv balance = Account_balance_cents(acc_after);
    print(balance);
    ret 0;
}
