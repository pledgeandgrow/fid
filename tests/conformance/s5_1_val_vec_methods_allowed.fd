// Conformance: docs/reference/reference.md §5.1.
// `val` binds a name that cannot be assigned again. It does not freeze the
// value: methods that change a `Vec` may still be called on a `val`.

fn main() -> i64 {
    val v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    v.set(0, 5);
    println(v.get(0) + v.get(1));
    return 0;
}

