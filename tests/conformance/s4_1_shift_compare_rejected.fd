// Conformance: docs/reference/reference.md §4.1.
// `&&` binds tighter than `|`, `^`, `&`, `<<` and `>>`. `flags & 1 != 0`
// parses as `flags & (1 != 0)`; write `(flags & 1) != 0`. `(x & 255) >> 5 !=
// m` is `(x & 255) >> (5 != m)`, a type error.
//! error:

fn main() -> i64 {
    val x: i64 = 255;
    val m: i64 = 7;
    if (x & 255) >> 5 != m { println(1); }
    return 0;
}
