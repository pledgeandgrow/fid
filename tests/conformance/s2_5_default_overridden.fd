// Conformance: docs/reference/reference.md §2.5.
// A method with a body is a default; an impl that leaves it out gets it.

cap Greet {
    fn name(self) -> str;
    fn greet(self) -> str { return "hi " + self.name(); }
}

struct A {
    n: i64,
}

struct B {
    n: i64,
}

impl Greet for B {
    pub fn name(self: B) -> str { return "b"; }
    pub fn greet(self: B) -> str { return "yo " + self.name(); }
}

fn main() -> i64 {
    val b: B = B { n: 1 };
    println(b.greet());
    return 0;
}

//> yo b
