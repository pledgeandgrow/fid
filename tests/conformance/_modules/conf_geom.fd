// A module of the conformance tests (reference §2.9): `use _modules::conf_geom;`.
module conf_geom;

pub struct Rect {
    pub w: i64,
    pub h: i64,
}

pub fn area(w: i64, h: i64) -> i64 { return w * h; }

pub fn scale(x: i64) -> i64 { return x * 2; }

fn secret_helper(x: i64) -> i64 { return x; }
