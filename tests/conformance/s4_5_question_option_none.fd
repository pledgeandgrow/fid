// Conformance: docs/reference/reference.md §4.5.
// `e?` requires `Option<T>` or `Result<T, E>` and has type `T`; on `None` or
// `Err` it returns from the enclosing function with that value.

fn first_even(v: Vec<i64>) -> Option<i64> {
    for x in v {
        if x % 2 == 0 { return Option::Some(x); }
    }
    return Option::None;
}

fn plus_one(v: Vec<i64>) -> Option<i64> {
    val e: i64 = first_even(v)?;
    return Option::Some(e + 1);
}

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(3);
    println(plus_one(v).is_none());
    return 0;
}

//> true
