// Conformance: docs/reference/reference.md §9.4.
// `do E.op(args)` inside the `handle` block runs the matching handler with the
// arguments bound to its names (as `i64`). `resume(cont, v)` runs the rest of
// the `handle` block after the `do`.

fn main() -> i64 {
    handle {
        do Log.write(5);
    } with {
        Log.write(v) => {
            println(v * 10);
        }
    }
    return 0;
}

