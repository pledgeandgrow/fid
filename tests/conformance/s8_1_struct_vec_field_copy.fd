// Conformance: docs/reference/reference.md §8.1.
// Copying a struct copies the collections it holds the same way: after `var t
// = s; t.v.push(2)`, `s.v` is unchanged.

struct S {
    v: Vec<i64>,
    m: HashMap<str, i64>,
}

fn main() -> i64 {
    var s: S = S { v: Vec::new(), m: HashMap::new() };
    s.v.push(1);
    var t: S = s;
    t.v.push(2);
    println(s.v.len());
    println(t.v.len());
    return 0;
}

//> 1
//> 2
