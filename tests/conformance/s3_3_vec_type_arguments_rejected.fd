// Conformance: docs/reference/reference.md §3.3.
// Two instances of Vec with different type arguments are different types: a
// `Vec<str>` is not assigned to a `Vec<i64>` variable (before, any two
// instances were compatible, and the strings were read as integers).
//! error: cannot assign Vec<str> to variable

fn main() -> i64 {
    var words: Vec<str> = Vec::new();
    words.push("hello");
    val nums: Vec<i64> = words;
    println(nums.len());
    return 0;
}
