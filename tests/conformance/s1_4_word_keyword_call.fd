// Conformance: docs/reference/reference.md §1.4.
// The word keywords ... may also be used as the name of a function ... A keyword that starts a statement still does so there.

fn handle(a: i64) -> i64 { return a + 1; }

fn main() -> i64 {
    var s: i64 = 0;
    s = (s + handle(2)) % 7;
    println(s);
    return 0;
}

