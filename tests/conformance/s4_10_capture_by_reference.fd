// Conformance: docs/reference/reference.md §4.10.
// A closure captures the variables it names by value when it is created; the
// values are copied into an environment. To capture by reference, capture a
// `&` or `&mut`.

fn main() -> i64 {
    var count: i64 = 0;
    val r: &mut i64 = &mut count;
    val inc = fn() { *r = *r + 1; };
    inc();
    inc();
    println(count);
    return 0;
}

