// Conformance: docs/reference/reference.md §2.3.
// `==` on enum values compares the tag and the payload.

enum V {
    A,
    B(i64),
    C(i64, i64),
}

fn main() -> i64 {
    println(V::C(1, 2) == V::C(1, 2));
    println(V::C(1, 2) == V::C(1, 3));
    println(V::C(1, 2) != V::C(2, 2));
    return 0;
}

//> true
//> false
//> true
