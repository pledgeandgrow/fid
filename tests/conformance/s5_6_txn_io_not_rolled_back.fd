// Conformance: docs/reference/reference.md §5.6.
// `txn { }`, `abort;`: at entry each live local is snapshotted; `abort;` puts
// every one back and leaves the innermost txn; reaching the end keeps the
// changes. IO is not rolled back.

fn main() -> i64 {
    txn {
        println("printed");
        abort;
    }
    println("after");
    return 0;
}

//> printed
//> after
