// Conformance: docs/reference/reference.md §1.9.
// When a generic argument list is closed, a `>>`, `>>=` or `>=` token is split
// so that its first `>` closes the list: `Vec<Vec<i64>>` parses.

fn main() -> i64 {
    var m: HashMap<str, Vec<i64>> = HashMap::new();
    var v: Vec<i64> = Vec::new();
    v.push(1);
    m.insert("a", v);
    println(m.len());
    return 0;
}

//> 1
