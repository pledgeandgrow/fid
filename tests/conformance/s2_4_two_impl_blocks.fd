// Conformance: docs/reference/reference.md §2.4.
// A type may have several `impl` blocks.

struct Ctr {
    n: i64,
}

impl Ctr {
    fn a(self) -> i64 { return self.n + 1; }
}

impl Ctr {
    fn b(self) -> i64 { return self.n + 2; }
}

fn main() -> i64 {
    val c: Ctr = Ctr { n: 10 };
    println(c.a() + c.b());
    return 0;
}

//> 23
