// Conformance: docs/reference/reference.md §2.1.
// Default values: `fn add(a: i64, b: i64 = 10)`. A call may leave out trailing parameters that have defaults.

fn add(a: i64, b: i64 = 10) -> i64 { return a + b; }

fn main() -> i64 {
    println(add(1));
    println(add(1, 2));
    return 0;
}

//> 11
//> 3
