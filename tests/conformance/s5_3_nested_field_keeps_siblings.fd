// Conformance: docs/reference/reference.md §5.3.
// `p.x.y = v` assigns a nested field.

struct In {
    y: i64,
}

struct Out {
    x: In,
    z: i64,
}

fn main() -> i64 {
    var p: Out = Out { x: In { y: 1 }, z: 2 };
    p.x.y = 7;
    println(p.z);
    println(p.x.y);
    return 0;
}

//> 2
//> 7
