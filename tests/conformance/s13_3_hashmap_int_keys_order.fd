// Conformance: docs/reference/reference.md §13.3 (decided Nov 17).
// `m.keys()` gives the keys in ascending order, integer keys by value, and
// `m.values()` the values in that order, whatever the insertion order.
// (String keys: tests/verify/bugs/d22_hashmap_str_keys_order.fd, open.)

fn main() -> i64 {
    var m: HashMap<i64, i64> = HashMap::new();
    m.insert(40, 4);
    m.insert(-5, 0);
    m.insert(10, 1);
    m.insert(1000, 9);
    m.insert(25, 2);
    val ks: Vec<i64> = m.keys();
    val vs: Vec<i64> = m.values();
    var i: i64 = 0;
    while i < ks.len() {
        println(int_to_str(ks.get(i)) + " " + int_to_str(vs.get(i)));
        i = i + 1;
    }
    return 0;
}

//> -5 0
//> 10 1
//> 25 2
//> 40 4
//> 1000 9
