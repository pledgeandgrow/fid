// Conformance: docs/reference/reference.md §8.3.
// For a local declared with an explicit struct type whose struct has a method
// `drop`, that method is called at function exit, last declared first.

struct R {
    id: i64,
}

impl R {
    fn drop(self) { println("drop " + int_to_str(self.id)); }
}

fn work() {
    val r: R = R { id: 7 };
    println("work");
}

fn main() -> i64 {
    work();
    println("after");
    return 0;
}

//> work
//> drop 7
//> after
