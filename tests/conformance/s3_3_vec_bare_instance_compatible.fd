// Conformance: docs/reference/reference.md §3.3.
// A `Vec` written without type arguments names no element type, so it is
// compatible with any `Vec<T>`. Two instances that name different type
// arguments are not (s3_3_vec_type_arguments_rejected.fd); until Nov 23 any
// two instances were compatible.

fn take(v: Vec<i64>) -> i64 {
    return v.len();
}

fn main() -> i64 {
    val a = Vec::new();
    println(take(a));
    return 0;
}

//> 0
