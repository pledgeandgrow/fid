// Conformance: docs/reference/reference.md §2.4.
// Annotations on a method (CU3, parse_impl_or_trait_impl: `@deprecated(use =
// "m2") fn m`) are read; reference §2.4 still says `@x fn` inside an `impl`
// block is a parse error, which the compiler no longer does.

struct Ctr {
    n: i64,
}

impl Ctr {
    @no-alloc fn get(self) -> i64 { return self.n; }
}

fn main() -> i64 {
    val c: Ctr = Ctr { n: 3 };
    println(c.get());
    return 0;
}

//> 3
