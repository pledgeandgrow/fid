// Conformance: docs/reference/reference.md §8.4.
// A reference may not outlive the block of what it points to.

fn main() -> i64 {
    var a: i64 = 1;
    var r: &i64 = &a;
    {
        var b: i64 = 2;
        val s: &i64 = &b;
        println(*s);
    }
    println(*r);
    return 0;
}

//> 2
//> 1
