// Conformance: docs/reference/reference.md §3.4.
// An assigned value has the variable's type: a `bool` is not assigned to an
// integer variable, nor a number to a `bool` one.
//! error: cannot assign bool to variable

fn main() -> i64 {
    var x: i64 = 5;
    x = true;
    var b: bool = false;
    b = 1;
    println(x);
    return 0;
}
