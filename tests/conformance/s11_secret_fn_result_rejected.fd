// Conformance: docs/reference/reference.md §11.
// `@secret`, `@sensitive`: the value may not reach an output, log, file,
// network, global, spawn or call through a function value; a `@secret`
// function's result is secret.
//! error:

@secret
fn key() -> i64 { return 42; }

fn main() -> i64 {
    println(key());
    return 0;
}
