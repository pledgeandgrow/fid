// Conformance: docs/reference/reference.md §4.11.
// `gensym("helper")` in the block gives a name nothing in the program declares
// (`helper__gs1`, …).

fn helper() -> i64 { return 1; }

fn main() -> i64 {
    comptime gen {
        val n: str = gensym("helper");
        return "fn " + n + "() -> i64 { return 2; } fn use_gen() -> i64 { return " + n + "() * 10; }";
    }
    println(helper() + use_gen());
    return 0;
}

//> 21
