// Conformance: docs/reference/reference.md §1.7.
// `'c'` is an integer literal whose value is the Unicode scalar value of the character. Escapes: `\n` `\t` ... `\xHH` `\u{H…}`.

fn main() -> i64 {
    println('A');
    println('\n');
    println('\x41');
    println('\u{e9}');
    println('\0');
    return 0;
}

//> 65
//> 10
//> 65
//> 233
//> 0
