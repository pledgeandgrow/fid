// Conformance: docs/reference/reference.md §5.3.
// A by-value parameter of type `Vec`, `HashMap` or a struct may not be changed
// — by assignment to it or its fields, or by a method that changes it —
// because the caller would not see the change. (Reading it is allowed.)

fn total(v: Vec<i64>) -> i64 {
    var s: i64 = 0;
    for x in v { s = s + x; }
    return s;
}

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(2);
    v.push(3);
    println(total(v));
    return 0;
}

//> 5
