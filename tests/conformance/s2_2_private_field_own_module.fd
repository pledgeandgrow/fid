// Conformance: docs/reference/reference.md §2.2.
// A field without `pub` is private to the module that declares the struct:
// reading it from another module is an error.

struct Counter {
    count: i64,
}

fn main() -> i64 {
    val c: Counter = Counter { count: 3 };
    println(c.count);
    return 0;
}

//> 3
