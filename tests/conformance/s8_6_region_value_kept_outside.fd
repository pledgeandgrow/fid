// Conformance: docs/reference/reference.md §8.6.
// `region r { … }` is a scope. A variable declared in a region is not visible
// after it. A value kept by something outside the region is kept.

fn main() -> i64 {
    var keep: Vec<str> = Vec::new();
    region r {
        val s: str = "in" + "side";
        keep.push(s);
    }
    println(keep.get(0));
    return 0;
}

//> inside
