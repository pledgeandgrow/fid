// Conformance: docs/reference/reference.md §8.3.
// When the compiler cannot prove a value is finished with, it leaves it
// allocated. Everything else lives until the process exits.

fn make() -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push("kept");
    return v;
}

fn main() -> i64 {
    val v: Vec<str> = make();
    println(v.get(0));
    return 0;
}

//> kept
