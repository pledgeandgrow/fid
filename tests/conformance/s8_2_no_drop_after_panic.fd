// Conformance: docs/reference/reference.md §8.2.
// Nothing unwinds: no drop or cleanup code runs after a panic.

struct R {
    id: i64,
}

impl R {
    fn drop(self) { println("dropped"); }
}

fn main() -> i64 {
    val r: R = R { id: 1 };
    println("start");
    panic("x");
    return 0;
}

//> start
//! panic
