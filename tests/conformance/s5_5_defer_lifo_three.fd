// Conformance: docs/reference/reference.md §5.5.
// `defer { stmts }` (braces are required). The deferred blocks of a function
// run when it returns, last registered first.

fn main() -> i64 {
    defer { println("one"); }
    defer { println("two"); }
    defer { println("three"); }
    println("body");
    return 0;
}

//> body
//> three
//> two
//> one
