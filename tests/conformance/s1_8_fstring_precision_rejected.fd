// Conformance: docs/reference/reference.md §1.8.
// There are no format specifiers: the braces hold one expression, and text
// after it (`{x:.3}`) is an error. Before, that text was dropped without a
// word and the f-string printed `1.5`.
//! error: text follows the expression

fn main() -> i64 {
    val x: f64 = 1.5;
    println(f"{x:.3}");
    return 0;
}
