// Conformance: docs/reference/reference.md §4.2.
// `+` on two `str` values concatenates. `==` on two `str` values compares text.

fn main() -> i64 {
    val a: str = "ab";
    val b: str = a + "cd";
    println(b);
    if b == "abcd" { println(1); } else { println(0); }
    return 0;
}

//> abcd
//> 1
