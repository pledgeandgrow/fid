// Conformance: docs/reference/reference.md §7.2.
// Type arguments are inferred from the arguments, and from the expected type.

fn pick<T>(c: bool, a: T, b: T) -> T {
    if c { return a; }
    return b;
}

fn main() -> i64 {
    println(pick(true, 1, 2));
    println(pick(false, "x", "y"));
    return 0;
}

//> 1
//> y
