// Conformance: docs/reference/reference.md §1.5.
// A decimal literal above `i64::MAX` keeps its 64 bits (`lex_parse_int`
// wraps), so `18446744073709551615` is valid for a `u64`.

fn main() -> i64 {
    val w: u64 = 18446744073709551615;
    val v: u64 = 5;
    if w > v { println(1); } else { println(0); }
    return 0;
}

//> 1
