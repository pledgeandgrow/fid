// Conformance: docs/reference/reference.md §7.1.
// Generic functions are monomorphised: each set of type arguments gets its own
// copy.

fn pair_str<T>(a: T, b: T) -> str { return f"{a},{b}"; }

fn main() -> i64 {
    println(pair_str(1, 2));
    println(pair_str("x", "y"));
    println(pair_str(true, false));
    return 0;
}

//> 1,2
//> x,y
//> true,false
