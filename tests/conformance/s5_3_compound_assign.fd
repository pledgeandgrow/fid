// Conformance: docs/reference/reference.md §5.3.
// op = `=` | `+=` | `-=` | `*=` | `/=` | `%=` | `&=` | `|=` | `^=` | `<<=` | `>>=`

fn main() -> i64 {
    var x: i64 = 5;
    x += 3;
    x *= 4;
    x -= 2;
    x /= 3;
    x %= 7;
    x <<= 3;
    x |= 5;
    x &= 29;
    x ^= 1;
    x >>= 1;
    println(x);
    return 0;
}

//> 14
