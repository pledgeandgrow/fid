// Conformance: docs/reference/reference.md §6.
// A bare name binds the value and matches anything. This includes a unit
// variant written without its enum. Write `Option::None`.

fn main() -> i64 {
    val o: Option<i64> = Option::None;
    match o {
        Option::Some(v) => { println(v); }
        Option::None => { println("none"); }
    }
    return 0;
}

//> none
