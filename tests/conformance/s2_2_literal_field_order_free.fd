// Conformance: docs/reference/reference.md §2.2.
// A struct literal names every field it sets: `Point { x: 1, y: 2 }`. A field
// left out is not reported.

struct Point {
    x: i64,
    y: i64,
}

fn main() -> i64 {
    val p: Point = Point { y: 2, x: 1 };
    println(p.x * 10 + p.y);
    return 0;
}

//> 12
