// Conformance: docs/reference/reference.md §8.1.
// Numbers, `bool`, structs, enums, tuples and arrays are values: assignment
// and by-value passing copy them.

struct N {
    s: str,
    n: i64,
}

fn main() -> i64 {
    var a: N = N { s: "a", n: 1 };
    var b: N = a;
    b.s = "b";
    b.n = 2;
    println(a.s);
    println(a.n);
    return 0;
}

//> a
//> 1
