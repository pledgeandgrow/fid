// Conformance: docs/reference/reference.md §4.6.
// A cast that makes a collection out of a number needs `unsafe`: a push
// would write through the word.
//! error: needs an `unsafe` block

fn main() -> i64 {
    var n: i64 = 7;
    val v: Vec<i64> = n as Vec<i64>;
    println(v.len());
    return 0;
}
