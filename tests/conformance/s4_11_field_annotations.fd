// Conformance: docs/reference/reference.md §4.11.
// A struct field carries @annotations (as a parameter does), and
// annotation reflection reads them: the names on a struct
// (struct_annotations) or one of its fields (field_annotations), so
// compile-time code can act on the safety annotations a declaration
// carries.

struct User {
    name: str,
    @secret token: str,
    age: i64,
}

@packed
struct Cfg { a: i64 }

fn main() -> i64 {
    val token_anns: Vec<str> = comptime field_annotations("User", "token");
    println(token_anns.get(0));
    val name_anns: Vec<str> = comptime field_annotations("User", "name");
    println(int_to_str(name_anns.len()));
    val sanns: Vec<str> = comptime struct_annotations("Cfg");
    println(sanns.get(0));
    return 0;
}

//> secret
//> 0
//> packed
