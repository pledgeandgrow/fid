// Conformance: docs/reference/reference.md §2.3.
// A variant is constructed with its enum's name: `Option::Some(5)`,
// `Shape::Empty`. A bare `Some(5)` is a call of an undefined function `Some`.
//! error:

enum E {
    One(i64),
}

fn main() -> i64 {
    val e: E = One(5);
    println(1);
    return 0;
}
