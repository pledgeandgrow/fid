// Conformance: docs/reference/reference.md §5.1.
// `val` binds a name that cannot be assigned again. It does not freeze the
// value: assigning a field of a `val` struct does not assign the name.

struct P {
    x: i64,
}

fn main() -> i64 {
    val p: P = P { x: 1 };
    p.x = 2;
    println(p.x);
    return 0;
}

//> 2
