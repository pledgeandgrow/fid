// Conformance: docs/reference/reference.md §13.3.
// `HashMap<K, V>`: `insert`, `get`, `contains`, `remove`, `len`, `get_or`, ...

fn main() -> i64 {
    var m: HashMap<str, i64> = HashMap::new();
    m.insert("a", 1);
    m.insert("b", 2);
    m.insert("a", 3);
    println(m.len());
    println(m.get_or("a", 0));
    println(m.get_or("z", 7));
    if m.contains("b") { println(1); } else { println(0); }
    m.remove("b");
    println(m.len());
    return 0;
}

//> 2
//> 3
//> 7
//> 1
//> 1
