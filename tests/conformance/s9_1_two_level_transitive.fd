// Conformance: docs/reference/reference.md §9.1.
// A function declares effects after its return type: `!IO`, `!{IO, Net}`, or
// `!{}` for none. For a top-level function with a declaration, an inferred
// effect that is not declared is an error.
//! error: IO

fn leaf() {
    println("x");
}

fn mid() {
    leaf();
}

fn top() -> i64 !{} {
    mid();
    return 1;
}

fn main() -> i64 {
    println(top());
    return 0;
}
