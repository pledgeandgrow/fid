// Conformance: docs/reference/reference.md §13.3.
// `m.keys()` gives the keys in ascending order: integer keys by value, `str`
// keys byte by byte as `str_compare`. `m.values()` gives the values in the
// order of `m.keys()`.

fn main() -> i64 {
    var m: HashMap<str, i64> = HashMap::new();
    m.insert("b", 2);
    m.insert("a", 1);
    m.insert("c", 3);
    println(m.values());
    return 0;
}

//> [1, 2, 3]
