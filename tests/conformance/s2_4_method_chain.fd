// Conformance: docs/reference/reference.md §2.4.
// Methods are called as `value.method(args)`. A function of the block whose
// first parameter is not `self` is called as `Name::function(args)`.

struct Ctr {
    n: i64,
}

impl Ctr {
    fn add(self, k: i64) -> Ctr { return Ctr { n: self.n + k }; }
}

fn main() -> i64 {
    val c: Ctr = Ctr { n: 1 };
    println(c.add(2).add(3).n);
    return 0;
}

//> 6
