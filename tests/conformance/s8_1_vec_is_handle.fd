// Conformance: docs/reference/reference.md §8.1.
// A Vec behaves as a value: assigning one gives an independent value. The
// data is shared until one side writes; the first write copies it (proposal
// 0004, lower.fd LOWER_RC). (The file name is from when §8.1 called a Vec a
// handle; settled Nov 16, LG1.)

fn main() -> i64 {
    var a: Vec<i64> = Vec::new();
    a.push(1);
    var b = a;
    b.set(0, 99);
    b.push(2);
    println(a.len());
    println(a.get(0));
    println(b.len());
    println(b.get(0));
    return 0;
}

//> 1
//> 1
//> 2
//> 99
