// Conformance: docs/reference/reference.md §4.11.
// `inline for v in a..b { .. }` unrolls while compiling: one copy of the
// body per iteration with the loop variable a comptime-known literal, so
// comptime expressions over it compute.

const N: i64 = 5;

fn main() -> i64 {
    var s: i64 = 0;
    inline for i in 0..N {
        s = s + comptime (i * i);
    }
    inline for j in 0..2 {
        println("iter");
    }
    println(int_to_str(s));
    return 0;
}

//> iter
//> iter
//> 30
