// Conformance: docs/reference/reference.md §4.1.
// `as` is a postfix operator ... `a + b as i64` is `a + (b as i64)`.

fn main() -> i64 {
    val b: i32 = 5;
    val a: i64 = 10;
    val c: i64 = a + b as i64;
    println(c);
    val x: i64 = 300;
    println(-x as i32);
    return 0;
}

//> 15
//> -300
