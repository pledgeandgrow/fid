// Conformance: docs/reference/reference.md §12.
// `@cfg(…)` on a function or a struct keeps the item only when every argument
// holds. `target_arch = "x86_64"`, `arch = "x86_64"`: always. (compiler.fd
// cfg_arch_is now reads the target's architecture, x86_64 on the host: so the
// test runs on the x86_64 backends.)
//@ backends: run,ccompile,emit,nat,x86_64-linux

@cfg(target_arch = "x86_64")
fn a() -> i64 { return 64; }

fn main() -> i64 {
    println(a());
    return 0;
}

//> 64
