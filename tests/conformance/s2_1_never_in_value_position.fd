// Conformance: docs/reference/reference.md §2.1.
// `-> !` means the function never returns (`Type::Never`). (A diverging branch
// takes the other branch's type, §4.7.)

fn die() -> ! {
    panic("stop");
}

fn main() -> i64 {
    val a: i64 = 5;
    val v: i64 = if a > 0 { a * 2 } else { die() };
    println(v);
    return 0;
}

//> 10
