// Conformance: docs/reference/reference.md §4.4.
// `e.f` reads a field; through a reference it reads the referent's field.

struct P {
    x: i64,
    y: i64,
}

struct L {
    a: P,
    b: P,
}

fn main() -> i64 {
    val l: L = L { a: P { x: 1, y: 2 }, b: P { x: 3, y: 4 } };
    println(l.b.y);
    return 0;
}

//> 4
