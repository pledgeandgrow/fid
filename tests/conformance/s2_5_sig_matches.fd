// Conformance: docs/reference/reference.md §2.5.
// An impl method's parameter count, parameter types and return type are
// compared with the trait's wherever the trait writes a concrete type.

cap Area {
    fn area(self, scale: i64) -> i64;
}

struct Sq {
    s: i64,
}

impl Area for Sq {
    pub fn area(self: Sq, scale: i64) -> i64 { return self.s * self.s * scale; }
}

fn main() -> i64 {
    val q: Sq = Sq { s: 3 };
    println(q.area(2));
    return 0;
}

