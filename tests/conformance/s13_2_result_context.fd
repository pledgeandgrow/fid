// Conformance: docs/reference/reference.md §13.2.
// `Result`: `is_ok`, `is_err`, `unwrap`, `unwrap_or`, `ok`, `err`, `map`,
// `map_err`, `and_then`, `unwrap_or_else`, `expect`, `context(msg)`,
// `with_context(f)`.

fn main() -> i64 {
    val ok: Result<i64, str> = Result::Ok(6);
    val bad: Result<i64, str> = Result::Err("boom");
    val r = bad.context("loading");
    println(r.err().unwrap());
    println(ok.context("x").unwrap());
    return 0;
}

//> loading: boom
//> 6
