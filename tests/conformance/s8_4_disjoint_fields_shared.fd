// Conformance: docs/reference/reference.md §8.4.
// `&s.x` and `&s.y` may coexist.

struct P {
    x: i64,
    y: i64,
}

fn main() -> i64 {
    var p: P = P { x: 1, y: 2 };
    val a: &i64 = &p.x;
    val b: &mut i64 = &mut p.y;
    *b = 7;
    println(*a);
    println(p.y);
    return 0;
}

//> 1
//> 7
