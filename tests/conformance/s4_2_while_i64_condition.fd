// Conformance: docs/reference/reference.md §4.2.
// `if` and `while` conditions must be `bool`, `i32` or `i64`. An integer
// literal alone is an `i8` and is rejected.

fn main() -> i64 {
    var k: i64 = 3;
    var steps: i64 = 0;
    while k {
        k = k - 1;
        steps = steps + 1;
    }
    println(steps);
    return 0;
}

//> 3
