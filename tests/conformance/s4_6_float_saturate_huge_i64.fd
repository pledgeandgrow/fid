// Conformance: docs/reference/reference.md §4.6.
// A float value outside the target's range gives the nearest end of the range
// (`1.0e300 as i64` is `9223372036854775807`, `-5.5 as u8` is 0, `300.7 as u8`
// is 255), +∞ the maximum, −∞ the minimum, NaN gives 0. A cast never panics.
// (Open: miscompile-log D21, tests/verify/bugs/d21_float_to_int_saturates.fd.)

fn main() -> i64 {
    val f: f64 = 1.0e300;
    val n: i64 = f as i64;
    println(n);
    return 0;
}

//> 9223372036854775807
