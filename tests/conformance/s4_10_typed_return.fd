// Conformance: docs/reference/reference.md §4.10.
// `fn(params) [-> type] (block | => expr)`; without `-> type` the return type
// is inferred from the body and its `return` statements.

fn main() -> i64 {
    val f = fn(a: i64, b: i64) -> i64 { return a * b; };
    println(f(6, 7));
    return 0;
}

//> 42
