// Conformance: docs/reference/reference.md §11.
// `@derive(…)` (struct): generates `S_clone` (Clone), `S_default` (Default),
// `S_equals` (PartialEq, Eq), `S_debug_str` (Debug), `S_to_json` (Serialize).

@derive(Clone)
struct D {
    a: i64,
    s: str,
}

fn main() -> i64 {
    val d: D = D { a: 1, s: "x" };
    val e: D = D_clone(d);
    println(e.a);
    println(e.s);
    return 0;
}

//> 1
//> x
