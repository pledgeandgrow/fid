// Conformance: docs/reference/reference.md §12.
// `@cfg(…)` on a function or a struct keeps the item only when every argument
// holds. (`feature = "…"` holds for a feature ark turned on: none here.)

@cfg(feature = "zz_not_on")
fn feat() -> i64 { return 1; }

@cfg(release)
fn feat() -> i64 { return 0; }

fn main() -> i64 {
    println(feat());
    return 0;
}

//> 0
