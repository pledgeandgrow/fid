// Conformance: docs/reference/reference.md §5.4.
// `for x in v` iterates a `Vec` (elements), an array (elements) or a `HashMap` (keys).

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(4);
    v.push(5);
    var s: i64 = 0;
    for x in v { s = s * 10 + x; }
    println(s);
    return 0;
}

