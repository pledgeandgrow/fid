// Conformance: docs/reference/reference.md §2.1.
// `given e` is a precondition. A call whose arguments are constants and make
// `e` false is a compile error; there is no run-time check.
//! error: precondition

fn div(a: i64, b: i64) -> i64
    given b != 0, given a >= 0
{
    return a / b;
}

fn main() -> i64 {
    println(div(-9, 3));
    return 0;
}
