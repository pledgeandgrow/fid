// Conformance: docs/reference/reference.md §8.2.
// A panic ends the program. It is never caught and never confined to the task
// or thread that raised it: a panic in a spawned task ends the whole program
// as one in `main` does.

fn boom() -> i64 {
    panic("in task");
    return 0;
}

fn main() -> i64 {
    println("start");
    val f = spawn boom();
    val r: i64 = await f;
    println("after");
    println(r);
    return 0;
}

//> start
//! panic
