// Conformance: docs/reference/reference.md §13.3.
// `HashMap<K, V>`: `HashMap::new()`, `insert`, `get`, `contains`, `remove`,
// `len`, `is_empty`, `clear`, `get_or`, `keys`, `values`, `clone`. Without
// type arguments it is `HashMap<str, i64>`.

fn main() -> i64 {
    var m: HashMap = HashMap::new();
    m.insert("k", 5);
    println(m.get("k") + 1);
    return 0;
}

