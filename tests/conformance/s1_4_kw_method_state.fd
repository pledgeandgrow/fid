// Conformance: docs/reference/reference.md §1.4.
// The word keywords (all but the type names) may also be used as the name of a
// function, method, parameter, field or local variable. (Here a method.)

struct C {
    n: i64,
}

impl C {
    fn state(self) -> i64 { return self.n + 100; }
}

fn main() -> i64 {
    val c: C = C { n: 5 };
    println(c.state());
    return 0;
}

//> 105
