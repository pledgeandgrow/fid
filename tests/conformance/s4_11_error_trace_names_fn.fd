// Conformance: docs/reference/reference.md §4.11.
// A comptime error carries the chain of comptime calls that produced it.
//! error: in comptime fn 'half'

comptime fn half(n: i64) -> i64 { return n / 0; }

fn main() -> i64 {
    val x = comptime half(8);
    println(int_to_str(x));
    return 0;
}
