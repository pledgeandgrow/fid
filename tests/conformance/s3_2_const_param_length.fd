// Conformance: docs/reference/reference.md §3.2.
// `N` is an integer literal or, in a generic function, a const parameter name.
// (`for x in a` walks an array's elements, §5.4.)

fn total<N: i64>(a: [i64; N]) -> i64 {
    var s: i64 = 0;
    for x in a { s = s + x; }
    return s;
}

fn main() -> i64 {
    val a: [i64; 3] = [1, 2, 3];
    val b: [i64; 2] = [10, 20];
    println(total(a));
    println(total(b));
    return 0;
}

//> 6
//> 30
