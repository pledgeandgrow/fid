// Conformance: docs/reference/reference.md §4.6.
// A cast that makes a reference out of a number needs `unsafe`: `*r` of a
// reference is read without a check, so the word must be an address.
//! error: needs an `unsafe` block

fn main() -> i64 {
    var n: i64 = 128;
    val r: &i64 = n as & i64;
    println(1);
    return 0;
}
