// Conformance: docs/reference/reference.md §11.
// `@no-alloc`: no allocating call or method (`push`, `Vec::new`, string `+`,
// …).
//! error:

@no-alloc
fn f(v: &mut Vec<i64>) { v.push(1); }

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    f(&mut v);
    println(v.len());
    return 0;
}
