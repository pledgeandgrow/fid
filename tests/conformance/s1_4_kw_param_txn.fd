// Conformance: docs/reference/reference.md §1.4.
// The word keywords (all but the type names) may also be used as the name of a
// function, method, parameter, field or local variable. (Here a parameter.)

fn twice(x: i64, txn: i64) -> i64 { return x + txn * 2; }

fn main() -> i64 {
    println(twice(1, 4));
    return 0;
}

