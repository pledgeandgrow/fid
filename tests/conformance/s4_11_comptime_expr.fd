// Conformance: docs/reference/reference.md §4.11.
// `comptime e` and `comptime { stmts }` are evaluated while compiling.

fn fact(n: i64) -> i64 {
    if n <= 1 { return 1; }
    return n * fact(n - 1);
}

fn main() -> i64 {
    val x: i64 = comptime fact(5);
    println(x);
    return 0;
}

//> 120
