// Conformance: docs/reference/reference.md §4.1.
// `??` (level 2) is below `+` (level 12): `o ?? 1 + 2` is `o ?? (1 + 2)`.

fn main() -> i64 {
    val o: Option<i64> = Option::None;
    val p: Option<i64> = Option::Some(10);
    println(o ?? 1 + 2);
    println(p ?? 1 + 2);
    return 0;
}

//> 3
//> 10
