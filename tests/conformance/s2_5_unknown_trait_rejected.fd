// Conformance: docs/reference/reference.md §2.5.
// An impl must provide every method without a default and every associated
// type, and the trait must exist.
//! error:

struct S {
    v: i64,
}

impl NoSuchTrait for S {
    pub fn one(self: S) -> i64 { return 1; }
}

fn main() -> i64 {
    val s: S = S { v: 0 };
    println(s.one());
    return 0;
}
