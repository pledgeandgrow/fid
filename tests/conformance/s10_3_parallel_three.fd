// Conformance: docs/reference/reference.md §10.3.
// Branches are separated by `|`. `x = f(…)` is spawned and `x` gets the result
// when the threads are joined. All threads are joined before the statement
// ends.

fn fib(n: i64) -> i64 {
    if n < 2 { return n; }
    return fib(n - 1) + fib(n - 2);
}

fn main() -> i64 {
    var a: i64 = 0;
    var b: i64 = 0;
    var c: i64 = 0;
    parallel {
        | a = fib(5);
        | b = fib(6);
        | c = fib(7);
    }
    println(a + b + c);
    return 0;
}

//> 26
