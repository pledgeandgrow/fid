// Conformance: docs/reference/reference.md §3.3.
// It accepts raw pointers with the same mutability and compatible pointees,
// `&T` to `*T`, a raw pointer to an integer, and an integer to a raw pointer
// only inside `unsafe`.

fn main() -> i64 {
    var x: i64 = 5;
    val p: *mut i64 = &mut x;
    unsafe {
        println(*p);
    }
    return 0;
}

//> 5
