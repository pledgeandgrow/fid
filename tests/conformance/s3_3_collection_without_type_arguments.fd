// Conformance: docs/reference/reference.md §3.3 and §13.3.
// What names no type arguments stands for any instance of its type: a bare
// `Vec`, and `HashMap::new()` where a declared type says other arguments
// than its default `<str, i64>`.

fn main() -> i64 {
    var counts: HashMap<i64, i64> = HashMap::new();
    counts.insert(1, 2);
    val words: Vec<str> = Vec::new();
    words.push("a");
    val bare = Vec::new();
    bare.push(3);
    println(counts.get(1));
    println(words.get(0));
    println(bare.get(0));
    return 0;
}

//> 2
//> a
//> 3
