// Conformance: docs/reference/reference.md §9.1.
// A call from a function with a declaration to a method whose declared effects
// it lacks is an error.
//! error:

struct L {
    n: i64,
}

impl L {
    fn log(self) !IO {
        println(self.n);
    }
}

fn quiet(l: L) !{} {
    l.log();
}

fn main() -> i64 {
    quiet(L { n: 1 });
    return 0;
}
