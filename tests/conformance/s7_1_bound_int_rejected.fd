// Conformance: docs/reference/reference.md §7.1.
// `T: A + B` bounds a type parameter by one or more traits; every bound is
// checked at each call. (`i64 does not implement Show (required by T: Show in
// 'twice')`, §7.2)
//! error: does not implement Show

cap Show {
    fn show(self) -> str;
}

cap Size {
    fn size(self) -> i64;
}

struct W {
    n: i64,
}

impl Show for W {
    pub fn show(self: W) -> str { return "w" + int_to_str(self.n); }
}

impl Size for W {
    pub fn size(self: W) -> i64 { return self.n; }
}

struct OnlyShow {
    n: i64,
}

impl Show for OnlyShow {
    pub fn show(self: OnlyShow) -> str { return "o"; }
}

fn describe<T: Show + Size>(x: T) -> str { return x.show() + ":" + int_to_str(x.size()); }

fn twice<T: Show>(x: T) -> str { return x.show() + x.show(); }

fn main() -> i64 {
    println(twice(5));
    return 0;
}
