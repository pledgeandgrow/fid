// Conformance: docs/reference/reference.md §8.6.
// `region r with budget(N) { … }` adds up the compile-time sizes of the
// `val`/`var` declarations in the block (an integer's width in bytes, 8 per
// `f64` or reference, 16 per `str`, 24 per `Vec`, 48 per `HashMap`, 8 per
// struct field) and reports an error when the sum exceeds `N`.
//! error:

struct P3 {
    a: i64,
    b: i64,
    c: i64,
}

fn main() -> i64 {
    region r with budget(23) {
        val p: P3 = P3 { a: 1, b: 2, c: 3 };
        println(p.a);
    }
    return 0;
}
