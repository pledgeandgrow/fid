// Conformance: docs/reference/reference.md §9.1.
// Higher-order functions are effect-polymorphic: each call of `apply` adds the
// effects of the function passed. So a `!{}` function may call
// `apply(pure_inc, 41)`.

fn apply(f: fn(i64) -> i64, x: i64) -> i64 { return f(x); }

fn pure_inc(x: i64) -> i64 { return x + 1; }

fn loud_inc(x: i64) -> i64 {
    println("inc");
    return x + 1;
}

fn calc() -> i64 !IO {
    return apply(loud_inc, 1);
}

fn main() -> i64 {
    println(calc());
    return 0;
}

//> inc
//> 2
