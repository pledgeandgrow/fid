// Conformance: docs/reference/reference.md §8.7.
// A struct annotated `@linear` is used exactly once. Using it inside a loop is
// an error.
//! error:

@linear
struct Coin {
    v: i64,
}

fn spend(c: Coin) -> i64 { return c.v; }

fn main() -> i64 {
    val c: Coin = Coin { v: 5 };
    for i in 0..1 {
        println(spend(c));
    }
    return 0;
}
