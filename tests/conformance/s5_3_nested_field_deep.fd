// Conformance: docs/reference/reference.md §5.3.
// `p.x.y = v` assigns a nested field.

struct In {
    y: i64,
}

struct Out {
    x: In,
    z: i64,
}

struct Top {
    o: Out,
}

fn main() -> i64 {
    var t: Top = Top { o: Out { x: In { y: 1 }, z: 2 } };
    t.o.x.y = 30;
    println(t.o.x.y + t.o.z);
    return 0;
}

//> 32
