// Conformance: docs/reference/reference.md §12.
// `@cfg(…)` on a function or a struct keeps the item only when every argument
// holds. `aarch64`, `arm64`, `riscv64`, `riscv`: never. (On an x86_64 target:
// cfg_arch_is reads the target.)
//@ backends: run,ccompile,emit,nat,x86_64-linux

@cfg(aarch64)
fn a() -> i64 { return 1; }

@cfg(release)
fn a() -> i64 { return 2; }

fn main() -> i64 {
    println(a());
    return 0;
}

//> 2
