// Conformance: docs/reference/reference.md §4.4.
// `e.f` reads a field; through a reference it reads the referent's field.

struct P {
    x: i64,
    y: i64,
}

fn bump(p: &mut P) { p.x = p.x + 1; }

fn main() -> i64 {
    var p: P = P { x: 3, y: 4 };
    bump(&mut p);
    bump(&mut p);
    println(p.x);
    return 0;
}

//> 5
