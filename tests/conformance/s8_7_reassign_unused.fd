// Conformance: docs/reference/reference.md §8.7.
// A struct annotated `@linear` is used exactly once. Assigning a new value
// while the old one is unused is an error.
//! error:

@linear
struct Coin {
    v: i64,
}

fn spend(c: Coin) -> i64 { return c.v; }

fn main() -> i64 {
    var c: Coin = Coin { v: 5 };
    c = Coin { v: 6 };
    println(spend(c));
    return 0;
}
