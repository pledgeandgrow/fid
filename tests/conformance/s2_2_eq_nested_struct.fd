// Conformance: docs/reference/reference.md §2.2.
// `==` and `!=` on two structs compare field by field.

struct Point {
    x: i64,
    y: i64,
}

struct Line {
    a: Point,
    b: Point,
}

fn main() -> i64 {
    val l: Line = Line { a: Point { x: 1, y: 1 }, b: Point { x: 2, y: 2 } };
    val m: Line = Line { a: Point { x: 1, y: 1 }, b: Point { x: 2, y: 3 } };
    println(l == m);
    println(l == l);
    return 0;
}

//> false
//> true
