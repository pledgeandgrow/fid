// Conformance: docs/reference/reference.md §5.4.
// `for x in v` iterates a `Vec` (elements), an array (elements) or a `HashMap`
// (keys). The loop variable is a single name; `for (i, x) in …` is a parse
// error.
//! error:

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    for (i, x) in v { println(x); }
    return 0;
}
