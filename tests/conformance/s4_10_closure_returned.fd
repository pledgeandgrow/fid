// Conformance: docs/reference/reference.md §4.10.
// `fn make_adder(n: i64) -> fn(i64) -> i64 { return fn(x: i64) => x + n; }`

fn make_adder(n: i64) -> fn(i64) -> i64 {
    return fn(x: i64) => x + n;
}

fn main() -> i64 {
    val add5 = make_adder(5);
    println(add5(10));
    return 0;
}

