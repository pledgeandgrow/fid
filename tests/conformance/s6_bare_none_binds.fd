// Conformance: docs/reference/reference.md §6.
// A bare name binds the value and matches anything. This includes a unit variant written without its enum.

fn main() -> i64 {
    val o: Option<i64> = Option::Some(3);
    match o {
        None => { println(1); }
        _ => { println(2); }
    }
    return 0;
}

//> 1
