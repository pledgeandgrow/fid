// Conformance: docs/reference/reference.md §4.11.
// A comptime value landing in a narrower integer declaration is checked
// while compiling, and the error names the value.
//! error: the comptime value 300 does not fit in i8

fn main() -> i64 {
    val x: i8 = comptime (200 + 100);
    println(int_to_str(x as i64));
    return 0;
}
