// Conformance: docs/reference/reference.md §4.8.
// `x |> f(a)` is `f(x, a)`; `x |> f` is `f(x)`; `x |> o.m(a)` is `x.m(a)`.

struct C {
    n: i64,
}

impl C {
    fn add(self, a: i64) -> i64 { return self.n + a; }
}

fn main() -> i64 {
    val c1: C = C { n: 1 };
    val c2: C = C { n: 100 };
    println(c1 |> c2.add(5));
    return 0;
}

//> 6
