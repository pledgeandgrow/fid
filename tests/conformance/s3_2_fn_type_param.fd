// Conformance: docs/reference/reference.md §3.2.
// `fn(T, U) -> R`: a function value (named function or closure). The `->` is
// required.

fn apply(f: fn(i64) -> i64, x: i64) -> i64 { return f(x); }

fn neg(x: i64) -> i64 { return 0 - x; }

fn main() -> i64 {
    println(apply(neg, 8));
    return 0;
}

//> -8
