// Conformance: docs/reference/reference.md §8.4.
// `&e` and `&mut e` make references; `*r` reads through one. Methods and field
// access read through references automatically.

struct C {
    n: i64,
}

fn inc(c: &mut C) { c.n = c.n + 1; }

fn main() -> i64 {
    var c: C = C { n: 0 };
    inc(&mut c);
    inc(&mut c);
    inc(&mut c);
    println(c.n);
    return 0;
}

