// Conformance: docs/reference/reference.md §2.12.
// `#[name(arg, …)]` at the top level is parsed into a list of attributes that
// is not attached to the next item, and `fid` reads none of them.

#[test]
fn checks() -> i64 { return 1; }

fn main() -> i64 {
    println(checks() + 1);
    return 0;
}

