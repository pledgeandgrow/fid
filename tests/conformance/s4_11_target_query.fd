// Conformance: docs/reference/reference.md §4.11.
// The build's target as comptime values: target_os() and target_arch()
// give what @cfg reads (the target a --target named, the host otherwise)
// — `comptime if comptime target_os() == "windows" { .. }` is the general
// form of which `@cfg(windows)` on a whole function or struct is the sugar.

fn main() -> i64 {
    println(comptime (str_len(target_os()) > 0));
    println(comptime (str_len(target_arch()) > 0));
    return 0;
}

//> true
//> true
