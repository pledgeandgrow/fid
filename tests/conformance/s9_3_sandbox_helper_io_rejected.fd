// Conformance: docs/reference/reference.md §9.3.
// So is a call to anything whose effects include `IO`, `Net` or `Spawn`: a
// function whose inferred effects include one.
//! error: Sandbox error

fn logit(x: i64) -> i64 {
    println(x);
    return x;
}

fn main() -> i64 {
    var r: i64 = 0;
    sandbox {
        r = logit(1);
    }
    println(r);
    return 0;
}
