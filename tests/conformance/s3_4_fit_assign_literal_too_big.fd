// Conformance: docs/reference/reference.md §3.4.
// A literal given to an integer type must fit it. A negative literal fits only
// a signed type. The check applies to `val`/`var` declarations and to `x = e`.
//! error: does not fit

fn main() -> i64 {
    var x: u8 = 1;
    x = 256;
    println(x);
    return 0;
}
