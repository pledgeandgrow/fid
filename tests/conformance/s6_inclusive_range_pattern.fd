// Conformance: docs/reference/reference.md §6.
// Integer patterns are non-negative literals: `-1 =>` is a parse error
// (`invalid pattern 'Minus'`). `a..=b` and `a..b` match ranges.

fn grade(n: i64) -> str {
    match n {
        0..=59 => { return "F"; }
        60..=79 => { return "C"; }
        80..=100 => { return "A"; }
        _ => { return "?"; }
    }
    return "";
}

fn main() -> i64 {
    println(grade(59));
    println(grade(60));
    println(grade(100));
    println(grade(101));
    return 0;
}

//> F
//> C
//> A
//> ?
