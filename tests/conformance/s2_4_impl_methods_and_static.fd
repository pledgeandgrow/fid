// Conformance: docs/reference/reference.md §2.4.
// Methods are called as `value.method(args)`. A function of the block whose first parameter is not `self` is called as `Name::function(args)`. A type may have several `impl` blocks.

struct C {
    n: i64,
}

impl C {
    fn new(n: i64) -> C { return C { n: n }; }
    fn get(self: C) -> i64 { return self.n; }
}

impl C {
    fn twice(self: C) -> i64 { return self.n * 2; }
}

fn main() -> i64 {
    val c: C = C::new(21);
    println(c.get());
    println(c.twice());
    return 0;
}

//> 21
//> 42
