// Conformance: docs/reference/reference.md §8.1.
// Only `@linear` struct types move.

fn len_of(v: Vec<i64>) -> i64 { return v.len(); }

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    println(len_of(v));
    println(len_of(v));
    v.push(2);
    println(v.len());
    return 0;
}

//> 1
//> 1
//> 2
