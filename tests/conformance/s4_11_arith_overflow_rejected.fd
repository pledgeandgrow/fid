// Conformance: docs/reference/reference.md §4.11.
// Overflow in comptime arithmetic is an error with the operands in the
// message, never a silently wrapped value.
//! error: does not fit in i64

fn main() -> i64 {
    val x = comptime (9223372036854775807 + 1);
    println(int_to_str(x));
    return 0;
}
