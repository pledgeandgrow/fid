// Conformance: docs/reference/reference.md §1.4.
// The word keywords (all but the type names) may also be used as the name of a
// function, method, parameter, field or local variable. (Here a function,
// called inside an expression.)

fn given(a: i64) -> i64 { return a * 2; }

fn main() -> i64 {
    val r: i64 = 1 + given(5);
    println(r);
    return 0;
}

