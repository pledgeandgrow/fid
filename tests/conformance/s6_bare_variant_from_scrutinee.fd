// Conformance: docs/reference/reference.md §6.
// `Variant(x, y)` without the enum name works when the variant can be resolved
// from the scrutinee's type or is unique.

enum Shape {
    Circle(i64),
    Rect(i64, i64),
}

fn main() -> i64 {
    val s: Shape = Shape::Rect(2, 3);
    match s {
        Circle(r) => { println(r); }
        Rect(w, h) => { println(w * h); }
    }
    return 0;
}

//> 6
