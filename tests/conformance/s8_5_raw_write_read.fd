// Conformance: docs/reference/reference.md §8.5.
// In the program's own module these need an `unsafe { }` block or an `@unsafe`
// function: reading through a raw pointer and writing through one; `p_malloc`,
// `p_alloc`, `p_free`, `p_realloc`, `p_memcpy`, `p_memset`; making a pointer
// from an integer.

fn main() -> i64 {
    unsafe {
        val p = p_malloc(8) as *mut i64;
        *p = 77;
        println(*p);
        p_free(p as *mut u8);
    }
    return 0;
}

//> 77
