// Conformance: docs/reference/reference.md §2.4.
// A type may have several `impl` blocks. (Items can be in any order, §2.)

impl Late {
    fn v(self) -> i64 { return self.v * 2; }
}

struct Late {
    v: i64,
}

fn main() -> i64 {
    val l: Late = Late { v: 4 };
    println(l.v());
    return 0;
}

//> 8
