// Conformance: docs/reference/reference.md §6.
// `a..=b` and `a..b` match ranges.

fn k(n: i64) -> i64 {
    match n {
        0..3 => { return 1; }
        3..=5 => { return 2; }
        _ => { return 3; }
    }
}

fn main() -> i64 {
    println(k(2));
    println(k(3));
    println(k(5));
    println(k(6));
    return 0;
}

//> 1
//> 2
//> 2
//> 3
