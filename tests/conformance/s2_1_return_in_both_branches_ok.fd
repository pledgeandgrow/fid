// Conformance: docs/reference/reference.md §2.1.
// A function declared to return a value (not `void`, `!` or `_`) must not
// reach the end of its body without returning, except `main`.

fn f(x: i64) -> i64 {
    if x > 0 {
        return 1;
    } else {
        return 2;
    }
}

fn main() -> i64 {
    println(f(-1));
    return 0;
}

//> 2
