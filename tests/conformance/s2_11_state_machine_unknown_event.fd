// Conformance: docs/reference/reference.md §2.11.
// `S_handle(state, event)` for an event the state does not name keeps the
// state.

state Door {
    Closed {
        on open => Opened
    }
    Opened {
        on close => Closed
    }
}

fn show(d: Door) {
    match d {
        Door::Closed => { println("closed"); }
        Door::Opened => { println("opened"); }
    }
}

fn main() -> i64 {
    var d = Door_initial();
    d = Door_handle(d, "close");
    show(d);
    return 0;
}

//> closed
