// Conformance: docs/reference/reference.md §5.3.
// A parameter of scalar type may be assigned.

fn count_down(n: i64) -> i64 {
    var steps: i64 = 0;
    while n > 0 {
        n = n - 1;
        steps = steps + 1;
    }
    return steps;
}

fn main() -> i64 {
    val n: i64 = 4;
    println(count_down(n));
    println(n);
    return 0;
}

//> 4
//> 4
