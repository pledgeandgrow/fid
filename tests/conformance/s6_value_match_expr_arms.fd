// Conformance: docs/reference/reference.md §6.
// In a `match` used as a value, an arm body may also be a single expression:
// `val s = match n { 0 => 10, _ => 20 };`.

fn main() -> i64 {
    val n: i64 = 0;
    val s: i64 = match n { 0 => 10, _ => 20 };
    val t: i64 = match n + 1 { 0 => 10, _ => 20 };
    println(s);
    println(t);
    return 0;
}

//> 10
//> 20
