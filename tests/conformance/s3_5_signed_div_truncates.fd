// Conformance: docs/reference/reference.md §3.5.
// (the C-like truncating division of the backends) `/` truncates toward zero, `%` takes the sign of the dividend.

fn main() -> i64 {
    var a: i64 = 0 - 7;
    println(a / 2);
    println(a % 2);
    println(7 / (0 - 2));
    println(7 % (0 - 2));
    return 0;
}

//> -3
//> -1
//> -3
//> 1
