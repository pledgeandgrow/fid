// Conformance: docs/reference/reference.md §2.5.
// Type parameters on a trait method (`fn m<U>(…)`) are parsed; an impl's
// method declares the same number (it may name them differently).

cap Conv {
    fn conv<U>(self, x: U) -> i64;
}

struct S {
    v: i64,
}

impl Conv for S {
    pub fn conv<V>(self: S, x: V) -> i64 { return self.v + 1; }
}

fn main() -> i64 {
    val s: S = S { v: 1 };
    println(s.conv(true));
    return 0;
}

//> 2
