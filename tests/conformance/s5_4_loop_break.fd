// Conformance: docs/reference/reference.md §5.4.
// `loop` is a statement ... `break` and `continue` apply to the innermost loop.

fn main() -> i64 {
    var i: i64 = 0;
    var s: i64 = 0;
    loop {
        i = i + 1;
        if i > 10 { break; }
        if i % 2 == 0 { continue; }
        var j: i64 = 0;
        while true { j = j + 1; if j == 3 { break; } }
        s = s + i * j;
    }
    println(s);
    return 0;
}

//> 75
