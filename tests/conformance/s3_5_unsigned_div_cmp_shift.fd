// Conformance: docs/reference/reference.md §3.5.
// Unsigned types are unsigned for division, remainder, comparison, `>>` and printing.

fn main() -> i64 {
    var a: u8 = 200;
    var b: u8 = 7;
    println(a / b);
    println(a % b);
    if a > b { println(1); } else { println(0); }
    println(a >> 1);
    println(a);
    var w: u64 = 18446744073709551615;
    if w > 1 { println(1); } else { println(0); }
    print(w / 2);
    print("\n");
    return 0;
}

//> 28
//> 4
//> 1
//> 100
//> 200
//> 1
//> 9223372036854775807
