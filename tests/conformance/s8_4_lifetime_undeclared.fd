// Conformance: docs/reference/reference.md §8.4.
// Lifetimes are declared in the function's `<...>`; `'static` needs no
// declaration. A lifetime of the result must be one a parameter carries.
// Either mistake is a parse error.
//! error:

fn first(x: &'a i64) -> &'a i64 { return x; }

fn main() -> i64 {
    val a: i64 = 1;
    println(*first(&a));
    return 0;
}
