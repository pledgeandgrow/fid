// Conformance: docs/reference/reference.md §6.
// An arm guard `if expr` is checked after the pattern matches.

fn main() -> i64 {
    val n: i64 = 4;
    match n {
        x if x > 10 => { println(1); }
        x if x > 3 => { println(2); }
        _ => { println(3); }
    }
    return 0;
}

//> 2
