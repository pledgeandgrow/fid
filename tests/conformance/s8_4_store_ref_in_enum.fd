// Conformance: docs/reference/reference.md §8.4.
// A reference may not be stored: not in a struct field, enum variant, array,
// `Vec`, `Box`, global, or through another reference; not sent to another task
// (`spawn f(&x)`).
//! error:

enum E {
    R(&i64),
}

fn main() -> i64 {
    val x: i64 = 1;
    val e: E = E::R(&x);
    println(1);
    return 0;
}
