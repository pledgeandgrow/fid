// Conformance: docs/reference/reference.md §4.10.
// A closure captures the variables it names by value when it is created; the
// values are copied into an environment.

fn apply(f: fn(i64) -> i64, x: i64) -> i64 { return f(x); }

fn main() -> i64 {
    val k: i64 = 10;
    println(apply(fn(x: i64) => x + k, 5));
    return 0;
}

//> 15
