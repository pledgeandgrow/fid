// Conformance: docs/reference/reference.md §6.
// In a `match` statement every arm body is a block: `1 => { … }`. A statement
// `match x { 1 => f(), _ => g(), }` is a parse error.

fn main() -> i64 {
    val x: i64 = 2;
    match x {
        1 => { println("one"); }
        2 => { println("two"); }
        _ => { println("many"); }
    }
    return 0;
}

//> two
