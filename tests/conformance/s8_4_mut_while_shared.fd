// Conformance: docs/reference/reference.md §8.4.
// Borrow rules: 1. `&mut x` is an error while any borrow of `x` (or of a
// related path such as a field) is active.
//! error:

fn main() -> i64 {
    var x: i64 = 1;
    val a: &i64 = &x;
    val b: &mut i64 = &mut x;
    *b = 2;
    println(*a);
    return 0;
}
