// Conformance: docs/reference/reference.md §13.3.
// `HashMap<K, V>`: `HashMap::new()`, `insert`, `get`, `contains`, `remove`,
// `len`, `is_empty`, `clear`, `get_or`, `keys`, `values`, `clone`.

fn main() -> i64 {
    var m: HashMap<i64, str> = HashMap::new();
    m.insert(10, "ten");
    m.insert(2, "two");
    println(m.get(10));
    println(m.contains(3));
    return 0;
}

//> ten
//> false
