// Conformance: docs/reference/reference.md §8.4.
// Passing `&c` where `&mut Counter` is expected is a type error.
//! error:

struct Counter {
    n: i64,
}

fn bump(c: &mut Counter) { c.n = c.n + 1; }

fn main() -> i64 {
    var c: Counter = Counter { n: 0 };
    bump(&c);
    println(c.n);
    return 0;
}
