// Conformance: docs/reference/reference.md §7.2.
// Type arguments are inferred from the arguments, and from the expected type
// when only the result mentions a parameter (`val z: i64 = zero();`).

struct P {
    x: i64,
}

fn wrap<T>(v: T) -> Option<T> { return Option::Some(v); }

fn main() -> i64 {
    val o = wrap(P { x: 3 });
    println(o.unwrap().x);
    return 0;
}

//> 3
