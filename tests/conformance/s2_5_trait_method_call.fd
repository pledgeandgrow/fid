// Conformance: docs/reference/reference.md §2.5.
// Traits are declared with `cap`; an impl provides the methods.

cap Show {
    fn show(self) -> str;
}

struct Pt {
    x: i64,
}

impl Show for Pt {
    pub fn show(self: Pt) -> str { return "pt" + int_to_str(self.x); }
}

fn main() -> i64 {
    val p: Pt = Pt { x: 3 };
    println(p.show());
    return 0;
}

//> pt3
