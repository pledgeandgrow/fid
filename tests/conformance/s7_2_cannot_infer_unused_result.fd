// Conformance: docs/reference/reference.md §7.2.
// A type parameter that nothing gives is an error: `cannot infer the type
// parameter 'T' of 'make'`.
//! error: cannot infer the type parameter

fn make<T>() -> Vec<T> { return Vec::new(); }

fn main() -> i64 {
    val v = make();
    println(v.len());
    return 0;
}
