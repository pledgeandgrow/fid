// Conformance: docs/reference/reference.md §10.2.
// Declare an `async fn`'s result as `Future<T>`; its body returns `T`. `await
// e` requires a `Future<T>` and gives `T`.

async fn name(n: i64) -> Future<str> {
    return "n" + int_to_str(n);
}

fn main() -> i64 {
    println(await name(3));
    return 0;
}

//> n3
