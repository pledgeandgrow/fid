// Conformance: docs/reference/reference.md §11.
// `@deprecated[(use = "f")]`, `@deprecated("text")`: each call of the function
// (other than its own) is a warning.

@deprecated(use = "new_f")
fn old_f() -> i64 { return 1; }

fn new_f() -> i64 { return 2; }

fn main() -> i64 {
    println(old_f() + new_f());
    return 0;
}

