// Conformance: docs/reference/reference.md §7.1.
// Functions, structs, enums, `impl` blocks and trait impls take type
// parameters. `where` clauses are not part of the grammar.

enum Maybe<T> {
    Just(T),
    Nothing,
}

fn get_or<T>(m: Maybe<T>, d: T) -> T {
    match m {
        Maybe::Just(v) => { return v; }
        Maybe::Nothing => { return d; }
    }
    return d;
}

fn main() -> i64 {
    val a: Maybe<i64> = Maybe::Just(3);
    val b: Maybe<i64> = Maybe::Nothing;
    println(get_or(a, 0));
    println(get_or(b, 7));
    return 0;
}

//> 3
//> 7
