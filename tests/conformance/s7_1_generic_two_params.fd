// Conformance: docs/reference/reference.md §7.1.
// Functions, structs, enums, `impl` blocks and trait impls take type
// parameters. `where` clauses are not part of the grammar.

fn second<A, B>(a: A, b: B) -> B { return b; }

fn main() -> i64 {
    println(second(1, "two"));
    return 0;
}

//> two
