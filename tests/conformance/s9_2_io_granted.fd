// Conformance: docs/reference/reference.md §9.2.
// `use m with { IO, FS }` grants capabilities. When any import of the program
// has a `with` clause, the program runs in strict mode: a call that needs a
// capability not granted is an error.

use math with { IO };

fn main() -> i64 {
    println("granted");
    return 0;
}

//> granted
