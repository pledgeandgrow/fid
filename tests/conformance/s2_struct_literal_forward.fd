// Conformance: docs/reference/reference.md §2.
// A struct literal `Name { … }` parses when `Name` is capitalised and `{` is
// followed by a field name and `:`, or by `..`: `Dev { handle: h }` is a
// literal even when `Dev` is declared further down.

fn main() -> i64 {
    val h: i64 = 7;
    val d: Dev = Dev { handle: h };
    println(d.handle);
    return 0;
}

struct Dev {
    handle: i64,
}

//> 7
