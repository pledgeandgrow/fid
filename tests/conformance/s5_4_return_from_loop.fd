// Conformance: docs/reference/reference.md §5.4.
// `return [expr]`.

fn find(v: Vec<i64>, t: i64) -> i64 {
    var i: i64 = 0;
    for x in v {
        if x == t { return i; }
        i = i + 1;
    }
    return -1;
}

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(4);
    v.push(7);
    println(find(v, 7));
    println(find(v, 9));
    return 0;
}

//> 1
//> -1
