// Conformance: docs/reference/reference.md §3.1.
// The primitive types: `i8` `i16` `i32` `i64` `i128` signed integers, `u8`
// `u16` `u32` `u64` `u128` unsigned integers, `f32` `f64` IEEE floats, `bool`,
// `str`, `void`.

fn main() -> i64 {
    val x: u32 = 4294967295;
    println(x);
    return 0;
}

//> 4294967295
