// Conformance: docs/reference/reference.md §2.1.
// Named arguments: `add(b: 2, a: 1)`. Positional arguments fill the first
// parameters, a named one the parameter of its name, one left out takes its
// default.

fn f(a: i64, b: i64, c: i64) -> i64 { return a * 100 + b * 10 + c; }

fn main() -> i64 {
    println(f(1, c: 3, b: 2));
    return 0;
}

