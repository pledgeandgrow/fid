// Conformance: docs/reference/reference.md §10.4.
// `spawn scope { … }` runs its body; at the end every spawned thread not yet
// joined is joined.

fn sq(x: i64) -> i64 { return x * x; }

fn main() -> i64 {
    var r: i64 = 0;
    spawn scope {
        val f = spawn sq(9);
        r = await f;
    }
    println(r);
    return 0;
}

//> 81
