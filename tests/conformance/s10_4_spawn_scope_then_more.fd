// Conformance: docs/reference/reference.md §10.4.
// `spawn scope { … }` runs its body; at the end every spawned thread not yet
// joined is joined.

fn task(total: i64, n: i64) -> i64 {
    p_atomic_add(total, n);
    return n;
}

fn main() -> i64 {
    val total = p_shared_alloc(8);
    p_atomic_store(total, 0);
    spawn scope {
        spawn task(total, 1);
    }
    val first: i64 = p_atomic_load(total);
    spawn scope {
        spawn task(total, 2);
        spawn task(total, 4);
    }
    println(first);
    println(p_atomic_load(total));
    return 0;
}

//> 1
//> 7
