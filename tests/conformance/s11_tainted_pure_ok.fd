// Conformance: docs/reference/reference.md §11.
// `@tainted` (param): the function with the parameter may have no `IO` or
// `Net` effect.

fn check(@tainted input: str) {
    val n: i64 = str_len(input);
}

fn main() -> i64 {
    check("abc");
    println("checked");
    return 0;
}

//> checked
