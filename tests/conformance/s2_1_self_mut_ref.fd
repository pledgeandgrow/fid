// Conformance: docs/reference/reference.md §2.1.
// `self` with no type is a parameter of type `Self`; it is also written `self:
// T`, `self: &T` or `self: &mut T`.

struct C {
    n: i64,
}

impl C {
    fn bump(self: &mut C) { self.n = self.n + 10; }
}

fn main() -> i64 {
    var c: C = C { n: 4 };
    c.bump();
    c.bump();
    println(c.n);
    return 0;
}

