// Conformance: docs/reference/reference.md §11.
// `@constant_time`: no early return, no branch, loop, short-circuit, index or
// division on secret data (every parameter not `@public`).
//! error:

@constant_time
fn f(a: i64, b: i64) -> i64 { return a / b; }

fn main() -> i64 {
    println(f(12, 3));
    return 0;
}
