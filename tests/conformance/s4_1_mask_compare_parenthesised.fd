// Conformance: docs/reference/reference.md §4.1.
// `&&` binds tighter than `|`, `^`, `&`, `<<` and `>>`. `flags & 1 != 0`
// parses as `flags & (1 != 0)`; write `(flags & 1) != 0`.

fn main() -> i64 {
    val flags: i64 = 3;
    if (flags & 1) != 0 { println(1); } else { println(0); }
    return 0;
}

//> 1
