// Conformance: docs/reference/reference.md §4.11.
// embed("path") reads a file of the project while compiling, its bytes a
// comptime Vec<i64>: the one file read comptime code may do.

fn main() -> i64 {
    val data: Vec<i64> = comptime embed("tests/conformance/s4_11_embed_data.txt");
    println(int_to_str(data.len()));
    println(int_to_str(data.get(0)) + " " + int_to_str(data.get(6)));
    return 0;
}

