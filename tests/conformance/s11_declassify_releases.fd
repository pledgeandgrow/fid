// Conformance: docs/reference/reference.md §11.
// `@declassify`: an audited release: the function may return secret or
// sensitive values, and its result is not secret.

@declassify
fn last_digit(@secret pin: i64) -> i64 { return pin % 10; }

fn main() -> i64 {
    println(last_digit(1234));
    return 0;
}

