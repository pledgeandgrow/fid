// Conformance: docs/reference/reference.md §11.
// Annotations are written before a top-level `fn` or `struct` (after or before
// `pub`), before a function parameter, and before a `val`/`var` statement.

@constant_time
fn pick(@public flag: i64, a: i64) -> i64 {
    var r: i64 = 0;
    if flag == 1 { r = a; }
    return r;
}

fn main() -> i64 {
    println(pick(1, 9));
    return 0;
}

//> 9
