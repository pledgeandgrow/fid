// Conformance: docs/reference/reference.md §13.3.
// `Vec::filled(n, x)` makes `n` elements, each `x`, for numbers, bools,
// strings, Vecs and maps.

fn main() -> i64 {
    var v: Vec<Vec<i64>> = Vec::filled(2, Vec::new());
    var a = v.get(0);
    a.push(1);
    v.set(0, a);
    println(v.get(0).len());
    println(v.get(1).len());
    return 0;
}

//> 1
//> 0
