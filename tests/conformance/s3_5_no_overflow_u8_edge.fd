// Conformance: docs/reference/reference.md §3.5.
// `+`, `-`, `*` and negation panic on overflow at the declared width, unless
// the function is `@wrapping`, where they wrap.

fn main() -> i64 {
    val a: u8 = 254;
    val one: u8 = 1;
    val c: u8 = a + one;
    println(c);
    return 0;
}

//> 255
