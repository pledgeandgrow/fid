// Conformance: docs/reference/reference.md §6.
// An arm guard `if expr` is checked after the pattern matches.

fn main() -> i64 {
    val n: i64 = 7;
    match n {
        x if x > 10 => { println("big"); }
        x if x > 5 => { println("medium"); }
        _ => { println("small"); }
    }
    return 0;
}

//> medium
