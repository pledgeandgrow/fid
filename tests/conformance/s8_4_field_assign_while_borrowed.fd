// Conformance: docs/reference/reference.md §8.4.
// Borrow rules: 3. Changing `x` — assignment, field or index assignment, write
// through it, or a changing method — is an error while a borrow of `x` is
// active.
//! error:

struct P {
    x: i64,
}

fn main() -> i64 {
    var p: P = P { x: 1 };
    val r: &P = &p;
    p.x = 3;
    println(r.x);
    return 0;
}
