// Conformance: docs/reference/reference.md §8.4.
// Lifetimes: `fn first<'a>(x: &'a i64, y: &i64) -> &'a i64`. The result
// borrows from exactly the parameters whose type carries one of the result's
// lifetimes.

fn first<'a>(x: &'a i64, y: &i64) -> &'a i64 { return x; }

fn main() -> i64 {
    var a: i64 = 1;
    var b: i64 = 2;
    val r: &i64 = first(&a, &b);
    b = 5;
    println(*r);
    println(b);
    return 0;
}

//> 1
//> 5
