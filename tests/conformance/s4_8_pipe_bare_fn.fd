// Conformance: docs/reference/reference.md §4.8.
// `x |> f(a)` is `f(x, a)`; `x |> f` is `f(x)`; `x |> o.m(a)` is `x.m(a)`.

fn sub(a: i64, b: i64) -> i64 { return a - b; }

fn dbl(x: i64) -> i64 { return x * 2; }

fn inc(x: i64) -> i64 { return x + 1; }

fn main() -> i64 {
    println(4 |> dbl);
    return 0;
}

//> 8
