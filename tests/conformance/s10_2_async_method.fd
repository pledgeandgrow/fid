// Conformance: docs/reference/reference.md §10.2.
// Declare an `async fn`'s result as `Future<T>`; its body returns `T`. `await
// e` requires a `Future<T>` and gives `T`. An `async fn` may be a method of an
// impl block.

struct W {
    k: i64,
}

impl W {
    async fn scaled(self, x: i64) -> Future<i64> {
        return self.k * x;
    }
}

fn main() -> i64 {
    val w: W = W { k: 5 };
    println(await w.scaled(6));
    return 0;
}

//> 30
