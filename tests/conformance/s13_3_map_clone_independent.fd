// Conformance: docs/reference/reference.md §13.3.
// `HashMap<K, V>`: `HashMap::new()`, `insert`, `get`, `contains`, `remove`,
// `len`, `is_empty`, `clear`, `get_or`, `keys`, `values`, `clone`.

fn main() -> i64 {
    var m: HashMap<str, i64> = HashMap::new();
    m.insert("b", 2);
    m.insert("a", 1);
    m.insert("c", 3);
    var n = m.clone();
    n.insert("d", 4);
    println(m.len());
    println(n.len());
    return 0;
}

//> 3
//> 4
