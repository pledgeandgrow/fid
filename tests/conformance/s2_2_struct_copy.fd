// Conformance: docs/reference/reference.md §2.2.
// Struct values are copied on assignment and when passed by value.

struct P {
    x: i64,
}

fn bump(p: P) -> i64 { var q: P = p; q.x = q.x + 1; return q.x; }

fn main() -> i64 {
    var a: P = P { x: 1 };
    var b: P = a;
    b.x = 50;
    println(a.x);
    println(bump(a));
    println(a.x);
    return 0;
}

//> 1
//> 2
//> 1
