// Conformance: docs/reference/reference.md §3.3.
// It accepts any two instances of `Vec`, `HashMap`, `Rc` or `Arc`, and `Name`
// against `Name<…>` (a generic used without arguments). A `Vec` written
// without an element type holds `i64` (§13.3).

fn main() -> i64 {
    var v: Vec = Vec::new();
    v.push(5);
    println(v.get(0));
    return 0;
}

//> 5
