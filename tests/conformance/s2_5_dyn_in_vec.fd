// Conformance: docs/reference/reference.md §2.5.
// `dyn Trait` is a trait-object type; a value is made with `v as dyn Trait`
// and its methods, defaults included, are dispatched at run time.

cap Animal {
    fn legs(self) -> i64;
    fn kind(self) -> str { return "animal"; }
}

struct Dog {
    a: i64,
}

struct Bird {
    a: i64,
}

impl Animal for Dog {
    pub fn legs(self: Dog) -> i64 { return 4; }
    pub fn kind(self: Dog) -> str { return "dog"; }
}

impl Animal for Bird {
    pub fn legs(self: Bird) -> i64 { return 2; }
}

fn count(a: dyn Animal) -> i64 { return a.legs(); }

fn main() -> i64 {
    var zoo: Vec<dyn Animal> = Vec::new();
    zoo.push(Dog { a: 0 } as dyn Animal);
    zoo.push(Bird { a: 0 } as dyn Animal);
    zoo.push(Dog { a: 0 } as dyn Animal);
    var total: i64 = 0;
    for a in zoo { total = total + a.legs(); }
    println(total);
    return 0;
}

//> 10
