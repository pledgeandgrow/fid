// Conformance: docs/reference/reference.md §5.4.
// `loop` is a statement, not an expression. `break expr` parses; the value is
// evaluated and discarded.

fn main() -> i64 {
    var i: i64 = 0;
    loop {
        i = i + 1;
        if i == 3 { break i * 100; }
    }
    println(i);
    return 0;
}

//> 3
