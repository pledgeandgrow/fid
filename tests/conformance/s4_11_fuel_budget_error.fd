// Conformance: docs/reference/reference.md §4.11.
// Comptime evaluation has a fuel budget (FID_CT_FUEL, 100 million steps by
// default): a comptime that would run away is an error, never a hang.
//@ env: FID_CT_FUEL=1000
//! error: fuel

comptime fn burn() -> i64 {
    var i: i64 = 0;
    var s: i64 = 0;
    while i < 100000 {
        s = s + i;
        i = i + 1;
    }
    return s;
}

fn main() -> i64 {
    println(int_to_str(comptime burn()));
    return 0;
}
