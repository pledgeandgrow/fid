// Conformance: docs/reference/reference.md §1.8.
// `\0`, `\x00` and `\u{0}` are a zero byte of the string, and the rest of the
// literal is kept: `str_len("ab\0cd")` is 5.

fn main() -> i64 {
    val s: str = "x\0yz";
    println(str_byte_at(s, 1));
    println(str_byte_at(s, 3));
    return 0;
}

//> 0
//> 122
