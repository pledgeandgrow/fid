// Conformance: docs/reference/reference.md §8.4.
// Lifetimes: `fn first<'a>(x: &'a i64, y: &i64) -> &'a i64`. The result
// borrows from exactly the parameters whose type carries one of the result's
// lifetimes. A body returning a borrow of another parameter is an error.
//! error:

fn first<'a>(x: &'a i64, y: &i64) -> &'a i64 { return y; }

fn main() -> i64 {
    val a: i64 = 1;
    val b: i64 = 2;
    println(*first(&a, &b));
    return 0;
}
