// Conformance: docs/reference/reference.md §6.
// An arm guard `if expr` is checked after the pattern matches.

fn main() -> i64 {
    val o: Option<i64> = Option::Some(3);
    match o {
        Option::Some(v) if v % 2 == 0 => { println("even"); }
        Option::Some(v) => { println("odd"); }
        Option::None => { println("none"); }
    }
    return 0;
}

//> odd
