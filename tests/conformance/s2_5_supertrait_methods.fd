// Conformance: docs/reference/reference.md §2.5.
// `cap Sub: A + B` gives `Sub` the methods of `A` and `B`; an impl of `Sub`
// must provide them.

cap HasA {
    fn a(self) -> i64;
}

cap HasB {
    fn b(self) -> i64;
}

cap Both: HasA + HasB {
    fn c(self) -> i64;
}

struct S {
    v: i64,
}

impl Both for S {
    pub fn a(self: S) -> i64 { return self.v; }
    pub fn b(self: S) -> i64 { return self.v * 2; }
    pub fn c(self: S) -> i64 { return self.v * 3; }
}

fn main() -> i64 {
    val s: S = S { v: 1 };
    println(s.a() + s.b() + s.c());
    return 0;
}

//> 6
