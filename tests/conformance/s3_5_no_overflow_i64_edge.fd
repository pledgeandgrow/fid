// Conformance: docs/reference/reference.md §3.5.
// `+`, `-`, `*` and negation panic on overflow at the declared width, unless
// the function is `@wrapping`, where they wrap.

fn main() -> i64 {
    val a: i64 = 9223372036854775806;
    val one: i64 = 1;
    val c: i64 = a + one;
    println(c);
    val d: i64 = -9223372036854775807;
    val e: i64 = d - one;
    println(e);
    return 0;
}

//> 9223372036854775807
//> -9223372036854775808
