// Conformance: docs/reference/reference.md §13.3.
// `Vec<T>`: `push`, `pop`, `len`, `is_empty`, `get`, `set`, `insert`, `remove`, `contains`, `reverse`, `sort`, ...

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(3);
    v.push(1);
    v.push(2);
    v.sort();
    println(v.get(0) * 100 + v.get(1) * 10 + v.get(2));
    v.reverse();
    println(v.get(0));
    v.insert(1, 9);
    println(v.get(1));
    v.remove(0);
    println(v.get(0));
    if v.contains(2) { println(1); } else { println(0); }
    v.set(0, 7);
    println(v.get(0));
    v.clear();
    if v.is_empty() { println(1); } else { println(0); }
    return 0;
}

//> 123
//> 3
//> 9
//> 9
//> 1
//> 7
//> 1
