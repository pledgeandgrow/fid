// Conformance: docs/reference/reference.md §4.6.
// integer or `f64` to `f32` / `f64`: rounded to the nearest value of the
// target, ties to even; `f32` to `f64` is exact.

fn main() -> i64 {
    val a: i64 = 9007199254740993;
    val f: f64 = a as f64;
    println(f);
    return 0;
}

//> 9007199254740992
