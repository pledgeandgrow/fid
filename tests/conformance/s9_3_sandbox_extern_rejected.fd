// Conformance: docs/reference/reference.md §9.3.
// So is code whose effects are not known: a C function declared `extern "C"`.
//! error:

extern "C" {
    fn labs(x: i64) -> i64;
}

fn main() -> i64 {
    var r: i64 = 0;
    sandbox {
        unsafe {
            r = labs(-3);
        }
    }
    println(r);
    return 0;
}
