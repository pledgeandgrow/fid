// Conformance: docs/reference/reference.md §13.2.
// `Option`: `is_some`, `is_none`, `unwrap`, `unwrap_or`, `map`, `and_then`,
// `or_else`, `unwrap_or_else`, `expect`, `context(msg)` (to `Result<T, str>`).
// `map` and `and_then` take a function from `T` to `T`.

fn main() -> i64 {
    val s: Option<i64> = Option::Some(4);
    val n: Option<i64> = Option::None;
    val r: Result<i64, str> = n.context("missing");
    println(r.is_err());
    match r {
        Result::Ok(v) => { println(v); }
        Result::Err(e) => { println(e); }
    }
    println(s.context("x").unwrap());
    return 0;
}

//> true
//> missing
//> 4
