// Conformance: docs/reference/reference.md §4.11.
// comptime_assert(cond, "msg") checks while compiling: a false condition
// stops the build, a true one leaves nothing in the program.
//! error: comptime assert failed: math broke

fn main() -> i64 {
    comptime { comptime_assert(2 + 2 == 5, "math broke"); }
    println("fine");
    return 0;
}
