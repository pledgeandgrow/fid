// Conformance: docs/reference/reference.md §1.4.
// The word keywords ... may also be used as the name of a function, method, parameter, field or local variable.

fn layer(grad: i64) -> i64 { return grad + 1; }

fn main() -> i64 {
    val kernel: i64 = 5;
    println(layer(kernel));
    return 0;
}

