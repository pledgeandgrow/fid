// Conformance: docs/reference/reference.md §2.2.
// Struct values are copied on assignment and when passed by value.

struct Point {
    x: i64,
    y: i64,
}

fn main() -> i64 {
    var a: Point = Point { x: 1, y: 2 };
    var b: Point = a;
    b.x = 50;
    println(a.x);
    println(b.x);
    return 0;
}

//> 1
//> 50
