// Conformance: docs/reference/reference.md §4.7.
// A `match` used as a value has the type of its first arm that does not
// diverge.

fn main() -> i64 {
    val o: Option<i64> = Option::Some(5);
    val v: i64 = match o {
        Option::Some(x) => { x * 2 }
        Option::None => { 0 }
    };
    println(v);
    return 0;
}

//> 10
