// Conformance: docs/reference/reference.md §11.
// A function with any of the safety primitives may call only functions and
// methods that have every primitive it has.

@no-recursion
fn helper(a: i64) -> i64 { return a + 1; }

@no-recursion
fn f(a: i64) -> i64 { return helper(a); }

fn main() -> i64 {
    println(f(1));
    return 0;
}

//> 2
