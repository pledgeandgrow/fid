// Conformance: docs/reference/reference.md §2.5.
// `impl<T> Show for Slot<T>` implements a trait for a generic struct.

cap Size {
    fn size(self) -> i64;
}

struct Slot<T> {
    v: T,
    n: i64,
}

impl<T> Size for Slot<T> {
    pub fn size(self: Slot<T>) -> i64 { return self.n; }
}

fn main() -> i64 {
    val a: Slot<str> = Slot { v: "x", n: 4 };
    println(a.size());
    return 0;
}

//> 4
