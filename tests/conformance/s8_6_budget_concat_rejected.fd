// Conformance: docs/reference/reference.md §8.6.
// Heap allocations in the block count too: one whose size is known at compile
// time is added to the sum (24 per `Vec::new()`); any other is an error (`…
// allocates on the heap: '.push()'`). String `+` allocates.
//! error: allocates on the heap

fn main() -> i64 {
    val a: str = "a";
    region r with budget(1000) {
        val s: str = a + "b";
        println(s);
    }
    return 0;
}
