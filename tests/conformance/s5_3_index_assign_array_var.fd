// Conformance: docs/reference/reference.md §5.3.
// An index assignment needs a variable on the left: `v[i] = x` is valid,
// `v[i][j] = x` and `s.items[i] = x` are parse errors (`index assignment
// target must be an array variable`).

fn main() -> i64 {
    var a: [i64; 3] = [0, 0, 0];
    a[2] = 9;
    println(a[2]);
    return 0;
}

//> 9
