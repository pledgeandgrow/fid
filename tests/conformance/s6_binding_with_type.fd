// Conformance: docs/reference/reference.md §6.
// Bindings are names (`_` allowed), optionally with a type name (`Some(v:
// i64)`). There are no nested, tuple, struct or `|` patterns.

fn main() -> i64 {
    val o: Option<i64> = Option::Some(5);
    match o {
        Option::Some(v: i64) => { println(v * 2); }
        Option::None => { println(0); }
    }
    return 0;
}

//> 10
