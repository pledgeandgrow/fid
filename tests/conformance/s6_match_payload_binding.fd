// Conformance: docs/reference/reference.md §6.
// `Variant(x, y)` without the enum name works when the variant can be resolved from the scrutinee's type.

enum Sh {
    Rect(i64, i64),
    Dot,
}

fn main() -> i64 {
    val s: Sh = Sh::Rect(3, 4);
    match s {
        Rect(w, h) => { println(w * h); }
        Dot => { println(0); }
    }
    return 0;
}

//> 12
