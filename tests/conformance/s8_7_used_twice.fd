// Conformance: docs/reference/reference.md §8.7.
// A struct annotated `@linear` is used exactly once. Using it a second time is
// an error (`was already consumed (moved)`).
//! error: already consumed

@linear
struct Coin {
    v: i64,
}

fn spend(c: Coin) -> i64 { return c.v; }

fn main() -> i64 {
    val c: Coin = Coin { v: 5 };
    println(spend(c));
    println(spend(c));
    return 0;
}
