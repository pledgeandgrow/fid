// Conformance: docs/reference/reference.md §2.2.
// `..base` copies the remaining fields from another value of the same struct.

struct P {
    x: i64,
    y: i64,
    z: i64,
}

fn main() -> i64 {
    val a: P = P { x: 1, y: 2, z: 3 };
    val b: P = P { y: 20, ..a };
    println(b.x + b.y + b.z);
    return 0;
}

//> 24
