// Conformance: docs/reference/reference.md §5.4.
// `break` and `continue` apply to the innermost loop; there are no labels.

fn main() -> i64 {
    var n: i64 = 0;
    for i in 0..3 {
        for j in 0..10 {
            if j == 2 { break; }
            n = n + 1;
        }
    }
    println(n);
    return 0;
}

//> 6
