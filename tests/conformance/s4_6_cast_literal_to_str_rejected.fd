// Conformance: docs/reference/reference.md §4.6.
// A cast that makes a str out of a number needs `unsafe`, whatever the
// number's width: a literal is typed by its size (`5` is an `i8`), and before
// only i64, i32, u64 and u32 were checked.
//! error: needs an `unsafe` block

fn main() -> i64 {
    val s: str = 5 as str;
    println(str_len(s));
    return 0;
}
