// Conformance: docs/reference/reference.md §10.1.
// Every argument of the spawned call, and every variable the expression names,
// must be `@send`. References and raw pointers are not. Structs whose fields
// are all `@send` are `@send`. (A struct that holds a string or a collection
// is refused as a spawn argument: its copies would share it, CA5.)

struct Job {
    id: i64,
    weight: f64,
}

fn run_job(j: Job) -> i64 { return j.id * 2; }

fn main() -> i64 {
    val f = spawn run_job(Job { id: 21, weight: 0.5 });
    println(await f);
    return 0;
}

//> 42
