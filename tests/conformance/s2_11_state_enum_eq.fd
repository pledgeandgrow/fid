// Conformance: docs/reference/reference.md §2.11.
// The state machine is an enum (§2.11); `==` on enum values compares the tag
// and the payload (§2.3).

state Door {
    Closed {
        on open => Opened
    }
    Opened {
        on close => Closed
    }
}

fn show(d: Door) {
    match d {
        Door::Closed => { println("closed"); }
        Door::Opened => { println("opened"); }
    }
}

fn main() -> i64 {
    var d = Door_initial();
    println(d == Door::Closed);
    d = Door_handle(d, "open");
    println(d == Door::Opened);
    println(d == Door::Closed);
    return 0;
}

//> true
//> true
//> false
