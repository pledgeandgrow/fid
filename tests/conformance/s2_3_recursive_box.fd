// Conformance: docs/reference/reference.md §2.3.
// A recursive enum holds itself through `Box`: `Node(Box<Tree>)`.

enum List {
    Nil,
    Cons(i64, Box<List>),
}

fn sum(l: List) -> i64 {
    match l {
        List::Nil => { return 0; }
        List::Cons(v, rest) => { return v + sum(*rest); }
    }
    return 0;
}

fn main() -> i64 {
    val l: List = List::Cons(1, Box::new(List::Cons(2, Box::new(List::Cons(3, Box::new(List::Nil))))));
    println(sum(l));
    return 0;
}

//> 6
