// Conformance: docs/reference/reference.md §12.
// `@cfg(…)` on a function or a struct keeps the item only when every argument
// holds. `arch = "riscv64"`: never. (A call of a removed function is an
// error.)
//! error:

@cfg(arch = "riscv64")
fn only_riscv() -> i64 { return 1; }

fn main() -> i64 {
    println(only_riscv());
    return 0;
}
