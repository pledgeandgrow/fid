// Conformance: docs/reference/reference.md §10.6.
// A function that runs on another thread, or any function it calls, may not
// assign a global of the program unless it calls a function whose name ends in
// `mutex_lock` or `write_lock`. (Reading a global is not assigning it.)

var limit: i64 = 5;

fn work() -> i64 {
    return limit * 2;
}

fn main() -> i64 {
    val a = spawn work();
    println(await a);
    return 0;
}

//> 10
