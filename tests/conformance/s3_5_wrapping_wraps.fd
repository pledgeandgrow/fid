// Conformance: docs/reference/reference.md §3.5.
// ... unless the function is `@wrapping`, where they wrap.

@wrapping
fn mul8(a: i8, b: i8) -> i8 { return a * b; }

@wrapping
fn add8(a: u8, b: u8) -> u8 { return a + b; }

fn main() -> i64 {
    println(mul8(100, 100));
    println(add8(200, 100));
    return 0;
}

//> 16
//> 44
