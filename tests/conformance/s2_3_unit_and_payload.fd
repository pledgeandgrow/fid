// Conformance: docs/reference/reference.md §2.3.
// A variant has no payload or a parenthesised payload list; a payload may be
// named (`V(x: i64)`).

enum Shape {
    Empty,
    Square(i64),
    Rect(i64, i64),
}

fn area(s: Shape) -> i64 {
    match s {
        Shape::Empty => { return 0; }
        Shape::Square(a) => { return a * a; }
        Shape::Rect(w, h) => { return w * h; }
    }
    return -1;
}

fn main() -> i64 {
    println(area(Shape::Empty));
    println(area(Shape::Square(3)));
    println(area(Shape::Rect(2, 5)));
    return 0;
}

//> 0
//> 9
//> 10
