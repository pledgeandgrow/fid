// Conformance: docs/reference/reference.md §2.5.
// A method with a body is a default; an impl that leaves it out gets it.

cap Greet {
    fn name(self) -> str;
    fn greet(self) -> str { return "hi " + self.name(); }
}

struct A {
    n: i64,
}

struct B {
    n: i64,
}

impl Greet for A {
    pub fn name(self: A) -> str { return "a"; }
}

fn main() -> i64 {
    val a: A = A { n: 1 };
    println(a.greet());
    return 0;
}

//> hi a
