// Conformance: docs/reference/reference.md §8.4.
// A reference may be passed to a call, held in a local, and returned when it
// comes from a reference parameter. `Option`, `Result` and tuples may hold
// references in those same places.

fn find(a: &i64) -> Option<&i64> {
    if *a > 0 { return Option::Some(a); }
    return Option::None;
}

fn main() -> i64 {
    val x: i64 = 4;
    val o: Option<&i64> = find(&x);
    println(o.is_some());
    return 0;
}

//> true
