// Conformance: docs/reference/reference.md §3.2.
// `Name<A, B>`: an instance of a generic struct or enum.

enum Either<L, R> {
    Left(L),
    Right(R),
}

fn main() -> i64 {
    val e: Either<i64, str> = Either::Right("r");
    match e {
        Either::Left(n) => { println(n); }
        Either::Right(s) => { println(s); }
    }
    return 0;
}

//> r
