// Conformance: docs/reference/reference.md §8.2.
// A memory fault in `unsafe` code is reported the same way, as `Panic: Invalid
// memory access (null or dangling pointer)`.

fn main() -> i64 {
    println("start");
    unsafe {
        val p: *mut i64 = 0;
        println(*p);
    }
    return 0;
}

//> start
//! panic
