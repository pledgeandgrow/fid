// Conformance: docs/reference/reference.md §9.3.
// Inside `sandbox { }` every call in the capability table is an error,
// whatever has been granted (`Sandbox error: 'print()' requires 'IO'
// capability`).
//! error: Sandbox error

fn main() -> i64 {
    sandbox {
        println("x");
    }
    return 0;
}
