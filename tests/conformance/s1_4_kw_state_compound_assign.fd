// Conformance: docs/reference/reference.md §1.4.
// A keyword followed by an assignment operator or `.` at the start of a
// statement is a variable (`handle.fd = 3;`, `state += 1;`).

fn main() -> i64 {
    var state: i64 = 1;
    state += 1;
    state *= 5;
    println(state);
    return 0;
}

//> 10
