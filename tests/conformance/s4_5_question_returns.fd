// Conformance: docs/reference/reference.md §4.5.
// `e?` ... on `None` or `Err` it returns from the enclosing function with that value.

fn half(x: i64) -> Option<i64> {
    if x % 2 == 1 { return Option::None; }
    return Option::Some(x / 2);
}

fn quarter(x: i64) -> Option<i64> {
    val h = half(x)?;
    return half(h);
}

fn main() -> i64 {
    println(quarter(8) ?? 0 - 1);
    println(quarter(6) ?? 0 - 1);
    return 0;
}

//> 2
//> -1
