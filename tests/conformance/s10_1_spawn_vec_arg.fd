// Conformance: docs/reference/reference.md §10.1.
// `spawn f(args)` starts `f(args)` on an OS thread and gives a `Future<T>`,
// where `T` is `f`'s return type.

fn total(v: Vec<i64>) -> i64 {
    var s: i64 = 0;
    for x in v { s = s + x; }
    return s;
}

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    val f = spawn total(v);
    println(await f);
    return 0;
}

//> 6
