// Conformance: docs/reference/reference.md §10.5.
// The builtins `p_chan_create`, `p_chan_send` and `p_chan_recv` are the
// runtime layer.

fn producer(ch: i64) -> i64 {
    for i in 1..=3 { p_chan_send(ch, i * 10); }
    return 0;
}

fn main() -> i64 {
    val ch = p_chan_create(8);
    val f = spawn producer(ch);
    var s: i64 = 0;
    for i in 0..3 { s = s + p_chan_recv(ch); }
    await f;
    println(s);
    return 0;
}

//> 60
