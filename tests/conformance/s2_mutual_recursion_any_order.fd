// Conformance: docs/reference/reference.md §2.
// A file is a sequence of items, each optionally preceded by `pub`. Items can
// be in any order.

fn is_even(n: i64) -> bool {
    if n == 0 { return true; }
    return is_odd(n - 1);
}

fn is_odd(n: i64) -> bool {
    if n == 0 { return false; }
    return is_even(n - 1);
}

fn main() -> i64 {
    println(is_even(10));
    println(is_odd(7));
    return 0;
}

//> true
//> true
