// Conformance: docs/reference/reference.md §4.11.
// An inline for whose range is not known at compile time is an error: the
// loop is unrolled while compiling.
//! error: inline for

fn main() -> i64 {
    var n: i64 = 4;
    n = n + 1;
    inline for i in 0..n {
        println("x");
    }
    return 0;
}
