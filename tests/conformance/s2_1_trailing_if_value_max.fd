// Conformance: docs/reference/reference.md §2.1.
// A trailing expression statement, or a trailing `if`/`else` or `match`, is
// the function's value.

fn max2(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

fn main() -> i64 {
    println(max2(3, 8));
    println(max2(8, 3));
    return 0;
}

//> 8
//> 8
