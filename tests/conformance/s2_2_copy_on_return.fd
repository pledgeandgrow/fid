// Conformance: docs/reference/reference.md §2.2.
// Struct values are copied on assignment and when passed by value.

struct Point {
    x: i64,
    y: i64,
}

fn mk() -> Point { return Point { x: 4, y: 5 }; }

fn main() -> i64 {
    var a: Point = mk();
    var b: Point = mk();
    a.y = 0;
    println(b.y);
    return 0;
}

//> 5
