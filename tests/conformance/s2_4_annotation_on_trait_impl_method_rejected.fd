// Conformance: docs/reference/reference.md §2.4.
// Annotations cannot be written on methods: `@x fn` inside an `impl` block is
// a parse error. The same holds in trait impls. (Since CU3 a plain impl block
// reads them, see s2_4_annotation_on_method; a trait impl does not.)
//! error: expected fn

cap Get {
    fn get(self) -> i64;
}

struct Ctr {
    n: i64,
}

impl Get for Ctr {
    @no-recursion fn get(self) -> i64 { return self.n + 1; }
}

fn main() -> i64 {
    val c: Ctr = Ctr { n: 3 };
    println(c.get());
    return 0;
}
