// Conformance: docs/reference/reference.md §2.3.
// `==` on enum values compares the tag and the payload.

enum Shape {
    Circle(i64),
    Empty,
}

fn main() -> i64 {
    val a: Shape = Shape::Circle(1);
    val b: Shape = Shape::Circle(1);
    val c: Shape = Shape::Circle(2);
    if a == b { println(1); } else { println(0); }
    if a == c { println(1); } else { println(0); }
    if Shape::Empty == Shape::Empty { println(1); } else { println(0); }
    return 0;
}

//> 1
//> 0
//> 1
