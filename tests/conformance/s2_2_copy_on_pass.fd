// Conformance: docs/reference/reference.md §2.2.
// Struct values are copied on assignment and when passed by value.

struct Point {
    x: i64,
    y: i64,
}

fn moved(p: Point) -> i64 {
    var q: Point = p;
    q.x = q.x + 100;
    return q.x;
}

fn main() -> i64 {
    val a: Point = Point { x: 1, y: 2 };
    println(moved(a));
    println(a.x);
    return 0;
}

