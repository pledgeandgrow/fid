// Conformance: docs/reference/reference.md §11.
// `@safety-critical`: `no-alloc` + `no-recursion` + `no-unbounded` +
// `no-panic` + `no-indirect`.
//! error:

@safety-critical
@wrapping
fn apply(f: fn(i64) -> i64, x: i64) -> i64 { return f(x); }

fn inc(x: i64) -> i64 { return x + 1; }

fn main() -> i64 {
    println(apply(inc, 1));
    return 0;
}
