// Conformance: docs/reference/reference.md §4.11.
// A generated name already declared is an error, and so is a generated trait,
// global, type alias, extern block or `use`.
//! error:

fn taken() -> i64 { return 1; }

fn main() -> i64 {
    comptime gen {
        return "fn taken() -> i64 { return 2; }";
    }
    println(taken());
    return 0;
}
