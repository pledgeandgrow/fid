// Conformance: docs/reference/reference.md §3.2.
// `[T; N]`: a fixed-size array. Indexing is bounds-checked at run time
// (`Panic: Array index out of bounds`).

fn main() -> i64 {
    val a: [i64; 3] = [1, 2, 3];
    var i: i64 = 0 - 1;
    println("start");
    println(a[i]);
    return 0;
}

//> start
//! panic
