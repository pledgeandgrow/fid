// Conformance: docs/reference/reference.md §2.1.
// Default values: `fn add(a: i64, b: i64 = 10)`. A call may leave out trailing
// parameters that have defaults; lowering supplies the default.

fn hello(name: str = "world") -> str { return "hello " + name; }

fn main() -> i64 {
    println(hello());
    println(hello("fid"));
    return 0;
}

//> hello world
//> hello fid
