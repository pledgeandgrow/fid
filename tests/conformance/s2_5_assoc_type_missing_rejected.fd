// Conformance: docs/reference/reference.md §2.5.
// An impl must provide every method without a default and every associated
// type, and the trait must exist.
//! error:

cap Container {
    type Item;
    fn first(self) -> i64;
}

struct S {
    v: i64,
}

impl Container for S {
    pub fn first(self: S) -> i64 { return self.v; }
}

fn main() -> i64 {
    val s: S = S { v: 2 };
    println(s.first());
    return 0;
}
