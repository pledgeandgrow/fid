// Conformance: docs/reference/reference.md §4.1.
// Precedence from lowest to highest: `|>`, `??`, `..`, `||`, `|`, `^`, `&`,
// `<<` `>>`, `&&`, `==` `!=`, `<` `>` `<=` `>=` `is`, `+` `-`, `*` `/` `%`,
// prefix, postfix. Binary operators of one level associate to the left.

fn main() -> i64 {
    val b: bool = 1 != 1 || 2 != 2;
    println(b);
    return 0;
}

//> false
