// Conformance: docs/reference/reference.md §6.
// A bare name that is a unit variant of the scrutinee's enum is that variant,
// as `Some(x)` is: `None =>` matches None only. (Before, the name bound the
// value and the arm matched anything, so this printed 1.)

fn main() -> i64 {
    val o: Option<i64> = Option::Some(3);
    match o {
        None => {
            println(1);
        }
        _ => {
            println(2);
        }
    }
    return 0;
}

//> 2
