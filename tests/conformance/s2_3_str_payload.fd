// Conformance: docs/reference/reference.md §2.3.
// A variant has no payload or a parenthesised payload list; a payload may be
// named (`V(x: i64)`).

enum Msg {
    Text(str),
    Quit,
}

fn main() -> i64 {
    val m: Msg = Msg::Text("hey");
    match m {
        Msg::Text(t) => { println(t); }
        Msg::Quit => { println("q"); }
    }
    return 0;
}

//> hey
