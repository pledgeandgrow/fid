// Conformance: docs/reference/reference.md §4.11.
// Inside a generic function the selection waits for the instantiation: the
// same body serves both, each with its branch taken.

fn desc(comptime T: type, v: T) -> str {
    comptime if comptime is_struct(T) {
        return "struct";
    } else {
        return "scalar";
    }
}

struct P { x: i64 }

fn main() -> i64 {
    val p: P = P { x: 1 };
    println(desc(p));
    println(desc::<i64>(3));
    return 0;
}

//> struct
//> scalar
