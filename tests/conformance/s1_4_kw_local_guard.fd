// Conformance: docs/reference/reference.md §1.4.
// The word keywords (all but the type names) may also be used as the name of a
// function, method, parameter, field or local variable. (Here a local variable
// read in an expression.)

fn main() -> i64 {
    val guard: i64 = 6;
    val y: i64 = guard + 1;
    println(y);
    return 0;
}

//> 7
