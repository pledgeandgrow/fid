// Conformance: docs/reference/reference.md §3.3.
// Two instances of Vec with different type arguments are different types: a
// `Vec<i64>` is not passed where the parameter is a `Vec<str>`.
//! error: Vec<str>

fn first_len(v: Vec<str>) -> i64 {
    return v.len();
}

fn main() -> i64 {
    val nums: Vec<i64> = Vec::new();
    nums.push(42);
    println(first_len(nums));
    return 0;
}
