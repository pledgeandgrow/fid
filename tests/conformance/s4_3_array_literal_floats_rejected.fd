// Conformance: docs/reference/reference.md §4.3.
// `[a, b, c]`: an array literal. The parser fixes its element type to `i64`,
// so an array literal of floats or strings is a type error (`array element
// type mismatch, expected i64, got f64`).
//! error: array element type mismatch

fn main() -> i64 {
    val a = [1.5, 2.5];
    println(1);
    return 0;
}
