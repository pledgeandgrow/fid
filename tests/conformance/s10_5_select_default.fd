// Conformance: docs/reference/reference.md §10.5.
// `select` takes the first case whose channel has a value, binding it to the
// name; otherwise it runs `default`.

fn main() -> i64 {
    val ch = p_chan_create(1);
    select {
        case ch => x => {
            println(x);
        }
        default => {
            println("empty");
        }
    }
    return 0;
}

//> empty
