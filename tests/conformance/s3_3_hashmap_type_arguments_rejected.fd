// Conformance: docs/reference/reference.md §3.3.
// Two instances of HashMap with different type arguments are different types.
//! error: cannot assign HashMap<i64, str> to variable

fn main() -> i64 {
    var names: HashMap<i64, str> = HashMap::new();
    names.insert(1, "one");
    val counts: HashMap<i64, i64> = names;
    println(counts.len());
    return 0;
}
