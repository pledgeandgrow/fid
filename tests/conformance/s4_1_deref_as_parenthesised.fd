// Conformance: docs/reference/reference.md §4.1.
// `as` is a postfix operator, so it binds tighter than any prefix or binary
// operator: `-x as i32` is `-(x as i32)`, `a + b as i64` is `a + (b as i64)`.
// Write `(*s) as f64`.

fn main() -> i64 {
    val x: i64 = 3;
    val s: &i64 = &x;
    val f: f64 = (*s) as f64;
    println(f + 0.5);
    return 0;
}

//> 3.5
