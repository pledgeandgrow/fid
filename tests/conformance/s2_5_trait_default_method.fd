// Conformance: docs/reference/reference.md §2.5.
// A method with a body is a default; an impl that leaves it out gets it.

cap Named {
    fn name(self) -> str;
    fn greet(self) -> str { return "hi " + self.name(); }
}

struct Bob {
    a: i64,
}

impl Named for Bob {
    pub fn name(self: Bob) -> str { return "bob"; }
}

fn main() -> i64 {
    val b: Bob = Bob { a: 1 };
    println(b.greet());
    return 0;
}

//> hi bob
