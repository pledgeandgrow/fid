// Conformance: docs/reference/reference.md §3.5.
// A signed type's minimum `% -1` is 0 (the remainder is in range).

fn rem64(a: i64, b: i64) -> i64 {
    return a % b;
}

fn rem16(a: i16, b: i16) -> i16 {
    return a % b;
}

fn main() -> i64 {
    val m: i64 = -9223372036854775807 - 1;
    println(rem64(m, -1));
    val m16: i16 = -32767 - 1;
    println(rem16(m16, -1));
    return 0;
}

//> 0
//> 0
