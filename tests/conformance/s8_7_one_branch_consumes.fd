// Conformance: docs/reference/reference.md §8.7.
// After an `if`, a linear variable counts as used only if both branches used
// it.
//! error:

@linear
struct Coin {
    v: i64,
}

fn spend(c: Coin) -> i64 { return c.v; }

fn main() -> i64 {
    val c: Coin = Coin { v: 5 };
    val k: bool = true;
    if k {
        println(spend(c));
    }
    return 0;
}
