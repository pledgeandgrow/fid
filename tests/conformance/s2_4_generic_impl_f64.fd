// Conformance: docs/reference/reference.md §2.4.
// `impl<T> Slot<T> { … }`: the type parameters after `impl` are in scope in
// the methods. On a `Slot<f64>` the method's `T` is `f64` (§7.2).

struct Slot<T> {
    v: T,
}

impl<T> Slot<T> {
    fn get(self) -> T { return self.v; }
}

fn main() -> i64 {
    val a: Slot<f64> = Slot { v: 1.25 };
    val x: f64 = a.get() * 2.0;
    println(x);
    return 0;
}

//> 2.5
