// Conformance: docs/reference/reference.md §8.4.
// A reference may be passed to a call, held in a local, and returned when it
// comes from a reference parameter.

fn bigger(a: &i64, b: &i64) -> &i64 {
    if *a > *b { return a; }
    return b;
}

fn main() -> i64 {
    val x: i64 = 3;
    val y: i64 = 8;
    val r: &i64 = bigger(&x, &y);
    println(*r);
    return 0;
}

//> 8
