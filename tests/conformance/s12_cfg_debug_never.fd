// Conformance: docs/reference/reference.md §12.
// `@cfg(…)` on a function or a struct keeps the item only when every argument
// holds. `debug` never holds.

@cfg(debug)
fn mode() -> str { return "debug"; }

@cfg(release)
fn mode() -> str { return "release"; }

fn main() -> i64 {
    println(mode());
    return 0;
}

//> release
