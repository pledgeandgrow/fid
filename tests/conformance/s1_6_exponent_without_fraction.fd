// Conformance: docs/reference/reference.md §1.6.
// Digits with an exponent and no fraction (`1e5`, `5e3`, `1E-9`) are a float
// literal since known-bugs 2g.18 (lexer.fd: "Float with an exponent and no
// fraction"; only when digits follow the `e`). Reference §1.6 still says
// `1e5` lexes as `1` followed by the identifier `e5` (VF10: the reference is
// out of date there, not the compiler).

fn main() -> i64 {
    val x: f64 = 1e5;
    println(x);
    val y: f64 = 25e-1;
    println(y);
    return 0;
}

//> 100000
//> 2.5
