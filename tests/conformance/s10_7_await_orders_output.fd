// Conformance: docs/reference/reference.md §10.7 (decided Nov 17).
// What a thread prints before it returns comes before what its awaiter
// prints after `await` returns, and one `println` is written whole.

fn worker(id: i64) -> i64 {
    println(f"worker {id} line 1");
    println(f"worker {id} line 2");
    return id * 10;
}

fn main() -> i64 {
    val t = spawn worker(7);
    val r = await t;
    println(f"main got {r}");
    val u = spawn worker(8);
    val r2 = await u;
    println(f"main got {r2}");
    return 0;
}

//> worker 7 line 1
//> worker 7 line 2
//> main got 70
//> worker 8 line 1
//> worker 8 line 2
//> main got 80
