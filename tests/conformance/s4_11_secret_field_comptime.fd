// Conformance: docs/reference/reference.md §4.11.
// The composable pattern: a comptime fn walks a struct's fields with the
// string-named reflection builtins (field_names_of, field_annotations),
// and a `comptime T: type` function hands it the type's name — the whole
// count computed per instantiation while compiling.

struct User {
    name: str,
    @secret token: str,
    age: i64,
}

comptime fn count_secret_fields(sn: str) -> i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    val names: Vec<str> = field_names_of(sn);
    while i < names.len() {
        val anns: Vec<str> = field_annotations(sn, names.get(i));
        var j: i64 = 0;
        while j < anns.len() {
            if anns.get(j) == "secret" {
                n = n + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return n;
}

fn secrets_in(comptime T: type, v: T) -> i64 {
    return comptime count_secret_fields(comptime type_name(T));
}

struct Plain { x: i64 }

fn main() -> i64 {
    val u: User = User { name: "ada", token: "xyz", age: 36 };
    println(int_to_str(secrets_in(u)));
    val p: Plain = Plain { x: 1 };
    println(int_to_str(secrets_in(p)));
    return 0;
}

//> 1
//> 0
