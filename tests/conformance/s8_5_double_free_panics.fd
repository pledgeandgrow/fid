// Conformance: docs/reference/reference.md §8.5.
// A double free panics with `Double free`, a free of anything that is not a
// live block with `Invalid free`.

fn main() -> i64 {
    println("start");
    unsafe {
        val p = p_malloc(16);
        p_free(p);
        p_free(p);
    }
    println("never");
    return 0;
}

//> start
//! panic
