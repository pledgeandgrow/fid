// Conformance: docs/reference/reference.md §1.8.
// Format strings `f"…{expr}…"`: each `{…}` is lexed and parsed again as an
// expression. The result has type `str`. Text outside braces takes the same
// escapes as a plain string.

fn main() -> i64 {
    println(f"a\tb{1}");
    return 0;
}

//> a	b1
