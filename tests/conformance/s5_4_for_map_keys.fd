// Conformance: docs/reference/reference.md §5.4.
// `for x in v` iterates a `Vec` (elements), an array (elements) or a `HashMap`
// (keys). (`keys` are in ascending order, §13.3.)

fn main() -> i64 {
    var m: HashMap<i64, str> = HashMap::new();
    m.insert(3, "c");
    m.insert(1, "a");
    m.insert(2, "b");
    for k in m { println(k); }
    return 0;
}

//> 1
//> 2
//> 3
