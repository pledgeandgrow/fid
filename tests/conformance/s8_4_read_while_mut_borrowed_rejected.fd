// Conformance: docs/reference/reference.md §8.4, rule 4.
// A read of a variable while a mutable borrow of it is active is an error,
// as a mutation is (LG3).
//! error: cannot read m

fn id_mut<'a>(x: &'a mut i64) -> &'a mut i64 {
    return x;
}

fn main() -> i64 {
    var m: i64 = 1;
    val r = id_mut(&mut m);
    val v = m;
    *r = v + 1;
    println(*r);
    return 0;
}
