// Conformance: docs/reference/reference.md §4.1.
// A call's result can be called on the same line: `pick(1)(5)`,
// `fs.get(1)(5)`, `(fn(x: i64) -> i64 { return x * x; })(7)`.

fn dbl(x: i64) -> i64 { return x * 2; }

fn neg(x: i64) -> i64 { return 0 - x; }

fn pick(k: i64) -> fn(i64) -> i64 {
    if k == 1 { return dbl; }
    return neg;
}

fn main() -> i64 {
    println(pick(1)(5));
    println(pick(2)(5));
    return 0;
}

//> 10
//> -5
