// Conformance: docs/reference/reference.md §6.
// A `match` on an enum must cover every variant, ... unless an arm is `_` or a name.
//! error:

enum E {
    A,
    B,
    C,
}

fn main() -> i64 {
    val e: E = E::A;
    match e {
        E::A => { println(1); }
        E::B => { println(2); }
    }
    return 0;
}
