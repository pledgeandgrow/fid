// Conformance: docs/reference/reference.md §8.7.
// A struct annotated `@linear` is used exactly once. (Assigning it to another
// name uses it.)

@linear
struct Coin {
    v: i64,
}

fn spend(c: Coin) -> i64 { return c.v; }

fn main() -> i64 {
    val c: Coin = Coin { v: 5 };
    val d: Coin = c;
    println(spend(d));
    return 0;
}

//> 5
