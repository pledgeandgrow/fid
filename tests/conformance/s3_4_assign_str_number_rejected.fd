// Conformance: docs/reference/reference.md §3.4.
// An assigned value has the variable's type, as a declaration's initialiser
// has the declared type: a `str` variable is not assigned a number.
//! error: cannot assign

fn main() -> i64 {
    var s: str = "abc";
    s = 42;
    println(s);
    return 0;
}
