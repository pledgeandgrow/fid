// Conformance: docs/reference/reference.md §12.
// `@cfg(…)` on a function or a struct keeps the item only when every argument
// holds.

@cfg(debug)
struct Cfg {
    a: i64,
}

@cfg(release)
struct Cfg {
    a: i64,
    b: i64,
}

fn main() -> i64 {
    val c: Cfg = Cfg { a: 1, b: 2 };
    println(c.a + c.b);
    return 0;
}

//> 3
