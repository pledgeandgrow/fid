// Conformance: docs/reference/reference.md §8.1.
// `Vec`, `HashMap` and `str` behave as values too: assigning one gives an
// independent value. The data is shared until one side writes; the first write
// copies it. `str` values are immutable, so sharing one is not observable.

fn main() -> i64 {
    var s: str = "a";
    var t: str = s;
    t = t + "b";
    println(s);
    println(t);
    return 0;
}

//> a
//> ab
