// Conformance: docs/reference/reference.md §10.5.
// The builtins `p_chan_create`, `p_chan_send` and `p_chan_recv` are the
// runtime layer.

fn main() -> i64 {
    val ch = p_chan_create(4);
    p_chan_send(ch, 1);
    p_chan_send(ch, 2);
    p_chan_send(ch, 3);
    println(p_chan_recv(ch));
    println(p_chan_recv(ch));
    println(p_chan_recv(ch));
    return 0;
}

//> 1
//> 2
//> 3
