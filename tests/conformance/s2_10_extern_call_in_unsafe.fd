// Conformance: docs/reference/reference.md §2.10.
// In the program's own module, calling an extern function whose name does not
// start with `p_` needs `unsafe`.
//@ backends: ccompile

extern "C" {
    fn labs(x: i64) -> i64;
}

fn main() -> i64 {
    unsafe {
        println(labs(-5));
    }
    return 0;
}

//> 5
