// Conformance: docs/reference/reference.md §10.7.
// Calls are ordered when one happens before the other: a thread's or task's
// calls before it returns before those its awaiter makes after `await`
// returns. (Before and after the joins at the end of `parallel`.)

fn w(n: i64) -> i64 {
    println("in branch");
    return n;
}

fn main() -> i64 {
    println("before");
    var a: i64 = 0;
    parallel {
        | a = w(1);
    }
    println("after");
    return 0;
}

//> before
//> in branch
//> after
