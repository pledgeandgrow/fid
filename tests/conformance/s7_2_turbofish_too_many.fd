// Conformance: docs/reference/reference.md §7.2.
// `f::<T, U>(args)` gives the type arguments; their number must equal the
// function's type parameters. Only a plain function name takes a turbofish.
//! error:

fn id<T>(x: T) -> T { return x; }

fn main() -> i64 {
    println(id::<i64, i64>(1));
    return 0;
}
