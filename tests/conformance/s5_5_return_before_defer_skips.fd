// Conformance: docs/reference/reference.md §5.5.
// Every `return` lowered after a `defer` statement runs it, also when the
// `defer` was in a branch that did not execute. (A `return` lowered before the
// `defer` does not run it.)

fn f(x: i64) -> i64 {
    if x == 0 { return 0; }
    defer { println("late"); }
    return x;
}

fn main() -> i64 {
    println(f(0));
    println(f(3));
    return 0;
}

//> 0
//> late
//> 3
