// Conformance: docs/reference/reference.md §11.
// `@repr(C)`, `@packed` (struct): C-compatible layout; fields with no padding.

@packed
struct Pk {
    a: u8,
    b: i64,
}

fn main() -> i64 {
    val p: Pk = Pk { a: 1, b: 300 };
    println(p.a + 0);
    println(p.b);
    return 0;
}

//> 1
//> 300
