// Conformance: docs/reference/reference.md §4.1.
// `&&` binds tighter than `|`, `^`, `&`, `<<` and `>>`. `flags & 1 != 0`
// parses as `flags & (1 != 0)`; write `(flags & 1) != 0`. (`1 | 2 && 3` is `1
// | (2 && 3)`, and `&&` needs `bool`.)
//! error:

fn main() -> i64 {
    val x = 1 | 2 && 3;
    println(x);
    return 0;
}
