// Conformance: docs/reference/reference.md §4.5.
// `e is Name` is a `bool`: an enum-variant test at run time (`x is Some`), or
// a type test (`x is i64`).

fn main() -> i64 {
    val a: Option<i64> = Option::Some(1);
    val b: Option<i64> = Option::None;
    println(a is Some);
    println(b is Some);
    println(b is None);
    return 0;
}

//> true
//> false
//> true
