// Conformance: docs/reference/reference.md §4.11.
// `comptime fn` marks a function for compile-time calls; a call with literal
// arguments is evaluated at compile time. (Called with a run-time value it
// runs at run time.)

comptime fn sq(x: i64) -> i64 { return x * x; }

fn main() -> i64 {
    var n: i64 = 3;
    n = n + 1;
    println(sq(n));
    return 0;
}

//> 16
