// Conformance: docs/reference/reference.md §8.3.
// For a local declared with an explicit struct type whose struct has a method
// `drop`, that method is called at function exit (a parameter is not such a
// local).

struct R {
    id: i64,
}

impl R {
    fn drop(self) { println("drop " + int_to_str(self.id)); }
}

fn look(r: R) -> i64 { return r.id; }

fn main() -> i64 {
    val r: R = R { id: 3 };
    println(look(r));
    return 0;
}

//> 3
//> drop 3
