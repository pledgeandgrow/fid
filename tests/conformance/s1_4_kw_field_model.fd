// Conformance: docs/reference/reference.md §1.4.
// The word keywords (all but the type names) may also be used as the name of a
// function, method, parameter, field or local variable. (Here a struct field.)

struct Box1 {
    model: i64,
}

fn main() -> i64 {
    val b: Box1 = Box1 { model: 12 };
    println(b.model + 1);
    return 0;
}

//> 13
