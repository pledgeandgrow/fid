// Conformance: docs/reference/reference.md §7.1.
// `N: i64` (any integer type keyword) declares a const parameter; `[T; N]` in
// a parameter takes the array's length.

fn length<N: i64>(a: [i64; N]) -> i64 { return N; }

fn main() -> i64 {
    val a: [i64; 4] = [1, 2, 3, 4];
    val b: [i64; 2] = [1, 2];
    println(length(a));
    println(length(b));
    return 0;
}

//> 4
//> 2
