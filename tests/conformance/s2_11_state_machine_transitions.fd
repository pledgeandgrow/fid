// Conformance: docs/reference/reference.md §2.11.
// `state S { A { on e => B, … } … }` becomes an enum with one variant per
// state, `S_initial()` and `S_handle(state, event)`.

state Door {
    Closed {
        on open => Opened
    }
    Opened {
        on close => Closed
    }
}

fn show(d: Door) {
    match d {
        Door::Closed => { println("closed"); }
        Door::Opened => { println("opened"); }
    }
}

fn main() -> i64 {
    var d = Door_initial();
    show(d);
    d = Door_handle(d, "open");
    show(d);
    d = Door_handle(d, "close");
    show(d);
    return 0;
}

//> closed
//> opened
//> closed
