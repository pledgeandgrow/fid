// Conformance: docs/reference/reference.md §8.2.
// A stack overflow is a panic: `Panic: Stack overflow` (status 1). `fid run`
// stops at its recursion limit instead.

fn down(n: i64) -> i64 {
    return down(n + 1) + 1;
}

fn main() -> i64 {
    println("start");
    println(down(0));
    return 0;
}

//> start
//! panic
