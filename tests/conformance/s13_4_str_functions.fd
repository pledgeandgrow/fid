// Conformance: docs/reference/reference.md §13.4.
// Core provides `str_len`, `str_slice`, `str_find`, `str_replace`, `str_to_upper`, `str_parse_int`, ...

fn main() -> i64 {
    val s: str = "Hello, world";
    println(str_len(s));
    println(str_slice(s, 7, 12));
    println(str_find(s, "o"));
    println(str_replace(s, "world", "you"));
    println(str_to_upper("abc"));
    println(str_parse_int("-42") + 1);
    if str_starts_with(s, "Hell") { println(1); } else { println(0); }
    println(str_trim("  x  "));
    return 0;
}

//> 12
//> world
//> 4
//> Hello, you
//> ABC
//> -41
//> 1
//> x
