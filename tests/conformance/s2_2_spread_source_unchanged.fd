// Conformance: docs/reference/reference.md §2.2.
// `..base` copies the remaining fields from another value of the same struct.

struct P3 {
    a: i64,
    b: i64,
    c: i64,
}

fn main() -> i64 {
    val a: P3 = P3 { a: 1, b: 2, c: 3 };
    val b: P3 = P3 { a: 7, c: 9, ..a };
    println(a.a + a.b + a.c);
    println(b.a + b.b + b.c);
    return 0;
}

//> 6
//> 18
