// Conformance: docs/reference/reference.md §6.
// A bare name that is a unit variant of the scrutinee's enum is that variant,
// as `Some(x)` is: `None =>` written first matches None only, and the arms
// after it still run. (Before, the name bound the value and the arm matched
// everything.)
fn pick(o: Option<i64>) -> i64 {
    match o {
        None => {
            return -1;
        }
        Some(v) => {
            return v;
        }
    }
}

fn main() -> i64 {
    println(pick(Option::Some(7)));
    println(pick(Option::None));
    match 5 {
        x => {
            println(x);
        }
    }
    return 0;
}

//> 7
//> -1
//> 5
