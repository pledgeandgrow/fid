// Conformance: docs/reference/reference.md §4.3.
// `Name::member(args)`: an associated function of a struct (`Vec::new()`,
// `Point::origin()`).

struct Point {
    x: i64,
    y: i64,
}

impl Point {
    fn origin() -> Point { return Point { x: 0, y: 0 }; }
}

fn main() -> i64 {
    val p: Point = Point::origin();
    println(p.x + p.y);
    return 0;
}

//> 0
