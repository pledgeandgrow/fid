// Conformance: docs/reference/reference.md §1.10.
// The parser consumes a `;` after a statement or item if there is one; it does
// not require it.

fn add(a: i64, b: i64) -> i64 {
    return a + b
}

fn main() -> i64 {
    val x = add(1, 2)
    var y = x * 2
    y = y + 1
    println(y)
    return 0
}

//> 7
