// Conformance: docs/reference/reference.md §1.6.
// A float literal is digits, `.`, at least one digit, and an optional exponent: `1_000.25`.

fn main() -> i64 {
    val x: f64 = 1_000.25;
    println((x * 4.0) as i64);
    val y: f64 = 1.5e-3;
    println((y * 10000.0) as i64);
    return 0;
}

//> 4001
//> 15
