// Conformance: docs/reference/reference.md §2.5.
// A struct, enum, string, bool or number given where a `dyn T` is wanted, or a
// `dyn T` where one of those is wanted, is a type error: the object exists
// only where the cast made it.
//! error:

cap Animal {
    fn legs(self) -> i64;
    fn kind(self) -> str { return "animal"; }
}

struct Dog {
    a: i64,
}

struct Bird {
    a: i64,
}

impl Animal for Dog {
    pub fn legs(self: Dog) -> i64 { return 4; }
    pub fn kind(self: Dog) -> str { return "dog"; }
}

impl Animal for Bird {
    pub fn legs(self: Bird) -> i64 { return 2; }
}

fn count(a: dyn Animal) -> i64 { return a.legs(); }

fn main() -> i64 {
    val d = Dog { a: 0 } as dyn Animal;
    val back: Dog = d;
    println(1);
    return 0;
}
