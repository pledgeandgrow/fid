// Conformance: docs/reference/reference.md §10.1.
// `spawn` of any other expression evaluates it at once. It is inside
// `spawn scope { }` (CA6: a task whose handle is never read is an error
// outside one).

fn main() -> i64 {
    spawn scope {
        val x = spawn (2 + 3);
    }
    println("ok");
    return 0;
}

//> ok
