// Conformance: docs/reference/reference.md §8.2.
// A panic flushes stdout (what the program printed before is not lost), and
// exits with status 1.

fn main() -> i64 {
    for i in 0..5 { println(i); }
    val v: Vec<i64> = Vec::new();
    println(v.get(2));
    return 0;
}

//> 0
//> 1
//> 2
//> 3
//> 4
//! panic
