// Conformance: docs/reference/reference.md §4.11.
// A statement `comptime if cond { .. } else { .. }` selects its branch
// while compiling: the branch not taken is not type checked (it may name
// what the other configuration has) and its locals are as visible as any
// other statement's.

const WIDE: bool = true;

fn main() -> i64 {
    comptime if WIDE {
        println("wide build");
        val w: i64 = 80;
        println(int_to_str(w));
    } else {
        this_only_exists_in_the_narrow_build();
    }
    return 0;
}

//> wide build
//> 80
