// Conformance: docs/reference/reference.md §7.2.
// Methods of a generic `impl` are typed per receiver: on a `Slot<f64>` the
// method's `T` is `f64`. On a value written without type arguments (a bare
// `Option`) `T` is `i64`.

fn main() -> i64 {
    val o: Option = Option::Some(5);
    val n: i64 = o.unwrap();
    println(n + 1);
    return 0;
}

//> 6
