// Conformance: docs/reference/reference.md §3.4.
// Without a context a literal takes the smallest of `i8`, `i16`, `i32`, `i64`
// that holds it. An unannotated `val`/`var` initialised from an expression of
// only literals is an `i64`: `var i = 0;` is an `i64`.

fn main() -> i64 {
    val x = 100 + 100;
    val y = x * 1000000000;
    println(y);
    return 0;
}

//> 200000000000
