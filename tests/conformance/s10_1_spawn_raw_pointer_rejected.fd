// Conformance: docs/reference/reference.md §10.1.
// Every argument of the spawned call, and every variable the expression names,
// must be `@send`. References and raw pointers are not.
//! error:

fn read(p: *mut i64) -> i64 { return 0; }

fn main() -> i64 {
    var x: i64 = 1;
    val p: *mut i64 = &mut x;
    val f = spawn read(p);
    println(await f);
    return 0;
}
