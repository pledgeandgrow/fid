// Conformance: docs/reference/reference.md §4.7.
// A `match` used as a value has the type of its first arm that does not
// diverge.

fn f(n: i64) -> i64 {
    val v: i64 = match n {
        0 => { return 100; }
        _ => { n + 1 }
    };
    return v;
}

fn main() -> i64 {
    println(f(0));
    println(f(5));
    return 0;
}

//> 100
//> 6
