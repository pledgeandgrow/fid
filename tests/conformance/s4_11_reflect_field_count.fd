// Conformance: docs/reference/reference.md §4.11.
// Reflection: `comptime type_name(T)`, `is_struct(T)`, `is_enum(T)`,
// `field_count(T)`, `field_names(T)`, `enum_variants(E)`, `struct_size(T)`,
// `field_offset(T.f)`, `enum_discriminant(E.V)`.

struct Point {
    x: i64,
    y: i64,
    label: str,
}

enum Color {
    Red,
    Green,
    Blue,
}

fn main() -> i64 {
    val n: i64 = comptime field_count(Point);
    println(n);
    return 0;
}

