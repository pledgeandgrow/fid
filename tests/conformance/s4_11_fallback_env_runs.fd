// Conformance: docs/reference/reference.md §4.11.
// FID_CT_FALLBACK=1 restores the old behavior: a comptime that cannot be
// evaluated warns and runs when the program does.
//@ env: FID_CT_FALLBACK=1

struct P { x: i64 }

fn getx(p: P) -> i64 { return p.x; }

fn main() -> i64 {
    val n = comptime getx(P { x: 40 }) + 2;
    println(int_to_str(n));
    return 0;
}

//> 42
