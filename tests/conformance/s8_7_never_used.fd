// Conformance: docs/reference/reference.md §8.7.
// A struct annotated `@linear` is used exactly once. Leaving its scope without
// using it is an error (`is linear but was never consumed`).
//! error: never consumed

@linear
struct Coin {
    v: i64,
}

fn spend(c: Coin) -> i64 { return c.v; }

fn main() -> i64 {
    val c: Coin = Coin { v: 5 };
    println(1);
    return 0;
}
