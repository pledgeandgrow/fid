// Conformance: docs/reference/reference.md §5.1.
// `var` binds a name that can be assigned. `var x: T;` declares it without a
// value; reading it before an assignment is an error (`Init error`).

fn main() -> i64 {
    val c: bool = true;
    var x: i64;
    if c { x = 1; } else { x = 2; }
    println(x);
    return 0;
}

//> 1
