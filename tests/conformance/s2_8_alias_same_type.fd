// Conformance: docs/reference/reference.md §2.8.
// `type Name = type`: an alias names a type. Equal types after aliases are
// resolved are compatible (§3.3).

type Id = i64;

fn take(x: i64) -> i64 { return x + 1; }

fn main() -> i64 {
    val i: Id = 9;
    println(take(i));
    return 0;
}

//> 10
