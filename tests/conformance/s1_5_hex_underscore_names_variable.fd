// Conformance: docs/reference/reference.md §1.5.
// Hexadecimal, binary and octal literals take no underscores: `0xFF_FF` lexes
// as `0xFF` followed by the identifier `_FF`. (With `_FF` declared, `0xFF_FF;`
// is `0xFF` and then the statement `_FF`.)

fn main() -> i64 {
    val _FF: i64 = 1;
    val x: i64 = 0xFF_FF;
    println(x);
    return 0;
}

//> 255
