// Conformance: docs/reference/reference.md §2.2.
// The default expression is written in at each such literal, so it is
// evaluated once per literal.

var g_count: i64 = 0;

fn next() -> i64 {
    g_count = g_count + 1;
    return g_count;
}

struct Id {
    id: i64 = next(),
}

fn main() -> i64 {
    val a: Id = Id { .. };
    val b: Id = Id { .. };
    println(a.id);
    println(b.id);
    return 0;
}

//> 1
//> 2
