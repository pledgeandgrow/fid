// Conformance: docs/reference/reference.md §6.
// Nested constructor patterns (`Ok(x)` in `Some(Ok(x))`) match since Nov 15
// (competitive-roadmap LG8: parser.fd pd_desugar_arms makes them inner
// matches); reference §6 still says there are no nested patterns.

fn main() -> i64 {
    val o: Option<Option<i64>> = Option::Some(Option::Some(1));
    match o {
        Option::Some(Option::Some(v)) => { println(v); }
        _ => { println(0); }
    }
    return 0;
}

