// Conformance: docs/reference/reference.md §2.2.
// A field may declare a default: `port: i64 = 8080`. A literal ending in a
// bare `..` gives every field it leaves out its default; a field left out that
// has none is an error.

struct Config {
    host: str = "localhost",
    port: i64 = 8080,
    debug: bool = false,
}

fn main() -> i64 {
    val c: Config = Config { .. };
    println(c.host);
    println(c.port);
    println(c.debug);
    return 0;
}

//> localhost
//> 8080
//> false
