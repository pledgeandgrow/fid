// Conformance: docs/reference/reference.md §4.10.
// A closure that captures a linear variable is an error; one that captures a
// reference cannot escape (§8.4).
//! error:

@linear
struct Token {
    id: i64,
}

fn burn(t: Token) -> i64 { return t.id; }

fn main() -> i64 {
    val t: Token = Token { id: 1 };
    val f = fn() -> i64 { return burn(t); };
    println(f());
    return 0;
}
