// Conformance: docs/reference/reference.md §11.
// `@gas(N)`: the body's static cost (nodes, with trips of loops that have
// literal bounds) plus its callees' must not exceed `N`.
//! error:

@gas(1)
fn f(a: i64) -> i64 {
    var s: i64 = 0;
    for i in 0..1000 { s = s + i * a; }
    return s;
}

fn main() -> i64 {
    println(f(1));
    return 0;
}
