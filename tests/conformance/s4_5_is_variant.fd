// Conformance: docs/reference/reference.md §4.5.
// `e is Name` is a `bool`: an enum-variant test at run time (`x is Some`).

fn main() -> i64 {
    val a: Option<i64> = Option::Some(3);
    if a is Some { println(1); } else { println(0); }
    val b: Option<i64> = Option::None;
    if b is Some { println(1); } else { println(0); }
    return 0;
}

//> 1
//> 0
