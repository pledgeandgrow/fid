// Conformance: docs/reference/reference.md §1.8.
// `"…"`: escapes `\n` `\t` `\r` `\\` `\"` `\0` `\xHH` `\u{H…}`. (`\u{…}` puts
// the character's UTF-8 bytes in the string.)

fn main() -> i64 {
    val s: str = "\u{e9}";
    println(str_len(s));
    println(str_byte_at(s, 0));
    println(str_byte_at(s, 1));
    return 0;
}

