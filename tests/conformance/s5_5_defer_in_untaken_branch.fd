// Conformance: docs/reference/reference.md §5.5.
// Every `return` lowered after a `defer` statement runs it, also when the
// `defer` was in a branch that did not execute.

fn f(c: bool) -> i64 {
    if c {
        defer { println("from branch"); }
    }
    return 7;
}

fn main() -> i64 {
    println(f(false));
    return 0;
}

//> from branch
//> 7
