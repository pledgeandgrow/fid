// Conformance: docs/reference/reference.md §5.5.
// A deferred block runs only if its `defer` statement executed: one in a
// branch that did not run does not. (Before, every `return` lowered after
// the statement ran it, and this printed "from branch" first.)

fn f(c: bool) -> i64 {
    if c {
        defer { println("from branch"); }
    }
    return 7;
}

fn main() -> i64 {
    println(f(false));
    println(f(true));
    return 0;
}

//> 7
//> from branch
//> 7
