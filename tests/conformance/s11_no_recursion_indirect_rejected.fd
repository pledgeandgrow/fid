// Conformance: docs/reference/reference.md §11.
// `@no-recursion`: no direct or indirect recursion.
//! error:

@no-recursion
fn a(n: i64) -> i64 {
    if n == 0 { return 0; }
    return b(n - 1);
}

@no-recursion
fn b(n: i64) -> i64 { return a(n); }

fn main() -> i64 {
    println(a(3));
    return 0;
}
