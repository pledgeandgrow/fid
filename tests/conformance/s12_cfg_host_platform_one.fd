// Conformance: docs/reference/reference.md §12.
// `@cfg(…)` on a function or a struct keeps the item only when every argument
// holds. `linux`, `windows`, `macos` hold when `fid` itself runs on that
// system.

@cfg(windows)
fn host() -> i64 { return 1; }

@cfg(linux)
fn host() -> i64 { return 1; }

@cfg(macos)
fn host() -> i64 { return 1; }

fn main() -> i64 {
    println(host());
    return 0;
}

//> 1
