// Conformance: docs/reference/reference.md §7.2.
// An integer literal given for a type parameter is an `i64`.

fn one<T>(x: T) -> Vec<T> {
    var v: Vec<T> = Vec::new();
    v.push(x);
    return v;
}

fn main() -> i64 {
    val v: Vec<i64> = one(3);
    println(v.get(0));
    return 0;
}

//> 3
