// Conformance: docs/reference/reference.md §3.4.
// A plain assignment checks the assigned value's type, as a declaration
// does: a `bool` is not assigned to an `i64` variable. (Until Nov 23 nothing
// but a literal's fit was checked, and this was accepted.)

//! error: cannot assign bool to variable

fn main() -> i64 {
    var x: i64 = 0;
    x = true;
    println(7);
    return 0;
}
