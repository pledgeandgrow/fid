// Conformance: docs/reference/reference.md §1.3.
// The single character `_` is an identifier token; the parser gives it a
// meaning in patterns (wildcard) and types (inferred type).

fn main() -> i64 {
    val n: i64 = 9;
    match n {
        1 => { println(1); }
        _ => { println(0); }
    }
    return 0;
}

//> 0
