// Conformance: docs/reference/reference.md §3.3.
// It accepts any two instances of `Vec`, `HashMap`, `Rc` or `Arc`, and `Name`
// against `Name<…>` (a generic used without arguments).

fn main() -> i64 {
    val a: Vec<i64> = Vec::new();
    val b: Vec<str> = a;
    println(b.len());
    return 0;
}

//> 0
