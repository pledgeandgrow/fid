// Conformance: docs/reference/reference.md §6.
// A `match` on an enum must cover every variant, and one on `bool` both
// values, unless an arm is `_` or a name. A `match` on integers or strings is
// not checked for exhaustiveness.

enum Dir {
    N,
    E,
    S,
}

fn main() -> i64 {
    val d: Dir = Dir::E;
    match d {
        Dir::N => { println(1); }
        rest => { println(8); }
    }
    return 0;
}

//> 8
