// Conformance: docs/reference/reference.md §3.4.
// In the program's own module, a value of a wider integer type, or a float,
// given to a narrower integer variable is an error; `as` converts. The check
// applies to `val`/`var` declarations and to `x = e`.
//! error: may not fit

fn main() -> i64 {
    val big: i64 = 5;
    var small: i32 = 0;
    small = big;
    println(small);
    return 0;
}
