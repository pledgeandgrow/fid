// Conformance: docs/reference/reference.md §2.1.
// A call with named arguments is checked: a name that is no parameter, a
// parameter given twice, a positional argument after a named one, a parameter
// without a default left out, and a named argument of the wrong type are
// errors.
//! error:

fn f(a: i64, b: i64) -> i64 { return a - b; }

fn main() -> i64 {
    println(f(a: 1, b: "two"));
    return 0;
}
