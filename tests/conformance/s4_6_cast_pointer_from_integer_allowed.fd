// Conformance: docs/reference/reference.md §4.6.
// Making a raw pointer from an integer with a cast is allowed in safe code:
// a raw pointer cannot be read or written without `unsafe`. The cast is the
// explicit form (a bare `var p: *mut i64 = n;` needs `unsafe`, §8.5).

fn main() -> i64 {
    val n: i64 = 4096;
    val p: *mut i64 = n as * mut i64;
    println(p as i64);
    return 0;
}

//> 4096
