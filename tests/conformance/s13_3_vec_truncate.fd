// Conformance: docs/reference/reference.md §13.3.
// `Vec<T>`: `Vec::new()`, `push`, `pop`, `len`, `is_empty`, `get`, `set`,
// `clear`, `capacity`, `insert`, `remove`, `contains`, `reverse`, `first`,
// `last`, `extend`, `truncate`, `sort`, `for_each`, `fold`, `any`, `all`,
// `find`, `position`, `clone`, `map`, `filter`.

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(3);
    v.push(1);
    v.push(4);
    v.push(1);
    v.push(5);
    v.truncate(2);
    println(v.len());
    println(v.get(1));
    return 0;
}

