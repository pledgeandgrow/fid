// Conformance: docs/reference/reference.md §11.
// `@bounded-stack[(N)]`: everything reachable is non-recursive and called
// directly; with `N`, the deepest call chain is at most `N` frames.
//! error:

@bounded-stack
fn c(n: i64) -> i64 { return n; }

@bounded-stack
fn b(n: i64) -> i64 { return c(n); }

@bounded-stack
fn a(n: i64) -> i64 { return b(n); }

@bounded-stack(1)
fn top(n: i64) -> i64 { return a(n); }

fn main() -> i64 {
    println(top(3));
    return 0;
}
