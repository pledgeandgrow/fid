// Conformance: docs/reference/reference.md §4.7.
// `if c { a } else { b }` has the type of its branches; a branch that diverges
// takes the other's type.

fn f(n: i64) -> i64 {
    val v: i64 = if n < 0 { return 0; } else { n * 3 };
    return v;
}

fn main() -> i64 {
    println(f(4));
    println(f(-4));
    return 0;
}

//> 12
//> 0
