// Conformance: docs/reference/reference.md §4.11.
// `comptime T: type` declares a comptime type parameter: a type parameter
// the caller fills by inference or `f::<T>(..)`, and one whose reflection
// the function body computes per instantiation.

struct P { x: i64, y: i64 }

fn name_of(comptime T: type, v: T) -> str {
    return comptime type_name(T);
}

fn fields_of(comptime T: type, v: T) -> i64 {
    return comptime field_count(T);
}

fn main() -> i64 {
    val p: P = P { x: 1, y: 2 };
    println(name_of(p));
    println(name_of::<i64>(3));
    println(int_to_str(fields_of(p)));
    return 0;
}

//> P
//> i64
//> 2
