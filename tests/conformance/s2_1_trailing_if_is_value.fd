// Conformance: docs/reference/reference.md §2.1.
// A trailing expression statement, or a trailing `if`/`else` or `match`, is the function's value.

fn max(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

fn main() -> i64 {
    println(max(3, 9));
    println(max(9, 3));
    return 0;
}

//> 9
//> 9
