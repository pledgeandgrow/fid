// Conformance: docs/reference/reference.md §2.2.
// `==` and `!=` on two structs compare field by field.

struct P {
    x: i64,
    y: i64,
}

fn main() -> i64 {
    val a: P = P { x: 1, y: 2 };
    val b: P = P { x: 1, y: 2 };
    val c: P = P { x: 1, y: 3 };
    if a == b { println(1); } else { println(0); }
    if a != c { println(1); } else { println(0); }
    return 0;
}

//> 1
//> 1
