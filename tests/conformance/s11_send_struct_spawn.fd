// Conformance: docs/reference/reference.md §11.
// `@sync` (struct): recorded; no check reads it. `@send` (struct): values may
// be sent to another thread.

@send
struct S {
    n: i64,
}

fn work(s: S) -> i64 { return s.n * 2; }

fn main() -> i64 {
    val f = spawn work(S { n: 4 });
    println(await f);
    return 0;
}

//> 8
