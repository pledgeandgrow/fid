// Conformance: docs/reference/reference.md §2.4.
// `impl<T> Slot<T> { … }`: the type parameters after `impl` are in scope in
// the methods.

struct Slot<T> {
    v: T,
}

impl<T> Slot<T> {
    fn get(self) -> T { return self.v; }
}

fn main() -> i64 {
    val a: Slot<i64> = Slot { v: 5 };
    val b: Slot<str> = Slot { v: "s" };
    println(a.get());
    println(b.get());
    return 0;
}

//> 5
//> s
