// Conformance: docs/reference/reference.md §6.
// Integer patterns are non-negative literals: `-1 =>` is a parse error
// (`invalid pattern 'Minus'`). `a..=b` and `a..b` match ranges.
//! error: invalid pattern

fn main() -> i64 {
    val x: i64 = -1;
    match x {
        -1 => { println(1); }
        _ => { println(0); }
    }
    return 0;
}
