// Conformance: docs/reference/reference.md §4.1.
// | `|` (5) < `^` (6) < `&` (7) < `<<` `>>` (8) < `+` `-` (12) < `*` `/` `%` (13).

fn main() -> i64 {
    println(1 | 6 ^ 3 & 5);
    println(2 + 3 * 4 - 6 / 2);
    println(16 >> 1 + 1);
    println(5 & 3 << 1);
    return 0;
}

//> 7
//> 11
//> 4
//> 4
