// Conformance: docs/reference/reference.md §1.3.
// An identifier is an ASCII letter or `_` followed by ASCII letters, digits
// and `_`.

fn main() -> i64 {
    val a_very_long_name_with_many_parts_0123456789: i64 = 6;
    println(a_very_long_name_with_many_parts_0123456789);
    return 0;
}

//> 6
