// Conformance: docs/reference/reference.md §3.4.
// In the program's own module, a value of a wider integer type, or a float,
// given to a narrower integer variable is an error; `as` converts.
//! error: may not fit

fn main() -> i64 {
    val big: u16 = 5;
    val small: u8 = big;
    println(small);
    return 0;
}
