// Conformance: docs/reference/reference.md §11.
// `@no-indirect`: no call through a function or `dyn` parameter or dynamic
// dispatch.
//! error:

@no-indirect
fn apply(f: fn(i64) -> i64, x: i64) -> i64 { return f(x); }

fn inc(x: i64) -> i64 { return x + 1; }

fn main() -> i64 {
    println(apply(inc, 1));
    return 0;
}
