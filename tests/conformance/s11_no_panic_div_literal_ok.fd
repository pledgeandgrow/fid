// Conformance: docs/reference/reference.md §11.
// `@no-panic`: no `unwrap`/`expect`/`p_panic`, no division or remainder by a
// value not proven non-zero, no unchecked indexing or overflow (unless
// `@wrapping`).

@no-panic
@wrapping
fn f(a: i64) -> i64 { return a / 2; }

fn main() -> i64 {
    println(f(6));
    return 0;
}

