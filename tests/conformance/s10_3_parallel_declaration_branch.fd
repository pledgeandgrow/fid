// Conformance: docs/reference/reference.md §10.3.
// A branch that is one call is spawned on a thread; another branch runs as a
// function of its own or in order on the current thread. All threads are
// joined before the statement ends.

fn id(x: i64) -> i64 { return x; }

fn main() -> i64 {
    val n: i64 = 4;
    var a: i64 = 0;
    parallel {
        | a = id(n);
        | val k: i64 = n * 2;
          println(k);
    }
    println(a);
    return 0;
}

//> 8
//> 4
