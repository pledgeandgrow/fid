// Conformance: docs/reference/reference.md §4.5.
// `e?` requires `Option<T>` or `Result<T, E>` and has type `T`; on `None` or
// `Err` it returns from the enclosing function with that value.

fn parse(s: str) -> Result<i64, str> {
    if s == "one" { return Result::Ok(1); }
    return Result::Err("bad: " + s);
}

fn twice(s: str) -> Result<i64, str> {
    val n: i64 = parse(s)?;
    return Result::Ok(n * 2);
}

fn main() -> i64 {
    println(twice("one").unwrap());
    return 0;
}

//> 2
