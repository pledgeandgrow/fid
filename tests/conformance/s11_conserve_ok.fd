// Conformance: docs/reference/reference.md §11.
// `@conserve`: no `IO`/`Net`/`Spawn`/`Diverge` effect, no floats, calls only
// `@conserve` functions and methods.

@conserve
fn move_amount(a: i64, b: i64) -> i64 { return a + b; }

fn main() -> i64 {
    println(move_amount(3, 4));
    return 0;
}

