// Conformance: docs/reference/reference.md §13.3.
// `Box::new(x)` gives `Box<T>`; `*b` gives the `T`. `Rc::new` and `Arc::new`
// give `Rc<T>`/`Arc<T>` with `clone`, `drop`, `get`, `count`.

fn main() -> i64 {
    val a: Rc<i64> = Rc::new(7);
    val b: Rc<i64> = a.clone();
    println(a.count());
    println(b.get());
    return 0;
}

//> 2
//> 7
