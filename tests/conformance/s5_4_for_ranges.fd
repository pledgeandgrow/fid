// Conformance: docs/reference/reference.md §5.4.
// `for x in a..b` and `for x in a..=b` iterate a range.

fn main() -> i64 {
    var s: i64 = 0;
    for i in 1..4 { s = s * 10 + i; }
    println(s);
    var t: i64 = 0;
    for i in 1..=4 { t = t * 10 + i; }
    println(t);
    return 0;
}

//> 123
//> 1234
