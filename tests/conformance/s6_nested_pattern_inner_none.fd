// Conformance: docs/reference/reference.md §6.
// Nested constructor patterns match since Nov 15 (LG8); a `_` arm takes what
// the nested arm does not.

fn main() -> i64 {
    val o: Option<Option<i64>> = Option::Some(Option::None);
    match o {
        Option::Some(Option::Some(v)) => { println(v); }
        _ => { println(0); }
    }
    return 0;
}

//> 0
