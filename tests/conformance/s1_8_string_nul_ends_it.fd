// Conformance: docs/reference/reference.md §1.8.
// `\0`, `\x00` and `\u{0}` are a zero byte of the string, and the rest of the
// literal is kept (RT2, Nov 16: they ended the literal before, hence the
// file's name).

fn main() -> i64 {
    println(str_len("ab\0cd"));
    println(str_len("ab\x00cd"));
    println(str_byte_at("ab\0cd", 2));
    println(str_byte_at("ab\u{0}cd", 3));
    return 0;
}

//> 5
//> 5
//> 0
//> 99
