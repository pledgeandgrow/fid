// Conformance: docs/reference/reference.md §4.11.
// `comptime gen { … }` (statement) generates code: the block's value, a
// string, is parsed and its functions, structs, enums, constants, impl blocks
// and trait impls are added to the program.

fn main() -> i64 {
    comptime gen {
        return "enum GenE { A, B(i64) }";
    }
    val e: GenE = GenE::B(4);
    match e {
        GenE::A => { println(0); }
        GenE::B(n) => { println(n); }
    }
    return 0;
}

//> 4
