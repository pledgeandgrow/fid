// Conformance: docs/reference/reference.md §11.
// `@realtime`: no `IO`/`Net`/`Spawn` effect, no `while`, no recursion, no
// allocating, blocking or dynamic-dispatch call.
//! error:

@realtime
fn f(n: i64) -> i64 {
    var i: i64 = 0;
    while i < n { i = i + 1; }
    return i;
}

fn main() -> i64 {
    println(f(1));
    return 0;
}
