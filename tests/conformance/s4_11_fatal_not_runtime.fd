// Conformance: docs/reference/reference.md §4.11.
// A `comptime` that cannot be evaluated is a compile error; it does not
// silently run when the program does (FID_CT_FALLBACK=1 restores that).
//! error: comptime error

struct P { x: i64 }

fn getx(p: P) -> i64 { return p.x; }

fn main() -> i64 {
    // getx typechecks, but a struct argument is beyond the evaluator: an
    // explicit comptime that fails is fatal, not runtime work
    val n = comptime getx(P { x: 40 });
    println(int_to_str(n));
    return 0;
}
