// Conformance: docs/reference/reference.md §6.
// Arms are tried in order; the first that matches runs.

fn main() -> i64 {
    val n: i64 = 5;
    match n {
        0..=9 => { println("digit"); }
        5 => { println("five"); }
        _ => { println("other"); }
    }
    return 0;
}

//> digit
