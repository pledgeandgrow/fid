// Test: @gas annotation (Phase 7.5D)
// Functions marked @gas(N) have a compile-time gas budget of N.
// Gas cost = AST node count + gas of all called functions (transitive).
// If total > N, it's a compile error — unlike Solidity which fails at runtime.

// Simple function with small gas budget — should pass
@gas(50)
pf simple_add(a: i64, b: i64) -> i64 {
    ret a + b;
}

// Function that calls simple_add — gas includes callee's gas
@gas(100)
pf use_add(x: i64) -> i64 {
    pv r = simple_add(x, 10);
    ret r + 1;
}

// Function with a loop — more gas but within budget
@gas(200)
pf sum_loop(n: i64) -> i64 {
    pv total = 0;
    pv i = 0;
    while i < n {
        total = total + i;
        i = i + 1;
    }
    ret total;
}

pf main() {
    pv r1 = simple_add(3, 4);
    print("simple_add(3,4) = ");
    print(r1);
    print("\n");

    pv r2 = use_add(5);
    print("use_add(5) = ");
    print(r2);
    print("\n");

    pv r3 = sum_loop(10);
    print("sum_loop(10) = ");
    print(r3);
    print("\n");

    print("OK\n");
}
