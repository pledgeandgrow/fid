// CA5: every argument a spawned task is given is a whole copy of its own
// (core p_send_copy), and the task's wrapper (lower.fd
// Lowerer_spawn_wrapper) frees those copies when the call returns,
// whatever the result is: a number, a str, a Vec or a map. Before, a task
// whose result was a Vec or map ran without the wrapper and its argument
// copies were never freed (a Vec_send_copy buffer and header per spawn).

fn words_up(ws: Vec<str>) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < ws.len() {
        out.push(ws.get(i) + "!");
        i = i + 1;
    }
    return out;
}

fn count_keys(m: HashMap<str, i64>, extra: str) -> HashMap<str, i64> {
    var m = m;
    m.insert(extra, m.len());
    return m;
}

fn total(v: Vec<i64>) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < v.len() {
        s = s + v.get(i);
        i = i + 1;
    }
    return s;
}

fn label(v: Vec<str>, n: i64) -> str {
    return v.get(0) + int_to_str(n + v.len());
}

fn main() {
    var ws: Vec<str> = Vec::new();
    ws.push("a");
    ws.push("b" + int_to_str(2));
    val t1 = spawn words_up(ws);
    val r1 = await t1;
    println(r1.get(0) + " " + r1.get(1) + " " + ws.get(1));

    var m: HashMap<str, i64> = HashMap::new();
    m.insert("one", 1);
    m.insert("t" + "wo", 2);
    val t2 = spawn count_keys(m, "three");
    val r2 = await t2;
    println(int_to_str(r2.len()) + " " + int_to_str(r2.get("three")) + " " + int_to_str(m.len()));

    var v: Vec<i64> = Vec::new();
    v.push(4);
    v.push(5);
    val x = spawn total(v);
    val y = spawn total(v);
    println(int_to_str(await x + await y));

    val t4 = spawn label(ws, 3);
    println(await t4);
    println("done");
}
