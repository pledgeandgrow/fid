// Counted Boxes (proposal 0004, LOWER_BOX_RC): copying a Box counts one more
// owner of what it holds, and the last owner drops it and frees the block.
// A tree of Boxes, a struct with a Box field (read through `h.inner.f`), a
// copy of that struct, and a Box of a string all free every block.

enum Tree {
    Leaf(i64),
    Node(Box<Tree>, Box<Tree>),
}

struct Inner {
    tag: str,
    n: i64,
}

struct Holder {
    name: str,
    inner: Box<Inner>,
}

fn sum(t: Tree) -> i64 {
    match t {
        Tree::Leaf(v) => { return v; }
        Tree::Node(l, r) => { return sum(*l) + sum(*r); }
    }
    return 0;
}

fn build(d: i64) -> Tree {
    if d == 0 { return Tree::Leaf(1); }
    return Tree::Node(Box::new(build(d - 1)), Box::new(build(d - 1)));
}

fn main() {
    val t: Tree = build(6);
    println(int_to_str(sum(t)));
    var h: Holder = Holder { name: "a" + "b", inner: Box::new(Inner { tag: "x" + "y", n: 3 }) };
    var h2: Holder = h;
    println(h2.name + " " + h.inner.tag + " " + int_to_str(h.inner.n));
    var b: Box<str> = Box::new("s" + "t");
    println(*b);
}
