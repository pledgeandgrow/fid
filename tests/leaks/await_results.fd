// CA5: the result of `await` (a str, Vec or map a task returned) belongs
// to the awaiting statement: a let keeps it, any other use drops it at the
// statement's end. Before, a let duplicated it and the task's own value
// was never freed (one block per awaited string).

fn shout(ws: Vec<str>) -> str {
    var ws = ws;
    ws.set(0, ws.get(0) + "!");
    return int_to_str(ws.len()) + " " + ws.get(0);
}

fn grow(v: Vec<i64>, k: i64) -> Vec<i64> {
    var v = v;
    v.push(k);
    return v;
}

fn tally(n: i64) -> HashMap<i64, i64> {
    var m: HashMap<i64, i64> = HashMap::new();
    var i: i64 = 0;
    while i < n {
        m.insert(i, i * i);
        i = i + 1;
    }
    return m;
}

fn main() {
    var ws: Vec<str> = Vec::new();
    ws.push("x");
    val t1 = spawn shout(ws);
    val r1 = await t1;
    println(r1);
    val t2 = spawn shout(ws);
    println("again " + await t2);
    var v: Vec<i64> = Vec::new();
    v.push(1);
    val t3 = spawn grow(v, 5);
    val r3 = await t3;
    println(int_to_str(r3.len()) + " " + int_to_str(r3.get(1)) + " " + int_to_str(v.len()));
    val t4 = spawn tally(4);
    val r4 = await t4;
    println(int_to_str(r4.len()) + " " + int_to_str(r4.get(3)));
    println("done");
}
