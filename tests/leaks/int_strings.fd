// RL16 (known-bugs 2g.81): integer text made and dropped, on every backend
// with `--leaks` (scripts/leak-check.sh; NATIVE=x86_64-windows for pe_ir).
// pe_ir's int_to_str returned a plain buffer that no drop freed (each one
// a leak), and its --leaks images stopped at the first allocation.
fn label(i: i64) -> str {
    return "n" + int_to_str(i);
}

fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 200 {
        val s: str = int_to_str(i * 1000000007 - 100);
        total = total + str_len(s);
        i = i + 1;
    }
    println(total);
    println(int_to_str(0 - 9223372036854775807 - 1));
    println(label(42) + label(0 - 3));
    var v: Vec<str> = Vec::new();
    var k: i64 = 0;
    while k < 5 {
        v.push(int_to_str(k * k));
        k = k + 1;
    }
    println(v.len());
    println(v.get(4));
    return 0;
}
