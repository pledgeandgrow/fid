// Value semantics (proposal 0001, release M5): assigning a Vec, a HashMap or
// a struct holding them gives an independent value. Copies share their data
// until one side changes (copy-on-write); a change through one name is never
// seen through the other.

struct Bag {
    items: Vec<i64>,
}

fn main() {
    var a: Vec<i64> = Vec::new();
    a.push(1);
    var b: Vec<i64> = a;
    b.push(2);
    println(a.len());
    println(b.len());

    var p: Bag = Bag { items: Vec::new() };
    var q: Bag = p;
    q.items.push(5);
    println(p.items.len());
    println(q.items.len());

    var m1: HashMap<str, i64> = HashMap::new();
    m1.insert("a", 1);
    var m2: HashMap<str, i64> = m1;
    m2.insert("b", 2);
    println(m1.len());
    println(m2.len());

    var bags: Vec<Bag> = Vec::new();
    bags.push(Bag { items: Vec::new() });
    var bags2: Vec<Bag> = bags;
    bags2.get(0).items.push(9);
    println(bags.get(0).items.len());
    println(bags2.get(0).items.len());
}
