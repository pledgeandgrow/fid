// LF13 leak gate: Vec::filled buffers and `a + b` strings kept on the stack
// (lower.fd lw_rc_stack_vbuf_rewrite, lw_rc_stack_strs_fn) next to the ones
// that stay on the heap (too big, grown, returned, built from the area's
// own value). Every heap block must still be freed, and no stack area may
// reach p_free.

fn counts(word: str) -> i64 {
    var c: Vec<i64> = Vec::filled(26, 0);
    var i: i64 = 0;
    while i < str_len(word) {
        var k: i64 = str_byte_at(word, i) - 97;
        if k >= 0 && k < 26 {
            c.set(k, c.get(k) + 1);
        }
        i = i + 1;
    }
    var best: i64 = 0;
    for x in c {
        if x > best {
            best = x;
        }
    }
    return best;
}

fn rows() -> i64 {
    var total: i64 = 0;
    var r: i64 = 0;
    while r < 4 {
        var row: Vec<u8> = Vec::filled(16, r as u8);
        var j: i64 = 0;
        while j < row.len() {
            total = total + (row.get(j) as i64);
            j = j + 1;
        }
        r = r + 1;
    }
    return total;
}

fn grown() -> i64 {
    var v: Vec<i64> = Vec::filled(4, 1);
    v.push(5);
    var big: Vec<i64> = Vec::filled(200, 2);
    return v.len() + big.get(199);
}

fn names(n: i64) {
    var cur: str = "";
    var i: i64 = 0;
    while i < n {
        cur = "name-" + int_to_str(i);
        var full: str = cur + " (" + int_to_str(str_len(cur)) + ")";
        println(full);
        i = i + 1;
    }
}

fn wrapped() -> i64 {
    var w: str = "x";
    var i: i64 = 0;
    while i < 20 {
        w = "<" + w;
        w = w + ">";
        i = i + 1;
    }
    return str_len(w);
}

fn joined() -> str {
    var s: str = "kept-" + "value";
    return s;
}

fn main() {
    println("counts " + int_to_str(counts("mississippi")));
    println("rows " + int_to_str(rows()));
    println("grown " + int_to_str(grown()));
    names(3);
    println("wrapped " + int_to_str(wrapped()));
    var j: str = joined();
    println(j);
}
