enum Expr { IntLit(i64), BoolLit(bool), Call(Vec<i64>) }
struct IfExpr { cond: Expr, then_block: Vec<i64>, else_block: Vec<i64> }
enum ParseResultIfExpr { Ok(IfExpr), Err(str) }

fn main() {
    var a: IfExpr = IfExpr { cond: Expr::BoolLit(true), then_block: Vec::new(), else_block: Vec::new() };
    var b: IfExpr = a;
    b.then_block.push(1);
    var r: ParseResultIfExpr = ParseResultIfExpr::Ok(b);
    match r {
        ParseResultIfExpr::Ok(ie) => { println(ie.then_block.len()); }
        ParseResultIfExpr::Err(e) => { println(e); }
    }
}
