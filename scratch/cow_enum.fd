enum Ty { A, B(str, Vec<i64>), C(str, str, str, Vec<i64>) }
enum Ex { I(i64), V(Vec<i64>) }
struct P {
    name: str,
    ty: Ty,
    flag: bool,
    items: Vec<i64>,
    has: bool,
    ex: Ex,
    tail: bool,
}
fn main() {
    var ps: Vec<P> = Vec::new();
    var p1: P = P { name: "x", ty: Ty::B("s", Vec::new()), flag: false, items: Vec::new(), has: false, ex: Ex::I(0), tail: false };
    ps.push(p1);
    var p2: P = P { name: "y", ty: Ty::C("a","b","c", Vec::new()), flag: true, items: Vec::new(), has: true, ex: Ex::V(Vec::new()), tail: false };
    ps.push(p2);
    var q: Vec<P> = ps;
    println(q.get(0).name);
    println(q.get(1).name);
    println(ps.len());
}
