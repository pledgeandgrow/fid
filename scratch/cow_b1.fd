fn main() {
    var a: Vec<i64> = Vec::new();
    a.push(1); a.push(2);
    var b: Vec<i64> = a;
    var c: Vec<i64> = b;
    b.push(3); c.push(4); a.push(5);
    println(a.len()); println(b.len()); println(c.len());
    println(a.get(0) + a.get(1));
    println(b.get(0) + b.get(1) + b.get(2));
    println(c.get(0) + c.get(1) + c.get(2));
}
