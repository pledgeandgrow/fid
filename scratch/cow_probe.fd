struct P { x: i64, xs: Vec<i64> }
fn bump(p: &mut P) { p.x = 9; }
fn grow(v: &mut Vec<i64>) { v.push(5); }

fn main() {
    var a: P = P { x: 1, xs: Vec::new() };
    var b: P = a;
    b.x = 2;
    println(a.x);
    bump(&mut a);
    println(a.x);
    var v: Vec<i64> = Vec::new();
    v.push(0);
    var w: Vec<i64> = v;
    w.push(1);
    println(v.len());
    println(w.len());
    grow(&mut v);
    println(v.len());
    println(w.len());
    b.xs.push(7);
    println(a.xs.len());
    println(b.xs.len());
}
