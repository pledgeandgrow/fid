fn main() {
    // 3-way share: all three must stay isolated
    var a: Vec<i64> = Vec::new();
    a.push(1); a.push(2);
    var b: Vec<i64> = a;
    var c: Vec<i64> = b;
    b.push(3);
    c.push(4);
    a.push(5);
    println(a.len()); println(b.len()); println(c.len());
    println(a.get(0) + a.get(1));
    println(b.get(0) + b.get(1) + b.get(2));
    println(c.get(0) + c.get(1) + c.get(2));
    // Vec<str>: share then mutate — strings must not dangle
    var s1: Vec<str> = Vec::new();
    s1.push("alpha"); s1.push("beta");
    var s2: Vec<str> = s1;
    s2.set(0, "gamma");
    println(s1.get(0));
    println(s2.get(0));
    println(s1.len()); println(s2.len());
    // Vec<Vec>: inner vecs shared then isolated
    var vv: Vec<Vec<i64>> = Vec::new();
    vv.push(a);
    var vv2: Vec<Vec<i64>> = vv;
    vv2.get(0).push(9);
    println(vv.get(0).len());
    println(vv2.get(0).len());
    // HashMap
    var m: HashMap<str, i64> = HashMap::new();
    m.insert("k", 1);
    var m2: HashMap<str, i64> = m;
    m2.insert("k", 2);
    m2.insert("x", 3);
    println(m.get("k")); println(m2.get("k")); println(m.len()); println(m2.len());
    // drops in a loop — many shares must not OOM
    var i: i64 = 0;
    while i < 100000 {
        var t: Vec<i64> = a;
        t.push(i);
        var t2: Vec<i64> = t;
        t2.push(i);
        i = i + 1;
    }
    println("loop done");
    println(a.len());
}
