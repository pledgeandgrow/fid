enum Ty { A, B(str, Vec<i64>), C(str, str, str, Vec<i64>) }
enum Ex { I(i64), V(Vec<i64>) }
struct P {
    name: str,
    ty: Ty,
    flag: bool,
    items: Vec<i64>,
    has: bool,
    ex: Ex,
    tail: bool,
}
struct Ann { name: str, args: Vec<str> }
struct SD {
    name: str,
    fields: Vec<P>,
    is_pub: bool,
    annotations: Vec<Ann>,
    type_params: Vec<str>,
}
fn main() {
    var prog: Vec<SD> = Vec::new();
    var sd: SD = SD { name: "S", fields: Vec::new(), is_pub: false, annotations: Vec::new(), type_params: Vec::new() };
    sd.fields.push(P { name: "p1", ty: Ty::B("s", Vec::new()), flag: false, items: Vec::new(), has: false, ex: Ex::I(0), tail: false });
    sd.annotations.push(Ann { name: "a", args: Vec::new() });
    sd.type_params.push("T");
    prog.push(sd);
    var i: i64 = 0;
    while i < prog.len() {
        var s: SD = prog.get(i);
        var j: i64 = 0;
        while j < s.annotations.len() {
            var an: Ann = s.annotations.get(j);
            var args: Vec<str> = an.args;
            println(an.name);
            j = j + 1;
        }
        var f: i64 = 0;
        while f < s.fields.len() {
            println(s.fields.get(f).name);
            f = f + 1;
        }
        i = i + 1;
    }
    println("done");
}
