use myast::*;
fn main() {
    var a: IfExpr = IfExpr { cond: Expr::BoolLit(true), then_block: Vec::new(), else_block: Vec::new() };
    var b: IfExpr = a;
    b.then_block.push(1);
    println(a.then_block.len());
    println(b.then_block.len());
    var r: ParseResultIfExpr = ParseResultIfExpr::Ok(b);
}
