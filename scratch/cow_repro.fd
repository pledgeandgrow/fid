enum OptStmts { None, Some(Vec<i64>) }
struct IfExpr { cond: i64, then_block: Vec<i64>, else_block: OptStmts }
enum ParseResultStmts { Ok(Vec<i64>), Err(str) }
enum ParseResultIfExpr { Ok(IfExpr), Err(str) }

fn make_stmts(ok: bool) -> ParseResultStmts {
    if ok { var v: Vec<i64> = Vec::new(); v.push(1); return ParseResultStmts::Ok(v); }
    return ParseResultStmts::Err("bad");
}

fn make_ife(ok: bool) -> ParseResultIfExpr {
    var b: IfExpr = IfExpr { cond: 1, then_block: Vec::new(), else_block: OptStmts::None };
    b.then_block.push(2);
    if ok { return ParseResultIfExpr::Ok(b); }
    return ParseResultIfExpr::Err("bad");
}

fn parse_if() -> ParseResultIfExpr {
    var then_block: Vec<i64> = Vec::new();
    match make_stmts(true) {
        ParseResultStmts::Ok(b) => { then_block = b; }
        ParseResultStmts::Err(e) => { return ParseResultIfExpr::Err(e); }
    }
    var else_block: OptStmts = OptStmts::None;
    var nested: IfExpr = IfExpr { cond: 0, then_block: Vec::new(), else_block: OptStmts::None };
    match make_ife(true) {
        ParseResultIfExpr::Ok(ie) => { nested = ie; }
        ParseResultIfExpr::Err(e) => { return ParseResultIfExpr::Err(e); }
    }
    var stmts: Vec<i64> = Vec::new();
    stmts.push(nested.cond);
    stmts.push(nested.then_block.len());
    else_block = OptStmts::Some(stmts);
    return ParseResultIfExpr::Ok(IfExpr { cond: 9, then_block: then_block, else_block: else_block });
}

fn main() {
    match parse_if() {
        ParseResultIfExpr::Ok(ie) => { println(ie.cond); println(ie.then_block.len()); }
        ParseResultIfExpr::Err(e) => { println("err " + e); }
    }
}
