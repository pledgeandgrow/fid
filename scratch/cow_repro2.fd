enum Expr { IntLit(i64), BoolLit(bool), Call(Vec<i64>) }
struct IfExpr { cond: Expr, then_block: Vec<i64>, else_block: Vec<i64> }

fn useit(e: IfExpr) -> i64 { return e.then_block.len() + e.else_block.len(); }

fn main() {
    var a: IfExpr = IfExpr { cond: Expr::BoolLit(true), then_block: Vec::new(), else_block: Vec::new() };
    var b: IfExpr = a;
    b.then_block.push(1);
    println(a.then_block.len());
    println(b.then_block.len());
    println(useit(a));
}
